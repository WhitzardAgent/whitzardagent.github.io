---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { links } from "../data/links";

interface Props {
  title: string;
  description?: string;
  brand?: "whitzard" | "nuwa";
  ogImage?: string;
}

const {
  title,
  description = "Whitzard builds safety infrastructure for frontier AI and agentic systems.",
  brand = "whitzard",
  ogImage,
} = Astro.props;

const siteTitle = title.includes("Whitzard") || title.includes("Nuwa")
  ? title
  : brand === "nuwa"
    ? `${title} — Nuwa`
    : `${title} — Whitzard`;

const siteUrl = "https://www.whitzard.tech";
const defaultOgImage = brand === "nuwa"
  ? `${siteUrl}/assets/og/nuwa-og.png`
  : `${siteUrl}/assets/og/whitzard-og.png`;
const ogImageUrl = ogImage ? `${siteUrl}${ogImage}` : defaultOgImage;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="canonical" href={Astro.url.href} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+SC:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={brand === "nuwa" ? "nuwa-brand" : "whitzard-brand"}>
    <Header brand={brand} />
    <main>
      <slot />
    </main>
    <Footer brand={brand} />
  </body>
</html>
