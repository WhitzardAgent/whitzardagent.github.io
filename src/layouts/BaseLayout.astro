---
import "../styles/global.css";
import "../styles/motion.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import type { Locale } from "../i18n/config";
import { localizedPath, ogLocale, stripLocale } from "../i18n/config";
import { ui } from "../i18n/ui";
import { hasLocalizedPeer } from "../i18n/routes";
import SmoothScroll from "../components/motion/SmoothScroll.astro";

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  brand?: "whitzard" | "nuwa";
  ogImage?: string;
  ogImageAlt?: string;
  canonicalPath?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description,
  locale = "zh",
  brand = "whitzard",
  ogImage,
  ogImageAlt = locale === "zh" ? "白泽（Whitzard）智能体安全基础设施" : "Whitzard AI agent security infrastructure",
  canonicalPath,
  noindex = false,
  schema,
} = Astro.props;

const origin = "https://whitzard.tech";
const companyBrand = locale === "zh" ? "白泽（Whitzard）" : "Whitzard";
const resolvedDescription = description ?? (locale === "zh" ? "白泽（Whitzard）打造AI智能体时代的安全基础设施，覆盖评测、运行时控制与安全运营。" : "Whitzard builds security infrastructure for enterprise AI agents across evaluation, runtime control, and security operations.");
const researchBrand = locale === "zh" ? "女娲实验室" : "NUWA Lab";
const siteTitle = title.includes("Whitzard") || title.includes("白泽") || title.includes("NUWA") || title.includes("Nuwa") || title.includes("女娲实验室") ? title : `${title} — ${brand === "nuwa" ? researchBrand : companyBrand}`;
const basePath = stripLocale(canonicalPath ?? Astro.url.pathname);
const canonicalUrl = new URL(localizedPath(basePath, locale), origin).href;
const englishUrl = new URL(localizedPath(basePath, "en"), origin).href;
const chineseUrl = new URL(localizedPath(basePath, "zh"), origin).href;
const hasPeer = hasLocalizedPeer(basePath);
const defaultOgImage = brand === "nuwa" ? "/assets/og/nuwa-og.png" : "/assets/og/whitzard-og.png";
const ogImageUrl = new URL(ogImage ?? defaultOgImage, origin).href;
const organizationSchema = {
  "@context": "https://schema.org", "@type": "Organization", name: companyBrand, alternateName: locale === "zh" ? ["Whitzard", "白泽"] : ["白泽"], url: origin,
  logo: `${origin}/assets/logo/whitzard_logo.png`,
  description: locale === "zh" ? "白泽（Whitzard）打造AI智能体时代的安全基础设施。" : "Whitzard builds security infrastructure for enterprise AI agents.",
  sameAs: ["https://github.com/WhitzardAgent", "https://huggingface.co/WhitzardAgent"],
};
const breadcrumbs = basePath === "/" ? null : {
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: companyBrand, item: new URL(localizedPath("/", locale), origin).href },
    { "@type": "ListItem", position: 2, name: title.replace(/\s+[—-].*$/, ""), item: canonicalUrl },
  ],
};
const schemas = [organizationSchema, ...(breadcrumbs ? [breadcrumbs] : []), ...(Array.isArray(schema) ? schema : schema ? [schema] : [])];
---

<!doctype html>
<html lang={locale === "zh" ? "zh-CN" : "en"} data-brand={brand}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={brand === "nuwa" ? "#F4F6F2" : "#F6F7F3"} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" href="/assets/fonts/geist/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <title>{siteTitle}</title><meta name="description" content={resolvedDescription} /><meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    {hasPeer && <link rel="alternate" hreflang="zh-CN" href={chineseUrl} />}
    <link rel="alternate" hreflang="x-default" href={chineseUrl} />
    <meta property="og:title" content={siteTitle} /><meta property="og:description" content={resolvedDescription} />
    <meta property="og:type" content="website" /><meta property="og:url" content={canonicalUrl} /><meta property="og:site_name" content={companyBrand} />
    <meta property="og:locale" content={ogLocale(locale)} /><meta property="og:locale:alternate" content={ogLocale(locale === "en" ? "zh" : "en")} />
    <meta property="og:image" content={ogImageUrl} /><meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={siteTitle} /><meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={ogImageUrl} /><meta name="twitter:image:alt" content={ogImageAlt} />
    {schemas.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="ff378de3-72b9-4ba6-8fc8-985e171cef9e"></script>
    <ClientRouter />
  </head>
  <body class:list={[brand === "nuwa" ? "nuwa-brand" : "whitzard-brand", locale === "zh" && "locale-zh"]}>
    <a class="skip-link" href="#main-content">{ui[locale].skip}</a>
    <Header brand={brand} locale={locale} currentPath={basePath} />
    <main id="main-content" tabindex="-1"><slot /></main>
    <Footer brand={brand} locale={locale} />
    <SmoothScroll />
  </body>
</html>
