---
import BaseLayout from"../../layouts/BaseLayout.astro";import type{Locale}from"../../i18n/config";import type{CompanyCopy}from"../../i18n/pages/company";import{links}from"../../data/links";import"../../styles/company.css";interface Props{locale:Locale;copy:CompanyCopy["contact"]}const{locale,copy}=Astro.props;const mail=(subject:string)=>`mailto:${links.email}?subject=${encodeURIComponent(subject)}`;
---
<BaseLayout title={copy.meta.title} description={copy.meta.description} locale={locale} canonicalPath="/contact"><section class="contact-hero"><div class="site-container contact-hero__grid"><div><p class="eyebrow">{copy.eyebrow}</p><h1>{copy.title}</h1><p>{copy.lead}</p><a class="button button--primary" href={mail(locale==="zh"?"预约 AgentGuard 产品演示":"AgentGuard product demo")}>{copy.primary} ↗</a></div><aside><span>{copy.emailLabel}</span><a href={`mailto:${links.email}`}>{links.email}</a><p>{copy.response}</p></aside></div></section><section class="section contact-paths"><div class="site-container">{copy.paths.map((item,index)=><a href={mail(item.subject)}><span>0{index+1}</span><h2>{item.title}</h2><p>{item.body}</p><small>{links.email} →</small></a>)}</div></section><section class="section contact-prepare"><div class="site-container"><div><p class="eyebrow">CONTEXT</p><h2 class="section-title">{copy.prepareTitle}</h2></div><ol>{copy.prepare.map((item,index)=><li><span>0{index+1}</span>{item}</li>)}</ol></div></section></BaseLayout>
