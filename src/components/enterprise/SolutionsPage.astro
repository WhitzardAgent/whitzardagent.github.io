---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { Locale } from "../../i18n/config";
import { localizedPath } from "../../i18n/config";
import type { CompanyCopy } from "../../i18n/pages/company";
import UseCaseBoundaryExplorer from "./UseCaseBoundaryExplorer";
import "../../styles/company.css";
import "../../styles/use-cases.css";

interface Props { locale: Locale; copy: CompanyCopy["solutions"] }
const { locale, copy } = Astro.props;
const agentGuardPath = localizedPath("/agentguard", locale);
---

<BaseLayout title={copy.meta.title} description={copy.meta.description} locale={locale} canonicalPath="/solutions">
  <section class="commercial-hero commercial-hero--use-cases">
    <div class="site-container use-case-hero__grid">
      <div>
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.title}</h1>
        <p>{copy.lead}</p>
        <div class="use-case-hero__actions">
          <a class="button button--primary" href={localizedPath("/contact", locale)}>{copy.primary}</a>
          <a class="button button--secondary" href={agentGuardPath}>{copy.secondary} →</a>
        </div>
      </div>
      <UseCaseBoundaryExplorer scenarios={copy.scenarios} labels={copy.explorer} client:load />
    </div>
  </section>

  <section class="section use-case-value">
    <div class="site-container use-case-value__grid">
      <div><p class="eyebrow">{copy.valueEyebrow}</p><h2 class="section-title">{copy.valueTitle}</h2></div>
      <div><p>{copy.valueBody}</p><a href={agentGuardPath}>{copy.secondary} →</a></div>
    </div>
  </section>

  <section class="section use-case-controls"><div class="site-container">
    <h2 class="section-title">{copy.controlsTitle}</h2>
    <div class="use-case-controls__list">{copy.scenarios.map(item => <article id={`use-case-${item.index}`}>
      <header><span>{item.index}</span><h3>{item.title}</h3></header>
      <ul class="security-dimensions">{item.securityDimensions.map(dimension => <li>{dimension}</li>)}</ul>
      <div class="use-case-controls__products">
        <div><h4>AgentGuard</h4><p>{item.controls.agentguard}</p><a href={agentGuardPath}>AgentGuard →</a></div>
        <div><h4>WhitzardGateway</h4><p>{item.controls.gateway}</p><a href={localizedPath("/gateway", locale)}>WhitzardGateway →</a></div>
      </div>
    </article>)}</div>
    <p class="use-case-controls__scope">{copy.controlScope}</p>
  </div></section>

  <section class="section solution-journey">
    <div class="site-container">
      <p class="eyebrow">{copy.journeyTitle}</p>
      <ol>{copy.journey.map((item, index) => <li><span>0{index + 1}</span><strong>{item}</strong></li>)}</ol>
      <a class="button button--primary" href={localizedPath("/contact", locale)}>{copy.cta}</a>
    </div>
  </section>
</BaseLayout>
