---
import type { Locale } from "../../i18n/config";
import type { HomeCopy } from "../../i18n/pages/home";

interface Props { copy: HomeCopy["loop"]; locale: Locale }
const { copy, locale } = Astro.props;
const researchHref = locale === "zh" ? "/research" : "/en/research";
const productHref = locale === "zh" ? "/agentguard" : "/en/agentguard";
---

<section class="research-bridge section" aria-labelledby="research-bridge-title">
  <div class="site-container research-bridge__head">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 id="research-bridge-title" class="section-title">{copy.title}</h2>
  </div>
  <div class="site-container research-bridge__duo">
    <a class="research-bridge__brand research-bridge__brand--lab" href={researchHref} aria-label={`${copy.lab.name} · ${copy.lab.role}`}>
      <img src="/assets/logo/nvwa_logo.png" width="112" height="112" alt="" loading="lazy" />
      <span>{copy.lab.role}</span><h3>{copy.lab.name}</h3>
    </a>
    <div class="research-bridge__axis" role="img" aria-label={`${copy.bridge.down}. ${copy.bridge.up}.`}>
      <span class="research-bridge__axis-label research-bridge__axis-label--forward">{copy.bridge.down}</span>
      <span class="research-bridge__line" aria-hidden="true"><i></i></span>
      <span class="research-bridge__axis-label research-bridge__axis-label--return">{copy.bridge.up}</span>
    </div>
    <a class="research-bridge__brand research-bridge__brand--product" href={productHref} aria-label={`${copy.product.name} · ${copy.product.role}`}>
      <img src="/assets/logo/whitzard_logo.png" width="112" height="112" alt="" loading="lazy" />
      <span>{copy.product.role}</span><h3>{copy.product.name}</h3>
    </a>
  </div>
</section>
