---
import type { Locale } from "../../i18n/config";
import { localizedPath } from "../../i18n/config";
import { getNewsLink, getNewsSourceLabel, newsTypeLabels, sortedNewsItems } from "../../data/news";
import NewsCard from "../NewsCard.astro";

interface Props { locale: Locale; embedded?: boolean; excludeHref?: string; }

const { locale, embedded = false, excludeHref } = Astro.props;
const items = sortedNewsItems
  .filter((item) => !excludeHref || getNewsLink(item, locale) !== excludeHref)
  .slice(0, 3);
const copy = locale === "zh"
  ? {
      eyebrow: "NEWSROOM",
      title: "最新动态",
      intro: "跟进白泽、女娲实验室与开放生态的最新进展。",
      cta: "查看全部动态",
    }
  : {
      eyebrow: "NEWSROOM",
      title: "Latest",
      intro: "Follow recent updates from Whitzard, NUWA, and the open ecosystem.",
      cta: "View all updates",
    };
---

{items.length > 0 && (
  <section class:list={["home-latest", !embedded && "section", embedded && "home-latest--embedded"]}>
    <div class="site-container home-latest__grid">
      <div>
        <p class="eyebrow">{copy.eyebrow}</p>
        <h2 class="section-title">{copy.title}</h2>
        <p>{copy.intro}</p>
        <a class="text-link" href={localizedPath("/news", locale)}>{copy.cta} <span class="arrow">→</span></a>
      </div>
      <div class="home-latest__list">
        {items.map((item) => (
          <NewsCard
            locale={locale}
            title={item.title[locale]}
            date={item.date}
            typeLabel={newsTypeLabels[locale][item.type]}
            summary={item.summary?.[locale]}
            href={getNewsLink(item, locale)}
            source={getNewsSourceLabel(item, locale)}
            featured={item.featured}
          />
        ))}
      </div>
    </div>
  </section>
)}
