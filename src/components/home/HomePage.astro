---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { Locale } from "../../i18n/config";
import { localizedPath } from "../../i18n/config";
import type { HomeCopy } from "../../i18n/pages/home";
import BrandHero from "../brand/BrandHero.astro";
import BrandArtwork from "../brand/BrandArtwork.astro";
import AgentGuardBoundaryFlow from "./AgentGuardBoundaryFlow";
import HomeApplications from "./HomeApplications.astro";
import LatestNews from "./LatestNews.astro";
import { researchAssets } from "../../data/generated/researchAssets";
import { researchVisuals } from "../../data/researchVisuals";
import { links } from "../../data/links";
import "../../styles/enterprise-home.css";
import "../../styles/boundary-flow.css";
interface Props { locale: Locale; copy: HomeCopy }
const { locale, copy } = Astro.props;
const path = (value: string) => localizedPath(value, locale);
const zh = locale === "zh";
const selectedResearch = [
  { arxivId: "2503.17378", label: zh ? "自主复制与前沿风险" : "Self-replication and frontier risk" },
  { arxivId: "2603.07427", label: zh ? "前沿风险评测环境" : "Executable frontier-risk evaluations" },
  { arxivId: "2505.11063", label: zh ? "智能体推理校准" : "Reasoning alignment for agents" },
].map(selection => {
  const item = researchAssets.find(item => item.arxivId === selection.arxivId);
  const visual = researchVisuals.find(visual => visual.researchSlug === item?.slug);
  if (!item || !visual) throw new Error(`Homepage research requires a verified paper and matching visual: ${selection.arxivId}`);
  return { item, visual, label: selection.label };
});
---
<BaseLayout title={copy.meta.title} description={copy.meta.description} locale={locale} canonicalPath="/">
  <div class="enterprise-home">
    <BrandHero locale={locale} artwork="home" eyebrow={copy.hero.eyebrow} title={copy.hero.title} segments={zh ? ["打造", "智能体时代", "的", "安全基础设施"] : undefined} description={copy.hero.description} centered>
      <a class="button button--primary" href={path("/agentguard")}>{copy.hero.primary} <span aria-hidden="true">→</span></a>
      <a class="button button--secondary" href={path("/waitlist")} data-umami-event="waitlist-cta-click">{zh ? "加入心愿单" : "Join the waitlist"}</a>
    </BrandHero>

    <section id="products" class="section home-products">
      <div class="site-container">
        <header class="home-section-head"><div><p class="eyebrow">{copy.products.eyebrow}</p><h2>{zh ? "让智能体安全进入业务" : "Bring AI agents into business, securely"}</h2></div><p>{zh ? "贯穿评测、防护与审计，为智能体建立可信边界。" : "Evaluation, runtime protection, and audit across the agent lifecycle."}</p></header>
        <div class="home-product-showcase">
          <article class="home-product-main">
            <div class="home-product-main__copy"><span class="home-product-name">AgentGuard</span><h3>{copy.products.agentguard.title}</h3><p>{copy.products.agentguard.body}</p><ul>{copy.products.agentguard.features.slice(0,3).map((feature)=><li>{feature}</li>)}</ul><a class="text-link" href={path("/agentguard")}>{copy.products.agentguard.cta} →</a></div>
            <a class="home-product-screen" href={path("/agentguard")} aria-label={zh ? "查看 AgentGuard 产品与社区版界面" : "Explore AgentGuard and its community interface"}><div><i></i><i></i><i></i><span>AgentGuard Community</span></div><img src="/assets/agentguard/dashboard.png" alt={zh ? "AgentGuard 社区版安全审计控制台" : "AgentGuard Community security audit console"} width="2505" height="1229" loading="lazy" decoding="async"/><small>{zh ? "社区版真实产品界面" : "Actual Community Edition interface"}</small></a>
          </article>
          <article class="home-model-service"><div><span class="eyebrow">MODEL SERVICES</span><h3>{copy.products.models.title}</h3><p>{copy.products.models.body}</p></div><a class="text-link" href={path("/models")}>{copy.products.models.cta} →</a></article>
        </div>
        <details class="home-runtime-details"><summary><span>{zh ? "查看智能体安全执行流程" : "See how an agent task is protected"}</span><b aria-hidden="true">＋</b></summary><div class="home-runtime-details__body"><p>{copy.system.runtimeBody}</p><AgentGuardBoundaryFlow locale={locale} client:visible /></div></details>
        <p class="home-product-principles">{zh ? "可信边界 · 可核实证据 · 最小必要干预" : "Trusted boundaries · Verifiable evidence · Minimal necessary intervention"}</p>
      </div>
    </section>

    <section id="applications" class="section home-use-cases"><div class="site-container"><header class="home-section-head"><div><p class="eyebrow">{zh ? "应用场景" : "USE CASES"}</p><h2>{zh ? "覆盖企业智能体的关键任务" : "Protect the workflows that matter"}</h2></div><a class="text-link" href={path("/solutions")}>{zh ? "查看应用场景" : "Explore use cases"} →</a></header><HomeApplications locale={locale}/></div></section>

    <section id="research" class="section home-research"><div class="site-container">
      <header class="home-research__intro"><div><p class="eyebrow">{zh ? "女娲实验室 · 研究驱动" : "NUWA · RESEARCH"}</p><h2>{zh ? <><span class="brand-phrase">为全球 AI 治理</span><br/><span class="brand-phrase">提供风险证据</span><span class="brand-phrase">与公共产品</span></> : "Shared Risk Evidence and Public Goods for the World"}</h2><p>{copy.research.body}</p><div class="home-research__links"><a class="button button--primary" href={path("/nuwa")}>{copy.research.cta} →</a><a class="text-link" href={path("/nuwa/blog")}>Research Blog →</a></div></div><BrandArtwork artwork="nuwa" /></header>
      <div class="home-research__evidence">{selectedResearch.map(({item,visual,label})=><article><img src={visual.assetPath.replace(".png", "-640.webp")} alt={visual.alt[locale]} width="640" height="360" loading="lazy" decoding="async"/><div><span>{item.year} · {item.venue}</span><h3>{label}</h3><p>{item.summary[locale]}</p><a href={item.links.find(link=>link.kind==="paper")?.url ?? item.links[0].url} target="_blank" rel="noreferrer">{zh ? "阅读论文" : "Read the paper"} ↗</a></div></article>)}</div>
      <div class="home-research__record"><div><span class="eyebrow">{copy.highlight.eyebrow}</span><h3>{copy.highlight.title}</h3><p>{copy.highlight.body}</p><a href={copy.highlight.sourceUrl} target="_blank" rel="noreferrer">{copy.highlight.source} ↗</a></div><a class="home-index-entry" href={path("/nuwa/whitzard-index")}><span class="eyebrow">WHITZARD INDEX</span><h3>{copy.research.indexTitle}</h3><p>{zh ? "持续观测前沿 AI 风险，查看已发表评测证据与方法说明。" : "Track frontier AI risk through published evaluation evidence and documented methods."}</p><span>{zh ? "探索白泽指数" : "Explore Whitzard Index"} →</span></a></div>
    </div></section>

    <section id="ecosystem" class="section home-open"><div class="site-container home-open__grid"><BrandArtwork artwork="ecosystem"/><div><p class="eyebrow">{copy.ecosystem.eyebrow}</p><h2>{copy.ecosystem.title}</h2><p>{copy.ecosystem.intro}</p><ul>{copy.ecosystem.directions.map(item=><li>{item}</li>)}</ul><div class="home-open__actions"><a class="button button--primary" href={path("/open-ecosystem")}>{copy.ecosystem.viewAll} →</a><a class="text-link" href={links.github} target="_blank" rel="noreferrer">GitHub ↗</a><a class="text-link" href={links.huggingface} target="_blank" rel="noreferrer">Hugging Face ↗</a></div></div></div></section>
    <LatestNews locale={locale} excludeHref={copy.highlight.sourceUrl} />
    <section id="join" class="home-join"><div class="site-container"><p class="eyebrow">{copy.closing.eyebrow}</p><h2>{copy.closing.title}</h2><p>{copy.closing.body}</p><div><a class="button button--primary" href={path("/waitlist")} data-umami-event="waitlist-cta-click">{copy.closing.primary} →</a><a class="button button--secondary" href={path("/contact")}>{zh ? "联系白泽" : "Contact Whitzard"}</a></div></div></section>
  </div>
</BaseLayout>
