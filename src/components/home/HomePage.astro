---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { Locale } from "../../i18n/config";
import { localizedPath } from "../../i18n/config";
import type { HomeCopy } from "../../i18n/pages/home";
import { openSourceAssets } from "../../data/generated/openSourceAssets";
import { links } from "../../data/links";
import { boundaryFlowCopy, enterpriseScenarioLabCopy } from "../../data/agentguardEnterpriseScenarios";
import HomeHero from "./HomeHero";
import ThreeChainScrolly from "./ThreeChainScrolly";
import ResearchProductLoop from "./ResearchProductLoop";
import AgentGuardOperationsCenter from "./AgentGuardOperationsCenter.astro";
import "../../styles/home.css";

interface Props { locale: Locale; copy: HomeCopy; }
const { locale, copy } = Astro.props;
const featuredIds = ["whitzard-os", "whitzard-eval", "thought-aligner", "mate"];
const featured = featuredIds.map((id) => openSourceAssets.find((item) => item.id === id)).filter(Boolean);
const statusMap: Record<Locale, Record<string, string>> = {
  en: { "open-source": "Open source", active: "Maintained", "coming soon": "Coming soon" },
  zh: { "open-source": "开源", active: "持续维护", "coming soon": "即将开放" },
};
---

<BaseLayout title={copy.meta.title} description={copy.meta.description} locale={locale} canonicalPath="/">
  <HomeHero copy={copy.hero} flowCopy={boundaryFlowCopy[locale]} scenarioCopy={enterpriseScenarioLabCopy[locale]} locale={locale} client:load />

  <section class="manifesto-band">
    <div class="manifesto-boundary" aria-hidden="true"></div>
    <div class="site-container"><h2 class="display-emphasis">{copy.manifesto}</h2></div>
  </section>

  <section class="risk-section section">
    <div class="site-container">
      <div class="risk-section__head"><div><p class="eyebrow">{copy.risk.eyebrow}</p><h2 class="section-title">{copy.risk.title}</h2></div><p>{copy.risk.intro}</p></div>
      <div class="risk-grid">{copy.risk.cards.map((card, index) => <article><span>0{index + 1}</span><h3>{card.title}</h3><p>{card.body}</p></article>)}</div>
      <p class="risk-closing display-emphasis">{copy.risk.closing}</p>
    </div>
  </section>

  <AgentGuardOperationsCenter locale={locale} copy={copy.operations} />

  <section class="platform-section section">
    <div class="site-container platform-section__head"><p class="eyebrow">{copy.platform.eyebrow}</p><h2 class="section-title">{copy.platform.title}</h2><p>{copy.platform.intro}</p></div>
    <div class="site-container platform-stack">{copy.platform.layers.map((layer) => <article style={`--layer:${layer.index}`}><div><span>{layer.index}</span><h3>{layer.title}</h3><p>{layer.body}</p></div><ul>{layer.items.map((item) => <li>{item}</li>)}</ul></article>)}</div>
  </section>

  <ThreeChainScrolly copy={copy.chains} client:visible />

  <section class="enterprise-section section">
    <div class="site-container enterprise-section__head"><div><p class="eyebrow">{copy.enterprise.eyebrow}</p><h2 class="section-title">{copy.enterprise.title}</h2></div><p>{copy.enterprise.intro}</p></div>
    <div class="site-container deployment-diagram" aria-label={copy.enterprise.diagram.join(" to ")}>{copy.enterprise.diagram.map((node, index) => <><div class:list={[index === 1 && "is-control"]}><span>{index === 1 ? "AG" : `0${index + 1}`}</span>{node}</div>{index < copy.enterprise.diagram.length - 1 && <i aria-hidden="true">→</i>}</>)}</div>
    <div class="site-container enterprise-grid">{copy.enterprise.items.map((item, index) => <article><span>0{index + 1}</span><h3>{item.title}</h3><p>{item.body}</p></article>)}</div>
  </section>

  <ResearchProductLoop copy={copy.loop} locale={locale} client:visible />

  <section class="ecosystem-preview section">
    <div class="site-container ecosystem-preview__head"><div><p class="eyebrow">{copy.ecosystem.eyebrow}</p><h2 class="section-title">{copy.ecosystem.title}</h2><p>{copy.ecosystem.intro}</p></div><a class="text-link" href={localizedPath("/open-ecosystem", locale)}>{copy.ecosystem.viewAll} <span class="arrow">→</span></a></div>
    <div class="site-container ecosystem-grid">{featured.map((project, index) => project && <article><div><span>0{index + 1}</span><small>{project.capability?.[locale] ?? statusMap[locale][project.status ?? ""] ?? project.status}</small></div><h3>{project.name}</h3><p>{project.description[locale]}</p><div class="ecosystem-grid__links">{project.githubUrl && <a href={project.githubUrl} target="_blank" rel="noreferrer" aria-label={`${project.name} GitHub`}>GitHub ↗</a>}{project.hfUrl && <a href={Array.isArray(project.hfUrl) ? project.hfUrl[0] : project.hfUrl} target="_blank" rel="noreferrer" aria-label={`${project.name} Hugging Face`}>Hugging Face ↗</a>}</div></article>)}</div>
  </section>

  <section class="final-cta"><div class="site-container"><p class="eyebrow">{copy.cta.eyebrow}</p><h2>{copy.cta.title}</h2><p>{copy.cta.body}</p><div><a class="button final-cta__primary" href={localizedPath("/contact", locale)}>{copy.cta.primary}</a><a class="button final-cta__secondary" href={`mailto:${links.email}`}>{copy.cta.secondary}</a></div></div></section>
</BaseLayout>
