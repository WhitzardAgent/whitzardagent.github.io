---
import type { Locale } from "../../i18n/config";
import { localizedPath } from "../../i18n/config";
import type { HomeCopy } from "../../i18n/pages/home";

interface Props { locale: Locale; copy: HomeCopy["operations"] }
const { locale, copy } = Astro.props;
---

<section class="operations-center section">
  <div class="site-container operations-center__head">
    <div><p class="eyebrow">{copy.eyebrow}</p><h2 class="section-title">{copy.title}</h2></div>
    <p>{copy.body}</p>
  </div>
  <operations-center class="site-container operations-center__grid">
    <figure class="operations-center__surface">
      <div class="operations-center__badge">{copy.communityBadge}</div>
      <img src="/assets/agentguard/dashboard.png" width="2505" height="1229" loading="lazy" decoding="async" alt={copy.imageAlt} />
      <figcaption>{copy.callouts.map((item, index) => <span><i>0{index + 1}</i>{item}</span>)}</figcaption>
    </figure>
    <div class="operations-center__events">
      <div class="operations-center__tabs" role="tablist" aria-label={copy.queueLabel}>
        <span>{copy.queueLabel}</span>
        {copy.cases.map((item, index) => <button id={`ops-tab-${item.id}`} type="button" role="tab" aria-selected={index === 0 ? "true" : "false"} aria-controls={`ops-panel-${item.id}`} tabindex={index === 0 ? 0 : -1} data-index={index}><i aria-hidden="true" />{item.label}</button>)}
      </div>
      {copy.cases.map((item, index) => <article id={`ops-panel-${item.id}`} role="tabpanel" aria-labelledby={`ops-tab-${item.id}`} hidden={index !== 0} data-panel={index}>
        <dl>
          <div><dt>{copy.fields.request}</dt><dd>{item.request}</dd></div>
          <div><dt>{copy.fields.risk}</dt><dd>{item.risk}</dd></div>
          <div class="is-agentguard"><dt>{copy.fields.action}</dt><dd>{item.action}</dd></div>
          <div><dt>{copy.fields.status}</dt><dd>{item.status}</dd></div>
          <div><dt>{copy.fields.audit}</dt><dd>{item.audit}</dd></div>
        </dl>
      </article>)}
      <a class="text-link" href={`${localizedPath("/agentguard", locale)}#runtime`}>{copy.cta} →</a>
    </div>
  </operations-center>
</section>

<script>
  class OperationsCenter extends HTMLElement {
    connectedCallback() {
      const tabs = Array.from(this.querySelectorAll<HTMLButtonElement>("[role=tab]"));
      const panels = Array.from(this.querySelectorAll<HTMLElement>("[role=tabpanel]"));
      const activate = (index: number, focus = false) => {
        tabs.forEach((tab, itemIndex) => {
          const selected = itemIndex === index;
          tab.setAttribute("aria-selected", String(selected));
          tab.tabIndex = selected ? 0 : -1;
          panels[itemIndex].hidden = !selected;
        });
        if (focus) tabs[index]?.focus();
      };
      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => activate(index));
        tab.addEventListener("keydown", (event) => {
          if (!["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
          event.preventDefault();
          const next = event.key === "Home" ? 0 : event.key === "End" ? tabs.length - 1 : ["ArrowDown", "ArrowRight"].includes(event.key) ? (index + 1) % tabs.length : (index - 1 + tabs.length) % tabs.length;
          activate(next, true);
        });
      });
    }
  }
  if (!customElements.get("operations-center")) customElements.define("operations-center", OperationsCenter);
</script>
