<script>
  import Lenis from "lenis";

  type Runtime = { lenis: Lenis; frame: number };
  declare global { interface Window { __wzSmooth?: Runtime } }

  function stopSmoothScroll() {
    const runtime = window.__wzSmooth;
    if (!runtime) return;
    cancelAnimationFrame(runtime.frame);
    runtime.lenis.destroy();
    delete window.__wzSmooth;
  }

  function startSmoothScroll() {
    stopSmoothScroll();
    if (!matchMedia("(min-width: 1024px) and (pointer: fine) and (prefers-reduced-motion: no-preference)").matches) return;
    const lenis = new Lenis({ duration: 1, smoothWheel: true, syncTouch: false });
    const runtime: Runtime = { lenis, frame: 0 };
    const raf = (time: number) => { lenis.raf(time); runtime.frame = requestAnimationFrame(raf); };
    runtime.frame = requestAnimationFrame(raf);
    window.__wzSmooth = runtime;
  }

  document.addEventListener("astro:page-load", startSmoothScroll);
  document.addEventListener("astro:before-swap", stopSmoothScroll);
  startSmoothScroll();
</script>
