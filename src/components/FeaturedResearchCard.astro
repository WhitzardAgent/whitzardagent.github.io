---
interface Props {
  title: string;
  authors?: string;
  year?: string;
  venue?: string;
  status?: string;
  summary: string;
  url?: string;
  pdfUrl?: string;
  topic?: string[];
  featured?: boolean;
}

const { title, authors, year, venue, status, summary, url, pdfUrl, topic } = Astro.props;
---

<a
  href={url || "#"}
  target={url ? "_blank" : undefined}
  rel={url ? "noopener noreferrer" : undefined}
  class:list={[
    "block bg-white border-2 border-nw-jade/25 rounded-lg p-6 hover:border-nw-jade/50 transition-colors no-underline group",
    !url && "pointer-events-none",
  ]}
>
  <!-- Meta line -->
  <div class="flex flex-wrap items-center gap-2 mb-3">
    <span class="text-nw-jade font-mono text-sm">&#9670;</span>
    {status && (
      <span class="text-xs text-wz-muted bg-wz-panel px-1.5 py-0.5 rounded">{status}</span>
    )}
    {venue && (
      <span class="text-xs text-nw-jade bg-nw-jade-pale px-1.5 py-0.5 rounded">{venue}</span>
    )}
    {year && (
      <span class="text-xs text-wz-subtle">{year}</span>
    )}
  </div>

  <h3 class="text-wz-ink font-semibold text-base mb-2 leading-snug group-hover:text-wz-blue transition-colors">{title}</h3>

  {authors && (
    <p class="text-wz-subtle text-xs mb-2">{authors}</p>
  )}

  <p class="text-wz-muted text-sm leading-relaxed mb-4">{summary}</p>

  {topic && topic.length > 0 && (
    <div class="flex flex-wrap gap-1.5 mb-4">
      {topic.map((t) => (
        <span class="text-xs text-nw-jade bg-nw-jade-pale px-2 py-0.5 rounded-full">{t}</span>
      ))}
    </div>
  )}

  <div class="flex items-center gap-4">
    {url && (
      <span class="text-wz-blue text-xs font-medium inline-flex items-center gap-1">
        Read paper
        <span class="text-wz-subtle group-hover:translate-x-0.5 transition-transform">&rarr;</span>
      </span>
    )}
    {pdfUrl && (
      <a href={pdfUrl} target="_blank" rel="noopener noreferrer" class="text-wz-muted text-xs hover:underline no-underline" onclick="event.stopPropagation()">PDF</a>
    )}
  </div>
</a>
