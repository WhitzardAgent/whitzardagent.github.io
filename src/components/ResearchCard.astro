---
interface Props {
  title: string;
  type: string;
  status?: string;
  venue?: string;
  year?: string;
  authors?: string;
  summary: string;
  url: string;
  secondaryUrl?: string;
  topic: string[];
  featured?: boolean;
}

const { title, type, status, venue, year, authors, summary, url, secondaryUrl, topic, featured } = Astro.props;

const typeLabel: Record<string, string> = {
  paper: "Paper",
  report: "Report",
  "position-paper": "Position Paper",
  "technical-note": "Technical Note",
  framework: "Framework",
  brief: "Brief",
  note: "Note",
};
---

<div class:list={[
  "bg-white border rounded-lg p-5 transition-shadow hover:shadow-md",
  featured ? "border-nw-jade/30" : "border-wz-hairline",
]}>
  <!-- Meta line -->
  <div class="flex flex-wrap items-center gap-2 mb-2">
    <span class="text-wz-teal text-xs font-medium uppercase">{typeLabel[type] || type}</span>
    {status && (
      <span class="text-xs text-wz-muted bg-wz-panel px-2 py-0.5 rounded-full">{status}</span>
    )}
    {venue && (
      <span class="text-xs text-nw-jade bg-nw-jade-pale px-2 py-0.5 rounded-full">{venue}</span>
    )}
    {year && year !== "To be verified" && (
      <span class="text-xs text-wz-subtle">{year}</span>
    )}
  </div>

  <!-- Title -->
  <h3 class="text-wz-ink font-semibold text-sm mb-1.5 leading-snug">{title}</h3>

  <!-- Summary -->
  <p class="text-wz-muted text-xs leading-relaxed mb-3">{summary}</p>

  <!-- Topic chips -->
  {topic.length > 0 && (
    <div class="flex flex-wrap gap-1 mb-3">
      {topic.map((t) => (
        <span class="text-xs text-wz-subtle bg-wz-mist px-1.5 py-0.5 rounded">{t}</span>
      ))}
    </div>
  )}

  <!-- Links -->
  <div class="flex flex-wrap gap-4">
    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      class="text-wz-blue text-xs font-medium hover:underline no-underline inline-flex items-center gap-1"
    >
      {type === "technical-note" || type === "brief" ? "Read article" : "Read paper"}
      <span class="text-wz-subtle">&rarr;</span>
    </a>
    {secondaryUrl && (
      <a
        href={secondaryUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-wz-muted text-xs font-medium hover:underline no-underline"
      >
        arXiv abstract
      </a>
    )}
  </div>
</div>
