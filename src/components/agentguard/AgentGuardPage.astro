---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { Locale } from "../../i18n/config";
import { localizedPath } from "../../i18n/config";
import type { AgentGuardCopy } from "../../i18n/pages/agentguard";
import { supportedFrameworks } from "../../data/supportedFrameworks";
import { storyPageCopy } from "../../data/agentguardStory";
import AgentGuardSystemMap from "./AgentGuardSystemMap";
import UnifiedSecurityInfluenceEngine from "./UnifiedSecurityInfluenceEngine";
import AgentGuardRiskSimulator from "./AgentGuardRiskSimulator";
import AgentGuardShowcase from "./AgentGuardShowcase.astro";
import DeploymentArchitecture from "./DeploymentArchitecture";
import "../../styles/agentguard.css";
import "../../styles/agentguard-story.css";

interface Props { locale: Locale; copy: AgentGuardCopy }
const { locale, copy } = Astro.props;
const story = storyPageCopy[locale];
const softwareSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      name: "AgentGuard Community",
      applicationCategory: "SecurityApplication",
      operatingSystem: "AI agent runtimes",
      url: "https://github.com/WhitzardAgent/AgentGuard",
      isAccessibleForFree: true,
      license: "https://www.gnu.org/licenses/gpl-3.0.html",
      codeRepository: "https://github.com/WhitzardAgent/AgentGuard",
      publisher: { "@type": "Organization", name: locale === "zh" ? "白泽（Whitzard）" : "Whitzard", alternateName: locale === "zh" ? ["Whitzard", "白泽"] : ["白泽"] },
    },
    {
      "@type": "Product",
      name: "AgentGuard Enterprise",
      category: "Enterprise AI agent runtime security",
      url: `https://whitzard.tech${localizedPath("/agentguard", locale)}`,
      brand: { "@type": "Brand", name: locale === "zh" ? "白泽（Whitzard）" : "Whitzard", alternateName: locale === "zh" ? ["Whitzard", "白泽"] : ["白泽"] },
    },
  ],
};
---

<BaseLayout title={copy.meta.title} description={copy.meta.description} locale={locale} canonicalPath="/agentguard" schema={softwareSchema}>
  <section class="ag-hero">
    <div class="site-container ag-hero__grid">
      <div class="ag-hero__copy">
        <p class="eyebrow">{copy.hero.eyebrow}</p>
        <h1>{copy.hero.title}</h1>
        <p>{copy.hero.body}</p>
        <div class="ag-hero__actions">
          <a class="button button--primary" href={localizedPath("/contact", locale)}>{copy.hero.primary}</a>
          <a class="button button--secondary" href="https://github.com/WhitzardAgent/AgentGuard" target="_blank" rel="noreferrer">{copy.hero.secondary} ↗</a>
        </div>
        <div class="ag-adapter-strip"><span>{locale === "zh" ? "支持的智能体架构" : "SUPPORTED FRAMEWORKS"}</span><div>{supportedFrameworks.map((framework) => <small><img src={framework.logoPath} width="24" height="24" alt="" />{framework.productLabel}</small>)}</div></div>
      </div>
      <div class="ag-hero__protected" aria-label={story.protection.title}>
        <header><span>AgentGuard Enterprise</span><strong>{story.protection.title}</strong></header>
        <div class="ag-hero__protected-core"><b>AG</b><span>Interaction<br/>Boundary Runtime</span></div>
        <ul>{story.protection.items.map((item, index) => <li><span>0{index + 1}</span>{item}</li>)}</ul>
        <footer><i aria-hidden="true" />{locale === "zh" ? "持续理解身份、数据、工具与行动后果" : "Continuous context across identity, data, tools, and action"}</footer>
      </div>
    </div>
  </section>

  <section class="section story-section story-section--frost" id="system-map">
    <div class="site-container story-section__head"><div><p class="eyebrow">{story.map.eyebrow}</p><h2 class="section-title">{story.map.title}</h2></div><p>{story.map.body}</p></div>
    <div class="site-container"><AgentGuardSystemMap locale={locale} density="full" client:visible /></div>
  </section>

  <section class="section story-section story-section--xuan" id="engine">
    <div class="site-container story-section__head"><div><p class="eyebrow">{story.engine.eyebrow}</p><h2 class="section-title">{story.engine.title}</h2></div><p>{story.engine.body}</p></div>
    <div class="site-container"><UnifiedSecurityInfluenceEngine locale={locale} density="full" client:visible /></div>
  </section>

  <section class="section story-section" id="runtime">
    <div class="site-container story-section__head"><div><p class="eyebrow">{story.simulator.eyebrow}</p><h2 class="section-title">{story.simulator.title}</h2></div><p>{story.simulator.body}</p></div>
    <div class="site-container"><AgentGuardRiskSimulator locale={locale} density="full" client:visible /></div>
  </section>

  <AgentGuardShowcase locale={locale} copy={copy.demo} />

  <section class="section ag-editions" id="enterprise">
    <div class="site-container ag-section-head ag-section-head--split">
      <div><p class="eyebrow">{copy.editions.eyebrow}</p><h2 class="section-title">{copy.editions.title}</h2></div>
      <p>{copy.editions.body}</p>
    </div>
    <div class="site-container ag-editions__grid">
      <article class="ag-edition ag-edition--community">
        <span>{copy.editions.community.label}</span><h3>{copy.editions.community.name}</h3><p>{copy.editions.community.body}</p>
        <ul>{copy.editions.community.features.map(item => <li>{item}</li>)}</ul>
        <a class="button button--secondary" href="https://github.com/WhitzardAgent/AgentGuard" target="_blank" rel="noreferrer">{copy.editions.community.cta} ↗</a>
      </article>
      <article class="ag-edition ag-edition--enterprise">
        <span>{copy.editions.enterprise.label}</span><h3>{copy.editions.enterprise.name}</h3><p>{copy.editions.enterprise.body}</p>
        <ul>{copy.editions.enterprise.features.map(item => <li>{item}</li>)}</ul>
        <a class="button button--primary" href={localizedPath("/contact", locale)} data-umami-event="agentguard-demo-cta">{copy.editions.enterprise.cta}</a>
      </article>
    </div>
  </section>

  <section class="section ag-deploy-section" id="deployment">
    <div class="site-container ag-section-head ag-section-head--split"><div><p class="eyebrow">{copy.deployment.eyebrow}</p><h2 class="section-title">{copy.deployment.title}</h2></div><p>{copy.deployment.body}</p></div>
    <div class="site-container"><DeploymentArchitecture nodes={copy.deployment.nodes} client:visible /></div>
    <div class="site-container ag-deploy-modes">{copy.deployment.modes.map((item) => <article><h3>{item.title}</h3><p>{item.body}</p></article>)}</div>
  </section>

  <section class="section story-section story-section--frost" id="security-stack">
    <div class="site-container story-section__head"><div><p class="eyebrow">{story.securityStack.eyebrow}</p><h2 class="section-title">{story.securityStack.title}</h2></div><p>{story.securityStack.body}</p></div>
    <div class="site-container security-stack-table">{story.securityStack.rows.map((row) => <div><strong>{row[0]}</strong><span>{row[1]}</span><span>{row[2]}</span></div>)}</div>
  </section>

  <section class="section ag-evidence">
    <div class="site-container ag-section-head"><p class="eyebrow">{copy.evidence.eyebrow}</p><h2 class="section-title">{copy.evidence.title}</h2></div>
    <div class="site-container ag-evidence__grid">{copy.evidence.items.map((item) => <a href={item.href} target={item.href.startsWith("http") ? "_blank" : undefined} rel={item.href.startsWith("http") ? "noreferrer" : undefined}><h3>{item.title}</h3><p>{item.body}</p><span>{item.label} →</span></a>)}</div>
  </section>

  <section class="ag-cta"><div class="site-container"><h2>{copy.cta.title}</h2><p>{copy.cta.body}</p><ol class="demo-agenda">{story.demoAgenda.map((item) => <li>{item}</li>)}</ol><div><a class="button ag-cta__primary" href={localizedPath("/contact", locale)} data-umami-event="agentguard-demo-cta">{copy.cta.primary}</a><a class="button ag-cta__secondary" href="https://github.com/WhitzardAgent/AgentGuard" target="_blank" rel="noreferrer">{copy.cta.github} ↗</a></div></div></section>
</BaseLayout>
