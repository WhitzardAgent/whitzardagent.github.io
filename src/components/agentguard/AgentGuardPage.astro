---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { Locale } from "../../i18n/config";
import { localizedPath } from "../../i18n/config";
import type { AgentGuardCopy } from "../../i18n/pages/agentguard";
import { runtimeConsoleCopy } from "../../i18n/pages/runtime-console";
import { enterpriseScenarioLabCopy } from "../../data/agentguardEnterpriseScenarios";
import AgentGuardEnterpriseScenarioLab from "./AgentGuardEnterpriseScenarioLab";
import AgentGuardShowcase from "./AgentGuardShowcase.astro";
import DeploymentArchitecture from "./DeploymentArchitecture";
import "../../styles/agentguard.css";
import "../../styles/enterprise-scenario-lab.css";

interface Props { locale: Locale; copy: AgentGuardCopy }
const { locale, copy } = Astro.props;
const runtimeCopy = runtimeConsoleCopy[locale];
const softwareSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      name: "AgentGuard Community",
      applicationCategory: "SecurityApplication",
      operatingSystem: "AI agent runtimes",
      url: "https://github.com/WhitzardAgent/AgentGuard",
      isAccessibleForFree: true,
      license: "https://www.gnu.org/licenses/gpl-3.0.html",
      codeRepository: "https://github.com/WhitzardAgent/AgentGuard",
      publisher: { "@type": "Organization", name: "Whitzard" },
    },
    {
      "@type": "Product",
      name: "AgentGuard Enterprise",
      category: "Enterprise AI agent runtime security",
      url: `https://whitzard.tech${localizedPath("/agentguard", locale)}`,
      brand: { "@type": "Brand", name: "Whitzard" },
    },
  ],
};
---

<BaseLayout title={copy.meta.title} description={copy.meta.description} locale={locale} canonicalPath="/agentguard" schema={softwareSchema}>
  <section class="ag-hero">
    <div class="site-container ag-hero__grid">
      <div class="ag-hero__copy">
        <p class="eyebrow">{copy.hero.eyebrow}</p>
        <h1>{copy.hero.title}</h1>
        <p>{copy.hero.body}</p>
        <div class="ag-hero__actions">
          <a class="button button--primary" href={localizedPath("/contact", locale)}>{copy.hero.primary}</a>
          <a class="button button--secondary" href="https://github.com/WhitzardAgent/AgentGuard" target="_blank" rel="noreferrer">{copy.hero.secondary} ↗</a>
        </div>
        <div class="ag-adapter-strip"><span>{runtimeCopy.supportedLabel}</span><div>{runtimeCopy.frameworks.map((framework) => <small>{framework}</small>)}</div></div>
      </div>
      <figure class="ag-hero__product">
        <img src="/assets/agentguard/dashboard.png" width="2505" height="1229" alt={copy.hero.imageAlt} loading="eager" decoding="sync" fetchpriority="high" />
        <figcaption><span>AgentGuard Console</span><strong>{copy.hero.imageCaption}</strong></figcaption>
      </figure>
    </div>
  </section>

  <section class="section ag-editions" id="enterprise">
    <div class="site-container ag-section-head ag-section-head--split">
      <div><p class="eyebrow">{copy.editions.eyebrow}</p><h2 class="section-title">{copy.editions.title}</h2></div>
      <p>{copy.editions.body}</p>
    </div>
    <div class="site-container ag-editions__grid">
      <article class="ag-edition ag-edition--community">
        <span>{copy.editions.community.label}</span><h3>{copy.editions.community.name}</h3><p>{copy.editions.community.body}</p>
        <ul>{copy.editions.community.features.map(item => <li>{item}</li>)}</ul>
        <a class="button button--secondary" href="https://github.com/WhitzardAgent/AgentGuard" target="_blank" rel="noreferrer">{copy.editions.community.cta} ↗</a>
      </article>
      <article class="ag-edition ag-edition--enterprise">
        <span>{copy.editions.enterprise.label}</span><h3>{copy.editions.enterprise.name}</h3><p>{copy.editions.enterprise.body}</p>
        <ul>{copy.editions.enterprise.features.map(item => <li>{item}</li>)}</ul>
        <a class="button button--primary" href={localizedPath("/contact", locale)}>{copy.editions.enterprise.cta}</a>
      </article>
    </div>
  </section>

  <section class="section ag-runtime-section" id="runtime">
    <div class="site-container ag-section-head ag-section-head--split">
      <div><p class="eyebrow">{copy.runtime.eyebrow}</p><h2 class="section-title">{copy.runtime.title}</h2></div>
      <p>{copy.runtime.body}</p>
    </div>
    <div class="site-container"><AgentGuardEnterpriseScenarioLab copy={enterpriseScenarioLabCopy[locale]} client:visible /></div>
  </section>

  <AgentGuardShowcase locale={locale} copy={copy.demo} />

  <section class="section ag-mechanisms">
    <div class="site-container ag-section-head"><p class="eyebrow">{copy.mechanisms.eyebrow}</p><h2 class="section-title">{copy.mechanisms.title}</h2></div>
    <div class="site-container ag-mechanisms__grid">{copy.mechanisms.items.map((item, index) => <article><span>0{index + 1}</span><h3>{item.title}</h3><p>{item.body}</p><small>{item.detail}</small></article>)}</div>
  </section>

  <section class="section ag-deploy-section" id="deployment">
    <div class="site-container ag-section-head ag-section-head--split"><div><p class="eyebrow">{copy.deployment.eyebrow}</p><h2 class="section-title">{copy.deployment.title}</h2></div><p>{copy.deployment.body}</p></div>
    <div class="site-container"><DeploymentArchitecture nodes={copy.deployment.nodes} client:visible /></div>
    <div class="site-container ag-deploy-modes">{copy.deployment.modes.map((item) => <article><h3>{item.title}</h3><p>{item.body}</p></article>)}</div>
  </section>

  <section class="section ag-evidence">
    <div class="site-container ag-section-head"><p class="eyebrow">{copy.evidence.eyebrow}</p><h2 class="section-title">{copy.evidence.title}</h2></div>
    <div class="site-container ag-evidence__grid">{copy.evidence.items.map((item) => <a href={item.href} target={item.href.startsWith("http") ? "_blank" : undefined} rel={item.href.startsWith("http") ? "noreferrer" : undefined}><h3>{item.title}</h3><p>{item.body}</p><span>{item.label} →</span></a>)}</div>
  </section>

  <section class="ag-cta"><div class="site-container"><h2>{copy.cta.title}</h2><p>{copy.cta.body}</p><div><a class="button ag-cta__primary" href={localizedPath("/contact", locale)}>{copy.cta.primary}</a><a class="button ag-cta__secondary" href="https://github.com/WhitzardAgent/AgentGuard" target="_blank" rel="noreferrer">{copy.cta.github} ↗</a></div></div></section>
</BaseLayout>
