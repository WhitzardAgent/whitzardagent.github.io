---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type {Locale} from "../../i18n/config";
import {localizedPath} from "../../i18n/config";
import type {AgentGuardCopy} from "../../i18n/pages/agentguard";
import AgentRuntimeDemo from "./AgentRuntimeDemo";
import AgentGuardShowcase from "./AgentGuardShowcase.astro";
import DeploymentArchitecture from "./DeploymentArchitecture";
import "../../styles/agentguard.css";
interface Props{locale:Locale;copy:AgentGuardCopy}
const{locale,copy}=Astro.props;
const softwareSchema={"@context":"https://schema.org","@type":"SoftwareApplication",name:"AgentGuard",applicationCategory:"SecurityApplication",operatingSystem:"Enterprise AI agent runtimes",url:`https://whitzard.tech${localizedPath("/agentguard",locale)}`,isAccessibleForFree:true,codeRepository:"https://github.com/WhitzardAgent/AgentGuard",publisher:{"@type":"Organization",name:"Whitzard"}};
---
<BaseLayout title={copy.meta.title} description={copy.meta.description} locale={locale} canonicalPath="/agentguard" schema={softwareSchema}>
 <section class="ag-hero"><div class="site-container ag-hero__grid"><div><p class="eyebrow">{copy.hero.eyebrow}</p><h1>{copy.hero.title}</h1><p>{copy.hero.body}</p><div><a class="button button--primary" href={localizedPath("/contact",locale)}>{copy.hero.primary}</a><a class="button button--secondary" href="https://github.com/WhitzardAgent/AgentGuard" target="_blank" rel="noreferrer">{copy.hero.secondary} ↗</a></div></div><div class="ag-hero__surface" aria-hidden="true"><span>Before LLM</span><span>After LLM</span><b>AgentGuard</b><span>Before Tool</span><span>After Tool</span><i></i></div></div></section>
 <AgentGuardShowcase locale={locale} copy={copy.demo} />
 <section class="section ag-runtime-section"><div class="site-container ag-section-head"><p class="eyebrow">{copy.runtime.eyebrow}</p><h2 class="section-title">{copy.runtime.title}</h2><p>{copy.runtime.body}</p></div><div class="site-container"><AgentRuntimeDemo copy={copy.runtime} client:visible /></div></section>
 <section class="section ag-chains"><div class="site-container ag-section-head"><p class="eyebrow">{copy.chains.eyebrow}</p><h2 class="section-title">{copy.chains.title}</h2><p>{copy.chains.body}</p></div><div class="site-container ag-chains__grid">{copy.chains.items.map((item,index)=><article><span>0{index+1}</span><h3>{item.title}</h3><p>{item.body}</p></article>)}</div><div class="site-container ag-fusion">{copy.chains.fusion}</div></section>
 <section class="section ag-capabilities"><div class="site-container ag-section-head"><p class="eyebrow">{copy.capabilities.eyebrow}</p><h2 class="section-title">{copy.capabilities.title}</h2></div><div class="site-container ag-capabilities__grid">{copy.capabilities.items.map((item,index)=><article><span>{String(index+1).padStart(2,"0")}</span><h3>{item.title}</h3><p>{item.body}</p></article>)}</div></section>
 <section class="section ag-layers"><div class="site-container ag-section-head"><p class="eyebrow">{copy.layers.eyebrow}</p><h2 class="section-title">{copy.layers.title}</h2></div><div class="site-container ag-layer-list">{copy.layers.items.map(layer=><article><div><span>{layer.index}</span><h3>{layer.title}</h3><p>{layer.body}</p></div><ul>{layer.items.map(item=><li>{item}</li>)}</ul></article>)}</div></section>
 <section class="section ag-deploy-section"><div class="site-container ag-section-head"><p class="eyebrow">{copy.deployment.eyebrow}</p><h2 class="section-title">{copy.deployment.title}</h2><p>{copy.deployment.body}</p></div><div class="site-container"><DeploymentArchitecture nodes={copy.deployment.nodes} client:visible /></div><div class="site-container ag-deploy-modes">{copy.deployment.modes.map(item=><article><h3>{item.title}</h3><p>{item.body}</p></article>)}</div></section>
 <section class="section ag-evidence"><div class="site-container ag-section-head"><p class="eyebrow">{copy.evidence.eyebrow}</p><h2 class="section-title">{copy.evidence.title}</h2><p>{copy.evidence.body}</p></div><div class="site-container ag-evidence__grid">{copy.evidence.items.map(item=><a href={item.href} target={item.href.startsWith("http")?"_blank":undefined} rel={item.href.startsWith("http")?"noreferrer":undefined}><h3>{item.title}</h3><p>{item.body}</p><span>{item.label} →</span></a>)}</div></section>
 <section class="ag-cta"><div class="site-container"><h2>{copy.cta.title}</h2><p>{copy.cta.body}</p><div><a class="button ag-cta__primary" href={localizedPath("/contact",locale)}>{copy.cta.primary}</a><a class="button ag-cta__secondary" href="https://github.com/WhitzardAgent/AgentGuard" target="_blank" rel="noreferrer">{copy.cta.github} ↗</a></div></div></section>
</BaseLayout>
