---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { Locale } from "../../i18n/config";
import { localizedPath } from "../../i18n/config";
import type { AgentGuardCopy } from "../../i18n/pages/agentguard";
import { supportedFrameworks } from "../../data/supportedFrameworks";
import { storyPageCopy } from "../../data/agentguardStory";
import AgentGuardShowcase from "./AgentGuardShowcase.astro";
import DeploymentArchitecture from "./DeploymentArchitecture";
import { companyIdentity } from "../../data/companyIdentity";
import { companyCopy } from "../../i18n/pages/company";
import "../../styles/agentguard.css";
import "../../styles/agentguard-story.css";

interface Props { locale: Locale; copy: AgentGuardCopy }
const { locale, copy } = Astro.props;
const story = storyPageCopy[locale];
const softwareSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      name: "AgentGuard Community",
      applicationCategory: "SecurityApplication",
      operatingSystem: "AI agent runtimes",
      url: "https://github.com/WhitzardAgent/AgentGuard",
      isAccessibleForFree: true,
      license: "https://www.gnu.org/licenses/gpl-3.0.html",
      codeRepository: "https://github.com/WhitzardAgent/AgentGuard",
      publisher: { "@type": "Organization", name: companyIdentity.brand[locale], legalName: companyIdentity.legalName },
    },
    {
      "@type": "Product",
      name: "AgentGuard Enterprise",
      category: "Enterprise AI agent runtime security",
      url: `https://whitzard.tech${localizedPath("/agentguard", locale)}`,
      brand: { "@type": "Brand", name: locale === "zh" ? "白泽（Whitzard）" : "Whitzard", alternateName: locale === "zh" ? ["Whitzard", "白泽"] : ["白泽"] },
    },
  ],
};
---

<BaseLayout title={copy.meta.title} description={copy.meta.description} locale={locale} canonicalPath="/agentguard" schema={softwareSchema}>
  <section class="ag-hero">
    <div class="site-container ag-hero__grid ag-hero__grid--editorial">
      <div class="ag-hero__copy">
        <span class="ag-hero__side-mark" aria-hidden="true">{locale === "zh" ? "守界" : "BOUNDARY"}</span>
        <p class="eyebrow">{copy.hero.eyebrow}</p>
        <h1>{locale === "zh" ? <><span class="brand-phrase">智能体</span><span class="brand-phrase">运行时</span><span class="brand-phrase">安全控制层</span></> : copy.hero.title}</h1>
        <p>{copy.hero.body}</p>
        <div class="ag-hero__actions">
          <a class="button button--primary" href={localizedPath("/waitlist", locale)} data-umami-event="waitlist-cta-click">{copy.hero.primary}</a>
          <a class="button button--secondary" href="https://github.com/WhitzardAgent/AgentGuard" target="_blank" rel="noreferrer">{copy.hero.secondary} ↗</a>
        </div>
        <div class="ag-hero__scope" aria-label={story.protection.title}>
          <span>{story.protection.eyebrow}</span>
          <strong>{story.protection.title}</strong>
          <ul>{story.protection.items.map((item) => <li>{item}</li>)}</ul>
        </div>
      </div>
      <figure class="ag-product-hero-image"><img src="/assets/agentguard/policy-builder.png" width="2513" height="955" alt={locale === "zh" ? "AgentGuard 社区版策略配置界面" : "AgentGuard Community policy configuration interface"} fetchpriority="high" decoding="async"/><figcaption>{locale === "zh" ? "AgentGuard 社区版 · 策略配置与运行时控制" : "AgentGuard Community · Policy configuration and runtime control"}</figcaption></figure>
      <div class="ag-hero__evidence" aria-label={locale === "zh" ? "AgentGuard 产品证据" : "AgentGuard product evidence"}>
        <div><span>{locale === "zh" ? "企业交付" : "ENTERPRISE"}</span><strong>AgentGuard Enterprise</strong></div>
        <div><span>{locale === "zh" ? "开放技术" : "OPEN SOURCE"}</span><strong>AgentGuard Community</strong></div>
        <div class="ag-hero__evidence-frameworks"><span>{locale === "zh" ? "支持框架" : "FRAMEWORKS"}</span><p>{supportedFrameworks.map((framework) => <small><img src={framework.logoPath} width="22" height="22" alt="" />{framework.productLabel}</small>)}</p></div>
        <div><span>{locale === "zh" ? "关键介入" : "CONTROL POINTS"}</span><strong>LLM · Tool · Memory</strong></div>
        <div><span>{locale === "zh" ? "部署方式" : "DEPLOYMENT"}</span><strong>{locale === "zh" ? "企业信任边界内" : "Inside the enterprise boundary"}</strong></div>
      </div>
    </div>
  </section>

  <AgentGuardShowcase locale={locale} copy={copy.demo} />
  <section class="section ag-product-use-cases"><div class="site-container"><p class="eyebrow">{locale === "zh" ? "应用场景" : "USE CASES"}</p><h2 class="section-title">{locale === "zh" ? "保护业务中的智能体任务" : "Protect agents in business workflows"}</h2><div>{companyCopy[locale].solutions.scenarios.map(item=><a href={localizedPath(`/solutions#use-case-${item.index}`,locale)}><h3>{item.title}</h3><p>{item.tasks}</p><p>{item.value}</p><span>{locale === "zh" ? "了解场景" : "Explore use case"} →</span></a>)}</div></div></section>

  <section class="section ag-controls" aria-labelledby="ag-controls-title">
    <div class="site-container"><header class="ag-section-head"><h2 id="ag-controls-title" class="section-title">{copy.controls.title}</h2><p>{copy.controls.body}</p></header>
      <div class="ag-controls__grid">{copy.controls.items.map((item, index) => <article id={item.id}><span>0{index + 1}</span><h3>{item.title}</h3><p>{item.body}</p></article>)}</div>
    </div>
  </section>

  <section class="section ag-editions" id="enterprise">
    <div class="site-container ag-section-head ag-section-head--split">
      <div><p class="eyebrow">{copy.editions.eyebrow}</p><h2 class="section-title">{copy.editions.title}</h2></div>
      <p>{copy.editions.body}</p>
    </div>
    <div class="site-container ag-editions__grid">
      <article class="ag-edition ag-edition--community">
        <span>{copy.editions.community.label}</span><h3>{copy.editions.community.name}</h3><p>{copy.editions.community.body}</p>
        <ul>{copy.editions.community.features.map(item => <li>{item}</li>)}</ul>
        <a class="button button--secondary" href="https://github.com/WhitzardAgent/AgentGuard" target="_blank" rel="noreferrer">{copy.editions.community.cta} ↗</a>
      </article>
      <article class="ag-edition ag-edition--enterprise">
        <span>{copy.editions.enterprise.label}</span><h3>{copy.editions.enterprise.name}</h3><p>{copy.editions.enterprise.body}</p>
        <ul>{copy.editions.enterprise.features.map(item => <li>{item}</li>)}</ul>
        <a class="button button--primary" href={localizedPath("/waitlist", locale)} data-umami-event="waitlist-cta-click">{copy.editions.enterprise.cta}</a>
      </article>
    </div>
  </section>

  <section class="section ag-deploy-section" id="deployment">
    <div class="site-container ag-section-head ag-section-head--split"><div><p class="eyebrow">{copy.deployment.eyebrow}</p><h2 class="section-title">{copy.deployment.title}</h2></div><p>{copy.deployment.body}</p></div>
    <div class="site-container"><DeploymentArchitecture locale={locale} nodes={copy.deployment.nodes} modes={copy.deployment.modes} /></div>
  </section>

  <section class="section story-section story-section--frost" id="security-stack">
    <div class="site-container story-section__head"><div><p class="eyebrow">{story.securityStack.eyebrow}</p><h2 class="section-title">{story.securityStack.title}</h2></div><p>{story.securityStack.body}</p></div>
    <div class="site-container security-stack-table">{story.securityStack.rows.map((row) => <div><strong>{row[0]}</strong><span>{row[1]}</span><span>{row[2]}</span></div>)}</div>
  </section>

  <section class="section ag-evidence">
    <div class="site-container ag-section-head"><p class="eyebrow">{copy.evidence.eyebrow}</p><h2 class="section-title">{copy.evidence.title}</h2></div>
    <div class="site-container ag-evidence__grid">{copy.evidence.items.map((item) => <a href={item.href.startsWith("/") ? localizedPath(item.href, locale) : item.href} target={item.href.startsWith("http") ? "_blank" : undefined} rel={item.href.startsWith("http") ? "noreferrer" : undefined}><h3>{item.title}</h3><p>{item.body}</p><span>{item.label} →</span></a>)}</div>
  </section>

  <section class="ag-cta"><div class="site-container"><h2>{copy.cta.title}</h2><p>{copy.cta.body}</p><ol class="demo-agenda">{story.demoAgenda.map((item) => <li>{item}</li>)}</ol><div><a class="button ag-cta__primary" href={localizedPath("/waitlist", locale)} data-umami-event="waitlist-cta-click">{copy.cta.primary}</a><a class="button ag-cta__secondary" href="https://github.com/WhitzardAgent/AgentGuard" target="_blank" rel="noreferrer">{copy.cta.github} ↗</a></div></div></section>
</BaseLayout>
