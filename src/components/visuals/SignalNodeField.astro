---
/** Pulsing signal node field for Whitzard hero. Pure inline SVG + CSS. */
interface Props {
  class?: string;
}

const { class: cls = "" } = Astro.props;
const nodes = [
  { cx: 120, cy: 80, r: 4, delay: 0 },
  { cx: 300, cy: 60, r: 5, delay: 1.5 },
  { cx: 440, cy: 140, r: 3.5, delay: 3 },
  { cx: 180, cy: 220, r: 3, delay: 4.5 },
  { cx: 380, cy: 240, r: 4.5, delay: 2 },
  { cx: 260, cy: 150, r: 2.5, delay: 1 },
];
---

<div class:list={["relative", cls]} aria-hidden="true">
  <svg viewBox="0 0 560 320" fill="none" class="w-full h-auto" preserveAspectRatio="xMidYMid meet">
    <defs>
      <linearGradient id="signal-grad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#2F7F7A" stop-opacity="0.1" />
        <stop offset="100%" stop-color="#164A8B" stop-opacity="0.18" />
      </linearGradient>
    </defs>

    <!-- Large faint boundary -->
    <ellipse cx="280" cy="160" rx="240" ry="140" stroke="#2F7F7A" stroke-opacity="0.05" stroke-width="1" fill="none" />

    <!-- Signal arcs -->
    <path d="M 80 200 Q 200 40 340 120 Q 440 180 500 130" stroke="#2F7F7A" stroke-opacity="0.15" stroke-width="1" fill="none" stroke-dasharray="6 4" class="slow-pulse" />
    <path d="M 60 230 Q 180 60 360 100 Q 460 150 520 100" stroke="#164A8B" stroke-opacity="0.1" stroke-width="0.8" fill="none" stroke-dasharray="8 6" class="slow-pulse" style="animation-delay: 2.5s;" />

    <!-- Signal flow line -->
    <path d="M 100 180 Q 200 80 300 140 Q 400 200 460 160" stroke="#2F7F7A" stroke-opacity="0.25" stroke-width="1.5" fill="none" stroke-linecap="round" />

    <!-- Nodes with outer glow -->
    {nodes.map((n, i) => (
      <g>
        <circle cx={n.cx} cy={n.cy} r={n.r * 3} fill="#2F7F7A" opacity="0.04" class="slow-pulse" style={`animation-delay: ${n.delay}s;`} />
        <circle cx={n.cx} cy={n.cy} r={n.r} fill="#2F7F7A" opacity="0.5" class="slow-pulse" style={`animation-delay: ${n.delay}s;`} />
        <circle cx={n.cx} cy={n.cy} r={n.r * 0.5} fill="#2F7F7A" opacity="0.9" />
      </g>
    ))}

    <!-- Scan line -->
    <rect x="0" y="0" width="560" height="2" fill="url(#signal-grad)" opacity="0.12" class="scan-line" />
  </svg>
</div>
