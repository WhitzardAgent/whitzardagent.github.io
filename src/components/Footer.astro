---
import { links } from "../data/links";

interface Props {
  brand?: "whitzard" | "nuwa";
}

const { brand = "whitzard" } = Astro.props;
---

<footer class="border-t border-wz-hairline bg-wz-panel mt-24">
  <div class="max-w-[1180px] mx-auto px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Brand -->
      <div class="md:col-span-1">
        <p class="text-wz-ink font-semibold text-lg mb-2">
          {brand === "nuwa" ? "Nuwa 女娲" : "Whitzard 白泽"}
        </p>
        <p class="text-wz-muted text-sm leading-relaxed">
          {brand === "nuwa"
            ? "Frontier AI Safety Lab studying frontier AI risks, agent safety, and controllable AI."
            : "Building safety infrastructure for frontier AI and agentic systems."}
        </p>
      </div>

      <!-- Navigation -->
      <div>
        <p class="text-wz-ink font-medium text-sm mb-3">Navigation</p>
        <div class="flex flex-col gap-2 text-sm text-wz-muted">
          <a href="/" class="hover:text-wz-ink transition-colors no-underline">Whitzard</a>
          <a href="/nuwa" class="hover:text-wz-ink transition-colors no-underline">Nuwa</a>
          <a href="/research" class="hover:text-wz-ink transition-colors no-underline">Research</a>
          <a href="/blog" class="hover:text-wz-ink transition-colors no-underline">Blog</a>
          <a href="/open-source" class="hover:text-wz-ink transition-colors no-underline">Open Source</a>
          <a href="/contact" class="hover:text-wz-ink transition-colors no-underline">Contact</a>
        </div>
      </div>

      <!-- Projects -->
      <div>
        <p class="text-wz-ink font-medium text-sm mb-3">Projects</p>
        <div class="flex flex-col gap-2 text-sm text-wz-muted">
          <a href="/agentguard" class="hover:text-wz-ink transition-colors no-underline">AgentGuard</a>
          <a href="/open-source" class="hover:text-wz-ink transition-colors no-underline">Snowl</a>
          <a href="/open-source" class="hover:text-wz-ink transition-colors no-underline">Qise</a>
          <a href="/open-source" class="hover:text-wz-ink transition-colors no-underline">QitOS</a>
        </div>
      </div>

      <!-- External Links -->
      <div>
        <p class="text-wz-ink font-medium text-sm mb-3">Channels</p>
        <div class="flex flex-col gap-2 text-sm text-wz-muted">
          <a
            href={links.x}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-wz-ink transition-colors no-underline"
          >
            X (Twitter)
          </a>
          <a
            href={links.substack}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-wz-ink transition-colors no-underline"
          >
            Substack
          </a>
          <a
            href={links.github}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-wz-ink transition-colors no-underline"
          >
            GitHub
          </a>
          <a
            href={links.huggingface}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-wz-ink transition-colors no-underline"
          >
            Hugging Face
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-10 pt-6 border-t border-wz-hairline flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-wz-subtle text-xs">
        &copy; {new Date().getFullYear()} Whitzard. All rights reserved.
      </p>
      <div class="flex items-center gap-1 text-wz-subtle text-xs">
        <span style="color: var(--stone-jade);">&#9670;</span>
        <span style="color: var(--stone-vermilion);">&#9670;</span>
        <span style="color: var(--stone-ochre);">&#9670;</span>
        <span style="color: var(--stone-ivory);">&#9670;</span>
        <span style="color: var(--stone-ink);">&#9670;</span>
      </div>
    </div>
  </div>
</footer>
