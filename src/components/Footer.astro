---
import type { Locale } from "../i18n/config";
import { localizedPath } from "../i18n/config";
import { ui } from "../i18n/ui";
import { links } from "../data/links";

interface Props { brand?: "whitzard" | "nuwa"; locale: Locale; }
const { locale } = Astro.props;
const copy = ui[locale];
---

<footer class="site-footer">
  <div class="site-container site-footer__top">
    <div class="site-footer__brand">
      <a href={localizedPath("/", locale)} class="wordmark wordmark--light" aria-label={locale === "zh" ? "白泽（Whitzard）" : "Whitzard"}>
        <img class="wordmark__logo wordmark__logo--footer" src="/assets/logo/whitzard_logo.png" width="48" height="48" alt="" aria-hidden="true" loading="lazy" decoding="async" />
        {locale === "zh" ? <><span class="wordmark__text">白泽</span><span class="wordmark__han">（Whitzard）</span></> : <span class="wordmark__text">Whitzard</span>}
      </a>
      <p>{copy.footer.positioning}</p>
      <p class="site-footer__research">{copy.footer.researchLine}</p>
    </div>
    <div class="site-footer__column">
      <p class="site-footer__label">{copy.footer.products}</p>
      <a href={localizedPath("/agentguard", locale)}>AgentGuard</a>
      <a href={localizedPath("/models", locale)}>{locale === "zh" ? "模型服务" : "Model Services"}</a>
      <a href={localizedPath("/solutions", locale)}>{locale === "zh" ? "应用场景" : "Use Cases"}</a>
      <a href={localizedPath("/waitlist", locale)} data-umami-event="waitlist-cta-click">{copy.primaryCta}</a>
    </div>
    <div class="site-footer__column">
      <p class="site-footer__label">{copy.footer.nuwa}</p>
      <a href={localizedPath("/nuwa", locale)}>{locale === "zh" ? "实验室总览" : "Lab Overview"}</a>
      <a href={localizedPath("/nuwa/research", locale)}>{locale === "zh" ? "研究成果" : "Research"}</a>
      <a href={localizedPath("/nuwa/blog", locale)}>Research Blog</a>
      <a href={localizedPath("/nuwa/whitzard-index", locale)}>{locale === "zh" ? "白泽指数" : "Whitzard Index"}</a>
    </div>
    <div class="site-footer__column">
      <p class="site-footer__label">{copy.footer.ecosystem}</p>
      <a href={localizedPath("/open-ecosystem", locale)}>{locale === "zh" ? "开放生态" : "Open Ecosystem"}</a>
      <a href={links.github} target="_blank" rel="noreferrer">GitHub ↗</a>
      <a href={links.huggingface} target="_blank" rel="noreferrer">Hugging Face ↗</a>
    </div>
    <div class="site-footer__column">
      <p class="site-footer__label">{copy.footer.company}</p>
      <a href={localizedPath("/about", locale)}>{locale === "zh" ? "关于我们" : "About Us"}</a>
      <a href={`mailto:${links.email}`}>{links.email}</a>
    </div>
  </div>
  <div class="site-container site-footer__bottom">
    <p>© {new Date().getFullYear()} {locale === "zh" ? "白泽（Whitzard）" : "Whitzard"}</p><p>{copy.footer.legalLine}</p>
  </div>
</footer>
