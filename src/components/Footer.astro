---
import { links } from "../data/links";

interface Props {
  brand?: "whitzard" | "nuwa";
}

const { brand = "whitzard" } = Astro.props;
---

<footer class="border-t border-wz-hairline bg-wz-panel mt-24">
  <div class="max-w-[1180px] mx-auto px-6 py-10">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-6">
      <!-- Brand -->
      <div class="col-span-2 md:col-span-1">
        <p class="text-wz-ink font-semibold text-base mb-2">
          {brand === "nuwa" ? "Nuwa 女娲" : "Whitzard 白泽"}
        </p>
        <p class="text-wz-muted text-xs leading-relaxed">
          {brand === "nuwa"
            ? "Frontier AI Safety Lab studying frontier AI risks, agent safety, and controllable AI."
            : "Building safety infrastructure for frontier AI and agentic systems."}
        </p>
      </div>

      <!-- Navigation -->
      <div>
        <p class="text-wz-ink font-medium text-xs uppercase tracking-wide mb-3">Pages</p>
        <div class="flex flex-col gap-1.5 text-xs text-wz-muted">
          <a href="/" class="hover:text-wz-ink transition-colors no-underline">Whitzard</a>
          <a href="/nuwa" class="hover:text-wz-ink transition-colors no-underline">Nuwa</a>
          <a href="/research" class="hover:text-wz-ink transition-colors no-underline">Research</a>
          <a href="/blog" class="hover:text-wz-ink transition-colors no-underline">Blog</a>
          <a href="/about" class="hover:text-wz-ink transition-colors no-underline">About</a>
        </div>
      </div>

      <!-- Research -->
      <div>
        <p class="text-wz-ink font-medium text-xs uppercase tracking-wide mb-3">Research</p>
        <div class="flex flex-col gap-1.5 text-xs text-wz-muted">
          <a href="/nuwa" class="hover:text-wz-ink transition-colors no-underline">Nuwa Lab</a>
          <a href="/research" class="hover:text-wz-ink transition-colors no-underline">Publications</a>
          <a href="/open-source" class="hover:text-wz-ink transition-colors no-underline">Open Source</a>
          <a href="/agentguard" class="hover:text-wz-ink transition-colors no-underline">AgentGuard</a>
        </div>
      </div>

      <!-- Channels -->
      <div>
        <p class="text-wz-ink font-medium text-xs uppercase tracking-wide mb-3">Channels</p>
        <div class="flex flex-col gap-1.5 text-xs text-wz-muted">
          <a href={links.x} target="_blank" rel="noopener noreferrer" class="hover:text-wz-ink transition-colors no-underline">X (Twitter)</a>
          <a href={links.substack} target="_blank" rel="noopener noreferrer" class="hover:text-wz-ink transition-colors no-underline">Substack</a>
          <a href={links.github} target="_blank" rel="noopener noreferrer" class="hover:text-wz-ink transition-colors no-underline">GitHub</a>
          <a href={links.huggingface} target="_blank" rel="noopener noreferrer" class="hover:text-wz-ink transition-colors no-underline">Hugging Face</a>
        </div>
      </div>

      <!-- Contact -->
      <div>
        <p class="text-wz-ink font-medium text-xs uppercase tracking-wide mb-3">Contact</p>
        <div class="flex flex-col gap-1.5 text-xs text-wz-muted">
          <a href="/contact" class="hover:text-wz-ink transition-colors no-underline">Collaboration</a>
          <a href={`mailto:${links.email}`} class="hover:text-wz-ink transition-colors no-underline">{links.email}</a>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-8 pt-4 border-t border-wz-hairline flex flex-col md:flex-row justify-between items-center gap-3">
      <p class="text-wz-subtle text-xs">
        &copy; {new Date().getFullYear()} Whitzard. All rights reserved.
      </p>
      <div class="flex items-center gap-1 text-wz-subtle text-xs">
        <span style="color: var(--stone-jade);">&#9670;</span>
        <span style="color: var(--stone-vermilion);">&#9670;</span>
        <span style="color: var(--stone-ochre);">&#9670;</span>
        <span style="color: var(--stone-ivory);">&#9670;</span>
        <span style="color: var(--stone-ink);">&#9670;</span>
      </div>
    </div>
  </div>
</footer>
