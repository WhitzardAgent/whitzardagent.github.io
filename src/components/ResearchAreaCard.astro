---
interface Props {
  title: string;
  tag: string;
  description: string;
}

const { title, tag, description } = Astro.props;
---

<div class="card card--editorial hover-lift">
  <h3 class="text-wz-ink font-semibold text-sm leading-snug mb-1.5">{title}</h3>
  <p class="text-wz-muted text-xs leading-relaxed">{description}</p>
</div>
