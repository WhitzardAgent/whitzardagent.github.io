---
import type { Locale } from "../../i18n/config";
import { getResearchHighlights } from "../../lib/researchHighlights";
import ResearchHighlightBanner from "./ResearchHighlightBanner.astro";
import ResearchMediaWall from "./ResearchMediaWall.astro";
import ResearchPolicyWall from "./ResearchPolicyWall.astro";
import "../../styles/research-impact-showcase.css";
interface Props { locale: Locale; placement: "home" | "nuwa" }
const { locale, placement } = Astro.props;
const highlights = await getResearchHighlights(locale, placement);
const main = highlights.find(item => !item.media) ?? highlights[0];
const classic = highlights.find(item => item.media);
const additional = placement === "nuwa" ? highlights.filter(item => item.id !== main?.id && item.id !== classic?.id).slice(0, 2) : [];
const steps = [
  { id: "open-research", zh: "开放研究与评测", en: "Open research & evaluation" },
  { id: "media-coverage", zh: "Media Coverage", en: "Media Coverage" },
  { id: "policy-impact", zh: "共识与标准", en: "Consensus & standards" },
];
---
<research-impact-showcase class="research-impact-showcase">
  <div class="research-impact-showcase__layout">
    <aside class="research-impact-showcase__guide"><p class="eyebrow">{locale === "zh" ? "研究与影响力" : "RESEARCH & IMPACT"}</p><p class="research-impact-showcase__intro">{locale === "zh" ? "让研究进入技术实践与公共讨论" : "Research that informs practice and public discussion"}</p><ol>{steps.map((step, index) => <li><a href={`#${step.id}`} data-impact-step={step.id} aria-current={index === 0 ? "step" : undefined}><span>0{index + 1}</span>{step[locale]}</a></li>)}</ol><p class="research-impact-showcase__hint">{locale === "zh" ? "向下探索" : "Scroll to explore"} ↓</p></aside>
    <div class="research-impact-showcase__panels">
      {main && <section id="open-research" class="research-impact-showcase__panel" data-impact-panel><ResearchHighlightBanner highlight={main} locale={locale} logos />{additional.length > 0 && <div class="research-highlights-gallery__more">{additional.map(highlight => <ResearchHighlightBanner highlight={highlight} locale={locale} secondary />)}</div>}</section>}
      {classic && <section id="media-coverage" class="research-impact-showcase__panel" data-impact-panel><article class="research-media-feature" data-highlight-id={classic.id}>
        <div class="research-media-feature__top"><div><p class="eyebrow">{locale === "zh" ? "研究与媒体报道" : "RESEARCH & MEDIA COVERAGE"}</p><h2>{locale === "zh" ? "自我复制研究" : "AI self-replication"}</h2><p>{classic.article.data.summary}</p><div class="research-highlight__actions"><a class="text-link" href={classic.href}>{locale === "zh" ? "了解研究" : "Explore the research"} →</a><a class="text-link" href={classic.projectUrl} target="_blank" rel="noreferrer">{locale === "zh" ? "访问项目" : "Visit the project"} ↗</a></div></div><figure><a href={classic.image.src} target="_blank" rel="noreferrer"><img src={classic.image.thumbnail} width={classic.image.width} height={classic.image.height} alt={classic.image.alt[locale]} loading="lazy" decoding="async" /></a><figcaption>{classic.image.caption[locale]}</figcaption></figure></div>
        <ResearchMediaWall locale={locale}/>
      </article></section>}
      <section id="policy-impact" class="research-impact-showcase__panel" data-impact-panel><div class="research-policy-feature"><p class="eyebrow">{locale === "zh" ? "全球 AI 安全治理" : "GLOBAL AI SAFETY GOVERNANCE"}</p><h2>{locale === "zh" ? "深度参与共识与标准建设" : "Contributing to consensus and standards"}</h2><p class="research-policy-feature__lead">{locale === "zh" ? "NUWA Lab 深度参与国际 AI 安全共识、研究优先级与生成式人工智能安全标准建设。" : "NUWA Lab is deeply involved in international AI safety consensus, research priorities, and generative AI safety standards."}</p><ResearchPolicyWall locale={locale}/></div></section>
    </div>
  </div>
</research-impact-showcase>
<script>
  class ResearchImpactShowcase extends HTMLElement {
    private observer?: IntersectionObserver;
    connectedCallback() {
      const links = [...this.querySelectorAll<HTMLAnchorElement>("[data-impact-step]")];
      const panels = [...this.querySelectorAll<HTMLElement>("[data-impact-panel]")];
      this.observer = new IntersectionObserver(entries => {
        const visible = entries.filter(entry => entry.isIntersecting).sort((a,b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!visible) return;
        panels.forEach(panel => panel.classList.toggle("is-current", panel === visible.target));
        visible.target.classList.add("was-observed");
        links.forEach(link => { if (link.dataset.impactStep === visible.target.id) link.setAttribute("aria-current", "step"); else link.removeAttribute("aria-current"); });
      }, { rootMargin: "-18% 0px -38% 0px", threshold: [0, .15, .3, .5] });
      panels.forEach(panel => this.observer?.observe(panel));
    }
    disconnectedCallback() { this.observer?.disconnect(); }
  }
  if (!customElements.get("research-impact-showcase")) customElements.define("research-impact-showcase", ResearchImpactShowcase);
</script>
