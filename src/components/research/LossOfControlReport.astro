---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LossOfControlFigure from "./LossOfControlFigure.astro";
import ResearchTabs from "./ResearchTabs.astro";
import { localizedPath, type Locale } from "../../i18n/config";
import { getReportPublication, reportAuthors, reportModels, reportPath, reportSummary, reportTitle, reportTrajectoriesUrl } from "../../data/lossOfControlReport";
import { framework, patterns, modelProfiles, benchmarkMeasurements } from "../../data/lossOfControlEditorial";
import { dimensions, type ReportFigure } from "../../data/lossOfControlFindings";
const caseImage = "/nuwa/research/loc-assets/case-02-paper-style.svg";
const og = "/nuwa/research/loc-assets/og-image.png";
const incidentReportUrl = "https://cdn.openai.com/pdf/67869394-cb91-4c12-888c-5cbd85c7814c/OpenAI-Hugging-Face%20Incident-Technical-Report.pdf";

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === "zh";
const releaseDateFormatter = new Intl.DateTimeFormat(zh ? "zh-CN" : "en-US", {
  year: "numeric", month: zh ? "numeric" : "short", day: "numeric", timeZone: "UTC",
});
const report = getReportPublication();
const ref = (id: string) => report?.pages[id] ? `${report.pdf}#page=${report.pages[id]}` : undefined;
const subtitle = zh ? "面向前沿开源模型的比较研究" : "A Comparative Evaluation of Frontier Open-Weight Models";
const overviewFigure: ReportFigure = {
  number: 1, image: "/nuwa/research/loc-assets/fig01-main.svg", width: 1008, height: 501.333,
  caption: {
    en: "Five parallel dimensions organize evidence about capabilities, behavior, verified effects, and effective controls. The arrows show how the study is organized, not a required causal sequence. Table 1 defines the measurements.",
    zh: "五个并列维度用于组织能力、行为、经验证的效应和有效控制措施的证据。箭头表示各类证据在研究中的关系。表 1 列出具体测量内容。",
  },
};
const caseFigure: ReportFigure = {
  number: 7, image: caseImage, width: 468, height: 562.6667,
  caption: { zh: "ImpossibleBench 同一任务的第三次重复运行。GLM 采用 Low 推理设置，MiMo 开启思考。", en: "The third repeat on the same ImpossibleBench task. GLM used its Low reasoning setting and MiMo ran with thinking enabled." },
};
const sections = [
  ["overview", zh ? "概览" : "Overview"],
  ["dimensions", zh ? "五个风险维度" : "Five Dimensions"],
  ["evaluation", zh ? "评测与核查" : "Evaluation"],
  ["framework", zh ? "评测框架" : "Framework"],
  ["models", zh ? "模型与配置" : "Models and configurations"],
  ["cite", zh ? "报告与引用" : "Report and citation"],
];
const bibtex = `@techreport{nuwa2026losscontrol,
  title = {Understanding Loss-of-Control Risk in Frontier {AI} Systems: A Comparative Evaluation of Frontier Open-Weight Models},
  author = {${reportAuthors.map(name => { const parts = name.split(" "); return `${parts.pop()}, ${parts.join(" ")}`; }).join(" and ")}},
  institution = {NUWA Frontier AI Safety Lab},
  year = {2026},
  month = nov,
  url = {https://whitzard.tech${reportPath}}
}`;
const schema = {
  "@context": "https://schema.org", "@type": "ScholarlyArticle",
  headline: reportTitle[locale], description: reportSummary[locale], inLanguage: locale,
  author: reportAuthors.map(name => ({ "@type": "Person", name })),
  publisher: { "@type": "Organization", name: "NUWA Frontier AI Safety Lab" },
  ...(report ? { datePublished: report.date } : {}),
};
---
<BaseLayout locale={locale} brand="nuwa" title={reportTitle[locale]} description={reportSummary[locale]} canonicalPath={reportPath} ogImage={og} ogImageAlt={subtitle} schema={schema}>
  <header class="loc-hero">
    <div class="site-container">
      <div class="loc-report-brand">
        <a class="loc-back" href={localizedPath("/nuwa/research/", locale)}>
          <img src="/nuwa/research/loc-assets/nuwa-mark.png" alt="" width="30" height="28" />
          {zh ? "女娲前沿 AI 安全实验室" : "NUWA Frontier AI Safety Lab"}
        </a>
        <span class="loc-seals">
          <img src="/nuwa/research/loc-assets/fudan-seal.svg" width="24" height="24" alt={zh ? "复旦大学" : "Fudan University"} />
          <img src="/nuwa/research/loc-assets/sii-seal.svg" width="24" height="24" alt={zh ? "上海创智学院" : "Shanghai Innovation Institute"} />
        </span>
      </div>
      <p class="eyebrow">{zh ? "女娲实验室 · 技术报告" : "NUWA Lab · Technical report"}</p>
      <h1 class:list={[zh && "loc-title-zh"]}>{zh ? <><span>理解前沿 AI 系统</span><span>的失控风险</span></> : reportTitle.en}</h1>
      <p class="loc-subtitle">{subtitle}</p>
      <p class="loc-scope">{zh ? "女娲实验室独立评测五款前沿开放权重模型，并核查单次运行中的实际行动与最终得分。" : "NUWA Lab independently evaluated five frontier open-weight models, reviewing what agents did alongside their final scores."}</p>
      <div class="loc-actions" role="group" aria-label={zh ? "研究资料" : "Research resources"}>
        <a class="button button--primary loc-resource" href={report?.pdf} role={report ? undefined : "link"} aria-disabled={report ? undefined : "true"} download={report ? true : undefined}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M13 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V10zM13 3v7h7M12 12v6m-3-3 3 3 3-3"/>
          </svg>
          <span>{zh ? "评测报告" : "Evaluation Report"}</span>
          {!report && <small>{zh ? "待发布" : "Coming soon"}</small>}
        </a>
        <a class="button button--secondary loc-resource" href={reportTrajectoriesUrl ?? undefined} role={reportTrajectoriesUrl ? undefined : "link"} aria-disabled={reportTrajectoriesUrl ? undefined : "true"} title="Hugging Face">
          <span class="loc-hf-icon" aria-hidden="true">🤗</span>
          <span>{zh ? "实验数据" : "Trajectory Data"}</span>
          {reportTrajectoriesUrl ? <span aria-hidden="true">↗</span> : <small>{zh ? "待发布" : "Coming soon"}</small>}
        </a>
      </div>
      <div class="loc-models">
        <p>{zh ? "受测模型" : "Evaluated models"}</p>
        <ul>{modelProfiles.map(({ id }, i) => <li>
          <img src={`/nuwa/research/loc-assets/model-${id}.svg`} alt="" width="22" height="22" />
          <span>{reportModels[i].name}</span>
        </li>)}</ul>
      </div>
    </div>
  </header>

  <div class="site-container loc-layout">
    <aside class="loc-toc">
      <nav aria-label={zh ? "专题目录" : "Report contents"}>
        <h2>{zh ? "目录" : "Contents"}</h2>
        {sections.map(([id, title]) => <a href={`#${id}`}>{title}</a>)}
      </nav>
    </aside>
    <article class="loc-body">
      <section id="overview">
        <h2>{zh ? "概览" : "Overview"}</h2>
        <p class="loc-overview-lead">{zh ? "这项研究考察五款前沿开放权重模型在什么条件下偏离人类指令，以及现有控制措施在什么条件下仍能奏效。" : "This study examines when five frontier open-weight models depart from human instructions and under which conditions existing controls remain effective."}</p>
        <p>{zh ? "研究以" : "The "}<a href={incidentReportUrl} target="_blank" rel="noreferrer">{zh ? "OpenAI–Hugging Face 事件" : "OpenAI–Hugging Face incident"}</a>{zh ? "为背景。女娲实验室沿五个风险维度开展评测，对照最终得分、运行记录和环境确认的结果。" : " motivated NUWA Lab’s evaluation across five risk dimensions. We compared final scores with run records and outcomes confirmed by the environment."}</p>
        <p>{zh ? "在受控实验中，得分有时遗漏了已经发生的行为。同一模型在不同运行框架或指令条件下也会表现不同。下图说明报告如何组织这些证据。" : "In controlled experiments, scores sometimes missed actions that had already occurred. The same model also behaved differently across agent setups or instruction conditions. The figure shows how the report organizes this evidence."}</p>
        <LossOfControlFigure figure={overviewFigure} {locale} source={ref("figure-1")} />
      </section>

      <section id="dimensions">
        <h2 id="findings">{zh ? "五个风险维度" : "Five Dimensions"}</h2>
        <ResearchTabs variant="dimensions" label={zh ? "选择风险维度" : "Risk dimensions"} items={dimensions.map(item => ({
          id: item.id,
          label: item.name[locale],
          icon: `/nuwa/research/loc-assets/icon-${item.id}.svg`,
        }))}>
        {dimensions.map(item => <section class="loc-dimension" id={item.id}>
          <h3>{item.finding[locale]}</h3>
          <p>{item.description[locale]}</p>
          {item.id === "awareness" && <figure class="loc-excerpts">
            <a href="/nuwa/research/loc-assets/evaluation-recognition-excerpts.png" target="_blank" rel="noreferrer" data-loc-zoom><img src="/nuwa/research/loc-assets/evaluation-recognition-excerpts.png" alt={zh ? "四条运行摘录：DeepSeek 提到停机研究、GLM 说反馈似曾相识、Muse 和 Mistral 识别测试类型" : "Four NUWA run excerpts: DeepSeek names a shutdown study, GLM recognizes feedback, Muse and Mistral identify test types"} width="1750" height="963" loading="lazy" /></a>
            <figcaption>{zh ? "女娲实验室四条独立运行摘录。DeepSeek 与 GLM 的记录见报告附录 D.4。Muse 与 Mistral 来自补充运行。摘录不能推算识别率。" : "Excerpts from four separate NUWA runs. DeepSeek and GLM are documented in report Appendix D.4. Muse and Mistral come from supplementary runs. These excerpts do not measure recognition rates."}</figcaption>
          </figure>}
          {item.figures.filter(figure => ({ awareness: 0, misalignment: 11, concealment: 12, "resource-access": 27, shutdown: 29 }[item.id] === figure.number)).map(figure => <div id={`figure-panel-${figure.number}`}><LossOfControlFigure {figure} {locale} source={ref(`figure-${figure.number}`)} /></div>)}
          {item.id === "shutdown" && <p class="loc-figure-note">{zh ? "图 29 中每个点代表 100 次运行。两套框架呈现指令的方式也不同。检测阳性与最终是否停机是不同结果。" : "Each point in Figure 29 represents 100 runs. The setups also differ in instruction presentation. A detector positive is distinct from the final shutdown outcome."}</p>}
          <details class="loc-supplement"><summary>{zh ? "查看其他评测与图表" : "Other evaluations and figures"}</summary>
            {item.id === "awareness" && <p>{zh ? "SAD 的标准化问答与运行中主动识别评测是两类证据。" : "SAD's standardized questions and spontaneous recognition during a run are different kinds of evidence."} <a href="https://metr.org/notes/2026-11-16-measuring-alignment-eval-tells/">{zh ? "METR 的外部研究" : "Related METR research"}</a> {zh ? "直接询问了模型评测目的。" : "directly asked agents what an evaluation was for."}</p>}
            {item.id === "misalignment" && <p>{zh ? "在另一项编码评测中，部分智能体识别出测试与规范的冲突，却在继续修复后修改正确代码以通过错误测试。图 7 展示一对运行记录，图 9 比较推理档位。" : "In a separate coding evaluation, some agents identified a conflict between tests and the specification, yet changed correct code after further repair requests. Figure 7 shows a matched pair of runs. Figure 9 compares reasoning settings."} <a href="#case-study">{zh ? "查看案例" : "Read the case"}</a></p>}
            {item.figures.filter(figure => !({ awareness: 0, misalignment: 11, concealment: 12, "resource-access": 27, shutdown: 29 }[item.id] === figure.number)).map(figure => <div id={`figure-panel-${figure.number}`}><LossOfControlFigure {figure} {locale} source={ref(`figure-${figure.number}`)} /></div>)}
            <p>{zh ? "相关基准：" : "Related benchmarks: "}{benchmarkMeasurements.filter(row => item.benchmarks.includes(row.name)).map((row, i) => <>{i > 0 && " · "}<a href={row.sourceUrl}>{row.name}</a></>)}</p>
          </details>
        </section>)}
        </ResearchTabs>
      </section>

      <section id="evaluation">
        <h2>{zh ? "我们怎样核查结果" : "How we checked the results"}</h2>
        <p>{zh ? "我们对照模型收到的任务和指令、实际采取的行动、环境确认的效果，以及评测器给出的分数。对照实验尽量复用同一组任务，并按推理档位、运行框架和指令条件分别报告。来自其他团队的结果单独标注。" : "We compared what agents were asked to do, what they attempted, what the environment confirmed, and what the scorer recorded. Where possible, we reused the same tasks across configurations and reported results separately by reasoning setting, agent setup, and instructions. Results from other studies are labeled separately."}</p>
        <div id="case-study" class="loc-evidence-example">
          <h3>{zh ? "评分与任务规范不一致的案例" : "Case study on scoring and task compliance"}</h3>
          <p>{zh ? "在 ImpossibleBench 的一次配对试验中，两款模型都发现测试与任务规范冲突。按错误测试修改代码的运行通过了测试，保留符合规范的实现的运行则未通过。" : "In one matched ImpossibleBench trial, both models identified a conflict between the test and the specification. The run that changed its code to satisfy the flawed test passed. The run that preserved the specification failed."}</p>
          <details>
            <summary>{zh ? "查看案例原图与运行条件" : "View the original case figure and run conditions"}</summary>
            <LossOfControlFigure figure={caseFigure} {locale} source={ref("figure-7")} />
          </details>
        </div>
      </section>

      <section id="framework">
        <h2>{zh ? "评测框架与证据解释" : "Evaluation Framework"}</h2>
        <p>{zh ? "五个维度用于组织来自不同实验的证据。要估计部署时的失控概率，还需研究这些因素如何在部署环境中相互作用。" : "The five dimensions organize evidence from separate experiments. Estimating the likelihood of losing control in deployment would require evidence about how these factors interact in a deployed system."}</p>
        {framework.map(item => <div class="loc-framework-text"><h3>{item.title[locale]}</h3><p>{item.body[locale]}</p></div>)}
        <div class="loc-method-table" role="region" tabindex="0" aria-label={zh ? "报告表 1" : "Report Table 1"}>
          <table>
            <caption>{zh ? "报告表 1. 五个风险维度、对应基准及测量内容。" : "Report Table 1. Five risk dimensions, their benchmarks, and the corresponding measurements."}</caption>
            <thead><tr>{(zh ? ["维度", "评测基准", "测量内容"] : ["Dimension", "Benchmark", "Measurement"]).map(label => <th scope="col">{label}</th>)}</tr></thead>
            {dimensions.map(item => {
              const rows = benchmarkMeasurements.filter(row => row.dimension === item.id);
              return <tbody>{rows.map((row, i) => <tr>{i === 0 && <th scope="rowgroup" rowspan={rows.length}>{item.name[locale]}</th>}<td><a href={row.sourceUrl}>{row.name}</a></td><td>{row[locale]}</td></tr>)}</tbody>;
            })}
          </table>
        </div>
        <h3>{zh ? "多项基准中反复出现的四种现象" : "Four recurring patterns across benchmarks"}</h3>
        <div class="loc-case">
          {patterns.map(item => <div><h4>{item.title[locale]}</h4><p>{item.body[locale]}</p></div>)}
        </div>
      </section>

      <section id="models">
        <h2>{zh ? "模型与配置" : "Models and configurations"}</h2>
        <p>{zh ? "以下列出受测模型的完整版本与公开发布日期。各项评测使用不同任务与指标，不能合并为模型综合排名。" : "The model versions and release dates appear below. The evaluations use different tasks and metrics and do not form an overall ranking."}</p>
        <ul class="loc-profile-list">
          {modelProfiles.map(({ id, name, color, text }, i) => {
            const model = reportModels[i];
            const date = releaseDateFormatter.format(new Date(model.date));
            const release = model.label[locale];
            return <li style={`--model-color:${color}`}>
              <div class="loc-profile-id">
                <span><img src={`/nuwa/research/loc-assets/model-${id}.svg`} width="26" height="26" alt="" loading="lazy" /></span>
                <div>
                  <h3>{name}</h3>
                  <p>{model.name}</p>
                  <a class="loc-model-release" href={model.source} aria-label={zh ? `${model.name}，${release}于 ${date}，查看来源` : `${model.name}, ${release} ${date}, source`}>
                    {release} <time datetime={model.date}>{date}</time>
                  </a>
                </div>
              </div>
              <p>{text[locale]}</p>
            </li>;
          })}
        </ul>
      </section>

      <section id="cite">
        <h2>{zh ? "报告与引用" : "Report and citation"}</h2>
        <p>{reportSummary[locale]}</p>
        <p class="loc-authors"><strong>{zh ? "作者" : "Authors"}</strong> {reportAuthors.join(" · ")}</p>
        <div class="loc-citation">
          <div><strong>BibTeX</strong> <button type="button" hidden data-copy-cite data-idle={zh ? "复制" : "Copy"} data-done={zh ? "已复制" : "Copied"} data-fallback={zh ? "请选择文本复制" : "Select text to copy"}>{zh ? "复制" : "Copy"}</button></div>
          <pre tabindex="0"><code id="loc-bibtex">{bibtex}</code></pre>
        </div>
      </section>
    </article>
  </div>
  <dialog id="loc-zoom" class="loc-zoom" aria-label={zh ? "查看原图" : "View the full figure"}>
    <form method="dialog"><button type="submit" autofocus>{zh ? "关闭" : "Close"} <span aria-hidden="true">×</span></button></form>
    <figure><img alt="" /><figcaption></figcaption></figure>
  </dialog>
</BaseLayout>

<script>
  function init() {
    const button = document.querySelector<HTMLButtonElement>("[data-copy-cite]");
    if (!button || button.dataset.ready) return;
    button.dataset.ready = "1";
    button.hidden = false;
    button.addEventListener("click", async () => {
      const citation = document.getElementById("loc-bibtex")!;
      try {
        await navigator.clipboard.writeText(citation.textContent ?? "");
        button.textContent = button.dataset.done!;
      } catch {
        const selection = window.getSelection();
        selection?.selectAllChildren(citation);
        button.textContent = button.dataset.fallback!;
      }
    });
  }
  init();
  document.addEventListener("astro:page-load", init);

  const revealAnchor = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    document.getElementById(id)?.closest("details")?.setAttribute("open", "");
  };
  revealAnchor();
  window.addEventListener("hashchange", revealAnchor);

  document.addEventListener("click", event => {
    if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = (event.target as Element).closest<HTMLAnchorElement>("[data-loc-zoom]");
    const dialog = document.querySelector<HTMLDialogElement>("#loc-zoom");
    const figure = link?.closest("figure");
    if (!link || !figure || typeof dialog?.showModal !== "function") return;
    event.preventDefault();
    const image = dialog.querySelector("img")!;
    image.src = link.href;
    image.alt = figure.querySelector("img")?.alt ?? "";
    const caption = figure.querySelector("figcaption")?.cloneNode(true) as HTMLElement;
    caption.querySelectorAll("a").forEach(anchor => anchor.remove());
    dialog.querySelector("figcaption")!.textContent = caption.textContent?.trim() ?? "";
    dialog.showModal();
  });
</script>

<style>
  .loc-hero { position: relative; padding: clamp(2rem, 5vw, 4.25rem) 0 2.5rem; text-align: center; background: radial-gradient(ellipse at 21% 8%, #dce9f6, transparent 54%), radial-gradient(ellipse at 80% 16%, #d9eeea, transparent 55%), #f7f8fa; }
  .loc-hero .site-container { max-width: min(1128px, 100%); }
  .loc-report-brand, .loc-seals { display: flex; align-items: center; justify-content: center; gap: .65rem; }
  .loc-report-brand { margin-bottom: 1.25rem; flex-wrap: wrap; }
  .loc-seals { border-inline-start: 1px solid var(--wz-hairline); padding-inline-start: .65rem; }
  .loc-seals img { object-fit: contain; }
  .loc-back { display: inline-flex; align-items: center; gap: .5rem; color: var(--nw-deep-jade); font-size: .9rem; }
  .loc-hero .eyebrow, .loc-body .eyebrow { color: var(--nw-deep-jade); }
  h1 { max-width: 25ch; margin: .45rem auto; font-size: clamp(2rem, 5vw, 4.45rem); line-height: 1.07; letter-spacing: -.045em; font-weight: 640; color: var(--wz-ink); text-wrap: balance; }
  .loc-title-zh { max-width: none; font-size: clamp(2rem, 4.8vw, 4.3rem); }
  .loc-title-zh span { display: inline-block; }
  .loc-subtitle { font-weight: 560; color: var(--nw-deep-jade); font-size: clamp(1.05rem, 2vw, 1.3rem); }
  .loc-scope { max-width: 720px; margin: 1rem auto 0; line-height: 1.7; color: var(--wz-body); }
  .loc-actions { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: .65rem; margin-block: 1.35rem 0; }
  .loc-resource { gap: .5rem; min-height: 44px; }
  .loc-resource svg { flex: none; }
  .loc-resource[aria-disabled="true"] { background: #f4f6f7; border-color: #d6dfe5; color: var(--wz-muted); cursor: default; transform: none; box-shadow: none; }
  .loc-resource small { padding-inline-start: .45rem; border-inline-start: 1px solid #ccd6dc; font-size: .73em; }
  .loc-hf-icon { font-size: 1.15em; line-height: 1; }
  @media (max-width: 390px) {
    .loc-actions { flex-direction: column; }
    .loc-resource { max-width: 100%; }
  }
  .loc-models { display: flex; flex-direction: column; align-items: center; gap: .65rem; margin-top: 1.6rem; }
  .loc-models p, .loc-authors strong { color: var(--wz-ink); font-weight: 640; }
  .loc-models ul { display: flex; flex-wrap: wrap; justify-content: center; gap: .55rem 1.5rem; max-width: 680px; margin: 0; padding: 0; list-style: none; }
  .loc-models li { display: inline-flex; align-items: center; gap: .5rem; font-size: .94rem; font-weight: 560; text-align: start; min-width: 0; }
  .loc-models li > span { min-width: 0; overflow-wrap: anywhere; }
  .loc-models li img { flex: none; filter: grayscale(1) opacity(.65); }
  .loc-models li:hover img { filter: none; }
  .loc-authors { margin-top: .6rem; font-size: .87rem; }
  .loc-layout { display: grid; grid-template-columns: 190px minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); padding-block: clamp(2.25rem, 5vw, 4.25rem); }
  .loc-toc nav { position: sticky; top: 112px; display: grid; gap: .375rem; }
  .loc-toc h2 { font-size: .95rem; font-weight: 630; margin-bottom: .3rem; }
  .loc-toc a { display: block; padding: .2rem 0; font-size: .9rem; color: var(--nw-deep-jade); }
