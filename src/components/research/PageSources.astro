---
import {collectPageSources,citationDisplay,citationAuthors} from '../../lib/researchCitations.mjs';
import type {Locale} from '../../i18n/config';
interface Reference {sourceId?:string;url?:string;title?:string;version?:string;locator?:string;appliesTo?:string|string[]}
interface Props {locale:Locale;references:Reference[];sources?:any[];numerical?:boolean;compact?:boolean}
const {locale,references,sources=[],numerical=false}=Astro.props;
const entries=collectPageSources(references,sources).map(e=>({...e,authors:citationAuthors(e.authors),display:citationDisplay(e,locale)})),en=locale==='en';
const linkName=(kind:string)=>({pdf:'PDF',doi:'DOI',arxiv:'arXiv',web:en?'Web':'网页'}[kind]??kind);
---
{entries.length>0&&<section class="research-sources" id="research-sources" data-page-sources><h2>{en?'References':'参考文献'}</h2>{numerical&&entries.length===1&&<p class="research-sources__intro">{en?'Numerical results are reported by the cited authors.':'数值结果由所引研究的作者报告。'}</p>}<ol>{entries.map((e,index)=><li id={e.id} data-citation-key={e.key} data-source-ids={e.sourceIds.join(' ')}>{e.anchorAliases.map(id=><span id={id} class="citation-alias"/>)}<span class="research-sources__number" data-citation-number>[{index+1}]</span>{' '}{e.authors.length>0&&<span>{e.authors.slice(0,2).join(', ')}{e.authors.length>2?(en?', et al.':' 等'):''}. </span>}<a href={e.url} target="_blank" rel="noreferrer">{e.title}</a>{e.dates.length>0&&<span class="research-sources__date">. {e.dates.length===1?e.dates[0].value:e.dates.map(d=>`${d.role==='report-date'?(en?'Report':'报告'):d.role==='web-publication'?(en?'Web':'网页'):''} ${d.value}`.trim()).join(' / ')}</span>}{e.display.versions&&<span>. {e.display.versions}</span>}<span class="research-sources__links">{' '}{e.links.filter(l=>l.url!==e.url).map((l,i)=><>{i>0&&' · '}<a href={l.url} target="_blank" rel="noreferrer">[{linkName(l.kind)}]</a></>)}</span>{e.display.locations&&<span class="research-sources__locations">; {e.display.locations}</span>}<span class="research-sources__separator" aria-hidden="true">； </span></li>)}</ol></section>}
<style is:global>
.research-sources{margin:40px 0 0;padding:20px 0 8px;scroll-margin-top:110px;max-width:1100px;color:#455a62}.research-sources h2{font-size:20px;font-weight:550;margin:0 0 12px;letter-spacing:-.02em}.research-sources__intro{font-size:13px!important;line-height:1.7!important;margin:0 0 10px!important}.research-sources ol{list-style:none;padding:0;margin:0;line-height:1.85;font-size:13px}.research-sources li{display:inline;padding:0;margin:0;overflow-wrap:anywhere;scroll-margin-top:110px}.research-sources li>a{font-size:inherit;color:#21685e;text-decoration:underline;text-underline-offset:3px}.research-sources__number{color:#263b4a;font-variant-numeric:tabular-nums;font-weight:550}.research-sources__links a{color:#21685e;white-space:nowrap}.research-sources__locations{color:#53656c}.citation-alias{scroll-margin-top:110px}.research-sources li:last-child .research-sources__separator{display:none}@media(max-width:600px){.research-sources{margin-top:28px}.research-sources li{display:block;margin:0 0 8px}.research-sources__separator{display:none}}
</style>
