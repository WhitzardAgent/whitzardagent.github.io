---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { Locale } from "../../i18n/config";
import { localizedPath } from "../../i18n/config";
import type { ResearchCopy } from "../../i18n/pages/research";
import { researchAssets } from "../../data/generated/researchAssets";
import { researchInfrastructure } from "../../data/generated/researchInfrastructure";
import { researchRecognitions } from "../../data/researchRecognitions";
import { researchVisuals } from "../../data/researchVisuals";
import { links } from "../../data/links";
import ResearchExplorer from "./ResearchExplorer";
import PublicImpactPath from "./PublicImpactPath.astro";
import ResearchMission from "./ResearchMission.astro";
import ResearchBlogPreview from "./ResearchBlogPreview.astro";
import "../../styles/research.css";

interface Props { locale: Locale; copy: ResearchCopy["research"] }
const { locale, copy } = Astro.props;
const sorted = [...researchAssets].sort((a, b) => b.year - a.year || a.title.localeCompare(b.title));
const featured = researchAssets.filter((item) => item.featuredRank).sort((a, b) => (a.featuredRank ?? 99) - (b.featuredRank ?? 99));
const featuredPrimary = featured[0];
const featuredEvidence = featured[1];
const featuredCards = featured.slice(2).map((item) => ({ item, visual: researchVisuals.find((visual) => visual.researchSlug === item.slug) }));
const primaryLink = (item: typeof researchAssets[number]) => item.links.find((link) => link.kind === "paper")?.url ?? item.links[0].url;
const researcherNames = locale === "zh"
  ? { "jiarun-dai": "戴嘉润", "xudong-pan": "潘旭东", "geng-hong": "洪赓" }
  : { "jiarun-dai": "Jiarun Dai", "xudong-pan": "Xudong Pan", "geng-hong": "Geng Hong" };
const researchers = [
  { slug: "jiarun-dai", name: researcherNames["jiarun-dai"], role: locale === "zh" ? "联合创始人、CEO" : "Co-founder & CEO", focus: locale === "zh" ? "智能系统与软件系统安全" : "Intelligent systems and software security", url: "https://djrrr.github.io/" },
  { slug: "xudong-pan", name: researcherNames["xudong-pan"], role: locale === "zh" ? "联合创始人、CTO" : "Co-founder & CTO", focus: locale === "zh" ? "前沿 AI 风险、模型与智能体安全" : "Frontier AI risk, model and agent safety", url: "https://ravensanstete.github.io/en/" },
  { slug: "geng-hong", name: researcherNames["geng-hong"], role: locale === "zh" ? "战略与研究合作伙伴" : "Strategic & research partner", focus: locale === "zh" ? "网络犯罪、隐私与真实世界安全" : "Cybercrime, privacy, and in-the-wild security", url: "https://ghong.site/" },
] as const;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "ResearchOrganization", name: locale === "zh" ? "女娲实验室" : "NUWA Frontier AI Safety Lab", alternateName: locale === "zh" ? ["NUWA", "NUWA Frontier AI Safety Lab"] : ["NUWA", "女娲实验室"], url: `https://whitzard.tech${localizedPath("/nuwa/research", locale)}` },
    ...featured.map((item) => ({ "@type": "ScholarlyArticle", headline: item.title, author: item.authors.map((name) => ({ "@type": "Person", name })), datePublished: String(item.year), url: primaryLink(item), about: item.topics[locale] })),
  ],
};
---

<BaseLayout title={copy.meta.title} description={copy.meta.description} locale={locale} brand="nuwa" canonicalPath="/nuwa/research" schema={schema}>
  <section class="research-hero">
    <div class="site-container research-hero__grid">
      <img class="research-hero__logo" src="/assets/logo/nvwa_logo.png" width="112" height="112" alt={locale === "zh" ? "女娲实验室标识" : "NUWA logo"} />
      <div class="research-hero__content"><p class="eyebrow">{copy.eyebrow}</p><h1>{copy.title}</h1><p>{copy.lead}</p><div class="research-hero__actions"><a class="button button--primary" href={localizedPath("/nuwa/blog", locale)}>Research Blog</a><a class="button button--secondary" href={localizedPath("/nuwa/whitzard-index", locale)}>{locale === "zh" ? "白泽指数" : "Whitzard Index"}</a></div></div>
    </div>
  </section>

  <ResearchMission locale={locale} />

  <section id="featured" class="section research-featured">
    <div class="site-container research-section-head"><p class="eyebrow">{locale === "zh" ? "代表成果" : "FEATURED WORK"}</p><h2>{copy.featured}</h2><p>{copy.featuredLead}</p></div>
    <div class="site-container research-featured__editorial">
      {featuredPrimary && <article class="research-featured__primary">
        <div class="research-meta"><span>01</span><span>{featuredPrimary.year}</span><span>{featuredPrimary.venue}</span>{featuredPrimary.pages && <span>{featuredPrimary.pages}</span>}</div>
        <h3>{featuredPrimary.title}</h3><p>{featuredPrimary.summary[locale]}</p><p class="research-authors">{featuredPrimary.authors.join(" · ")}</p><a href={primaryLink(featuredPrimary)} target="_blank" rel="noreferrer">{copy.source} ↗</a>
      </article>}
      {featuredEvidence && <article class="research-featured__evidence">
        <div class="research-meta"><span>02</span><span>{featuredEvidence.year}</span><span>{featuredEvidence.venue}</span></div><h3>{featuredEvidence.title}</h3><p>{featuredEvidence.summary[locale]}</p><a href={primaryLink(featuredEvidence)} target="_blank" rel="noreferrer">{copy.source} ↗</a>
      </article>}
      <div class="research-featured__visuals">{featuredCards.map(({ item, visual }, index) => visual ? <figure>
        <a href={visual.sourcePdfUrl} target="_blank" rel="noreferrer"><picture><source type="image/webp" srcset={`${visual.assetPath.replace(".png", "-640.webp")} 640w, ${visual.assetPath.replace(".png", ".webp")} ${index === 0 ? 1030 : 1235}w`} sizes="(max-width: 640px) 100vw, (max-width: 900px) 45vw, 34vw" /><img src={visual.assetPath} width={index === 0 ? 1030 : 1235} height={index === 0 ? 1120 : 750} alt={visual.alt[locale]} loading="lazy" decoding="async" /></picture></a>
        <figcaption><div class="research-meta"><span>0{index + 3}</span><span>{item.year}</span><span>{visual.figureLabel} · PDF p.{visual.page}</span></div><h3>{item.title}</h3><p>{visual.caption[locale]}</p><a href={visual.sourcePdfUrl} target="_blank" rel="noreferrer">{copy.source} ↗</a></figcaption>
      </figure> : <article class="research-featured__text-card">
        <div class="research-meta"><span>0{index + 3}</span><span>{item.year}</span><span>{item.venue}</span></div>
        <div><p class="research-featured__monogram" aria-hidden="true">MG</p><h3>{item.title}</h3><p>{item.summary[locale]}</p><p class="research-authors">{item.authors.join(" · ")}</p></div>
        <div class="research-featured__links"><a href={primaryLink(item)} target="_blank" rel="noreferrer">{copy.linkLabels.paper} ↗</a>{item.links.filter((link) => link.kind === "project" || link.kind === "code").map((link) => <a href={link.url} target="_blank" rel="noreferrer">{copy.linkLabels[link.kind]} ↗</a>)}</div>
      </article>)}</div>
    </div>
  </section>

  <ResearchBlogPreview locale={locale} />

  <section id="infrastructure" class="section research-infrastructure">
    <div class="site-container research-section-head"><p class="eyebrow">{copy.infrastructure.eyebrow}</p><h2>{copy.infrastructure.title}</h2><p>{copy.infrastructure.lead}</p></div>
    <div class="site-container research-infrastructure__grid">{researchInfrastructure.map((item, index) => <article>
      <div class="research-infrastructure__meta"><span>{String(index + 1).padStart(2, "0")}</span><span>{item.type[locale]}</span></div>
      <h3>{item.name}</h3><p>{item.description[locale]}</p>
      <a href={item.websiteUrl} target="_blank" rel="noreferrer">{item.linkLabel[locale]} ↗</a>
    </article>)}</div>
  </section>

  <PublicImpactPath locale={locale} />

  <section id="recognition" class="section research-recognition">
    <div class="site-container research-section-head"><p class="eyebrow">{copy.recognitionEyebrow}</p><h2>{copy.recognitionTitle}</h2></div>
    <div class="site-container research-recognition__list">{researchRecognitions.map((item) => <article><span>{item.year}</span><div><h3>{item.title[locale]}</h3>{item.venueNote && <p>{item.venueNote[locale]}</p>}</div><a href={item.sourceUrl} target="_blank" rel="noreferrer">{copy.source} ↗</a></article>)}</div>
  </section>

  <section id="research-index" class="section research-index">
    <div class="site-container research-section-head"><p class="eyebrow">{locale === "zh" ? "出版物" : "PUBLICATIONS"}</p><h2>{copy.all}</h2></div>
    <div class="site-container"><ResearchExplorer assets={sorted} locale={locale} copy={{ filters: copy.filters, linkLabels: copy.linkLabels, source: copy.source }} themes={copy.areas.map(({ key, title }) => ({ key, title }))} members={researchers.map(({ slug, name }) => ({ key: slug, title: name }))} client:load /></div>
  </section>

  <section id="collaboration" class="section research-collaboration"><div class="site-container"><p class="eyebrow">{locale === "zh" ? "研究合作" : "COLLABORATION"}</p><h2>{copy.collaborationTitle}</h2><p>{copy.collaborationBody}</p><a class="button button--primary" href={`mailto:${links.email}?subject=${encodeURIComponent(locale === "zh" ? "女娲实验室研究合作" : "NUWA research collaboration")}`} data-umami-event="research-collaboration-click">{copy.collaborationCta}</a></div></section>
</BaseLayout>
