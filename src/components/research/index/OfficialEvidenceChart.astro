---
import type {OfficialObservation,SourceUnit} from '../../../data/nuwa-index/sourceIntelligence';
import type {Locale} from '../../../i18n/config';
import {localizedPath} from '../../../i18n/config';
import {indexBase} from '../../../data/nuwa-index';
interface Props{unit:SourceUnit;records:OfficialObservation[];locale:Locale}
const{unit,records,locale}=Astro.props,en=locale==='en',base=localizedPath(indexBase,locale);
const metrics=[...new Set(records.map(r=>r.metric))],tasks=[...new Set(records.map(r=>r.taskSet))];
const defaultTask=unit.id==='cybergym-official'?'level1':unit.id==='secbench-pro-official'?'260617 / overall':tasks[0];
const defaultMetric=unit.id==='secbench-pro-official'?'headline':metrics[0];
const initial=records.filter(r=>r.metric===defaultMetric&&r.taskSet===defaultTask);
import {officialContext,officialSvg,officialMobile,officialTable} from '../../../lib/nuwa-intelligence/officialCharts.mjs';
---
<nuwa-official-chart class="oc" data-locale={locale} data-base={base} data-default-task={defaultTask} data-default-metric={defaultMetric}>
 <div class="oc-heading"><h2>{en?'Evaluation results':'评测结果'}</h2></div>
 <div class="oc-controls" hidden><label hidden={metrics.length<2}>{en?'Metric':'指标'}<select name="metric">{metrics.map(m=><option value={m}>{records.find(r=>r.metric===m)!.label[locale]}</option>)}</select></label><label>{en?'Task set / version':'任务集／版本'}<select name="taskSet">{tasks.map(t=><option value={t}>{t}</option>)}</select></label></div><details class="oc-more" hidden><summary>{en?'Filter systems and configurations':'筛选系统与配置'}</summary><div class="oc-controls oc-controls--extra"><label>{en?'Search systems':'搜索系统'}<input name="system" type="search"/></label><label>{en?'Configuration':'运行配置'}<select name="configuration"><option value="">{en?'All reported configurations':'全部报告配置'}</option>{[...new Set(records.map(r=>`${r.harness??'Unknown'} · ${r.budget??'Budget not specified'} · ${r.trials??'?'} trials`))].map(c=><option value={c}>{c}</option>)}</select></label></div></details>
 <p class="oc-source">{en?'Reported by':'数据报告方'}: <strong>{unit.reporter}</strong> · {en?'Executed by':'实际执行方'}: {unit.executor??(en?'Not established for every submission':'各提交的执行方未完整确定')} · {en?'Captured':'抓取时间'}: {unit.capturedAt?.slice(0,10)??(en?'Not established':'未确定')}</p>
 <p class="oc-note">{unit.limits[locale]}</p>
 <div class="oc-actions" hidden><button type="button" data-display="chart">{en?'Chart':'图表'}</button><button type="button" data-display="table">{en?'Table':'表格'}</button><button type="button" data-all>{en?'Show all systems':'显示全部系统'}</button><button type="button" data-download="csv">CSV ↓</button><button type="button" data-download="svg">SVG ↓</button></div>
 <p class="oc-count" aria-live="polite">{en?`${Math.min(12,initial.length)} of ${initial.length} systems shown in source order`:`图表按来源顺序展示 ${Math.min(12,initial.length)}／${initial.length} 个系统`}</p>
 <h3 class="oc-metric-title">{officialContext(initial,locale)}</h3>
 <div class="oc-plot"><div class="oc-svg" set:html={officialSvg(initial.slice(0,12),locale,base,unit.title)}></div><div class="oc-mobile" set:html={officialMobile(initial.slice(0,12),locale,base)}></div></div>
 <div class="oc-table" set:html={officialTable(records,locale,base)}></div>
 <script is:inline type="application/json" data-records set:html={JSON.stringify(records).replaceAll('<','\u003c')}/>
</nuwa-official-chart>
<script>
import {embedSvgMarks} from '../../../lib/svgAssets';
import {officialContext,officialSvg,officialMobile,officialTable,officialCsv,filterOfficialRecords,readOfficialState,writeOfficialState} from '../../../lib/nuwa-intelligence/officialCharts.mjs';
class OfficialChart extends HTMLElement{
 controller?:AbortController;
 connectedCallback(){this.controller?.abort();this.controller=new AbortController();const{signal}=this.controller,records=JSON.parse(this.querySelector('[data-records]')!.textContent!),prefix=this.dataset.defaultMetric==='headline'?'sec':this.dataset.defaultMetric==='score_10'?'cyber':'exploit';let state=readOfficialState(location.search,prefix,{taskSet:this.dataset.defaultTask!,metric:this.dataset.defaultMetric!});const en=this.dataset.locale==='en',base=this.dataset.base!,inputs=[...this.querySelectorAll<HTMLInputElement|HTMLSelectElement>('input[name],select[name]')];
 const draw=()=>{inputs.forEach(i=>i.value=String(state[i.name as keyof typeof state]??''));const selected=filterOfficialRecords(records,state),shown=state.all?selected:selected.slice(0,12);this.querySelector('.oc-metric-title')!.textContent=officialContext(selected,this.dataset.locale);this.querySelector('.oc-svg')!.innerHTML=officialSvg(shown,this.dataset.locale,base,'Source-reported evidence');this.querySelector('.oc-mobile')!.innerHTML=officialMobile(shown,this.dataset.locale,base);this.querySelector('.oc-table')!.innerHTML=officialTable(selected,this.dataset.locale,base);(this.querySelector('.oc-plot') as HTMLElement).hidden=state.display==='table';(this.querySelector('.oc-table') as HTMLElement).hidden=state.display!=='table';this.querySelector('.oc-count')!.textContent=en?`${shown.length} of ${selected.length} systems shown in source order`:`图表按来源顺序展示 ${shown.length}／${selected.length} 个系统`;this.querySelector('[data-all]')!.textContent=state.all?(en?'Show first 12':'显示前12项'):(en?'Show all systems':'显示全部系统');this.querySelectorAll<HTMLButtonElement>('[data-display]').forEach(b=>b.setAttribute('aria-pressed',String(state.display===b.dataset.display)));};
 const save=()=>{history.pushState(null,'',`${location.pathname}?${writeOfficialState(location.search,prefix,state)}${location.hash}`);draw();};
 this.querySelectorAll<HTMLElement>('.oc-controls,.oc-actions,.oc-more').forEach(e=>e.hidden=false);inputs.forEach(i=>i.addEventListener(i.tagName==='INPUT'?'input':'change',()=>{state={...state,[i.name]:i.value};save();},{signal}));this.querySelectorAll<HTMLButtonElement>('[data-display]').forEach(b=>b.addEventListener('click',()=>{state.display=b.dataset.display!;save();},{signal}));this.querySelector('[data-all]')!.addEventListener('click',()=>{state.all=!state.all;save();},{signal});
 this.querySelectorAll<HTMLButtonElement>('[data-download]').forEach(b=>b.addEventListener('click',async()=>{const selected=filterOfficialRecords(records,state),svg=b.dataset.download==='svg',content=svg?await embedSvgMarks(officialSvg(selected,this.dataset.locale,base,'Source-reported evidence')):officialCsv(selected),url=URL.createObjectURL(new Blob([content],{type:svg?'image/svg+xml':'text/csv;charset=utf-8'})),a=document.createElement('a');a.href=url;a.download=`nuwa-${prefix}.${svg?'svg':'csv'}`;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);},{signal}));window.addEventListener('popstate',()=>{state=readOfficialState(location.search,prefix,{taskSet:this.dataset.defaultTask!,metric:this.dataset.defaultMetric!});draw();},{signal});draw();}
 disconnectedCallback(){this.controller?.abort();}
}
if(!customElements.get('nuwa-official-chart'))customElements.define('nuwa-official-chart',OfficialChart);
</script>
<style is:global>
.oc{display:block;margin:18px 0}.oc-heading>p:first-child{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#397164}.oc h2{font-size:25px;margin:8px 0}.oc-heading>p{max-width:900px;line-height:1.8;color:#4b626b}.oc-controls{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:12px 0}.oc-controls label{display:grid;gap:8px;font-size:13px;color:#34594e}.oc-controls select,.oc-controls input{width:100%;min-width:0;background:#fff;border:1px solid #b3c7be;padding:11px;border-radius:4px;font:inherit}.oc-source{font-size:13px;line-height:1.8;color:#365c50}.oc-note{font-size:14px;line-height:1.8;color:#52676b;max-width:960px}.oc-more summary{cursor:pointer;font-size:13px;color:#285d50;padding:12px 0}.oc-controls--extra{margin:8px 0 22px}.oc-actions{display:flex;flex-wrap:wrap;gap:9px;margin:14px 0}.oc-actions button{font:inherit;font-size:13px;border:1px solid #afc6bc;background:#fff;padding:9px 13px;cursor:pointer;border-radius:4px}.oc-actions button[aria-pressed=true]{background:#143b3d;color:#fff}.oc-metric-title{font-size:16px;font-weight:500;line-height:1.7;margin:12px 0}.oc-count{font-size:12px;color:#536963}.oc-plot{width:100%;background:#fafcf9;border:1px solid #cfddd5;padding:18px}.oc-plot svg{display:block;width:100%;height:auto}.oc-mobile{display:none}.oc-mobile ol{list-style:none;padding:0;margin:0}.oc-mobile li{padding:17px 9px;border-bottom:1px solid #dce5df}.oc-mobile li>div:first-child{display:flex;gap:14px;align-items:start;justify-content:space-between;font-size:13px;line-height:1.7}.oc-mobile a{overflow-wrap:anywhere;color:#244c55}.oc-mobile strong{white-space:nowrap;color:#164b3e}.oc-mobile small{display:block;font-size:11px;line-height:1.7;color:#49645b;margin-top:7px;overflow-wrap:anywhere}.oc-mobile-track{height:9px;background:#e4ede7;margin-top:9px}.oc-mobile-track span{height:100%;display:block;background:#307c6c}.oc-table{max-height:640px;overflow:auto;border:1px solid #d0ded4;margin:18px 0}.oc-table table{border-collapse:collapse;width:100%;font-size:13px}.oc-table th,.oc-table td{padding:13px;text-align:left;border-bottom:1px solid #dce5df;vertical-align:top;min-width:105px}.oc-table th:first-child{min-width:230px;max-width:340px}.oc-table thead{position:sticky;top:0;background:#edf3ed}.oc-table small{display:block;line-height:1.7;color:#4d645f;margin-top:6px}.oc-table a{color:#174e63}.oc-controls [hidden],.oc [hidden]{display:none!important}.oc-mobile [hidden]{display:none}@media(max-width:700px){.oc-svg{display:none}.oc-mobile{display:block}.oc-controls{grid-template-columns:1fr}.oc-plot{padding:4px}.oc h2{font-size:26px}}
</style>
