---
import type {Locale} from '../../../i18n/config';
import {localizedPath} from '../../../i18n/config';
import {catalogue,indexBase} from '../../../data/nuwa-index';
import {frameworkRelationships,frameworkResearchQuery} from '../../../lib/frameworkRelationships.mjs';
interface Props {locale:Locale}
const {locale}=Astro.props,en=locale==='en',model=frameworkRelationships(catalogue),base=localizedPath(indexBase,locale);
const T=(a:string,b:string)=>en?a:b;
const dimensions=[{id:'propensity',label:T('Propensity','行为倾向'),body:T('A tendency to respond or act in specified conditions.','在规定条件下作出某类回答或行动的倾向。'),query:'dimension=propensity',works:['aisi-propensity-study']},{id:'capability',label:T('Capability','任务能力'),body:T('Tasks achievable with given tools, resources and permissions.','给定工具、资源和权限下能够完成的任务。'),query:'dimension=capability',works:['time-horizons']},{id:'behavior',label:T('Behavior','可观察行为'),body:T('Outputs, decisions and actions observed in a particular setting.','具体情境中观察到的输出、决策与行动。'),query:'dimension=behavior',works:['agentic-misalignment']},{id:'swarm',label:T('Multi-agent dynamics','多智能体效应'),body:T('Coordination, collusion, propagation and collective failures depend on the system configuration.','协同、串谋、传播与集体失效取决于多智能体系统的具体配置。'),query:'scenario=multi-agent',works:['hugging-face-incident']}];
const nodes=[...dimensions.map(n=>({...n,works:n.works.map(id=>catalogue.works.find(w=>w.id===id)).filter((w):w is NonNullable<typeof w>=>Boolean(w)),href:`${base}/?view=research&${n.query}`})),...model.mechanisms.map(m=>({...m,label:m.label[locale],body:m.id==='autonomy'?T('Persistence and proliferation may change the reach and duration of actions across risk domains.','持续行动与扩散可能改变各风险领域中行动的范围和时长。'):T('Concealment and oversight evasion may make harmful activity harder to detect or interrupt.','隐蔽与监督规避可能增加识别或中止有害活动的难度。'),href:`${base}/risk/${m.id}/`})),...model.domains.map(a=>({id:a.id,label:a.label[locale],body:a.scope[locale],works:catalogue.works.filter(w=>w.areas.includes(a.id)).slice(0,2),href:`${base}/risk/${a.id}/`})),...model.capabilities.map(c=>({...c,label:c.id==='science'?T('AI for Science','科学研究'):c.id==='content'?T('Content generation','内容生成'):c.label[locale],body:T('An enabling capability shared by beneficial and risk-relevant applications. The linked studies explain the measured scope.','可用于有益应用及风险相关任务的使能能力；关联研究说明实际测量范围。'),href:`${base}/?${frameworkResearchQuery(c.works[0])}`}))];
---
<nuwa-framework class="nf-framework" data-source-ids={[...new Set(nodes.flatMap(n=>n.works.map(w=>w.sourceId)))].join(' ')}>
 <header class="nf-heading"><div><p>NUWA Framework</p><h2 id="nm-mechanism-title">{T('How frontier AI risk emerges','前沿 AI 风险的形成机制')}</h2></div><p>{T('Behavior formation, agentic mechanisms and dual-use applications in one research model.','连接行为形成、主体性机制与两用风险领域的研究模型。')}</p></header>
 <svg class="nf-diagram" viewBox="0 0 1240 530" role="group" aria-labelledby="nf-title nf-description">
  <title id="nf-title">{T('NUWA frontier risk framework','NUWA 前沿风险研究框架')}</title><desc id="nf-description">{T('Propensity and capability inform observed behavior under external conditions. Autonomy and deception connect across four dual-use risk domains. Enabling capabilities and multi-agent dynamics extend these relationships. Select a node for its definition and evidence.','外部条件下，行为倾向与任务能力共同影响可观察行为。自主性与欺骗关联四个两用风险领域，使能能力与多智能体效应扩展这些关系。选择节点可查看定义和研究依据。')}</desc>
  <defs><marker id="nf-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M1 1L9 5L1 9" fill="none" stroke="context-stroke" stroke-width="1.5"/></marker></defs>
  <rect x="1" y="1" width="421" height="528" rx="12" class="nf-condition-field"/>
  <text x="28" y="38" class="nf-layer">{T('BEHAVIOR FORMATION','行为形成')}</text><text x="28" y="66" class="nf-context">{T('Environment · Instructions · Harness','环境 · 指令 · Harness')}</text><text x="28" y="87" class="nf-context">{T('Permissions · Safeguards','权限 · 防护措施')}</text>
  <g class="nf-flow" aria-hidden="true"><path d="M110 191V218Q110 236 128 236H208V265"/><path d="M310 191V218Q310 236 292 236H208" class="nf-link"/><path d="M208 332V390" stroke-dasharray="5 5"/><path d="M378 298H453"/></g>
  {dimensions.slice(0,2).map((n,i)=><a href={`${base}/?view=research&${n.query}`} data-framework-node={n.id} aria-label={n.label}><rect x={28+i*200} y="128" width="172" height="63" rx="31"/><text x={114+i*200} y="165" text-anchor="middle">{n.label}</text></a>)}
  <a href={`${base}/?view=research&dimension=behavior`} data-framework-node="behavior"><rect x="45" y="265" width="333" height="67" rx="8"/><text x="211" y="306" text-anchor="middle">{T('Behavior','可观察行为')}</text></a>
  <a href={`${base}/?view=research&scenario=multi-agent`} data-framework-node="swarm"><rect x="28" y="390" width="372" height="105" rx="8" class="nf-optional"/><text x="214" y="431" text-anchor="middle">{T('Multi-agent dynamics','多智能体效应')}</text><text x="214" y="458" text-anchor="middle" class="nf-context">{T('Coordination · Collusion · Collective failure','协同 · 串谋 · 集体失效')}</text></a>
  <text x="470" y="38" class="nf-layer">{T('AGENTIC MECHANISMS','主体性机制')}</text>
  {model.mechanisms.map((m,i)=><a href={`${base}/risk/${m.id}/`} data-framework-node={m.id} data-framework-mechanism={m.id}><rect x={470+i*388} y="60" width="358" height="65" rx="8"/><text x={649+i*388} y="100" text-anchor="middle">{m.label[locale]}</text></a>)}
  <g class="nf-flow nf-agentic-flow" aria-hidden="true"><path d="M649 125V198H1037" class="nf-link"/><path d="M1037 125V198" class="nf-link"/><path d="M649 198H556V263"/><path d="M556 198H749V263"/><path d="M749 198H942V263"/><path d="M942 198H1135V263"/></g>
  <text x="470" y="159" class="nf-context">{T('Persistence and proliferation','持续行动与扩散')}</text><text x="858" y="159" class="nf-context">{T('Concealment and oversight evasion','隐蔽与监督规避')}</text>
  <text x="470" y="242" class="nf-layer">{T('DUAL-USE RISK DOMAINS','两用风险领域')}</text>
  {model.domains.map((a,i)=><a href={`${base}/risk/${a.id}/`} data-framework-node={a.id}><rect x={470+i*193} y="263" width="172" height="81" rx="8"/><text x={556+i*193} y={a.id==='autonomous-physical-harm'?295:310} text-anchor="middle">{a.id==='autonomous-physical-harm'?T('Autonomous','自主物理伤害'):a.label[locale]}{a.id==='autonomous-physical-harm'&&en&&<tspan x={556+i*193} dy="22">physical harm</tspan>}</text></a>)}
  <g class="nf-flow" aria-hidden="true"><path d="M556 440V388H1135" class="nf-link"/><path d="M1135 440V388" class="nf-link"/><path d="M749 440V388" class="nf-link"/><path d="M942 440V388" class="nf-link"/><path d="M556 388V344"/><path d="M749 388V344"/><path d="M942 388V344"/><path d="M1135 388V344"/></g>
  <text x="470" y="423" class="nf-layer">{T('ENABLING CAPABILITIES','使能能力')}</text>
  {model.capabilities.map((c,i)=><a href={`${base}/?${frameworkResearchQuery(c.works[0])}`} data-framework-node={c.id}><rect x={470+i*193} y="440" width="172" height="62" rx="8"/><text x={556+i*193} y="476" text-anchor="middle">{c.id==='science'?T('AI for Science','科学研究'):c.id==='content'?T('Content generation','内容生成'):c.label[locale]}</text></a>)}
 </svg>
 <div class="nf-mobile-map">{[{title:T('Behavior formation','行为形成'),items:nodes.slice(0,4)},{title:T('Agentic mechanisms','主体性机制'),items:nodes.slice(4,6)},{title:T('Dual-use risk domains','两用风险领域'),items:nodes.slice(6,10)},{title:T('Enabling capabilities','使能能力'),items:nodes.slice(10)}].map(section=><section><h3>{section.title}</h3><div>{section.items.map(n=><a href={n.href} data-framework-node={n.id}>{n.label} <span>↗</span></a>)}</div></section>)}</div>
 <div class="nf-detail" aria-live="polite">{nodes.map(n=><section data-framework-detail={n.id} hidden={n.id!=='autonomy'}><div><p class="nf-detail-label">{T('RESEARCH SCOPE','研究范围')}</p><h3>{n.label}</h3><p>{n.body}</p><a class="nf-detail-link" href={n.href}>{T('Explore this research','查看相关研究')} →</a></div><div><p class="nf-detail-label">{T('RELATED EVIDENCE','关联证据')}</p>{n.works.map(w=><a class="nf-evidence" href={`${base}/work/${w.id}/`}>{w.title} <span>→</span></a>)}</div></section>)}</div>
 <p class="nf-boundary">{T('NUWA’s research model organizes relationships to be tested. Propensity is measured under stated conditions; domain-specific evidence determines which pathways are supported.','NUWA 研究模型组织有待检验的关系；行为倾向在规定条件下测量，具体风险路径由领域证据支持。')}</p>
 <div class="nf-topic-definitions">{catalogue.areas.map(a=><a href={`${base}/risk/${a.id}/`}><h3>{a.label[locale]} <span>↗</span></h3><p>{a.scope[locale]}</p></a>)}</div>
</nuwa-framework>
<script>
class NuwaFramework extends HTMLElement{controller?:AbortController;connectedCallback(){this.controller?.abort();this.controller=new AbortController();const {signal}=this.controller;const nodes=[...this.querySelectorAll<HTMLAnchorElement|SVGAElement>('[data-framework-node]')];const select=(id:string)=>{nodes.forEach(n=>n.setAttribute('aria-current',String(n.getAttribute('data-framework-node')===id)));this.querySelectorAll<HTMLElement>('[data-framework-detail]').forEach(d=>d.hidden=d.dataset.frameworkDetail!==id);};nodes.forEach(n=>n.addEventListener('click',e=>{if(e instanceof MouseEvent&&(e.metaKey||e.ctrlKey||e.shiftKey||e.altKey))return;e.preventDefault();select(n.getAttribute('data-framework-node')!);},{signal}));select('autonomy');}disconnectedCallback(){this.controller?.abort();}}
if(!customElements.get('nuwa-framework'))customElements.define('nuwa-framework',NuwaFramework);
</script>
<style is:global>
.nf-framework{display:block}.nf-heading{display:flex;justify-content:space-between;gap:40px;align-items:end;margin:28px 0 24px}.nf-heading>div>p,.nf-detail-label{color:#226c61;font-size:11px;font-weight:600;letter-spacing:.08em;margin:0 0 8px}.nf-heading h2{font-size:32px;letter-spacing:-.035em;line-height:1.2;margin:0}.nf-heading>p{max-width:420px;font-size:14px;line-height:1.7;color:#53616e;margin:0}.nf-diagram{display:block;width:100%;height:auto;overflow:visible;background:#fff;border:1px solid #e2e8e7;border-radius:12px;padding:16px}.nf-diagram text{font-family:var(--font-sans);font-size:16px;fill:#182d43;font-weight:500;pointer-events:none}.nf-diagram .nf-layer{font-size:11px;font-weight:600;letter-spacing:1px;fill:#58716f}.nf-diagram .nf-context{font-size:12px;fill:#58716f;font-weight:400}.nf-diagram a rect{fill:#fff;stroke:#bfcecb;transition:fill .18s,stroke .18s}.nf-diagram a[aria-current=true] rect{fill:#e6f3ed;stroke:#236e5f;stroke-width:2}.nf-diagram a:hover rect{fill:#f0f7f4;stroke:#317969}.nf-diagram a:focus-visible{outline:2px solid #132e5a;outline-offset:3px}.nf-diagram .nf-condition-field{fill:#f4f8f6;stroke:none}.nf-diagram .nf-optional{stroke-dasharray:5 4}.nf-flow{fill:none;stroke:#94aaa2;stroke-width:1.4;marker-end:url(#nf-arrow)}.nf-flow path{marker-end:url(#nf-arrow)}.nf-flow path.nf-link{marker-end:none}.nf-agentic-flow{stroke:#397c6c}.nf-detail{border-block:1px solid #dce5e0;margin-top:24px;padding:22px 0}.nf-detail>section{display:grid;grid-template-columns:1fr 1fr;gap:50px}.nf-detail>section[hidden]{display:none}.nf-detail h3{font-size:24px;margin:0 0 8px}.nf-detail p:not(.nf-detail-label){font-size:14px;line-height:1.8;color:#4c5f68;margin:0 0 12px;max-width:550px}.nf-detail-link{font-size:13px;color:#216d5c}.nf-evidence{font-size:13px;line-height:1.6;display:flex;gap:20px;justify-content:space-between;padding:9px 0}.nf-evidence+.nf-evidence{border-top:1px solid #e5ebe7}.nf-boundary{font-size:12px;line-height:1.8;color:#596b73;max-width:970px;margin:18px 0 35px}.nf-topic-definitions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.nf-topic-definitions>a{padding:20px 0;border-top:2px solid #c8d9d2;text-decoration:none}.nf-topic-definitions h3{display:flex;justify-content:space-between;font-size:17px;margin:0 0 12px}.nf-topic-definitions p{font-size:13px;line-height:1.8;color:#50636b;margin:0}.nf-mobile-map{display:none}@media(max-width:800px){.nf-heading{display:block}.nf-heading h2{font-size:27px}.nf-heading>p{margin-top:12px}.nf-diagram{display:none}.nf-mobile-map{display:grid;gap:22px}.nf-mobile-map h3{font-size:13px;color:#48645b;margin:0 0 10px}.nf-mobile-map section>div{display:grid;grid-template-columns:1fr 1fr;gap:8px}.nf-mobile-map a{border:1px solid #c5d4cd;border-radius:6px;background:#fff;padding:15px 12px;font-size:13px;display:flex;justify-content:space-between;gap:8px}.nf-mobile-map a[aria-current=true]{border-color:#2c7864;background:#edf7f0}.nf-detail>section{grid-template-columns:1fr;gap:20px}.nf-topic-definitions{grid-template-columns:1fr 1fr;gap:16px}.nf-topic-definitions h3{font-size:15px}.nf-boundary{margin-bottom:22px}}@media(max-width:450px){.nf-topic-definitions{grid-template-columns:1fr}}
</style>
