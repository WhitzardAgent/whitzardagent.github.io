---
import {catalogue,indexBase} from '../../../data/nuwa-index';
import {localizedPath,type Locale} from '../../../i18n/config';
import {readTrendState,modelOriginLabels} from '../../../lib/modelEvidence.mjs';
import {selectedTrend,trendTable,trendSvg,trendSourceMarkup} from '../../../lib/riskTrends.mjs';
interface Props{locale:Locale}
const {locale}=Astro.props,en=locale==='en',series=catalogue.trendSeries??[],state=readTrendState('',series),base=localizedPath(indexBase,locale);
const linkIds=new Set(series.flatMap(s=>s.evidenceLinkIds)),links=(catalogue.assessmentEvidence??[]).filter(l=>linkIds.has(l.id)),modelIds=new Set(links.map(l=>l.modelId)),assessmentIds=new Set(links.map(l=>l.assessmentId)),variantIds=new Set(links.map(l=>l.variantId)),resultIds=new Set(links.map(l=>l.resultId));
const data={sourceVersions:catalogue.sourceVersions?.filter(v=>series.some(t=>t.sourceIds.includes(v.sourceId))),sources:catalogue.sources.filter(s=>series.some(t=>t.sourceIds.includes(s.id))),organizations:catalogue.organizations.filter(o=>links.some(l=>[...l.executorIds,...l.originalExecutorIds].includes(o.id))||catalogue.models?.some(m=>modelIds.has(m.id)&&m.developerId===o.id)),models:catalogue.models?.filter(m=>modelIds.has(m.id)),assessments:catalogue.assessments?.filter(a=>assessmentIds.has(a.id)),protocolVariants:catalogue.protocolVariants?.filter(v=>variantIds.has(v.id)),assessmentEvidence:links,trendSeries:series,results:catalogue.results.filter(r=>resultIds.has(r.id))};
const current=selectedTrend(data,state),metricName=(id:string)=>data.results.flatMap(r=>r.metrics).find(m=>m.id===id)?.label[locale]??id;
const developers=catalogue.organizations.filter(o=>data.models?.some(m=>m.developerId===o.id));
---
<section class="nt-section" id="model-risk-trends" aria-labelledby="nt-title"><div class="nm-section-heading"><div><p class="ni-kicker">{en?'MODEL RELEASE TIMELINE':'模型发布时间线'}</p><h2 id="nt-title">{en?'Frontier risk evidence over time':'前沿风险证据的长期变化'}</h2></div><p>{en?'Trace specific measurements across model releases. Each result keeps its original evaluator and protocol.':'沿模型发布序列跟踪具体测量，每项结果保留原始评测方与协议。'}</p></div>
<risk-timeline class="nt-chart" data-locale={locale} data-base={base} data-payload={JSON.stringify(data)}>
 <form class="nt-controls" hidden><label>{en?'Protocol series':'协议系列'}<select name="series">{series.map(s=><option value={s.id}>{catalogue.areas.find(a=>a.id===s.area)?.label[locale]} · {s.title[locale]}</option>)}</select></label><label>{en?'Metric':'指标'}<select name="metric">{current.series.metricIds.map(id=><option value={id}>{metricName(id)}</option>)}</select></label><label>{en?'Developer':'开发机构'}<select name="developer"><option value="">{en?'All':'全部'}</option>{developers.map(o=><option value={o.id}>{o.name[locale]}</option>)}</select></label><details><summary>{en?'Dates and provenance':'时间与出处'}</summary><div class="nt-more"><label>{en?'Source type':'来源类型'}<select name="origin"><option value="">{en?'All':'全部'}</option>{Object.entries(modelOriginLabels[locale]).map(([id,label])=><option value={id}>{label}</option>)}</select></label><label>{en?'Released from':'发布起始'}<input type="date" name="from"/></label><label>{en?'Released through':'发布截止'}<input type="date" name="to"/></label><label>{en?'Evidence public by':'证据公开截止'}<input type="date" name="asOf" max="2026-10-25"/></label></div></details><button type="reset">{en?'Reset':'重置'}</button></form>
 <div class="nt-toolbar" hidden><div><button type="button" data-trend-view="chart" aria-pressed="true">{en?'Chart':'图表'}</button><button type="button" data-trend-view="table" aria-pressed="false">{en?'Data':'数据表'}</button><button type="button" data-trend-scale aria-pressed="true">{en?'Log scale':'对数坐标'}</button></div><div><button type="button" data-trend-download="csv">CSV ↓</button><button type="button" data-trend-download="svg">SVG ↓</button></div></div>
 <div class="nt-source" data-trend-source aria-live="polite" set:html={trendSourceMarkup(data,current.series,locale)}/><h3 data-trend-heading>{metricName(state.metric)}</h3><p data-trend-description>{current.series.description[locale]}</p><div class="nt-legend">{developers.filter(o=>current.points.some(p=>p.developerId===o.id)).map(o=><span data-developer-legend={o.id}>{o.name[locale]}</span>)}</div><p class="ni-note nt-shape-legend">{en?'● External evaluation · ■ Developer evaluation · ▲ Reused result · bars show source-reported intervals':'● 外部评测 · ■ 开发者评测 · ▲ 引用结果 · 误差线采用原文区间'}</p><p class="nt-mobile-hint">{en?'Scroll horizontally to explore the full timeline. Select a point for model details.':'左右滑动查看完整时间线，选择数据点查看模型详情。'}</p><div data-trend-plot class="nt-plot" tabindex="0" role="region" aria-label={en?'Model-release scatter chart':'模型发布散点图'} set:html={trendSvg(current.points,current.series,metricName(state.metric),locale,{base})}/>
 <div class="nt-point-detail" data-point-detail hidden aria-live="polite"></div><p class="ni-note" data-trend-count>{current.points.length} {en?'recorded systems':'个记录系统'}</p><p class="nt-limit" data-trend-limit>{current.series.limitations[locale]}</p><p class="ni-note">{en?'Retrospective view of currently collected evidence. Historical cutoffs exclude results whose report version was not yet public. Unknown dates are not inferred. First-verified captures are identified separately.':'根据当前收录证据回溯。历史截止视图排除当时尚未公开的报告版本，不推断未知日期。首次核验快照单独标明。'}</p><div data-trend-table class="ec-table nt-table" role="region" tabindex="0" aria-label={en?'Complete trend data':'完整趋势数据'} set:html={trendTable(current.points,locale,base)}/><noscript><p class="ni-note">{en?'Default series and the complete data table are available without JavaScript.':'无 JavaScript 时可查看默认系列和完整数据表。'}</p></noscript>
</risk-timeline></section>
<script>
import {readTrendState,writeTrendState,modelOriginLabels} from '../../../lib/modelEvidence.mjs';
import {selectedTrend,trendTable,trendSvg,trendCsv,developerColors,trendSourceMarkup} from '../../../lib/riskTrends.mjs';
import {escapeHtml as e} from '../../../lib/evidenceCharts.mjs';
class RiskTimeline extends HTMLElement{
 abort?:AbortController;
 connectedCallback(){this.abort?.abort();this.abort=new AbortController();const {signal}=this.abort,data=JSON.parse(this.dataset.payload!) as import('../../../lib/modelEvidence.mjs').TrendData & {sources:import('../../../data/nuwa-index/types').Source[];organizations:import('../../../data/nuwa-index/types').Organization[]},locale=this.dataset.locale as 'en'|'zh',en=locale==='en',base=this.dataset.base!;let state=readTrendState(location.search,data.trendSeries!),log=true;const form=this.querySelector('form')!,metricSelect=form.elements.namedItem('metric') as HTMLSelectElement;
 const label=(id:string)=>data.results.flatMap(r=>r.metrics).find(m=>m.id===id)?.label[locale]??id;
 const draw=()=>{const {series,points}=selectedTrend(data,state);metricSelect.innerHTML=series.metricIds.map(id=>`<option value="${e(id)}">${e(label(id))}</option>`).join('');for(const key of ['series','metric','developer','origin','from','to','asOf'])(form.elements.namedItem(key) as HTMLInputElement).value=state[key as keyof typeof state];this.querySelector('[data-trend-source]')!.innerHTML=trendSourceMarkup(data,series,locale);this.querySelector('[data-trend-heading]')!.textContent=label(state.metric);this.querySelector('[data-trend-description]')!.textContent=series.description[locale];this.querySelector('[data-trend-plot]')!.innerHTML=trendSvg(points,series,label(state.metric),locale,{log,base});this.querySelector('[data-trend-table]')!.innerHTML=trendTable(points,locale,base);(this.querySelector('[data-trend-plot]') as HTMLElement).hidden=state.display==='table';(this.querySelector('[data-trend-table]') as HTMLElement).hidden=state.display!=='table';this.querySelectorAll<HTMLElement>('[data-trend-view]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.trendView===state.display)));this.querySelector('[data-trend-limit]')!.textContent=series.limitations[locale];this.querySelector('[data-trend-count]')!.textContent=en?`${points.filter(p=>p.releaseDate).length} plotted · ${points.filter(p=>!p.releaseDate).length} without a verified release date · source order retained`:`绘制 ${points.filter(p=>p.releaseDate).length} 项 · ${points.filter(p=>!p.releaseDate).length} 项未核实发布日期 · 保留来源顺序`;const legends=this.querySelector('.nt-legend')!;legends.innerHTML=[...new Set(points.map(p=>p.developerId))].map(id=>`<span style="--legend:${developerColors[id]??'#526965'}">${e(data.organizations.find(o=>o.id===id)?.name[locale]??id)}</span>`).join('');(this.querySelector('[data-trend-scale]') as HTMLElement).hidden=series.id!=='metr-horizon-1-1';this.querySelector('[data-trend-scale]')!.setAttribute('aria-pressed',String(log));(this.querySelector('[data-point-detail]') as HTMLElement).hidden=true;};
 const save=()=>{const url=new URL(location.href);url.search=writeTrendState(url.search,state);history.pushState(history.state,'',url);draw();};
 const closeOptions=()=>form.querySelectorAll<HTMLDetailsElement>('details').forEach(d=>d.open=false);this.addEventListener('keydown',ev=>{if(ev.key==='Escape')closeOptions();},{signal});document.addEventListener('click',ev=>{if(!(ev.target as Element).closest('risk-timeline details'))closeOptions();},{signal});form.addEventListener('submit',ev=>ev.preventDefault(),{signal});form.addEventListener('change',ev=>{const input=ev.target as HTMLInputElement;if(!input.name)return;if(input.name==='series'){state.series=input.value;state.metric=data.trendSeries!.find(s=>s.id===input.value)!.metricIds[0];}else state[input.name as keyof typeof state]=input.value;save();},{signal});form.addEventListener('reset',ev=>{ev.preventDefault();state=readTrendState('',data.trendSeries!);closeOptions();save();},{signal});
 this.querySelectorAll<HTMLElement>('[data-trend-view]').forEach(b=>b.addEventListener('click',()=>{state.display=b.dataset.trendView!;save();},{signal}));this.querySelector('[data-trend-scale]')!.addEventListener('click',()=>{log=!log;draw();},{signal});
 const detail=(id:string)=>{const {points}=selectedTrend(data,state),p=points.find(p=>p.id===id);if(!p)return;const region=this.querySelector('[data-point-detail]') as HTMLElement;region.hidden=false;region.innerHTML=`<strong>${e(p.system)}</strong><p>${e(p.value.toLocaleString('en',{maximumFractionDigits:p.precision}))} ${e(p.unit)} · ${modelOriginLabels[locale][p.origin]} · ${e((p.origin==='reused'?p.originalExecutorIds:p.executorIds).map(id=>data.organizations.find(o=>o.id===id)?.name[locale]??id).join(' · '))} · ${p.measurement==='imputed'?(en?'IRT-imputed':'IRT 插补'):p.measurement==='source-estimate'?(en?'Source estimate':'来源估计'):en?'Observed':'观察结果'}</p><dl><div><dt>${en?'Model release':'模型发布'}</dt><dd>${e(p.releaseDate)}${p.releaseDateBasis==='evaluator-release-date'?`<small>${en?'Evaluator-supplied model date':'评测方记载的模型日期'}</small>`:''}</dd></div><div><dt>${en?'Evaluation':'实际评测'}</dt><dd>${e(p.evaluationDate??(en?'Not specified':'未注明'))}</dd></div><div><dt>${en?'Report / revision':'报告 / 修订'}</dt><dd>${e(p.reportDate??'—')} / ${e(p.reportRevisionDate??'—')}</dd></div><div><dt>${en?'Available since':'证据可用日期'}</dt><dd>${e(p.publicSince??'—')}</dd></div></dl><p>${e(p.sample[locale])}</p><p class="ni-note">${e(p.configuration.harness??'')} · ${e(p.configuration.budget??(en?'Budget not specified':'预算未注明'))}</p><p class="ni-note">${e(p.limitations[locale])}</p><a href="${base}/model/${p.modelId}">${en?'Model record':'模型档案'} →</a> · <a href="${base}/result/${p.resultId}">${en?'Result and source':'结果与来源'} →</a>`;};
 this.querySelector('[data-trend-plot]')!.addEventListener('click',ev=>{const a=(ev.target as Element).closest<HTMLElement>('[data-trend-point]');if(a){ev.preventDefault();detail(a.dataset.trendPoint!);}},{signal});this.querySelector('[data-trend-plot]')!.addEventListener('focusin',ev=>{const a=(ev.target as Element).closest<HTMLElement>('[data-trend-point]');if(a)detail(a.dataset.trendPoint!);},{signal});
 this.querySelectorAll<HTMLElement>('[data-trend-download]').forEach(b=>b.addEventListener('click',()=>{const {series,points}=selectedTrend(data,state),ext=b.dataset.trendDownload,content=ext==='csv'?trendCsv(points,locale):trendSvg(points,series,label(state.metric),locale,{standalone:true,log,base});const url=URL.createObjectURL(new Blob([content],{type:ext==='csv'?'text/csv;charset=utf-8':'image/svg+xml'})),a=document.createElement('a');a.href=url;a.download=series.id+'.'+ext;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);},{signal}));window.addEventListener('popstate',()=>{state=readTrendState(location.search,data.trendSeries!);draw();},{signal});form.hidden=false;(this.querySelector('.nt-toolbar') as HTMLElement).hidden=false;draw();this.dataset.enhanced='true';
 }
 disconnectedCallback(){this.abort?.abort();}
}
if(!customElements.get('risk-timeline'))customElements.define('risk-timeline',RiskTimeline);
</script>
<style is:global>
.nt-source{display:grid;gap:8px;padding:17px 0;border-bottom:1px solid #d3e0d8;font-size:13px;line-height:1.7;overflow-wrap:anywhere}.nt-source strong{font-weight:500;color:#1e4d50}.nt-source-links a{color:#1c6b61;text-decoration:underline;text-underline-offset:3px}.nt-source-details{font-size:11px;color:#546b63}.nt-source-details summary{cursor:pointer;width:fit-content}.nt-source-details span,.nt-source-details small{display:block;margin-top:7px}.nt-source-version,.nt-source small{font-size:11px;color:#546b63}.nt-section{margin:56px 0}.nt-chart{display:block;padding:28px;border:1px solid #c9dbd1;background:#fafcf9;border-radius:8px;min-width:0}.nt-controls{display:flex;align-items:end;flex-wrap:wrap;gap:12px;border-bottom:1px solid #d3e0d8;padding-bottom:20px}.nt-controls label{display:grid;gap:6px;font-size:12px;color:#425b61;min-width:150px}.nt-controls label:first-child{flex:1;min-width:210px}.nt-controls :is(select,input){max-width:100%;min-width:0;border:1px solid #b9cfc4;background:#fff;border-radius:4px;padding:10px;color:#243d4c;font:inherit;min-height:42px}.nt-controls>label>select{max-width:410px}.nt-controls button,.nt-toolbar button{background:#fff;border:1px solid #b9cfc4;border-radius:4px;padding:9px 12px;font-size:12px;min-height:40px;cursor:pointer;color:#244957}.nt-controls details{position:relative;font-size:12px}.nt-controls summary{padding:12px 5px;cursor:pointer}.nt-more{position:absolute;z-index:9;right:0;top:100%;display:grid;grid-template-columns:1fr 1fr;gap:16px;padding:20px;background:white;border:1px solid #b9cfc4;width:420px;max-width:80vw;box-shadow:0 12px 20px #1232}.nt-toolbar{display:flex;justify-content:space-between;gap:12px;margin:16px 0 24px}.nt-toolbar>div{display:flex;gap:4px;flex-wrap:wrap}.nt-toolbar button[aria-pressed=true]{background:#214f51;color:white;border-color:#214f51}.nt-chart>h3{font-size:23px;font-weight:500;margin:22px 0 12px}.nt-chart>[data-trend-description]{font-size:14px;line-height:1.8;color:#4c626b;max-width:850px}.nt-mobile-hint{display:none}.nt-point-detail dd small{display:block;font-size:11px;color:#526b63;margin-top:4px}.nt-plot{overflow:auto;max-width:100%;scrollbar-width:thin}.nt-plot svg{display:block;width:100%;height:auto;min-width:640px}.nt-plot svg a{cursor:pointer;scroll-margin-top:120px}.nt-legend{display:flex;flex-wrap:wrap;gap:10px 20px;font-size:12px;margin:18px 0;color:#445e62}.nt-legend span:before{content:'';display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--legend,#526965);margin-right:7px}.nt-limit{font-size:13px;line-height:1.8;color:#715b49;border-left:2px solid #b19a7b;padding-left:14px;margin-top:22px}.nt-point-detail{overflow-wrap:anywhere;padding:22px;border:1px solid #b6cfc3;background:#edf4ee;margin:14px 0}.nt-point-detail>strong{font-size:18px}.nt-point-detail p{font-size:13px;line-height:1.7;margin:10px 0}.nt-point-detail dl{display:grid;grid-template-columns:1fr 1fr;gap:10px;font-size:12px}.nt-point-detail dt{color:#60756f}.nt-point-detail dd{margin:3px 0}.nt-point-detail a{font-size:13px;color:#1f695e}.nt-empty{padding:50px 24px;font-size:15px;color:#536b66;border:1px dashed #c4d7cd;margin:20px 0}.nt-table table{min-width:850px}.nt-chart [hidden]{display:none!important}.nt-chart:focus-visible,.nt-plot:focus-visible{outline:2px solid #26786b;outline-offset:3px}@media(max-width:700px){.nt-mobile-hint{display:block;font-size:12px;color:#4d6b63;margin:12px 0}.nt-chart{padding:18px 14px}.nt-controls{display:grid;grid-template-columns:1fr;width:100%}.nt-controls label{min-width:0!important}.nt-controls>label>select{max-width:100%;width:100%}.nt-more{position:static;grid-template-columns:1fr;max-width:100%;width:100%;margin:8px 0 12px;box-shadow:none}.nt-toolbar{flex-wrap:wrap}.nt-point-detail dl{grid-template-columns:1fr}.nt-source{display:grid;gap:8px;padding:17px 0;border-bottom:1px solid #d3e0d8;font-size:13px;line-height:1.7;overflow-wrap:anywhere}.nt-source strong{font-weight:500;color:#1e4d50}.nt-source-links a{color:#1c6b61;text-decoration:underline;text-underline-offset:3px}.nt-source-details{font-size:11px;color:#546b63}.nt-source-details summary{cursor:pointer;width:fit-content}.nt-source-details span,.nt-source-details small{display:block;margin-top:7px}.nt-source-version,.nt-source small{font-size:11px;color:#546b63}.nt-section{margin:38px 0}}
</style>
