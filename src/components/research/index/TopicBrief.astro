---
import type {Locale} from '../../../i18n/config';
import {catalogue,indexBase} from '../../../data/nuwa-index';
import {localizedPath} from '../../../i18n/config';
import AssertionEvidence from './AssertionEvidence.astro';
import {analysisState} from '../../../lib/nuwa-intelligence/monitoring.mjs';
interface Props{locale:Locale;area:string;presentation:any;analyses:any[]}
const {locale,area,presentation:p,analyses}=Astro.props,en=locale==='en',base=localizedPath(indexBase,locale);
const notes=analyses.filter(a=>{const g=catalogue.monitoring?.groups.find(g=>g.id===a.groupId);return g&&g.areas.includes(area)&&['current','local-review'].includes(analysisState(catalogue,g,a));});
const a=notes.find(a=>a.area===area)??notes[0];
---
<aside class="nt-brief" data-topic-brief={area} data-monitor-sources={a?.sourceIds.join(' ')??p.works.map((w:any)=>w.sourceId).join(' ')}>
 {a?<><p class="nt-brief-label">NUWA Analysis <span>· {en?'Source-based analysis':'来源证据分析'}</span></p><h3>{a.heading[locale]}</h3><ol>{(a.findings??[{title:a.takeaway,body:a.analysis,resultIds:a.resultIds.slice(0,1)}]).map((f:any,i:number)=><li><span class="nt-finding-number">0{i+1}</span><div><h4>{f.title[locale]}</h4><p>{f.body[locale]}</p><AssertionEvidence assertion={f} locale={locale}/></div></li>)}</ol><a class="nt-full-brief" href={`${base}/synthesis/${a.id}/`}>{en?'Read the research brief':'阅读完整研究综述'} →</a><p class="nt-analysis-scope">{en?'Evidence snapshot':'证据快照'} {a.snapshotId} · {a.date}<br/>{en?'Interpretation covers the stated evidence set; chart filters select a subset.':'解读针对所列完整证据集，图表筛选显示其中子集。'}</p></>:<><p class="nt-brief-label">{en?'Measurement scope':'测量范围'}</p><h3>{p.measurement[locale]}</h3><p class="nt-scope-copy">{p.scope[locale]}</p><p class="nt-brief-label nt-related-label">{en?'Related research':'相关研究'}</p><ul class="nt-related-list">{p.works.map((w:any)=><li><a href={`${base}/work/${w.id}/`}>{w.title} ↗</a></li>)}</ul><a class="nt-full-brief" href={`${base}/risk/${area}/`}>{en?'Explore the research question':'查看研究专题'} →</a></>}
</aside>
<style is:global>
.nt-brief{min-width:0;border-left:1px solid #dce5e2;padding:4px 0 0 26px;align-self:start}.nt-brief-label{font-size:12px;font-weight:600;color:#246859;margin:0 0 12px;letter-spacing:.015em}.nt-brief-label span{font-size:10px;font-weight:400;color:#6b7a80}.nt-brief>h3{font-size:23px;line-height:1.4;letter-spacing:-.025em;margin:0 0 22px;font-weight:550}.nt-brief ol{list-style:none;margin:0;padding:0}.nt-brief ol>li{display:flex;gap:11px;padding:0 0 18px;margin-bottom:18px;border-bottom:1px solid #e1e8e4}.nt-finding-number{font-size:11px;color:#42836c;font-variant-numeric:tabular-nums;padding-top:3px}.nt-brief h4{font-size:14px;line-height:1.55;font-weight:600;margin:0 0 7px}.nt-brief li p,.nt-scope-copy{font-size:13px;line-height:1.75;color:#4e626c;margin:0 0 7px}.nt-brief li a{font-size:11px;color:#216b59}.nt-full-brief{font-size:12px;font-weight:500;color:#1e6657;display:inline-block;margin:0 0 12px}.nt-analysis-scope{font-size:10px;line-height:1.7;color:#627679;margin:0}.nt-related-label{margin-top:30px}.nt-related-list{list-style:none;margin:0 0 20px;padding:0}.nt-related-list li{border-bottom:1px solid #e2e9e6;padding:12px 0}.nt-related-list li a{font-size:13px;line-height:1.7}.nt-scope-copy{font-size:14px;line-height:1.8}@media(max-width:1050px){.nt-brief{border-left:0;border-top:1px solid #dce5e2;padding:22px 0 0}.nt-brief>h3{font-size:23px;max-width:760px}.nt-brief ol{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.nt-brief ol>li{margin-bottom:0}.nt-analysis-scope br{display:none}}@media(max-width:650px){.nt-brief ol{grid-template-columns:1fr;gap:0}.nt-brief>h3{font-size:23px}.nt-brief li p{font-size:14px}.nt-analysis-scope{font-size:11px}}
</style>
