---
import GlobalResearchSearch from './preview/GlobalResearchSearch.astro';
import {currentEdition,catalogue} from '../../../data/nuwa-index';
interface Props{locale:'zh'|'en';pathname:string}
const {locale,pathname}=Astro.props,en=locale==='en',base=`${en?'/en':''}/nuwa/whitzard-index`;
const nav=[['?view=framework','Framework','风险框架'],['?view=trend','Trend','趋势'],['?view=research','Research','研究'],['?view=benchmarks','Benchmarks','评测'],['opinion/','Opinion','观点'],['sources/','Sources','来源'],['?view=methodology','Methodology','方法说明']];
---
<header class="ne-masthead"><div class="ne-masthead-row"><a class="ne-brand" href={`${base}/`}><img src="/assets/logo/nvwa_logo.png" width="32" height="32" alt="NUWA"/>NUWA <span>INDEX</span></a><div class="ne-actions"><GlobalResearchSearch locale={locale} candidateId={currentEdition?.candidateId??catalogue.snapshotId} searchUrl={`${base}/search/`}/><a href={`${en?'':'/en'}${pathname.replace(/^\/en(?=\/)/,'')}`}>{en?'中文':'English'}</a></div></div><nav aria-label="NUWA Index">{nav.map(([url,a,b])=><a href={`${base}/${url}`}>{en?a:b}</a>)}<details><summary>{en?'About':'关于'}</summary><a href={`${base}/updates/`}>{en?'Updates':'更新'}</a></details></nav></header>
<style>.ne-masthead{max-width:1440px;padding:22px clamp(20px,4vw,64px) 0;margin:auto;color:#162a32}.ne-masthead-row,.ne-actions{display:flex;align-items:center;justify-content:space-between;gap:22px}.ne-brand{display:flex;align-items:center;gap:10px;font-size:20px;font-weight:600;text-decoration:none}.ne-brand span{font-size:12px;letter-spacing:.16em;font-weight:400}.ne-actions>a{font-size:13px}.ne-masthead nav{display:flex;align-items:center;gap:12px 30px;flex-wrap:wrap;border-bottom:1px solid #cbd9cf;padding:20px 0 13px;font-size:14px}.ne-masthead a{color:inherit;text-decoration:none}.ne-masthead a:hover{color:#235e53}.ne-masthead details{position:relative;margin-left:auto;font-size:12px}.ne-masthead summary{cursor:pointer}.ne-masthead details[open]>a{display:block;padding:8px 0;background:#f4f6f2}@media(max-width:600px){.ne-masthead nav{gap:12px 20px;white-space:nowrap;font-size:13px}.ne-masthead details{display:none}.ne-actions{gap:14px}}.ne-masthead :focus-visible{outline:3px solid #2f7f7a;outline-offset:4px}</style>
