---
import GlobalResearchSearch from './preview/GlobalResearchSearch.astro';
import {currentEdition,catalogue} from '../../../data/nuwa-index';
interface Props{locale:'zh'|'en';pathname:string}
const {locale,pathname}=Astro.props,en=locale==='en',base=`${en?'/en':''}/nuwa/whitzard-index`;
const nav=[['','Overview','总览'],['models/compare/','Model comparison','模型比较'],['trends/','Risk trends','风险趋势'],['evaluations/','NUWA evaluations','NUWA 评测'],['assessments/','External assessments','外部评测']];
const resources=[['research/','Research library','研究目录'],['research/?view=research&researchMode=reports','Research analysis','研究解读'],['research/?view=framework','Risk framework','风险框架'],['research/?view=methodology','Methodology','方法说明'],['compare/','Compare protocols','比较评测协议'],['sources/','Sources','来源'],['opinion/','Perspectives','观点'],['updates/','Updates & data','版本与数据']];
---
<header class="ne-masthead"><div class="ne-company"><a href={en?'/en/':'/'}>{en?'Whitzard':'白泽（Whitzard）'}</a><a href={en?'/en/nuwa':'/nuwa'}>{en?'NUWA Lab':'女娲实验室'} ↗</a></div><div class="ne-masthead-row"><a class="ne-brand" href={`${base}/`}><img src="/assets/logo/nvwa_logo.png" width="32" height="32" alt="NUWA"/>NUWA <span>INDEX</span></a><div class="ne-actions"><GlobalResearchSearch locale={locale} candidateId={currentEdition?.candidateId??catalogue.snapshotId} searchUrl={`${base}/search/`}/><a data-platform-language href={`${en?'':'/en'}${pathname.replace(/^\/en(?=\/)/,'')}`}>{en?'中文':'English'}</a></div></div><nav aria-label="NUWA Index">{nav.map(([url,a,b])=><a href={`${base}/${url}`} aria-current={pathname.replace(/\/$/,'')===`${base}/${url}`.replace(/\/$/,'')?'page':undefined}>{en?a:b}</a>)}<details><summary>{en?'Research & methods':'研究与方法'}</summary><div>{resources.map(([url,a,b])=><a href={`${base}/${url}`}>{en?a:b}</a>)}</div></details></nav></header>
<script>
 const sync=()=>{document.querySelectorAll<HTMLAnchorElement>('[data-platform-language]').forEach(a=>{a.search=location.search;a.hash=location.hash;});};document.addEventListener('astro:page-load',sync);window.addEventListener('popstate',sync);window.addEventListener('nuwa-index-change',sync);window.addEventListener('nuwa-topic-change',sync);sync();
</script>
<style>.ne-masthead{max-width:1320px;padding:0 clamp(20px,4vw,60px);margin:auto;color:var(--wz-ink,#192d38)}.ne-company{display:flex;justify-content:space-between;border-bottom:1px solid #d7e1d9;padding:10px 0;color:#51655c;font-size:11px}.ne-masthead-row,.ne-actions{display:flex;align-items:center;justify-content:space-between;gap:20px}.ne-masthead-row{padding-top:20px}.ne-brand{display:flex;align-items:center;gap:10px;font-size:21px;font-weight:600;text-decoration:none}.ne-brand span{font-size:12px;letter-spacing:.16em;font-weight:400}.ne-actions>a{font-size:13px}.ne-masthead nav{display:flex;align-items:center;gap:12px 29px;flex-wrap:wrap;border-bottom:1px solid #cbd9cf;padding:18px 0 14px;font-size:14px}.ne-masthead a{color:inherit;text-decoration:none}.ne-masthead a:hover,.ne-masthead a[aria-current=page]{color:#235e53;text-decoration:underline;text-underline-offset:6px}.ne-masthead details{position:relative;font-size:14px}.ne-masthead summary{cursor:pointer;min-height:32px;display:flex;align-items:center;gap:8px}.ne-masthead summary:after{content:'⌄'}.ne-masthead details>div{position:absolute;top:34px;right:0;z-index:40;min-width:195px;border:1px solid #c3d4c7;padding:8px;background:#f4f6f2;box-shadow:0 10px 22px #173a2814;border-radius:5px}.ne-masthead details a{display:block;padding:10px;font-size:13px}.ne-masthead :focus-visible{outline:3px solid #2f7f7a;outline-offset:4px}@media(max-width:600px){.ne-masthead nav{gap:4px 18px;font-size:12px;padding-top:12px}.ne-masthead nav>a{min-height:38px;display:flex;align-items:center}.ne-masthead details{font-size:12px}.ne-masthead details>div{right:auto;left:0}.ne-masthead-row{padding-top:16px}.ne-actions{gap:14px}.ne-company{padding-block:9px}}
</style>
