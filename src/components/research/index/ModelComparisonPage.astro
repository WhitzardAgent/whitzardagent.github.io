---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import type {Locale} from '../../../i18n/config';
import {localizedPath} from '../../../i18n/config';
import {catalogue,indexBase} from '../../../data/nuwa-index';
import {comparisonDataset,comparisonOptions,platformVersion,defaultComparisonId} from '../../../lib/nuwa-intelligence/platformData';
import {projectComparison} from '../../../lib/nuwa-intelligence/platformComparison.mjs';
import {monitorSvg,monitorValue} from '../../../lib/nuwa-intelligence/monitoring.mjs';
import '../../../styles/nuwa-platform.css';
interface Props{locale:Locale}
const {locale}=Astro.props,en=locale==='en',base=localizedPath(indexBase,locale),dataset=comparisonDataset(defaultComparisonId,locale),initial=projectComparison(dataset,{sort:'source'});
---
<BaseLayout title={en?'Compare models and agent systems — NUWA Index':'模型与智能体系统比较 — NUWA Index'} description={en?'Compare source-reported outcomes, configurations and evaluation conditions.':'比较模型及智能体系统的原始评测指标、配置与测量条件。'} locale={locale} brand="nuwa" canonicalPath={`${indexBase}/models/compare`}>
<div class="np-platform" data-platform-version={platformVersion}><header class="np-container np-page-head"><p class="np-eyebrow">MODEL COMPARISON</p><h1>{en?'Compare models and agent systems':'比较模型与智能体系统'}</h1><p>{en?'Choose a risk topic and a measurement protocol, then compare 2–4 evaluated systems. Capability, propensity and observed behavior retain their own meaning.':'选择风险主题与测量协议，对照 2–4 个受测系统。任务能力、行为倾向与观察行为保留各自含义。'}</p></header>
<nuwa-model-comparison class="np-container" data-locale={locale} data-base={base}>
<script is:inline type="application/json" data-comparison-initial set:html={JSON.stringify(dataset).replace(/</g,'\\u003c')}/>
<form class="np-toolbar" data-comparison-form hidden><label>{en?'Risk topic':'风险主题'}<select name="area"><option value="">{en?'All topics':'全部主题'}</option>{catalogue.areas.map(a=><option value={a.id}>{a.label[locale]}</option>)}</select></label><label style="flex:3">{en?'Protocol / outcome':'协议／指标'}<select name="group">{comparisonOptions.map(o=><option value={o.id} data-areas={o.areas.join(' ')} selected={o.id===dataset.id}>{o.title[locale]}</option>)}</select></label><label>{en?'Order':'排序'}<select name="order"><option value="source">{en?'Source order':'原文顺序'}</option><option value="desc">{en?'Value: high to low':'数值：由高到低'}</option><option value="asc">{en?'Value: low to high':'数值：由低到高'}</option></select></label><label>{en?'Comparison scope':'比较范围'}<select name="scope"><option value="all">{en?'Reported evidence':'已报告证据'}</option><option value="strict">{en?'Strict comparisons':'严格可比'}</option></select></label><label>{en?'Public evidence cutoff':'证据公开截止'}<input type="date" name="asOf"/></label></form>
<fieldset class="np-selection" data-system-choices hidden><legend>{en?'Select 2–4 evaluated systems':'选择 2–4 个受测系统'}</legend></fieldset>
<h2 data-comparison-title style="font-size:24px;font-weight:500">{dataset.title[locale]}</h2><p data-comparison-description class="np-note">{dataset.description?.[locale]}</p>
<p class="np-status" role="status" data-comparison-status>{en?'Descriptive comparison. Harness, provider and reasoning conditions differ; this is not a strict model ranking.':'描述性比较：脚手架、提供方和推理条件存在差异，当前结果不构成严格模型排名。'}</p>
<div class="np-plot" data-comparison-plot set:html={monitorSvg(initial.rows,{...dataset,level:'descriptive'},locale,{display:'bars',all:true})}/>
<div class="np-table-scroll" tabindex="0" role="region" aria-label={en?'Compared outcomes':'比较结果'}><table class="np-table"><thead><tr><th>{en?'System / model':'系统／模型'}</th><th>{en?'Result / sample':'结果／样本'}</th><th>{en?'Configuration':'运行配置'}</th><th>{en?'Attribution / dates':'归属／日期'}</th></tr></thead><tbody data-comparison-rows>{initial.rows.map((r:any)=><tr><th scope="row"><a href={`${base}/result/${r.resultId}/`}>{r.system}</a><small>{r.dimension}</small></th><td><span class="np-value">{monitorValue(r)}</span><small>{r.intervalText??'—'}</small><small>{r.sample?.[locale]}</small></td><td>{Object.entries(r.configuration??{}).map(([k,v])=><small>{k}: {v??'—'}</small>)}<small>{r.taskSet}</small></td><td><small>{en?'Evaluator':'评测方'}: {r.attribution.evaluator}</small><a href={r.attribution.sourceUrl}>{r.attribution.reporter}</a><small>{en?'Evaluated':'评测'} {r.evaluationDate??'—'} · {en?'Report':'报告'} {r.reportDate??'—'}</small><small>{en?'Public since':'证据公开'} {r.publicSince??'—'}</small></td></tr>)}</tbody></table></div>
<details class="np-detail" open><summary>{en?'Comparison conditions and interpretation':'比较条件与解释范围'}</summary><ul class="np-conditions" data-comparison-conditions>{dataset.conditions.map((c:any)=><li><strong>{c.field}</strong> · {c.state}<br/>{c.note[locale]}</li>)}</ul><p class="np-note" data-comparison-limits>{dataset.limits[locale]}</p></details>
<div class="np-actions"><a class="np-button np-secondary" data-comparison-csv href={`${indexBase}/comparison-data/${en?'en--':''}${dataset.id}.csv`} download>CSV ↓</a><a class="np-button np-secondary" data-comparison-svg href={`${indexBase}/comparison-data/${en?'en--':''}${dataset.id}.svg`} download>SVG ↓</a><button class="np-button np-secondary" data-comparison-share hidden>{en?'Copy comparison link':'复制比较链接'}</button><a href={`${base}/compare/`}>{en?'Compare protocol designs':'比较协议设计'} →</a></div><p class="np-caption" data-comparison-citation>{en?'Evidence snapshot':'证据快照'} {dataset.snapshot} · NUWA Index {platformVersion}</p><noscript><p class="np-note">{en?'The default comparison and downloads are available without JavaScript. Each system links to its full static evidence record. Interactive selection requires JavaScript.':'无 JavaScript 时保留默认比较及下载；每个系统均可进入完整静态证据。交互筛选需要 JavaScript。'}</p></noscript>
</nuwa-model-comparison></div>
<script>import '../../../lib/nuwa-intelligence/platformClient';</script>
</BaseLayout>
