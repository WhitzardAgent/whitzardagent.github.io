---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {catalogue,indexBase} from '../../../data/nuwa-index';
import {localizedPath,type Locale} from '../../../i18n/config';
import AssertionEvidence from './AssertionEvidence.astro';
import PageSources from '../PageSources.astro';
interface Props{analysis:any;locale:Locale}
const{analysis:a,locale}=Astro.props,en=locale==='en',base=localizedPath(indexBase,locale);
---
<BaseLayout title={`${a.heading[locale]} — NUWA Index`} description={a.takeaway[locale]} locale={locale} brand="nuwa" canonicalPath={`${indexBase}/synthesis/${a.id}`}>
<article class="site-container ns-synthesis" data-reading-publication={a.publication?.state}><a href={`${base}?view=research&researchMode=reports`}>← {en?'Research reports':'研究报告'}</a><header><p class="ns-label">{a.status==='review-pending'?(en?'Source changed · interpretation awaiting review':'来源变化 · 解读待复核'):(en?'NUWA analysis · model-assisted · independent review pending':'NUWA 研究分析 · 模型辅助整理 · 独立复核待完成')}</p><h1>{a.heading[locale]}</h1><p class="ns-takeaway">{a.takeaway[locale]}</p><p>{en?'Evidence snapshot':'证据快照'} {a.snapshotId} · {a.date}</p></header><section id="argument"><h2>{en?'Evidence and argument':'证据与论证'}</h2><p>{a.analysis[locale]}</p></section>{a.findings?.map((f:any,i:number)=><section id={`claim-${i+1}`}><h2>{f.title[locale]}</h2><p>{f.body[locale]}</p><AssertionEvidence assertion={f} locale={locale}/></section>)}<section id="limitations"><h2>{en?'Limits and remaining assumptions':'局限与待验证假设'}</h2><p>{a.limits[locale]}</p></section><section id="next-question"><h2>{en?'Next research question':'后续研究问题'}</h2><p>{a.nextCheck[locale]}</p></section><PageSources locale={locale} sources={catalogue.sources} references={a.sourceRefs??a.sourceIds.map((sourceId:string)=>({sourceId}))}/></article>
</BaseLayout>
<style>.ns-synthesis{max-width:900px;padding-top:40px;padding-bottom:70px}.ns-synthesis header{margin:24px 0 32px}.ns-label{font-size:12px;color:#526b63}.ns-synthesis h1{font-size:38px;line-height:1.3;letter-spacing:-.025em;margin:12px 0 20px}.ns-synthesis .ns-takeaway{font-size:21px;line-height:1.7;background:#eaf2ed;padding:22px;border-left:3px solid #387563}.ns-synthesis section{margin:32px 0}.ns-synthesis h2{font-size:25px;margin:0 0 15px}.ns-synthesis p{font-size:17px;line-height:1.85}.ns-synthesis .nw-assertion-evidence p{font-size:12px}.ns-synthesis a{color:#246c5e}@media(max-width:600px){.ns-synthesis h1{font-size:29px}.ns-synthesis .ns-takeaway{font-size:18px;padding:17px}.ns-synthesis p{font-size:16px}}</style>
