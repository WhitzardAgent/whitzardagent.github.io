---
import {modelRelease,modelMetadata,parameterLabel} from '../../../lib/modelMetadata.mjs';
import OrganizationMark from './OrganizationMark.astro';
import {catalogue,indexBase} from '../../../data/nuwa-index';
import {localizedPath,type Locale} from '../../../i18n/config';
interface Props{locale:Locale}
const {locale}=Astro.props,en=locale==='en',base=localizedPath(indexBase,locale);
const models=(catalogue.models??[]).map(m=>({...m,releaseDate:modelRelease(m),modelMetadata:modelMetadata(m)})).sort((a,b)=>(b.releaseDate??'').localeCompare(a.releaseDate??'')||a.name.localeCompare(b.name));
---
<div class="nm-model-grid">{models.map(m=>{const org=catalogue.organizations.find(o=>o.id===m.developerId)!,aa=catalogue.assessments?.filter(a=>a.modelIds.includes(m.id))??[],links=catalogue.assessmentEvidence?.filter(l=>l.modelId===m.id)??[],areas=[...new Set(aa.flatMap(a=>a.areas))];return <article class="nm-model-card" data-model-record data-name={m.name} data-developer={m.developerId} data-search={`${m.name} ${m.family} ${m.aliases.join(' ')} ${org.name.en} ${org.name.zh}`} data-areas={areas.join(' ')}><p class="ni-kicker"><OrganizationMark organizationId={org.id} locale={locale}/></p><h3><a href={`${base}/model/${m.id}`}>{m.name} →</a></h3><p class="nm-model-date">{en?'Public availability':'公开可用'} · {m.releaseDate??(en?'Date not verified':'日期未核实')}</p><p class="nm-model-date">{parameterLabel(m.modelMetadata?.parameters,locale)}</p><div class="nm-model-card__evidence"><span>{aa.filter(a=>a.kind==='developer').length} {en?'developer disclosures':'份开发者披露'}</span><span>{aa.filter(a=>a.kind==='external').length} {en?'external assessments':'份外部评估'}</span></div><p>{links.length?en?'Results retain their protocol, configuration and original evaluator.':'结果保留对应协议、配置和原始评测方。':en?'The report catalogue is available; structured results have not been extracted for this model.':'已有报告目录；该模型的结构化结果尚未提取。'}</p><a class="nm-model-open" href={`${base}/model/${m.id}`}>{en?'Explore evidence':'查看证据'} →</a></article>;})}</div>
<style is:global>
.nm-model-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin:26px 0}.nm-model-card{padding:25px;border:1px solid #cadbd1;background:#fff;min-width:0;display:flex;flex-direction:column}.nm-model-card[hidden]{display:none}.nm-model-card h3{font-size:23px;font-weight:500;line-height:1.3;margin:12px 0;overflow-wrap:anywhere}.nm-model-card h3 a{text-decoration:none}.nm-model-date{font-size:12px;color:#52676b;margin:0 0 18px}.nm-model-card__evidence{display:flex;flex-wrap:wrap;gap:7px 14px;font-size:12px;color:#346a5d;padding-top:14px;border-top:1px solid #dce6df}.nm-model-card>p:not(.ni-kicker,.nm-model-date){font-size:13px;line-height:1.8;color:#516770;margin:16px 0}.nm-model-open{margin-top:auto;padding-top:10px;font-size:13px;color:#1d6a5b!important;text-decoration:none}@media(max-width:1000px){.nm-model-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.nm-model-grid{grid-template-columns:1fr}.nm-model-card{padding:22px}}
</style>
