---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProtocolComparison from './ProtocolComparison.astro';
import {indexBase} from '../../../data/nuwa-index';
import {localizedPath,type Locale} from '../../../i18n/config';
interface Props{locale:Locale}
const{locale}=Astro.props,en=locale==='en';
---
<BaseLayout title={en?'Compare evaluation protocols — NUWA Index':'比较评测协议 — NUWA Index'} description={en?'Compare measurement targets, scoring, conditions and limits across frontier-risk evaluation protocols.':'对照前沿风险评测协议的测量目标、判分、条件与局限。'} locale={locale} brand="nuwa" canonicalPath={`${indexBase}/compare`}>
<article class="site-container np-compare-page"><a href={`${localizedPath(indexBase,locale)}?view=benchmarks`}>← {en?'Benchmarks':'安全基准'}</a><h1>{en?'Choose the right measurement':'选择合适的测量工具'}</h1><p>{en?'Compare 2–4 protocol profiles before interpreting or combining their results. Unknown methods remain explicit gaps.':'先比较 2–4 项协议的设计，再解释它们的结果。现有材料无法确定的方法信息保持为明确缺口。'}</p><ProtocolComparison locale={locale}/></article>
</BaseLayout>
<style>.np-compare-page{padding-top:45px;padding-bottom:80px}.np-compare-page h1{font-size:38px;line-height:1.3;margin:22px 0 14px}.np-compare-page>p{max-width:800px;font-size:17px;line-height:1.8;margin-bottom:28px}@media(max-width:600px){.np-compare-page h1{font-size:28px}}</style>
