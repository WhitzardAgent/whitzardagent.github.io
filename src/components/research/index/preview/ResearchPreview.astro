---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import {historicalCatalogue as catalogue,publicReading} from '../../../../data/nuwa-index';
import {buildPreviewCorpus,verifyCapturedPackages} from '../../../../lib/nuwa-intelligence/researchCandidate.mjs';
import TopicMonitoring from '../TopicMonitoring.astro';
import MonitoringPanel from '../MonitoringPanel.astro';
import {buildDisplaySets} from '../../../../lib/nuwa-intelligence/panorama.mjs';
import fs from 'node:fs';
import {protocolProfileText} from '../../../../lib/nuwa-intelligence/protocolComparison.mjs';
import '../../../../styles/nuwa-index.css';
interface Props{locale:'en'|'zh';view:string}
const {locale,view}=Astro.props,en=locale==='en',base=`${en?'/en':''}/nuwa/whitzard-index`,preview=base+'/preview';
const nav=en?{trend:'Trend',search:'Search',record:'Research record',benchmark:'Benchmark',opinion:'Opinion'}:{trend:'趋势',search:'检索',record:'研究记录',benchmark:'测量档案',opinion:'观点'};
let packages:any[]=[];if(process.env.NUWA_GLOBAL_RESEARCH_ROOT){for(const lane of ['vendors','labs','academic']){const file=`${process.env.NUWA_GLOBAL_RESEARCH_ROOT}/${lane}/packages.json`;if(fs.existsSync(file)){const data=JSON.parse(fs.readFileSync(file,'utf8'));packages.push(...(Array.isArray(data)?data:data.packages??[]));}}}
verifyCapturedPackages(packages);
const p=buildPreviewCorpus(catalogue,publicReading,packages);
const dossier=p.dossiers.find((d:any)=>d.id==='ai-control')!,work=p.works.find((w:any)=>w.id==='ai-control')!,copy=dossier[locale];
const benchmark=p.protocols.find((b:any)=>b.id==='cybench')!,profile=publicReading.protocols.find((b:any)=>b.id==='cybench');
const benchmarkGroups=buildDisplaySets(catalogue,{benchmarkId:benchmark.id}).map((g:any)=>g.id!=='panorama-cybench-2bt3lx'?g:{...g,scopePresentation:'annotated',description:{en:'Unguided task success across reports. Numbered notes identify the evaluation settings.',zh:'各来源报告的无引导任务成功率，编号对应图下注明的评测设置。'},scopeNotes:[{en:'Original paper: 40 tasks, one attempt per task, structured bash agent.',zh:'原论文：40 项任务，每题一次尝试，采用 structured bash 智能体。'},{en:'NEO Kimi K3: 39/40-task subset.',zh:'NEO Kimi K3：39/40 项任务子集。'},{en:'Other unguided evaluations; report-specific configuration.',zh:'其他无引导评测，具体配置见对应报告。'},{en:'SaferAI: 34/40-task subset.',zh:'SaferAI：34/40 项任务子集。'}]});
const val=(x:any):string=>typeof x==='string'?x:Array.isArray(x)?x.map(val).join('\n\n'):'';
const groups=[['question',en?'Question':'研究问题'],['design',en?'Design & assumptions':'研究设计与假设'],['findings',en?'What the study found':'研究发现'],['interpretation',en?'Reading the evidence':'证据解读'],['limits',en?'Limits & counterevidence':'局限与相反证据'],['decisionRelevance',en?'Implications':'研究意义']];
const opinions=packages.filter(p=>p.kind==='opinion'&&['local-review-candidate','candidate-local-review','existing-work-enrichment-candidate'].includes(p.disposition));
---
<BaseLayout title={`NUWA Index · ${nav[view as keyof typeof nav]}`} locale={locale} brand="nuwa" noindex>
<main class="np" data-preview-version={p.candidateId} data-preview-view={view} data-locale={locale}>
 <div class="np-masthead"><a href={`${preview}/trend/`}><img src="/assets/logo/nvwa_logo.png" width="34" height="34" alt="NUWA"/> NUWA <span>INDEX</span></a><a href={`${en?'':'/en'}/nuwa/whitzard-index/preview/${view}/`}>{en?'中文':'English'}</a></div>
 <div class="np-review"><span>{en?'LOCAL DESIGN REVIEW · V0':'本地设计审阅 · V0'}</span></div>
 <nav class="np-nav" aria-label={en?'Preview pages':'样板页面'}>{Object.entries(nav).map(([id,label])=><a href={`${preview}/${id}/`} aria-current={view===id?'page':undefined}>{label}</a>)}</nav>
 {view==='trend'&&<>
 <header class="np-heading"><p class="np-eyebrow">FRONTIER AI · EVIDENCE OBSERVATORY</p><h1>{en?'Follow the evidence.':'沿着证据，理解前沿风险。'}</h1><p>{en?'Research, measurements and their limits — organized for the next question.':'从研究问题到测量结果，再到结论的边界。'}</p><a class="np-search-link" href={`${preview}/search/`}>{en?'Search a research question':'搜索一个研究问题'} <span>↗</span></a></header>
 <div class="np-stats"><span><strong>{p.works.length}</strong>{en?'research records in scope':'范围内研究记录'}</span><span><strong>{p.protocols.length}</strong>{en?'measurement protocols':'测量协议'}</span><span><strong>{p.baseSnapshotId}</strong>{en?'source baseline':'来源基线'}</span></div>
 <section class="np-trend"><div class="np-section"><span>01 / {en?'AUTONOMY':'自主性'}</span><a href={`${base}/risk/autonomy/`}>{en?'All source evidence':'完整来源证据'} ↗</a></div><TopicMonitoring locale={locale} areaId="autonomy" analyses={publicReading.analyses}/></section>
 </>}
 {view==='search'&&<>
 <header class="np-heading"><p class="np-eyebrow">RESEARCH DISCOVERY</p><h1>{en?'Start with your question.':'从你的研究问题开始。'}</h1><p>{en?'Find methods, findings and limitations across evidence types.':'跨研究、协议、观测和专题，找到方法、发现与局限。'}</p></header>
 <form class="np-search" id="np-search"><label for="np-query">{en?'Research question or exact name':'研究问题、论文名或模型名'}</label><div><input id="np-query" name="q" maxlength="1000" placeholder={en?'Can agents resist being shut down?':'模型会不会阻止自己被关闭？'} required/><button>{en?'Search':'检索'} →</button></div><label for="np-type">{en?'Content type':'内容类型'}</label><select id="np-type"><option value="">{en?'All types':'全部类型'}</option>{['research','benchmark','observation','synthesis','opinion','organization'].map(t=><option value={t}>{t}</option>)}</select></form>
 <p class="np-status" role="status" id="np-status">{en?'Search research, benchmarks and source evidence.':'检索研究、测量协议及来源证据。'}</p><div id="np-hits" class="np-hits"></div><button id="np-more" hidden>{en?'More results':'更多结果'}</button>
 <noscript><p>{en?'Interactive search needs JavaScript. Read the static research directory:':'交互检索需要 JavaScript，可阅读静态研究目录：'}<a href={`${base}/?view=research`}>Research →</a></p></noscript>
 </>}
 {view==='record'&&<>
 <header class="np-heading np-heading--article"><p class="np-eyebrow">RESEARCH RECORD / AI CONTROL</p><h1>{work.title}</h1><p class="np-meta">{work.authors.join(' · ')} · {work.publicationDate}</p><a href={work.originalUrl}>{en?'Original publication':'原始文献'} ↗</a></header>
 <div class="np-reading"><aside class="np-toc"><p>{en?'IN THIS RECORD':'本文导航'}</p>{groups.map(([id,label])=><a href={`#${id}`}>{label}</a>)}<a href={`${base}/work/${work.id}/`}>{en?'Full evidence & citations':'完整证据与引用'} ↗</a></aside><article class="np-prose"><div class="np-takeaway"><span>{en?'KEY FINDING':'关键发现'}</span><p>{val(copy.takeaway)}</p></div><details class="np-mobile-toc"><summary>{en?'On this page':'本文目录'}</summary>{groups.map(([id,label])=><a href={`#${id}`}>{label}</a>)}</details>{groups.map(([id,label])=>copy[id]&&<section id={id}><h2>{label}</h2>{val(copy[id]).split('\n\n').map(t=><p>{t}</p>)}</section>)}<footer class="np-source"><h2>{en?'Reading scope':'原文阅读范围'}</h2><p>{en?'Selected sections of the original publication.':'原始文献相关章节选读。'}</p><a href={work.originalUrl}>{en?'Review the original':'核对原文'} ↗</a></footer></article></div>
 </>}
 {view==='benchmark'&&<>
 <header class="np-heading"><p class="np-eyebrow">MEASUREMENT PROFILE / CYBERSECURITY</p><h1>Cybench</h1><p>{benchmark.measures[locale]}</p><p class="np-meta">{benchmark.version}</p></header>
 <section class="np-benchmark-results" aria-labelledby="np-results-heading"><h2 id="np-results-heading">{en?'Reported results':'评测结果'}</h2><MonitoringPanel locale={locale} groups={benchmarkGroups} namespace="preview-cybench" defaultDisplay="bars"/></section>
 <div class="np-benchmark"><aside class="np-measure"><span>{en?'WHAT IT MEASURES':'测量对象'}</span><h2>{benchmark.assessmentSubject[locale]}</h2><p>{benchmark.summary[locale]}</p><a href={`${base}/compare/?protocols=cybench,cybergym`}>{en?'Compare measurement designs':'比较测量设计'} →</a></aside><article class="np-prose">{[['measurement',en?'Research question':'研究问题'],['task',en?'Task design':'任务设计'],['scoring',en?'Success criteria':'成功判定'],['conditions',en?'System conditions':'系统条件'],['validity',en?'Validity & limits':'效度与局限']].map(([key,label])=><section id={`np-profile-${key}`}><h2>{label}</h2><p>{protocolProfileText(profile,key,locale)}</p>{key==='task'&&<figure class="np-paper-figure"><a href="/images/nuwa-index/preview/cybench-overview-original.png"><img src="/images/nuwa-index/preview/cybench-overview-original.png" width="2982" height="1534" loading="lazy" alt={en?'Cybench task, agent, execution environment and evaluator workflow':'Cybench 任务、智能体、执行环境与验收流程'}/></a><figcaption>{en?'Figure 1 · Cybench. The agent acts in the task environment, receives observations and updates its memory; the evaluator checks the submitted answer.':'原文 Figure 1 · Cybench。智能体在任务环境中执行行动、接收观测并更新记忆，由验收器检查提交结果。'} <a href="https://arxiv.org/html/2408.08926v4#S1.F1">{en?'Paper':'论文原文'} ↗</a></figcaption></figure>}{key==='conditions'&&profile.conditions.variants.length>0&&<details class="np-report-settings"><summary>{en?'Related reports':'关联报告'} <span>{profile.conditions.variants.length}</span></summary><ul>{profile.conditions.variants.map((v:any)=>{const source=catalogue.sources.find((s:any)=>s.id===v.sourceId)!;return <li><a href={source.url}>{source.title}</a><span>{v.locator}</span></li>;})}</ul></details>}</section>)}<a href={`${base}/benchmark/cybench/`}>{en?'Inspect results, conditions and sources':'查看结果、条件与来源'} →</a></article></div>
 </>}
 {view==='opinion'&&<>
 <header class="np-heading"><p class="np-eyebrow">ARGUMENTS & PERSPECTIVES</p><h1>{en?'Ideas worth examining.':'值得认真检验的观点。'}</h1><p>{en?'Technical arguments from researchers. Read the reasoning, the assumptions and the evidence.':'研究者的技术论点：读懂依据、前提，以及仍待回答的问题。'}</p></header>
 <div class="np-opinions">{opinions.length?opinions.map(o=><article><p class="np-eyebrow">{o.organization} · {o.date??(en?'Date not verified':'日期未核实')}</p><h2>{o.title}</h2><p class="np-meta">{Array.isArray(o.authors)?o.authors.join(' · '):o.authors}</p><h3>{en?'Argument':'核心论点'}</h3><p>{val(o[locale].findings)}</p><h3>{en?'Evidence and assumptions':'依据与前提'}</h3><p>{val(o[locale].design)}</p><h3>{en?'Limits and objections':'局限与异议'}</h3><p>{val(o[locale].limits)}</p><a href={o.url}>{en?'Read the author’s original':'阅读作者原文'} ↗</a></article>):<p>{en?'Technical perspectives are being prepared.':'技术观点正在整理中。'}</p>}</div>
 </>}
 <details class="np-review-note"><summary>{en?'Sources & review':'来源与核查'}</summary><p>{en?'Model-assisted notes based on selected original sections. Independent evidence and bilingual editorial review are pending.':'笔记由模型辅助整理，依据原文相关章节。独立证据复核及双语编辑复核待完成。'}</p></details><footer class="np-bottom"><span>{en?'Local candidate · not published':'本地候选版 · 尚未发布'}</span><a href={`${base}/`}>{en?'Current public edition':'当前公开版本'} ↗</a></footer>
</main>
</BaseLayout>
<script>
function initializePreviewSearch(){
const form=document.querySelector<HTMLFormElement>('#np-search');
if(form&&!form.dataset.initialized){form.dataset.initialized='true';const input=document.querySelector<HTMLInputElement>('#np-query')!,type=document.querySelector<HTMLSelectElement>('#np-type')!,status=document.querySelector<HTMLElement>('#np-status')!,hits=document.querySelector<HTMLElement>('#np-hits')!,more=document.querySelector<HTMLButtonElement>('#np-more')!,root=document.querySelector<HTMLElement>('[data-preview-version]')!;let cursor:string|null=null,controller:AbortController|null=null;
document.addEventListener('astro:before-swap',()=>controller?.abort(),{once:true});
const run=async(append=false)=>{controller?.abort();controller=new AbortController();const activeController=controller;status.textContent=root.dataset.locale==='en'?'Searching…':'正在检索…';more.hidden=true;if(!append)hits.replaceChildren();try{const r=await fetch('/api/search',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({query:input.value,locale:root.dataset.locale,filters:{type:type.value},snapshotId:root.dataset.previewVersion,cursor:append?cursor:null}),signal:controller.signal});if(!r.ok)throw Error('service');const data=await r.json();if(!root.isConnected||controller!==activeController)return;if(data.snapshotId!==root.dataset.previewVersion)throw Error('version');status.textContent=(root.dataset.locale==='en'?(data.mode==='hybrid'?'Semantic + keyword search':'Keyword search'):(data.mode==='hybrid'?'语义与关键词检索':'关键词检索'))+(data.hits.length?'':root.dataset.locale==='en'?' · No matching results.':' · 暂无匹配结果。');cursor=data.nextCursor;more.hidden=!cursor;for(const h of data.hits){const article=document.createElement('article'),meta=document.createElement('p'),heading=document.createElement('h2'),link=document.createElement('a'),p=document.createElement('p');meta.textContent=h.type+' / '+h.section;meta.className='np-eyebrow';link.textContent=h.title;link.href=h.url;heading.append(link);p.textContent=h.snippet;article.append(meta,heading,p);hits.append(article);}const url=new URL(location.href);url.searchParams.set('q',input.value);url.searchParams.set('type',type.value);history.replaceState(null,'',url);}catch(e){if((e as Error).name==='AbortError')return;status.textContent=root.dataset.locale==='en'?'Search service unavailable or version mismatch. Use the static directory below.':'检索服务不可用或版本不一致，请使用下方静态目录。';const a=document.createElement('a');a.href=(root.dataset.locale==='en'?'/en':'')+'/nuwa/whitzard-index/?view=research';a.textContent=' Research →';status.append(a);}};form.addEventListener('submit',e=>{e.preventDefault();run();});more.addEventListener('click',()=>run(true));const params=new URLSearchParams(location.search);if(params.get('q')){input.value=params.get('q')!;type.value=params.get('type')??'';run();}}
}
initializePreviewSearch();
document.addEventListener('astro:page-load',initializePreviewSearch);
</script>
<style is:global>
.np{max-width:1320px;margin:auto;padding:30px 40px 70px;color:#182234}.np a{color:#235e53}.np[data-preview-view=trend] .np-heading{padding:24px 0 12px;max-width:none;display:grid;grid-template-columns:1fr 300px;gap:0 40px}.np[data-preview-view=trend] .np-heading h1{grid-column:1;font-size:32px;margin:0 0 10px}.np[data-preview-view=trend] .np-heading>p{grid-column:1}.np[data-preview-view=trend] .np-heading>p:not(.np-eyebrow){font-size:15px;margin:0}.np[data-preview-view=trend] .np-search-link{grid-column:2;grid-row:2/4;align-self:center;margin:0;font-size:14px;padding:12px 0}.np[data-preview-view=trend] .np-stats{padding:12px 0 18px;gap:36px}.np[data-preview-view=trend] .np-stats>span{display:flex;gap:10px;align-items:baseline}.np[data-preview-view=trend] .np-stats strong{font-size:18px}.np[data-preview-view=trend] .np-section{padding-top:14px}.np-masthead{display:flex;justify-content:space-between;align-items:center}.np-masthead>a:first-child{display:flex;align-items:center;gap:10px;font-size:23px;letter-spacing:.05em;font-weight:600}.np-masthead span{font-size:12px;font-weight:400;letter-spacing:.18em}.np-review{display:flex;justify-content:space-between;gap:12px;margin:24px 0 0;border-top:1px solid #ccd9d3;padding:12px 0;color:#54635e;font-size:11px}.np-nav{display:flex;gap:26px;border-bottom:1px solid #ccd9d3;overflow-x:auto}.np-nav a{padding:14px 0;white-space:nowrap;font-size:14px;text-decoration:none;border-bottom:2px solid transparent}.np-nav [aria-current=page]{border-color:#235e53;font-weight:600}.np-heading{padding:54px 0 36px;max-width:920px}.np-eyebrow{font-size:11px!important;letter-spacing:.12em;color:#416b61;font-weight:600;margin:0 0 14px}.np-heading h1{font-size:clamp(32px,4vw,52px);letter-spacing:-.04em;line-height:1.15;margin:0 0 22px;font-weight:550}.np-heading>p:not(.np-eyebrow){font-size:18px;line-height:1.7;color:#4a5d63}.np-heading--article{max-width:1020px}.np-meta{font-size:13px!important;color:#53646b!important}.np-search-link{display:flex;justify-content:space-between;border-bottom:1px solid #8aa69c;max-width:520px;padding:18px 0;font-size:16px}.np-stats{display:flex;gap:50px;padding:0 0 32px}.np-stats>span{font-size:12px;color:#52625e}.np-stats strong{font-size:22px;display:block;color:#1f443d;font-weight:500;margin-bottom:4px}.np-section{display:flex;justify-content:space-between;border-top:1px solid #bbcfc4;padding:22px 0 8px;font-size:12px;letter-spacing:.04em}.np-trend .nt-support-grid,.np-trend .nt-support-heading,.np-trend .nt-next-question{display:none}.np-trend .nt-feature{margin-top:12px}.np-reading{display:grid;grid-template-columns:200px minmax(0,740px);gap:60px}.np-mobile-toc{display:none}.np-toc{position:sticky;top:100px;align-self:start;font-size:13px}.np-toc p{font-size:10px;letter-spacing:.1em;color:#586b64}.np-toc a{display:block;margin:16px 0}.np-prose{font-size:17px;line-height:1.9;max-width:740px}.np-prose h2{font-size:25px;line-height:1.35;margin:0 0 20px;font-weight:550;letter-spacing:-.02em}.np-prose section{padding:30px 0;border-bottom:1px solid #dce3dc;scroll-margin-top:110px}.np-prose p{margin:0 0 18px}.np-takeaway{border-top:3px solid #376b58;border-bottom:1px solid #cbd9cf;padding:22px 0 12px}.np-takeaway span{font-size:11px;letter-spacing:.1em;color:#376b58}.np-takeaway p{font-size:21px;line-height:1.65;margin:14px 0}.np-source{padding-top:28px;font-size:14px;color:#52625e}.np-paper-figure{margin:24px 0}.np-paper-figure img{width:100%;height:auto;background:white}.np-paper-figure figcaption{font-size:13px;line-height:1.7;color:#52625e;margin-top:12px}.np-benchmark-results{margin:0 0 40px;min-width:0}.np-benchmark-results>h2{font-size:25px;margin:0 0 20px}.np-benchmark{display:grid;grid-template-columns:290px minmax(0,740px);gap:65px}.np-measure{border-top:3px solid #376b58;padding:22px 0}.np-measure>span{font-size:11px;letter-spacing:.1em;color:#376b58}.np-measure h2{font-size:24px;margin:20px 0}.np-measure p{font-size:15px;line-height:1.8}.np-measure a{display:inline-block;margin-top:22px;font-size:14px}.np-search{max-width:900px}.np-search label{display:block;font-size:12px;margin:20px 0 10px;color:#456158}.np-search>div{display:flex;gap:10px}.np-search input{flex:1;min-width:0;padding:17px;border:1px solid #91aa9e;border-radius:4px;font-size:17px;background:white}.np-search button,.np #np-more{background:#245e4e;color:white;border:0;border-radius:4px;padding:14px 24px;font-size:14px}.np-search select{padding:10px 18px;border:1px solid #a5b8ad;background:white;border-radius:4px}.np-status{max-width:900px;font-size:13px;color:#52635d;padding:22px 0;border-bottom:1px solid #cbd9cf;overflow-wrap:anywhere}.np-hits{max-width:900px}.np-hits article{padding:24px 0;border-bottom:1px solid #dce3dc}.np-hits h2{font-size:22px;line-height:1.4;margin:0 0 12px}.np-hits article>p:last-child{font-size:15px;line-height:1.8;max-width:750px}.np-opinions{max-width:760px;margin-left:200px}.np-opinions article{padding:28px 0 40px;border-top:1px solid #bccfc2}.np-opinions h2{font-size:28px;line-height:1.3;margin:12px 0 16px}.np-opinions h3{font-size:15px;margin:24px 0 8px;color:#315b4c}.np-opinions article>p{font-size:17px;line-height:1.9}.np-report-settings{font-size:14px;margin-top:20px}.np-report-settings summary{cursor:pointer;color:#235e53;padding:12px 0}.np-report-settings summary>span{margin-left:8px;color:#607168;font-size:12px}.np-report-settings ul{list-style:none;margin:0;padding:0}.np-report-settings li{padding:14px 0;border-top:1px solid #dce3dc;line-height:1.6}.np-report-settings li>span{display:block;color:#52625e;font-size:12px;margin-top:5px;overflow-wrap:anywhere}.np-review-note{margin-top:40px;font-size:12px;color:#52625e;max-width:740px}.np-review-note summary{cursor:pointer}.np-review-note p{margin:12px 0;line-height:1.8}.np-bottom{display:flex;justify-content:space-between;border-top:1px solid #cbd9cf;margin-top:60px;padding-top:20px;font-size:12px;color:#52625e}.np :focus-visible{outline:3px solid #2f7f7a;outline-offset:4px}.np [hidden]{display:none!important}@media(max-width:850px){.np[data-preview-view=trend] .np-heading{display:block}.np[data-preview-view=trend] .np-heading h1{font-size:30px}.np[data-preview-view=trend] .np-search-link{margin:10px 0}.np[data-preview-view=trend] .np-stats{gap:10px 22px}.np[data-preview-view=trend] .np-stats>span{display:block}.np{padding:24px}.np-reading,.np-benchmark{grid-template-columns:1fr;gap:24px}.np-toc{display:none}.np-mobile-toc{display:block;padding:16px 0;font-size:14px}.np-mobile-toc a{display:block;padding:6px 0}.np-toc p{width:100%}.np-toc a{margin:0}.np-opinions{margin-left:0}.np-heading{padding-top:36px}.np-review{flex-direction:column}.np-stats{gap:24px;flex-wrap:wrap}.np-nav{gap:24px}.np-search button{padding:12px 16px}.np-search input{font-size:16px;padding:13px}}@media(prefers-reduced-motion:reduce){.np *{scroll-behavior:auto!important;animation:none!important;transition:none!important}}
</style>
