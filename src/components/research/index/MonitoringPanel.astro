---
import {modelSizeLegend} from '../../../lib/nuwa-intelligence/modelSize.mjs';
import {renderMonitorChart} from '../../../lib/nuwa-intelligence/chartServer.mjs';
import EvidenceDataTable from './EvidenceDataTable.astro';
import OrganizationMark from './OrganizationMark.astro';
import type {Locale} from '../../../i18n/config';
import {catalogue,indexBase} from '../../../data/nuwa-index';
import {localizedPath} from '../../../i18n/config';
import {monitorLegend,serializeMonitoringPayload,comparisonRows,analysisState} from '../../../lib/nuwa-intelligence/monitoring.mjs';
import {monitorDataSubset} from '../../../lib/nuwa-intelligence/monitorPayload.mjs';
import {primaryMetricOrder} from '../../../lib/nuwa-intelligence/editorial.mjs';
import {isConditionMatrix,orderChartRows} from '../../../lib/nuwa-intelligence/monitorChart.mjs';
import {displayRows} from '../../../lib/nuwa-intelligence/panorama.mjs';
interface Props {locale:Locale;groups:any[];namespace:string;defaultDisplay?:string;analyses?:any[];featured?:boolean;compact?:boolean;indicatorIds?:string[]}
const {locale,groups,namespace,defaultDisplay='timeline',analyses=[],featured=false,compact=false,indicatorIds=[]}=Astro.props,en=locale==='en',base=localizedPath(indexBase,locale),group=groups[0];
const rows=orderChartRows(group?(group.level==='panorama'?displayRows(catalogue,group,{locale}):comparisonRows(catalogue,group,{locale}).map(r=>({...r,key:r.resultId+'|'+r.metricId}))):[],group);
const matrix=isConditionMatrix(rows);
const initialDisplay=matrix?'bars':defaultDisplay==='timeline'&&rows.filter(r=>r.releaseDate).length<2?'bars':defaultDisplay;
const subset=monitorDataSubset(catalogue,groups);
const deferredPayload=namespace.startsWith('topic-')?`${indexBase}/monitor-data/${catalogue.snapshotId}--${locale}--${namespace.slice(6)}.json`:null;
const visibleAnalyses=analyses.flatMap((a:any)=>{const sourceGroup=catalogue.monitoring?.groups.find(g=>g.id===a.groupId);if(!sourceGroup||!['current','local-review'].includes(analysisState(catalogue,sourceGroup,a)))return[];const appliesTo=groups.filter(g=>g.id===a.groupId||g.sourceGroupIds?.includes(a.groupId)).map(g=>g.id);return appliesTo.length?[{...a,appliesTo,scope:sourceGroup.title}]:[];});
---
{group&&<nuwa-monitor class:list={["nm-monitor nv-panel",{"nv-featured":featured,"nv-compact":compact}]} data-featured={featured||undefined} data-namespace={namespace} data-snapshot={catalogue.snapshotId}>
<script type="application/json" data-monitor-data data-src={deferredPayload} is:inline set:html={deferredPayload?'':serializeMonitoringPayload({snapshotId:catalogue.snapshotId,data:subset,groups,namespace,locale,analyses:visibleAnalyses,defaultDisplay:initialDisplay,compact:featured||compact})}/>
<header class="nv-panel-heading"><p class="ni-kicker">{en?'PUBLISHED EVIDENCE':'已发表证据'}</p><h3 data-monitor-title>{group.title[locale]}</h3><p data-monitor-description>{group.description[locale]}</p></header>
<form class="nv-monitor-toolbar" data-monitor-controls hidden>
<label class="nv-metric"><span>{en?'Benchmark / metric':'Benchmark／指标'}</span><select name="group">{groups.map(g=><option value={g.id} hidden={featured&&indicatorIds.length>0&&!indicatorIds.includes(g.id)}>{g.title[locale]}</option>)}</select></label>
<label class="nv-model"><span>{en?'Model / system':'模型／系统'}</span><select name="model"><option value="">{en?'All systems':'全部系统'}</option>{[...new Map(rows.map(r=>[r.modelId??`system:${r.system}`,r.modelName??r.system])).entries()].map(([id,label])=><option value={id}>{label}</option>)}</select></label>
<details class="nv-advanced"><summary>{en?'Filters':'筛选'}</summary><div class="nv-advanced-fields">
<label><span>{en?'Developer':'模型开发者'}</span><select name="developer"><option value="">{en?'All developers':'全部开发者'}</option>{monitorLegend(rows,catalogue,locale).filter(d=>d.developerId).map(d=><option value={d.developerId}>{d.label}</option>)}</select></label>
<label><span>{en?'Evidence cutoff':'证据截止日期'}</span><input type="date" name="asOf" max={catalogue.monitoring?.cutoff}/></label>
<label><span>{en?'Evidence scope':'证据范围'}</span><select name="evidence"><option value="all">{en?'All reported evidence':'全部已报告证据'}</option><option value="strict">{en?'Strictly comparable':'严格可比'}</option></select></label>
<label><span>{en?'Find a system or evaluator':'查找系统或评测方'}</span><input name="q" type="search"/></label><label><span>{en?'Task scope':'任务范围'}</span><select name="facet"><option value="all">{en?'All task scopes':'全部任务范围'}</option>{group.facets?.map((f:any)=><option value={f.id}>{f.label[locale]}</option>)}</select></label><label><span>{en?'Time basis':'时间口径'}</span><select name="timeBasis"><option value="retrospective">{en?'Current evidence, retrospectively':'当前证据回溯'}</option><option value="contemporaneous">{en?'Publicly known at cutoff':'截止当时已公开'}</option></select></label></div></details>
</form>
<div class="nv-chart-tools"><div class="nv-view-switch" role="group" aria-label={en?'Evidence view':'证据视图'} data-monitor-views><button type="button" data-display="timeline" hidden={matrix} aria-pressed={initialDisplay==='timeline'}>{en?'Release trend':'发布时间趋势'}</button><button type="button" data-display="bars" aria-pressed={initialDisplay==='bars'}>{matrix?(en?'Conditions':'实验条件'):(en?'Systems':'系统结果')}</button><button type="button" data-display="table" aria-pressed="false">{en?'Data':'数据'}</button></div><label class="nv-chart-sort" data-chart-sort hidden><span>{en?'Order':'排序'}</span><select name="chartSort" aria-label={en?'Chart order':'图表排序'}><option value="metric">{en?`Main metric: ${primaryMetricOrder(group,rows)==='asc'?'low to high':'high to low'}`:`主指标：${primaryMetricOrder(group,rows)==='asc'?'由低到高':'由高到低'}`}</option><option value="release">{en?'Newest models first':'模型发布：由新到旧'}</option><option value="name">{en?'Model name':'模型名称'}</option><option value="source">{en?'Source order':'原文顺序'}</option><option value="value" data-score-sort>{en?'Value: high to low':'数值：由高到低'}</option><option value="value-asc" data-score-sort>{en?'Value: low to high':'数值：由低到高'}</option></select></label><p data-monitor-count aria-live="polite">{rows.length} {en?'observations':'条观测'} · {rows.filter(r=>r.releaseDate).length} {en?'dated':'已定位日期'}</p></div>
<div class="nm-monitor-legend" data-monitor-legend hidden={matrix}>{monitorLegend(rows,catalogue,locale).map(d=><button type="button" data-monitor-developer={d.developerId} style={`--developer-color:${d.color}`} aria-pressed="false"><span aria-hidden="true"/>{d.developerId?<OrganizationMark organizationId={d.developerId} locale={locale}/>:<span>{d.label}</span>}</button>)}</div>
<div class="nv-condition-key" hidden={matrix}><span>● {en?'Matched':'条件匹配'}</span><span>◇ {en?'Configuration differs':'配置差异'}</span><span>□ {en?'Some conditions undisclosed':'部分条件未披露'}</span></div>
<p class="nv-limits" data-monitor-empty hidden></p>
<div class="nm-monitor-plot" data-monitor-plot set:html={renderMonitorChart(rows,group,locale,{display:initialDisplay,all:true,compact:featured||compact})}/>
<ol class="nv-scope-notes" data-scope-notes hidden={group.scopePresentation!=='annotated'}>{group.scopePresentation==='annotated'&&group.facets.map((f:any,i:number)=><li>{group.scopeNotes?.[i]?.[locale]??f.label[locale]}</li>)}</ol>
<aside class="nv-model-size-legend" data-model-size-legend hidden={initialDisplay!=='timeline'||matrix} set:html={modelSizeLegend(rows.filter(r=>r.releaseDate),locale)}/>
<div class="nv-facet-pagination" data-facet-pagination hidden><button type="button" data-facet-prev>←</button><span data-facet-status></span><button type="button" data-facet-next>→</button></div>
<div class="nv-facet-pagination" data-system-pagination hidden><button type="button" data-system-prev>←</button><span data-system-status></span><button type="button" data-system-next>→</button></div>
<p class="nv-unlocated" data-monitor-unlocated>{rows.filter(r=>!r.releaseDate).length>0?(en?`${rows.filter(r=>!r.releaseDate).length} observations lack a verified model release date. They remain in Data and Systems.`:`${rows.filter(r=>!r.releaseDate).length} 条观测尚无已核实的模型发布日期，可在数据与系统结果中查看。`):''}</p>
<section class="nv-selection" data-monitor-selection aria-label={en?'Selected observation':'选中观测'} aria-live="polite"><p>{en?'Select a point or table row to inspect its conditions and provenance.':'选择图中数据点或表格行，查看条件与出处。'}</p></section>
<div class="nv-data-view" data-monitor-table><EvidenceDataTable rows={rows} locale={locale} namespace={namespace} active={false}/></div>
<div class="nv-monitor-footer"><p class="nm-monitor-attribution" data-monitor-attribution>{en?'Evaluated by':'实际评测方'}: {[...new Set(rows.map(r=>r.attribution.evaluator))].join(' · ')}<br/>{en?'Reported by':'报告发布方'}: {[...new Set(rows.map(r=>r.attribution.reporter))].join(' · ')}</p><div class="nv-downloads" data-monitor-actions hidden><button type="button" data-monitor-csv>CSV ↓</button><button type="button" data-monitor-svg>SVG ↓</button></div></div>
<p class="nv-limits" data-monitor-limits hidden={group.level==='panorama'}>{group.limits?.[locale]}</p><p class="nv-limits" data-monitor-measurement-note hidden={group.benchmarkId!=='time-horizons'}>{en?'METR Time Horizon 1.1: the source is no longer actively updated (last update: 8 September 2026). Estimates above 16 hours exceed its reliable measurement range.':'METR Time Horizon 1.1 来源已停止积极更新，最后更新于 2026 年 9 月 8 日。超过 16 小时的估计超出其可靠测量范围。'}</p>

<a class="nv-protocol-link" data-monitor-protocol hidden={featured||compact} href={`${base}/benchmark/${group.benchmarkId}/#monitoring`}>{en?'Protocol, configurations and original evidence':'协议、配置与原始证据'} →</a>
<div class="nm-monitor-analysis" data-monitor-analysis hidden={featured}>{visibleAnalyses.filter(a=>a.appliesTo.includes(group.id)).map(a=><section><p class="ni-kicker">NUWA ANALYSIS · {a.date} · {en?'Model-assisted analysis · independent review pending':'模型辅助分析 · 独立复核待完成'}</p><h4>{a.heading[locale]}</h4><p>{a.analysis[locale]}</p><div class="nm-takeaway"><strong>Take-away</strong><p>{a.takeaway[locale]}</p></div><p class="nv-limits">{a.limits[locale]}</p><p>{a.nextCheck[locale]}</p></section>)}</div>
<noscript><p class="ni-note">{en?'The default figure and complete semantic data table are available without JavaScript.':'默认图表与完整语义化数据表无需 JavaScript。'}</p></noscript>
</nuwa-monitor>}
<script>import '../../../lib/nuwa-intelligence/monitorController';</script>
<style is:global>
.nv-scope-notes{list-style:decimal;font-size:12px;line-height:1.7;color:#52635d;margin:12px 0 18px;padding-left:24px}.nv-scope-notes li{padding:3px 0}
.nv-model-size-legend{color:#435d5c;font-size:11px;line-height:1.7;margin:12px 0}.nv-size-key{display:flex;flex-wrap:wrap;align-items:center;gap:8px 16px}.nv-size-key>span{display:inline-flex;align-items:center;gap:6px;min-height:30px}.nv-size-key i{display:inline-block;box-sizing:border-box;width:var(--point-size);height:var(--point-size);border:1.8px solid #426c61;border-radius:50%;background:#edf4ef}.nv-size-key i.nv-size-unknown{border-style:dashed;background:#fff}.nv-model-size-legend p{font-size:11px!important;line-height:1.7!important;margin:7px 0!important}.nv-model-size-legend a{color:#246654;text-decoration:underline}.nv-panel{display:block;padding:22px;border:1px solid #dae4e1;border-radius:8px;background:#fff;min-width:0;container-type:inline-size}.nv-panel-heading>.ni-kicker{display:none}.nv-panel-heading h3{font-size:22px;line-height:1.4;font-weight:550;letter-spacing:-.025em;margin:0 0 8px}.nv-panel-heading>p{font-size:13px;line-height:1.7;color:#566a71;margin:0 0 16px}.nv-panel.nv-featured{padding:0;border:0;border-radius:0;background:transparent}.nv-featured .nv-panel-heading h3{font-size:18px;line-height:1.4;margin-bottom:12px}.nv-featured .nv-panel-heading>p{display:none}.nv-monitor-toolbar{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr) auto;gap:12px;align-items:end;margin:0;padding:0 0 12px;border-bottom:1px solid #e1e8e5}.nv-monitor-toolbar label,.nv-advanced-fields label{display:grid;gap:5px;font-size:10px;color:#4e6967;min-width:0}.nv-monitor-toolbar :is(select,input){min-width:0;width:100%;height:36px;border:1px solid #cbd9d3;border-radius:5px;background:#fff;padding:6px 8px;font:inherit;font-size:11px;color:#253c47}.nv-advanced{font-size:11px;align-self:end}.nv-advanced summary{cursor:pointer;color:#2c685c;display:list-item;padding:10px 8px}.nv-advanced[open]{grid-column:1/-1}.nv-advanced[open]>summary{padding-left:0}.nv-advanced-fields{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px;margin:12px 0}.nv-chart-sort{display:flex;align-items:center;gap:8px;font-size:12px;color:#43565e}.nv-chart-sort select{font:inherit;border:1px solid #c8d5ce;border-radius:5px;background:#fff;padding:6px 8px;max-width:190px}.nv-chart-tools{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:10px 0 4px}.nv-view-switch{display:flex;gap:3px;border:1px solid #dae4de;border-radius:5px;padding:2px;background:#fff}.nv-view-switch button{font-size:11px;padding:6px 9px;border:0;background:transparent;border-radius:3px;color:#506469;cursor:pointer}.nv-view-switch button[aria-pressed=true]{background:#e9f2ee;color:#165e50}.nv-chart-tools>p{font-size:10px;color:#627778;margin:0;font-variant-numeric:tabular-nums}.nm-monitor-legend{display:flex;flex-wrap:wrap;gap:5px 16px;margin:7px 0}.nm-monitor-legend button{display:inline-flex;align-items:center;gap:6px;font-size:11px;min-height:28px;border:0;padding:0;background:transparent;cursor:pointer}.nm-monitor-legend button>span:first-child{width:8px;height:8px;border-radius:50%;background:var(--developer-color)}.nm-monitor-legend button[aria-pressed=true]{text-decoration:underline;text-underline-offset:4px}.nv-condition-key{display:flex;flex-wrap:wrap;gap:8px 15px;font-size:10px;color:#5c7272;margin:4px 0 0}.nm-monitor-plot{min-width:0;width:100%;overflow:hidden;background:#fff;border-radius:5px;margin-top:4px}.nm-monitor-plot>svg{display:block;width:100%;height:auto}.nv-facet-pagination{display:flex;align-items:center;justify-content:center;gap:12px;font-size:11px;margin:8px 0}.nv-facet-pagination button{border:1px solid #c6d6cd;border-radius:4px;padding:4px 10px;background:#fff;cursor:pointer}.nv-unlocated{font-size:11px;line-height:1.7;color:#637677;margin:9px 0}.nv-unlocated:empty{display:none}.nv-selection{border-top:0;padding:13px 0;margin:14px 0 0;scroll-margin-top:90px}.nv-selection>p{font-size:11px;color:#60737a;line-height:1.7;margin:0}.nv-selection h4{font-size:15px;font-weight:550;line-height:1.6;overflow-wrap:anywhere;margin:0 0 12px}.nv-selection dl{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin:0}.nv-selection dt{font-size:10px;color:#55716b}.nv-selection dd{font-size:11px;line-height:1.8;margin:4px 0 0;overflow-wrap:anywhere}.nv-selection a{font-size:11px;color:#216854;display:inline-block;margin-top:10px}.nv-overlap{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:12px}.nv-overlap button{border:1px solid #c1d3c7;border-radius:4px;background:#fff;font-size:11px;padding:7px;cursor:pointer}.nv-monitor-footer{display:flex;justify-content:space-between;gap:15px;border-top:0;padding-top:12px;margin:14px 0 6px}.nm-monitor-attribution{font-size:10px!important;line-height:1.8!important;color:#516a6b;margin:0;overflow-wrap:anywhere}.nv-downloads{display:flex;gap:5px;align-items:start}.nv-downloads button{font-size:10px;padding:5px 8px;border:1px solid #c8d8ce;background:#fff;border-radius:4px;cursor:pointer}.nv-limits{font-size:11px;line-height:1.75;color:#5d7073;margin:8px 0;max-width:900px}.nv-protocol-link{display:inline-block;font-size:11px;color:#256b59;margin:6px 0}.nv-data-view{margin-top:12px;max-width:100%;overflow:auto}.nm-monitor-analysis{margin-top:20px;border-top:0;padding-top:20px}.nm-monitor-analysis:empty{display:none}.nm-monitor-analysis h4{font-size:22px;line-height:1.4;margin:12px 0}.nm-monitor-analysis p{font-size:14px;line-height:1.85}.nm-takeaway{border-left:3px solid #347863;padding:0 0 0 18px;margin:20px 0}.nm-takeaway strong{font-size:12px;color:#24634f}.nm-takeaway p{margin:7px 0}.nv-panel [hidden]{display:none!important}.nv-compact .nv-panel-heading h3{font-size:18px}.nv-compact .nv-panel-heading>p{display:none}.nv-compact .nv-monitor-toolbar{display:none}.nv-indicator-register{font-size:12px}
@container (max-width:650px){.nv-monitor-toolbar{grid-template-columns:minmax(0,1.5fr) minmax(0,1fr) auto;gap:7px}.nv-advanced-fields{grid-template-columns:1fr 1fr}.nv-selection dl{grid-template-columns:1fr 1fr}.nv-chart-tools{flex-wrap:wrap}.nv-chart-tools>p{font-size:10px}}
@media(max-width:600px){.nv-panel{padding:16px}.nv-featured{padding:0}.nv-monitor-toolbar{grid-template-columns:minmax(0,1fr) auto}.nv-metric{grid-column:1/-1}.nv-model{grid-column:1}.nv-panel-heading h3{font-size:19px}.nv-advanced-fields{grid-template-columns:1fr}.nv-selection dl{grid-template-columns:1fr}.nv-view-switch button{padding:8px 7px}.nv-chart-tools{align-items:start}.nv-monitor-footer{flex-wrap:wrap}.nm-monitor-attribution{font-size:11px!important}.nv-condition-key{font-size:10px}.nv-chart-tools>p{flex-basis:100%;margin-top:4px}}

@media(min-width:1051px){.nv-featured{display:grid;grid-template-columns:minmax(0,1fr) auto;column-gap:10px;align-items:end}.nv-featured>.nv-panel-heading{order:0;grid-column:1/-1}.nv-featured>.nv-monitor-toolbar{order:1;grid-column:1;border-bottom:0;padding:0}.nv-featured>.nv-chart-tools{display:contents}.nv-featured .nv-view-switch{order:1;grid-column:2;align-self:end;height:36px;align-items:center}.nv-featured .nv-chart-tools>p{order:4;grid-column:1/-1;margin:4px 0}.nv-featured>.nm-monitor-plot,.nv-featured>.nv-data-view{order:3;grid-column:1/-1;margin-top:12px}.nv-featured .nv-chart-sort{order:2;grid-column:2;justify-self:end;margin-top:10px}.nv-featured>.nm-monitor-legend{order:2;grid-column:1;margin-top:10px}.nv-featured>.nv-model-size-legend{order:4;grid-column:1/-1}.nv-featured>.nv-condition-key{order:4;grid-column:1/-1}.nv-featured>.nv-facet-pagination{order:5;grid-column:1/-1}.nv-featured>.nv-unlocated{order:6;grid-column:1/-1}.nv-featured>.nv-selection{order:7;grid-column:1/-1}.nv-featured>.nv-monitor-footer{order:8;grid-column:1/-1}.nv-featured>.nv-limits{order:9;grid-column:1/-1}.nv-featured>.nv-protocol-link{order:10;grid-column:1/-1}.nv-featured>.nm-monitor-analysis{order:11;grid-column:1/-1}.nv-featured>noscript{order:12;grid-column:1/-1}}
</style>
