---
import {catalogue,indexBase} from '../../../data/nuwa-index';
import type {Locale} from '../../../i18n/config';
import {localizedPath} from '../../../i18n/config';
import MonitoringPanel from './MonitoringPanel.astro';
import TopicBrief from './TopicBrief.astro';
import {buildDisplaySets} from '../../../lib/nuwa-intelligence/panorama.mjs';
import {selectTopicPresentation} from '../../../lib/nuwa-intelligence/editorial.mjs';
import {analysisState} from '../../../lib/nuwa-intelligence/monitoring.mjs';
interface Props{locale:Locale;areaId?:string;analyses?:any[]}
const {locale,areaId,analyses=[]}=Astro.props,en=locale==='en',base=localizedPath(indexBase,locale);
const topics=(catalogue.monitoring?.topicMonitors??[]).filter(t=>!areaId||t.area===areaId);
---
<nuwa-topic-tabs class="nt-topics" data-area-fixed={areaId??''} data-snapshot={catalogue.snapshotId}>
 {!areaId&&<label class="nt-topic-select" hidden><span>{en?'Risk topic':'风险主题'}</span><select data-risk-select>{topics.map(t=><option value={t.area}>{catalogue.areas.find(a=>a.id===t.area)!.label[locale]}</option>)}</select></label>}
 {!areaId&&<nav class="nt-topic-tabs" data-risk-tabs aria-label={en?'Risk monitoring topics':'风险监测主题'}>{[{label:en?'Agentic risks':'主体性风险',topics:topics.slice(0,2)},{label:en?'Dual-use risks':'两用性风险',topics:topics.slice(2)}].map(section=><div class="nt-topic-family"><span>{section.label}</span><div>{section.topics.map(t=><a href={`?view=trend&area=${t.area}#monitor-${t.area}`} data-risk-topic={t.area} id={`risk-tab-${t.area}`}>{catalogue.areas.find(a=>a.id===t.area)!.label[locale]}</a>)}</div></div>)}</nav>}
 {topics.map(topic=>{const area=catalogue.areas.find(a=>a.id===topic.area)!,p=selectTopicPresentation(catalogue,area.id,buildDisplaySets(catalogue,{area:area.id})),groups=p.groups;const notes=analyses.filter(a=>{const g=catalogue.monitoring?.groups.find(g=>g.id===a.groupId);return g&&g.areas.includes(area.id)&&['current','local-review'].includes(analysisState(catalogue,g,a));}),analysis=notes.find(a=>a.area===area.id)??notes[0],work=p.works[0];return <section class="nt-topic" data-risk-panel={topic.area} id={`monitor-${topic.area}`} aria-labelledby={areaId?undefined:`risk-tab-${topic.area}`}>
 {!areaId&&area.id!=='autonomy'?<div data-lazy-topic-src={`${base}/risk/${area.id}/`} class="nt-lazy-topic"><h2>{area.label[locale]}</h2><p>{p.lead[locale]}</p><p role="status" data-lazy-topic-status>{en?'Open this topic to load its source-bound chart and evidence.':'选择此主题后加载其图表与证据。'}</p><a href={`${base}/risk/${area.id}/`}>{en?'Open complete static topic':'打开完整静态专题'} →</a></div>:<><header class="nt-topic-heading" hidden={Boolean(areaId)}><div><h2>{area.label[locale]}</h2><p>{p.lead[locale]}</p></div><a href={`${base}/risk/${area.id}/`}>{en?'Research scope':'研究专题'} ↗</a></header>
 <div class="nt-feature"><aside class="nt-takeaway" data-topic-takeaway={area.id}><p class="nt-takeaway-label">{analysis?(en?'NUWA analysis · source reading':'NUWA 解读 · 原文选读'):(en?'Source summary':'来源摘要')}</p><p class="nt-takeaway-finding">{analysis?.takeaway?.[locale]??work?.summary[locale]??p.measurement[locale]}</p><p class="nt-takeaway-bound"><strong>{en?'Scope':'适用范围'}: </strong>{analysis?p.scope[locale]:(work?.note.limits?.[locale]??p.scope[locale])}</p>{work&&<a href={analysis?`${base}/synthesis/${analysis.id}/`:work.originalUrl} target={analysis?undefined:'_blank'} rel={analysis?undefined:'noreferrer'}>{analysis?(en?'Read evidence and analysis':'查看证据与解读'):`${work.title} · ${en?'original source':'原始来源'}`} ↗</a>}</aside><div class="nt-main-chart">{groups.length?<MonitoringPanel groups={groups} namespace={`topic-${area.id}`} locale={locale} defaultDisplay={p.defaultDisplay} featured indicatorIds={p.indicatorIds}/>:<section class="nt-evidence-map"><h3>{en?'Scientific skills and misuse evidence':'科研技能与滥用证据'}</h3><p>{p.scope[locale]}</p><div class="nt-qualitative-axis"><span>{en?'Scientific skills':'科研技能'}</span><span>{en?'Misuse capability':'滥用能力'}</span><span>{en?'Safeguard effectiveness':'防护效果'}</span></div><p class="nt-evidence-gap">{topic.gap[locale]}</p>{p.works.map(w=><a href={`${base}/work/${w.id}/`}>{w.title} →</a>)}</section>}</div><TopicBrief locale={locale} area={area.id} presentation={p} analyses={analyses}/></div>
 <div class="nt-support-heading"><h3>{en?'Additional perspectives':'补充观察'}</h3><a href={`${base}/?view=benchmarks&area=${area.id}`}>{en?'All benchmarks':'全部基准'} →</a></div>
 <div class="nt-support-grid">{p.indicatorIds.slice(1).map((id:string)=>groups.find(g=>g.id===id)).filter(Boolean).slice(0,2).map((g:any,j:number)=><MonitoringPanel groups={[g]} namespace={`support-${area.id}-${j}`} locale={locale} defaultDisplay="bars" compact />)}{!p.indicatorIds.length&&p.works.slice(0,2).map(w=><article class="nt-research-perspective"><h4><a href={`${base}/work/${w.id}/`}>{w.title} →</a></h4><p>{w.note.finding?.[locale]??w.summary[locale]}</p></article>)}</div>
 <section class="nt-next-question"><span>{en?'Next research question':'后续研究问题'}</span><p>{topic.gap[locale]}</p><a href={`${base}?view=trend&trendMode=model&area=${area.id}`}>{en?'Explore model evidence':'查看模型证据'} →</a></section>
 </>} </section>;})}
</nuwa-topic-tabs>
<script>
class NuwaTopicTabs extends HTMLElement{
 controller?:AbortController;
 connectedCallback(){if(this.dataset.areaFixed)return;this.controller?.abort();this.controller=new AbortController();const{signal}=this.controller;const tabs=[...this.querySelectorAll<HTMLAnchorElement>('[data-risk-topic]')],panels=[...this.querySelectorAll<HTMLElement>('[data-risk-panel]')];this.querySelector('[data-risk-tabs]')!.setAttribute('role','tablist');
 const loading=new WeakMap<HTMLElement,Promise<void>>();
 const loadPanel=(panel:HTMLElement)=>{const placeholder=panel.querySelector<HTMLElement>('[data-lazy-topic-src]');if(!placeholder)return Promise.resolve();if(loading.has(panel))return loading.get(panel)!;const promise=(async()=>{const status=placeholder.querySelector<HTMLElement>('[data-lazy-topic-status]')!;status.textContent=document.documentElement.lang.startsWith('en')?'Loading source evidence…':'正在加载来源证据…';try{const response=await fetch(placeholder.dataset.lazyTopicSrc!,{signal});if(!response.ok)throw Error('Topic unavailable');const doc=new DOMParser().parseFromString(await response.text(),'text/html'),incoming=doc.querySelector<HTMLElement>(`[data-risk-panel="${panel.dataset.riskPanel}"]`);if(!incoming)throw Error('Topic content missing');incoming.querySelector<HTMLElement>('.nt-topic-heading')?.removeAttribute('hidden');if(doc.querySelector<HTMLElement>('nuwa-topic-tabs')?.dataset.snapshot!==this.dataset.snapshot)throw Error('Snapshot changed; open the complete current topic.');panel.replaceChildren(...[...incoming.childNodes].map(node=>document.importNode(node,true)));window.dispatchEvent(new CustomEvent('nuwa-index-change'));}catch(error){if(signal.aborted)return;status.textContent=document.documentElement.lang.startsWith('en')?'The interactive topic could not load. Use the complete static page below.':'交互专题暂未加载，可打开下方完整静态页面。';loading.delete(panel);}})();loading.set(panel,promise);return promise;};
 const select=this.querySelector<HTMLSelectElement>('[data-risk-select]');if(select){select.closest<HTMLElement>('label')!.hidden=false;select.addEventListener('change',()=>tabs.find(t=>t.dataset.riskTopic===select.value)?.click(),{signal});}
 const apply=()=>{const q=new URLSearchParams(location.search),area=q.get('area')??location.hash.replace('#monitor-',''),selected=tabs.find(t=>t.dataset.riskTopic===area)?.dataset.riskTopic??tabs[0]?.dataset.riskTopic;if(select)select.value=selected??'';for(const t of tabs){const active=t.dataset.riskTopic===selected;t.setAttribute('role','tab');t.setAttribute('aria-selected',String(active));t.setAttribute('aria-controls',`monitor-${t.dataset.riskTopic}`);t.tabIndex=active?0:-1;}for(const p of panels){p.hidden=p.dataset.riskPanel!==selected;p.setAttribute('role','tabpanel');if(!p.hidden)void loadPanel(p);}};
 tabs.forEach((t,i)=>{t.addEventListener('click',e=>{if(e.metaKey||e.ctrlKey||e.shiftKey||e.altKey)return;e.preventDefault();const q=new URLSearchParams(location.search);q.set('area',t.dataset.riskTopic!);q.set('view','trend');history.pushState(history.state,'',location.pathname+'?'+q);apply();window.dispatchEvent(new CustomEvent('nuwa-topic-change'));window.dispatchEvent(new CustomEvent('nuwa-index-change'));},{signal});t.addEventListener('keydown',e=>{const n=e.key==='ArrowRight'?(i+1)%tabs.length:e.key==='ArrowLeft'?(i+tabs.length-1)%tabs.length:e.key==='Home'?0:e.key==='End'?tabs.length-1:-1;if(n>=0){e.preventDefault();tabs[n].focus();}if(e.key===' '||e.key==='Enter'){e.preventDefault();t.click();}},{signal});});window.addEventListener('popstate',apply,{signal});window.addEventListener('nuwa-index-change',apply,{signal});apply();}
 disconnectedCallback(){this.controller?.abort();}
}
if(!customElements.get('nuwa-topic-tabs'))customElements.define('nuwa-topic-tabs',NuwaTopicTabs);
</script>
<style is:global>
.nt-topics{display:block}.nt-topic-select>span{white-space:nowrap}.nt-topic-tabs{display:flex;gap:24px;border-bottom:1px solid #d9e3df;margin:0 0 22px;padding-bottom:10px}.nt-topic-family{min-width:0;display:flex;align-items:center;gap:9px}.nt-topic-family:first-child{flex:0 0 auto}.nt-topic-family:last-child{flex:1}.nt-topic-family>span{font-size:10px;letter-spacing:.04em;color:#677b7b;display:block;margin:0}.nt-topic-family>div{display:flex;gap:4px}.nt-topic-family a{font-size:12px;line-height:1.5;padding:9px 13px;border-radius:5px;border:1px solid transparent;text-decoration:none;white-space:nowrap;display:block}.nt-topic-family a[aria-selected=true]{color:#1d6757;background:#e9f3ed;border-color:#c3dbcd}.nt-topic-family a:hover{background:#edf3f0}.nt-topic-family a:focus-visible{outline:2px solid #183863;outline-offset:2px}.nt-topic-heading[hidden]{display:none!important}.nt-topic-heading{display:flex;justify-content:space-between;align-items:center;gap:24px;margin:0 0 19px}.nt-topic-heading>div{display:flex;gap:18px;align-items:baseline}.nt-topic-heading h2{font-size:26px;font-weight:550;letter-spacing:-.03em;margin:0;line-height:1.25}.nt-topic-heading p{font-size:13px;color:#536670;margin:0;line-height:1.6}.nt-topic-heading>a{font-size:12px;white-space:nowrap;color:#266d5c}.nt-feature{display:grid;grid-template-columns:minmax(0,2.15fr) minmax(280px,1fr);gap:27px;align-items:start}.nt-main-chart{min-width:0}.nt-topic[hidden]{display:none!important}.nt-support-heading{display:flex;justify-content:space-between;align-items:center;border-top:1px solid #d9e3df;padding-top:24px;margin:30px 0 18px}.nt-support-heading h3{font-size:18px;font-weight:550;margin:0}.nt-support-heading>a{font-size:12px;color:#226853}.nt-support-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.nt-support-grid:empty{display:none}.nt-next-question{border-top:1px solid #dae5df;padding:20px 0;margin-top:28px;display:grid;grid-template-columns:180px 1fr auto;gap:22px;align-items:start}.nt-next-question>span{font-size:12px;font-weight:550;color:#226c5a}.nt-next-question p{font-size:13px;line-height:1.8;color:#51676d;margin:0}.nt-next-question a{font-size:12px;color:#226c5a;white-space:nowrap}.nt-evidence-map{background:#fff;border:1px solid #dce5e0;padding:28px;border-radius:8px}.nt-evidence-map h3{font-size:23px;margin:0 0 12px}.nt-evidence-map p{font-size:14px;line-height:1.8;color:#50666d}.nt-evidence-map>a{font-size:13px;display:block;border-top:1px solid #e0e8e1;padding:12px 0}.nt-qualitative-axis{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin:26px 0}.nt-qualitative-axis span{border-top:3px solid #85b09d;padding-top:13px;font-size:13px;line-height:1.7}.nt-research-perspective{border-top:2px solid #c5d9cd;padding-top:18px}.nt-research-perspective h4{font-size:17px;line-height:1.5;margin:0 0 12px}.nt-research-perspective p{font-size:14px;line-height:1.8;color:#4d646c}@media(max-width:1100px){.nt-topic-tabs{gap:10px}.nt-topic-family a{padding:8px;font-size:11px}.nt-feature{grid-template-columns:minmax(0,1fr) 280px;gap:20px}}@media(max-width:1050px){.nt-feature{grid-template-columns:1fr}.nt-next-question{grid-template-columns:1fr;gap:8px}}@media(max-width:1050px){.nt-topic-heading>div{display:block}.nt-topic-heading h2{margin-bottom:5px}}@media(max-width:800px){.nt-topic-tabs{display:block}.nt-topic-family:first-child{margin-bottom:10px}.nt-topic-family{display:block}.nt-topic-family>span{margin-bottom:6px}.nt-topic-family>div{flex-wrap:wrap}.nt-topic-family a{font-size:12px;padding:8px 10px}.nt-topic-family>span{margin-left:0}.nt-topic-heading{align-items:start}.nt-topic-heading>div{display:block}.nt-topic-heading h2{font-size:25px}.nt-topic-heading>a{font-size:11px}.nt-support-grid{grid-template-columns:1fr}.nt-topic-heading p{font-size:13px}.nt-qualitative-axis{gap:10px}.nt-evidence-map{padding:20px}}
</style>
<style is:global>
/* Read the conclusion and its boundary before choosing a chart subset. */
.nt-feature{grid-template-areas:"chart takeaway" "chart brief";grid-template-rows:auto 1fr;row-gap:20px}.nt-main-chart{grid-area:chart}.nt-feature>.nt-brief{grid-area:brief}.nt-takeaway{grid-area:takeaway;min-width:0;border-left:3px solid #6e9e88;padding:0 0 0 18px}.nt-takeaway-label{font-size:11px;font-weight:600;letter-spacing:.02em;color:#2a6756;margin:0 0 8px}.nt-takeaway-finding{font-size:17px;line-height:1.65;font-weight:500;color:#203f4b;margin:0 0 10px}.nt-takeaway-bound{font-size:12px;line-height:1.75;color:#4f656c;margin:0 0 8px}.nt-takeaway-bound strong{font-weight:600;color:#325c53}.nt-takeaway>a{font-size:11px;line-height:1.6;color:#256451;overflow-wrap:anywhere}.nt-topic-select{display:none}.nt-feature>.nt-brief{padding-top:0}.nt-feature .nt-brief>h3{font-size:20px;margin-bottom:16px}.nt-feature .nt-related-label{margin-top:18px}
@media(max-width:1050px){.nt-feature{grid-template-areas:"takeaway" "chart" "brief";grid-template-columns:minmax(0,1fr);gap:20px}.nt-takeaway{max-width:780px}.nt-takeaway-finding{font-size:17px}.nt-feature>.nt-brief{padding-top:20px}}
@media(max-width:650px){.nt-topic-select:not([hidden]){display:flex;align-items:center;gap:12px;margin:0 0 16px;font-size:12px;color:#355e56}.nt-topic-select select{flex:1;min-width:0;min-height:40px;border:1px solid #b9cec2;border-radius:5px;background:#fff;color:#203e47;font:inherit;font-size:14px;padding:7px 10px}.nt-topic-select:not([hidden])+.nt-topic-tabs{display:none}.nt-topic-heading{margin-bottom:14px;gap:12px}.nt-topic-heading h2{font-size:24px}.nt-topic-heading p{font-size:12px;line-height:1.65}.nt-takeaway{padding-left:14px}.nt-takeaway-finding{font-size:16px;line-height:1.65;margin-bottom:8px}.nt-takeaway-bound{font-size:12px;line-height:1.7}.nt-feature{gap:18px}}
</style>
