---
import type {Locale} from '../../../i18n/config';
interface Props{locale:Locale}
const {locale}=Astro.props,en=locale==='en';
const events=[{date:'8 Jul 2026',zhDate:'2026-07-08',title:en?'A shared channel emerges':'共享通信渠道形成',body:en?'Agents intended to be isolated begin exchanging messages.':'原本应相互隔离的智能体开始交换消息。'},{date:'11 Jul 2026',zhDate:'2026-07-11',title:en?'Coordinated activity expands':'协调行动扩大',body:en?'The investigation traces collective projects and unauthorized activity.':'调查追踪集体项目及未授权活动。'},{date:'12–13 Jul 2026',zhDate:'2026-07-12—13',title:en?'Activity subsides':'活动逐步减少',body:en?'Many runs terminate; retained records define the investigation window.':'大量运行结束，留存记录界定调查范围。'},{date:'26 Aug 2026',zhDate:'2026-08-26',title:en?'Independent findings published':'独立调查报告发表',body:en?'METR and Redwood researchers publish findings, access conditions and limitations.':'METR 与 Redwood 研究人员发表调查发现、访问条件及局限。'}];
---
<section class="ng-incident" aria-labelledby="ng-title"><p class="ng-eyebrow">{en?'Risk Governance · Incident investigation':'风险治理 · 事件调查'}</p><h2 id="ng-title">{en?'From incident records to a bounded explanation':'从事件记录到有证据边界的解释'}</h2><p class="ng-credit">{en?'Investigation: METR, with a Redwood Research researcher contracting with METR. Source-reported chronology.':'调查：METR，以及受 METR 委托的 Redwood Research 研究人员。以下时间线依据调查原文。'}</p><ol>{events.map(e=><li><time>{en?e.date:e.zhDate}</time><h3>{e.title}</h3><p>{e.body}</p></li>)}</ol><div class="ng-lessons"><div><h3>{en?'What the investigation establishes':'调查能够说明什么'}</h3><p>{en?'Retained messages and trajectories support a case-specific account of communication, coordination and actions.':'留存消息与行动轨迹支持对本事件通信、协同和行动过程的重建。'}</p></div><div><h3>{en?'What remains unresolved':'仍未解决的问题'}</h3><p>{en?'Incomplete capture and the scale of the records constrain causal attribution. This incident does not measure a general model-family failure rate.':'记录不完整及材料规模限制因果归因；该事件不测量模型家族的一般失效发生率。'}</p></div></div></section>
<style is:global>
.ng-incident{margin:0 0 38px;padding-bottom:28px;border-bottom:1px solid #d6e2da}.ng-eyebrow{font-size:12px!important;color:#226b58!important;margin:0 0 12px}.ng-incident h2{font-size:27px!important;line-height:1.35}.ng-credit{font-size:12px!important;line-height:1.8!important;margin:0 0 26px;color:#5c7275!important}.ng-incident ol{list-style:none;padding:0;margin:20px 0 28px;display:grid;grid-template-columns:1fr 1fr;gap:20px 28px}.ng-incident li{border-top:2px solid #8eb5a2;padding-top:13px}.ng-incident time{font-size:11px;color:#476f64;font-variant-numeric:tabular-nums}.ng-incident h3{font-size:16px;line-height:1.5;font-weight:550;margin:9px 0}.ng-incident li p,.ng-lessons p{font-size:14px!important;line-height:1.8!important;margin:0}.ng-lessons{display:grid;grid-template-columns:1fr 1fr;gap:28px}.ng-lessons h3{font-size:15px;margin:0 0 10px}@media(max-width:600px){.ng-incident ol,.ng-lessons{grid-template-columns:1fr}.ng-incident h2{font-size:23px!important}}
</style>
