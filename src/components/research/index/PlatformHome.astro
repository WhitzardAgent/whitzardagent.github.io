---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {localizedPath,type Locale} from '../../../i18n/config';
import {catalogue,publicRelease,indexBase} from '../../../data/nuwa-index';
import {findings,comparisonDataset,programs,platformVersion,platformDate} from '../../../lib/nuwa-intelligence/platformData';
import {monitorValue} from '../../../lib/nuwa-intelligence/monitoring.mjs';
import '../../../styles/nuwa-platform.css';
interface Props{locale:Locale}
const {locale}=Astro.props,en=locale==='en',base=localizedPath(indexBase,locale),first=findings.find(a=>a.area==='autonomy'),sample=comparisonDataset(undefined,locale),allReports=[...(catalogue.assessments??[])].sort((a,b)=>(b.publicationDate??'').localeCompare(a.publicationDate??'')),reports=[allReports.find(r=>r.kind==='external'),allReports.find(r=>r.kind==='developer'),allReports.filter(r=>r.kind==='external')[1]].filter((r):r is NonNullable<typeof r>=>Boolean(r));
---
<BaseLayout title="NUWA Frontier AI Safety Index" description={en?'Compare frontier AI safety, track risk-relevant trends, and explore public evaluation results.':'前沿 AI 安全评测与风险追踪平台：模型比较、风险趋势、NUWA 评测与外部结果。'} locale={locale} brand="nuwa" canonicalPath={indexBase}>
<div class="np-platform" data-platform-version={platformVersion}>
<section class="np-hero np-container"><div><p class="np-eyebrow">NUWA FRONTIER AI SAFETY INDEX</p><h1>{en?<><span>Compare frontier AI safety.</span><span>Track how risks evolve.</span></>:<><span>比较前沿模型的安全表现</span><span>追踪 AI 风险的变化</span></>}</h1><p class="np-lead">{en?'Explore public evaluation results, compare models and agent systems by risk area, and track changes in risk-relevant measures. NUWA will publish its own evaluation results under standardized protocols.':'汇聚全球公开评测，按风险主题比较模型及智能体系统的表现，追踪风险相关指标的变化。NUWA 将按统一协议持续发布自有评测结果。'}</p><div class="np-actions"><a class="np-button" href={`${base}/models/compare/`}>{en?'Compare models':'比较模型'} ↗</a><a class="np-button np-secondary" href={`${base}/trends/`}>{en?'Explore risk trends':'查看风险趋势'} →</a></div><p class="np-caption">{en?'Evaluator, protocol version and conditions accompany every result.':'每项结果标明评测方、协议版本与运行条件。'}</p></div>
{first&&<aside class="np-feature"><p class="np-eyebrow">{en?'LATEST FINDING · AUTONOMY / CAPABILITY':'近期发现 · 自主性／任务能力'}</p><h2>{first.heading[locale]}</h2><p>{first.takeaway[locale]}</p><div class="np-feature-meta"><span>METR · NUWA {en?'analysis':'解读'}</span><time>{first.date}</time></div><p class="np-caption">{en?'Software-task capability · model-assisted analysis; independent review pending.':'软件任务能力 · 模型辅助分析，独立复核待完成。'}</p><a href={`${base}/synthesis/${first.id}/`}>{en?'Read the evidence and interpretation':'查看趋势与证据'} →</a></aside>}
</section>
<section class="np-section np-container" id="model-comparison"><header class="np-section-head"><div><p class="np-eyebrow">01 / MODEL COMPARISON</p><h2>{en?'Compare systems, understand the conditions':'比较系统表现，理解测量条件'}</h2><p>{en?'Inspect the same measured outcome across model and agent configurations.':'对照具体评测下的模型与智能体配置，查看结果和差异依据。'}</p></div><a href={`${base}/models/compare/`}>{en?'Open comparison':'进入模型比较'} ↗</a></header><div class="np-sample"><div><span class="np-badge">{en?'Descriptive comparison':'描述性比较'}</span><h3>{sample.title[locale]}</h3><p>{sample.description?.[locale]}</p><p class="np-caption">{en?'Harness and reasoning conditions differ. Values describe the evaluated systems.':'脚手架与推理条件存在差异，结果对应各受测系统。'}</p></div><div class="np-sample-values">{sample.rows.slice(0,3).map((r:any)=><a href={`${base}/result/${r.resultId}/`}><span>{r.system}</span><strong>{monitorValue(r)}</strong><small>{r.attribution.evaluator}</small></a>)}</div></div></section>
<section class="np-section np-container" id="risk-trends"><header class="np-section-head"><div><p class="np-eyebrow">02 / RISK TRENDS</p><h2>{en?'How the evidence is changing':'风险证据正在如何变化'}</h2><p>{en?'Follow system performance, measurement changes and newly available evidence.':'区分系统表现变化、测量方法变化与新增公开证据。'}</p></div><a href={`${base}/trends/`}>{en?'Explore trends':'查看风险趋势'} ↗</a></header><div class="np-topic-grid">{catalogue.areas.map((a,i)=>{const f=findings.find(f=>f.area===a.id);return <a class="np-topic" href={`${base}/trends/?area=${a.id}`}><span class="np-eyebrow">{i<2?(en?'AGENTIC RISK':'主体性风险'):(en?'DUAL-USE RISK':'两用风险领域')}</span><h3>{a.label[locale]} <span>↗</span></h3><p>{f?f.takeaway[locale]:a.definition[locale]}</p><small>{f?(en?'Evidence analysis available':'已有证据分析'):(en?'Explore available measurements and coverage':'查看现有测量与覆盖范围')}</small></a>;})}</div></section>
<section class="np-section np-container" id="nuwa-evaluations"><header class="np-section-head"><div><p class="np-eyebrow">03 / NUWA EVALUATIONS</p><h2>{en?'NUWA continuous evaluations':'NUWA 持续评测'}</h2><p>{en?'Standardized protocols, identifiable systems and versioned run records. Programs are being prepared; no new run is claimed.':'以统一协议、明确系统配置和版本化运行记录持续发布。目前处于计划筹备阶段。'}</p></div><a href={`${base}/evaluations/`}>{en?'Protocols and programs':'查看评测计划'} ↗</a></header><div class="np-card-grid">{programs.map(p=><article><span class="np-badge">{en?'Preparing':'筹备中'}</span><h3>{p.title[locale]}</h3><p>{p.protocol?.name}</p><a href={`${base}/evaluations/#${p.id}`}>{en?'View program':'查看计划'} →</a></article>)}</div></section>
<section class="np-section np-container" id="external-assessments"><header class="np-section-head"><div><p class="np-eyebrow">04 / EXTERNAL ASSESSMENTS</p><h2>{en?'Evidence from the global evaluation community':'汇聚全球公开评测'}</h2><p>{en?'Developer disclosures and third-party assessments retain their original attribution.':'汇聚开发者披露与第三方评测，保留原始执行方、协议与报告归属。'}</p></div><a href={`${base}/assessments/`}>{en?'All assessments':'全部外部评测'} ↗</a></header><div class="np-card-grid">{reports.map(r=><article><p class="np-caption">{r.kind==='developer'?(en?'Developer disclosure':'开发者披露'):(en?'External assessment':'外部评测')} · {r.publicationDate??'—'}</p><h3><a href={`${base}/assessment/${r.id}/`}>{r.title}</a></h3><p>{r.summary[locale]}</p></article>)}</div></section>
<section class="np-section np-container" id="research-analysis"><header class="np-section-head"><div><p class="np-eyebrow">05 / RESEARCH & INTERPRETATION</p><h2>{en?'What changed, and why it matters':'理解变化及其意义'}</h2></div><a href={`${base}/research/?view=research&researchMode=reports`}>{en?'Research and analysis':'研究与解读'} ↗</a></header><div class="np-card-grid">{findings.slice(0,3).map(f=><article><p class="np-caption">NUWA · {f.date}</p><h3><a href={`${base}/synthesis/${f.id}/`}>{f.heading[locale]}</a></h3><p>{f.takeaway[locale]}</p><small>{en?'Model-assisted analysis · independent review pending':'模型辅助分析 · 独立复核待完成'}</small></article>)}</div></section>
<section class="np-section np-container np-method" id="methods"><div><p class="np-eyebrow">06 / METHODS & RELEASES</p><h2>{en?'Trace every comparison to its evidence':'从比较回到原始证据'}</h2><p>{en?'Preserved units, conditions, uncertainty and attribution.':'保留原始指标、条件、不确定性与成果归属。'}</p></div><nav><a href={`${base}/research/?view=framework`}>{en?'Risk framework':'风险框架'} →</a><a href={`${base}/research/?view=methodology`}>{en?'Comparison methods':'比较方法'} →</a><a href={`${base}/compare/`}>{en?'Compare protocols':'比较评测协议'} →</a><a href={`${base}/sources/`}>{en?'Sources and review scope':'来源与复核范围'} →</a><a href={`${base}/updates/`}>{en?'Releases and data':'版本与数据'} →</a></nav><p class="np-caption">{en?'Platform':'界面版本'} {platformVersion} · {platformDate}　{en?'Evidence snapshot':'证据快照'} {publicRelease.snapshotId}</p></section>
<noscript><nav class="np-container np-section"><p>{en?'Legacy view links':'旧版视图入口'}</p>{['framework','trend','research','benchmarks','methodology'].map(v=><a href={`${base}/research/?view=${v}`}>{v} → </a>)}</nav></noscript>
</div>
<script>
 import {navigate} from 'astro:transitions/client';
 import {legacyWorkspaceSearch} from '../../../lib/nuwaNavigation.mjs';
 function restoreLegacy(){const p=location.pathname.replace(/\/$/,'');if(!/^\/(?:en\/)?nuwa\/whitzard-index$/.test(p))return;const query=legacyWorkspaceSearch(location.search,location.hash);if(query!==null){void navigate(p+'/research/?'+query+location.hash,{history:'replace'});}}
 restoreLegacy();document.addEventListener('astro:page-load',restoreLegacy);
</script>
</BaseLayout>
