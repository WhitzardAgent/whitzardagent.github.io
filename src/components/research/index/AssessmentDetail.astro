---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {catalogue,indexBase} from '../../../data/nuwa-index';
import {localizedPath,type Locale} from '../../../i18n/config';
import PageSources from '../PageSources.astro';
import EvidenceChart from './EvidenceChart.astro';
import {modelOriginLabels} from '../../../lib/modelEvidence.mjs';
import '../../../styles/nuwa-index.css';
interface Props{locale:Locale;id:string}
const {locale,id}=Astro.props,en=locale==='en',a=catalogue.assessments!.find(a=>a.id===id)!,base=localizedPath(indexBase,locale),links=catalogue.assessmentEvidence!.filter(l=>l.assessmentId===id),variants=catalogue.protocolVariants!.filter(v=>a.sections.some(s=>s.variantIds.includes(v.id))),refs=[{sourceId:a.sourceId,appliesTo:en?'Assessment report':'评估报告'},...links.flatMap(l=>{const r=catalogue.results.find(r=>r.id===l.resultId);return r?[{sourceId:r.sourceId,locator:r.locator,appliesTo:en?'Numerical results':'数值结果'}]:[];})];
---
<BaseLayout locale={locale} brand="nuwa" title={`${a.title} — NUWA Index`} description={a.summary[locale]} canonicalPath={`${indexBase}/assessment/${id}`}>
<article class="ni-page nm-assessment"><div class="site-container"><header class="ni-header"><a class="ni-back" href={`${base}?view=reports#ni-reports`}>← {en?'Assessments and reports':'评估与报告'}</a><p class="ni-kicker">{a.kind==='developer'?(en?'DEVELOPER DISCLOSURE':'开发者披露'):(en?'EXTERNAL ASSESSMENT':'外部评估')} · {a.publisherIds.map(id=>catalogue.organizations.find(o=>o.id===id)!.name[locale]).join(' · ')}</p><h1>{a.title}</h1><p class="ni-lead">{a.summary[locale]}</p><p class="ni-note">{en?'Published':'发表'} {a.publicationDate??(en?'Not verified':'未核实')}{a.updatedDate&&` · ${en?'Updated':'修订'} ${a.updatedDate}`}</p><a href="#research-sources">{en?'Sources':'来源'} ↓</a>{catalogue.sourceUnits?.some(u=>u.sourceId===a.sourceId)&&<p><a href={`${base}/source/${catalogue.sourceUnits!.find(u=>u.sourceId===a.sourceId)!.id}`}>{en?'Source version, extraction coverage and findings':'来源版本、提取范围与发现'} →</a></p>}</header><p class="nm-provenance-notice">{a.scopeNote[locale]}</p>
 <section class="nm-assessed-models"><h2>{en?'Models covered':'涉及模型'}</h2><div class="ni-tags">{a.modelIds.map(id=><a href={`${base}/model/${id}`}>{catalogue.models!.find(m=>m.id===id)!.name} →</a>)}</div></section>
 {a.researchNote&&<section class="nm-assessment-note"><h2>NUWA Research Note</h2>{(['question','method','finding','limits'] as const).map(key=><div><h3>{{question:en?'Research question':'研究问题',method:en?'Method':'方法',finding:en?'Source-reported findings':'来源报告的发现',limits:en?'Limitations':'局限'}[key]}</h3><p>{a.researchNote![key][locale]}</p></div>)}</section>}
 {variants.map(v=>{const vv=links.filter(l=>l.variantId===v.id),charts=catalogue.charts?.filter(c=>c.id===v.id+'-chart')??[];return <section class="nm-assessment-variant" id={`variant-${v.id}`}><div class="nm-variant-heading"><div><span class="ni-kind">{v.primaryDimension} · {v.locator}</span><h2>{v.name}</h2></div>{v.protocolId&&<a href={`${base}/benchmark/${v.protocolId}`}>{en?'Protocol record':'协议档案'} →</a>}</div><p>{v.measurementTarget[locale]}</p><p class="ni-note">{v.limitations[locale]}</p>{vv.length>0&&<p class="nm-executors">{[...new Set(vv.map(l=>`${modelOriginLabels[locale][l.origin]}: ${(l.origin==='reused'?l.originalExecutorIds:l.executorIds).map(id=>catalogue.organizations.find(o=>o.id===id)?.name[locale]??id).join(' · ')}`))].join(' / ')}</p>}{charts.map(spec=><EvidenceChart namespace={spec.id} spec={spec} records={spec.recordIds.map(id=>catalogue.results.find(r=>r.id===id)!)} locale={locale}/>)}{!charts.length&&<p class="ni-note">{en?'This section is catalogued; no precise numerical result has been extracted here. Open the original report for its figures and full findings.':'已整理本节协议，尚未提取精确数值。完整图示和发现请见原始报告。'}</p>}</section>;})}
 <section class="nm-section-audit"><h2>{en?'Report coverage':'报告覆盖核查'}</h2><div class="ec-table" tabindex="0"><table><thead><tr><th>{en?'Section':'章节'}</th><th>{en?'Source location':'原文位置'}</th><th>{en?'Treatment':'处理方式'}</th></tr></thead><tbody>{a.sections.map(s=><tr><td>{s.heading}</td><td>{s.locator}</td><td>{{linked:en?'Linked protocol':'关联协议',variant:en?'Protocol variant':'协议变体','report-specific':en?'Report-specific experiment':'报告特定实验',context:en?'Contextual evidence':'背景证据',limitations:en?'Limitations':'局限','source-unresolved':en?'Original protocol source pending':'原始协议来源待核实','not-extracted':en?'Numerical extraction pending':'数值提取待完成'}[s.disposition]??s.disposition}<p>{s.note[locale]}</p></td></tr>)}</tbody></table></div></section><PageSources locale={locale} references={refs} sources={catalogue.sources} numerical={links.length>0}/>
</div></article>
</BaseLayout>
<style is:global>
.nm-assessment>.site-container{max-width:1180px}.nm-assessment .ni-header h1{font-size:clamp(32px,4vw,54px);line-height:1.2;max-width:1000px}.nm-assessment .ni-header{padding-bottom:30px}.nm-provenance-notice{font-size:14px;line-height:1.85;background:#eaf2eb;border-left:3px solid #4b8873;padding:20px 24px;margin:0 0 30px}.nm-assessment h2{font-size:26px;line-height:1.4;font-weight:500}.nm-assessed-models{padding-bottom:28px}.nm-assessment-note{padding:30px 0;border-top:1px solid #cbdcd1;display:grid;grid-template-columns:1fr 1fr;gap:12px 36px}.nm-assessment-note h2{grid-column:1/-1}.nm-assessment-note h3{font-size:16px;font-weight:600;margin:14px 0 10px}.nm-assessment-note p{font-size:15px;line-height:1.85;color:#4d646b}.nm-assessment-variant{padding:36px 0;border-top:1px solid #cbdcd1;scroll-margin-top:110px}.nm-assessment-variant>p{font-size:15px;line-height:1.8;max-width:880px}.nm-variant-heading{display:flex;gap:20px;align-items:center;justify-content:space-between}.nm-variant-heading h2{margin:8px 0 20px}.nm-variant-heading>a{font-size:13px;white-space:nowrap;color:#266658}.nm-executors{color:#1e6657;font-size:13px!important;margin:20px 0}.nm-section-audit{padding:28px 0;border-top:1px solid #cadbd0}@media(max-width:700px){.nm-assessment-note{grid-template-columns:1fr}.nm-variant-heading{align-items:start;flex-direction:column;gap:0}.nm-variant-heading h2{margin-bottom:10px}.nm-variant-heading>a{margin-bottom:18px}}
</style>
