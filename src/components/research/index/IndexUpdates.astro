---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {catalogue,indexBase,publicRelease,snapshots,currentEdition} from '../../../data/nuwa-index';
import {localizedPath,type Locale} from '../../../i18n/config';
interface Props{locale:Locale}
const{locale}=Astro.props,en=locale==='en',base=localizedPath(indexBase,locale);
---
<BaseLayout title={en?'Index updates — NUWA Index':'更新记录 — NUWA Index'} description={publicRelease.changes[locale]} locale={locale} brand="nuwa" canonicalPath={`${indexBase}/updates`}>
<article class="site-container nuwa-updates"><a href={base}>← NUWA Index</a><h1>{en?'Index updates':'索引更新记录'}</h1>{currentEdition&&currentEdition.publication?.state!=='published'&&<section><h2>{en?'Local review candidate':'本地审阅候选'}</h2><p>{currentEdition.candidateId}</p><p>{catalogue.works.length} / {catalogue.benchmarks.length}</p><a href={`${indexBase}/data/current-reading.json`}>{en?'Candidate reading package':'候选阅读包'} · JSON</a></section>}<section><p>{publicRelease.publishedOn} · {publicRelease.snapshotId}</p><h2>{en?'Public reading index':'研究阅读版公开'}</h2><p>{publicRelease.changes[locale]}</p><p>{publicRelease.counts.works} {en?'research records':'项研究记录'} · {publicRelease.counts.protocols} {en?'measurement protocols':'项测量协议'} · {publicRelease.counts.syntheses} {en?'research analyses':'篇专题分析'}</p><p>{en?'Publication, source-reading scope and independent review are recorded separately. Source findings remain attributed to their original researchers.':'公开状态、原文阅读范围和独立复核分别记录；来源发现归属于原始研究者。'}</p><p><a href={`${base}?view=research`}>{en?'Browse the research':'浏览研究目录'} →</a> · <a href={`${indexBase}/data/reading-editions/${publicRelease.snapshotId}.json`}>{en?'Reading edition':'完整阅读版本'} · JSON</a> · <a href={`${indexBase}/snapshots/${publicRelease.snapshotId}.json`}>{en?'Evidence snapshot':'数据快照'} · JSON</a> · <a href={`${indexBase}/updates.xml`}>RSS</a></p></section><section><h2>{en?'Retained data snapshots':'保留的数据快照'}</h2><p>{en?'These archives retain the exact catalogue versions; archival availability does not establish independent verification or a past public deployment.':'归档保留对应目录版本；存在归档不代表已经完成独立复核或曾经公开部署。'}</p><ul>{[...snapshots].sort((a,b)=>b.snapshotId.localeCompare(a.snapshotId)).map(s=><li><a href={`${indexBase}/snapshots/${s.snapshotId}.json`}>{s.snapshotId}</a></li>)}</ul></section></article>
</BaseLayout>
<style>.nuwa-updates{max-width:900px;padding-top:40px;padding-bottom:70px;line-height:1.8}.nuwa-updates h1{font-size:36px;margin:24px 0}.nuwa-updates h2{font-size:24px}.nuwa-updates section{margin:32px 0}.nuwa-updates a{color:#276455}.nuwa-updates p{overflow-wrap:anywhere}</style>
