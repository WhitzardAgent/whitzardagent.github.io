---
import {catalogue,indexBase} from '../../../data/nuwa-index';
import {modelPanels} from '../../../lib/nuwa-intelligence/modelPanels.mjs';
import {renderMonitorChart} from '../../../lib/nuwa-intelligence/chartServer.mjs';
import {comparisonPermissions} from '../../../lib/nuwa-intelligence/monitoring.mjs';
import EvidenceDataTable from './EvidenceDataTable.astro';
import {modelRelease,modelMetadata,parameterLabel} from '../../../lib/modelMetadata.mjs';
import OrganizationMark from './OrganizationMark.astro';
import type {Locale} from '../../../i18n/config';
interface Props{locale:Locale}
const {locale}=Astro.props,en=locale==='en',models=(catalogue.models??[]).map(m=>({...m,releaseDate:modelRelease(m),modelMetadata:modelMetadata(m)})).sort((a,b)=>(b.releaseDate??'').localeCompare(a.releaseDate??'')||a.name.localeCompare(b.name));
const initial=models.find(m=>m.id==='glm-5-2')??models[0],panels=modelPanels(catalogue,initial.id,locale),first=panels[0]?.groups[0],base=(en?'/en':'')+indexBase;
const firstRows=(first?.rows??[]).map((row:any)=>({...row,key:`${row.resultId}|${row.metricId}`,conditionStatus:comparisonPermissions(first?.group).rank?'matched':first?.group.conditionsComplete?'conditional':'incomplete'}));
---
<nuwa-model-trend class="nm-model-trend" data-locale={locale} data-initial={initial.id} data-snapshot={catalogue.snapshotId}>
<script type="application/json" is:inline data-model-list set:html={JSON.stringify(models.map(({id,name,family,aliases,developerId,releaseDate,modelMetadata})=>({id,name,family,aliases,developerId,releaseDate,modelMetadata,developerName:catalogue.organizations.find(o=>o.id===developerId)?.name}))).replace(/</g,'\\u003c')}/>
<div class="nm-model-filter"><label><span>{en?'Find a model':'查找模型'}</span><input data-model-search type="search" placeholder={en?'Model name or family':'模型名称或家族'}/></label><label><span>{en?'Developer':'开发机构'}</span><select data-model-developer><option value="">{en?'All developers':'全部开发机构'}</option>{[...new Set(models.map(m=>m.developerId))].map(id=><option value={id}>{catalogue.organizations.find(o=>o.id===id)?.name[locale]}</option>)}</select></label><button type="button" data-model-clear>{en?'Clear model filters':'清除模型筛选'}</button></div>
<div class="nm-model-selection"><label><span>{en?'Model version':'模型版本'}</span><select data-trend-model>{models.map(m=><option value={m.id} selected={m.id===initial.id}>{m.name}</option>)}</select></label><label><span>Benchmark</span><select data-model-benchmark>{panels.map(p=><option value={p.id}>{p.name}</option>)}</select></label><label><span>{en?'Protocol and metric':'协议与指标'}</span><select data-model-protocol>{panels[0]?.groups.map((p:any)=><option value={p.group.id}>{p.group.title[locale]}</option>)}</select></label></div>
<div class="nm-model-profile"><div data-model-mark><OrganizationMark organizationId={initial.developerId} locale={locale}/></div><h2 data-model-title>{initial.name}</h2><p data-model-date>{en?'Public release':'公开发布'}: {initial.releaseDate??(en?'Not verified':'未核实')}</p><p data-model-parameters>{parameterLabel(initial.modelMetadata?.parameters,locale)}</p><a data-model-link href={`${base}/model/${initial.id}/`}>{en?'Full model evidence record':'完整模型证据档案'} →</a></div>
<p class="ni-note" data-model-status aria-live="polite">{en?'Each plot retains its original metric and protocol. Missing evidence is not a zero score.':'每幅图保留原始指标与协议；缺少证据不等于零分。'}</p>
<div class="nm-monitor" data-model-content>
  <h3 data-model-chart-title>{panels[0]?.name}</h3><p data-model-description>{first?.group.description[locale]}</p>
  <div class="nm-model-views" data-model-views hidden role="group" aria-label={en?'Model evidence view':'模型证据视图'}><button type="button" data-model-display="bars" aria-pressed="true">{en?'Results':'测评结果'}</button><button type="button" data-model-display="table" aria-pressed="false">{en?'Data':'数据'}</button><button type="button" data-model-csv>CSV ↓</button></div>
  <div data-model-plot class="nm-monitor-plot" set:html={first?renderMonitorChart(firstRows,first.group,locale,{display:'bars',all:true}):''}/>
  <p class="nm-monitor-attribution" data-model-credit>{first&&[...new Set(first.rows.map((r:any)=>r.attribution.evaluator))].join(' · ')} · NUWA: {en?'source compilation':'来源汇编'}</p>
  <div data-model-data><EvidenceDataTable rows={firstRows} locale={locale} namespace="model-trend" active={false} rankAllowed={comparisonPermissions(first?.group).rank}/></div>
  <section class="nm-model-observation" data-model-selection aria-live="polite" aria-label={en?'Selected observation details':'所选观测详情'}><p>{en?'Select a chart point or data row to inspect conditions and provenance.':'选择图中数据点或表格行，查看条件与出处。'}</p></section>
</div>
<noscript><p>{en?'Explore all model versions through the model records below.':'可通过以下模型档案查看全部版本。'}</p><details><summary>{en?'Model records':'模型档案'}</summary><ul>{models.map(m=><li><a href={`${base}/model/${m.id}/`}>{m.name}</a></li>)}</ul></details></noscript>
</nuwa-model-trend>
<script>
import {parameterLabel,modelMetadataReferences} from '../../../lib/modelMetadata.mjs';
import {monitorValue,comparisonPermissions,monitorCsv} from '../../../lib/nuwa-intelligence/monitoring.mjs';
import {orderChartRows} from '../../../lib/nuwa-intelligence/monitorChart.mjs';
import {projectEvidenceRows} from '../../../lib/nuwa-intelligence/panorama.mjs';
import {readModelScope,filterModelOptions} from '../../../lib/nuwa-intelligence/modelPanels.mjs';
class NuwaModelTrend extends HTMLElement{
 controller?:AbortController;chart?:typeof import('../../../lib/nuwa-intelligence/chartClient');request=0;
 connectedCallback(){this.controller?.abort();this.controller=new AbortController();const{signal}=this.controller,en=this.dataset.locale==='en',locale=en?'en':'zh',base=(en?'/en':'')+'/nuwa/whitzard-index';const models=JSON.parse(this.querySelector('[data-model-list]')!.textContent!),modelSelect=this.querySelector<HTMLSelectElement>('[data-trend-model]')!,benchmark=this.querySelector<HTMLSelectElement>('[data-model-benchmark]')!,protocol=this.querySelector<HTMLSelectElement>('[data-model-protocol]')!,plot=this.querySelector<HTMLElement>('[data-model-plot]')!;let panels:any[]=[],currentModel='',currentArea='',currentRows:any[]=[],currentGroup:any;const grid=this.querySelector('nuwa-evidence-grid') as HTMLElement&{setRows?:(rows:any[],options:any)=>void;setActive?:(active:boolean)=>void};const dataView=this.querySelector<HTMLElement>('[data-model-data]')!;this.querySelector<HTMLElement>('[data-model-views]')!.hidden=false;const cache=new Map();const setOptions=(el:HTMLSelectElement,items:any[],name:(v:any)=>string,value:(v:any)=>string)=>{el.replaceChildren(...items.map(v=>new Option(name(v),value(v))));};
 const readGridState=()=>{const q=new URLSearchParams(location.search);let filters={};try{const value=JSON.parse(q.get('modelGridFilters')??'{}');if(value&&typeof value==='object'&&!Array.isArray(value))filters=value;}catch{}return{display:q.get('modelDisplay')==='table'?'table':'bars',selected:q.get('modelSelected')??'',filters,sortField:q.get('modelGridSortField')??'',sortDirection:q.get('modelGridSortDirection')==='desc'?'desc':'asc'};};
 const saveGridState=(values:Record<string,string>,push=true)=>{const q=new URLSearchParams(location.search);q.set('view','trend');q.set('trendMode','model');for(const [name,value]of Object.entries(values)){if(value)q.set(name,value);else q.delete(name);}history[push?'pushState':'replaceState'](history.state,'',location.pathname+'?'+q+location.hash);renderProtocol();};
 const choose=(keys:string[])=>saveGridState({modelSelected:keys[0]??''});
 const draw=()=>{if(currentGroup&&this.chart&&!plot.hidden){const state=readGridState();this.chart.drawMonitorChart(plot,currentRows,currentGroup,locale,{display:'bars',all:true,selected:state.selected,gridSortField:state.sortField},choose);const selected=currentRows.find(r=>r.key===state.selected);plot.querySelectorAll<SVGAElement>('[data-keyboard-points] a').forEach(a=>{const active=Boolean(selected&&a.getAttribute('href')?.endsWith(`/result/${selected.resultId}/`));if(active)a.setAttribute('aria-current','true');else a.removeAttribute('aria-current');const circle=a.querySelector('circle');circle?.setAttribute('stroke',active?'#153e61':'transparent');circle?.setAttribute('stroke-width','3');});}};
 const renderSelection=()=>{const host=this.querySelector('[data-model-selection]')!;host.replaceChildren();const row=currentRows.find(row=>row.key===readGridState().selected);const node=(tag:string,value:any)=>{const el=document.createElement(tag);el.textContent=String(value??'—');return el;};if(!row){host.append(node('p',en?'Select a chart point or data row to inspect conditions and provenance.':'选择图中数据点或表格行，查看条件与出处。'));return;}host.append(node('h4',`${row.system} · ${monitorValue(row)}`));const dl=document.createElement('dl');for(const [label,value]of [[en?'Task set':'任务集',row.taskSet],...(row.observationCondition?[[en?'Experimental condition':'实验条件',row.observationCondition[locale]??row.observationCondition.en]]:[]),...(row.experimentalConditions?[[en?'Goal condition':'目标条件',row.experimentalConditions.goal],[en?'Threat condition':'威胁条件',row.experimentalConditions.threat]]:[]),[en?'Harness':'评测框架',row.configuration?.harness],[en?'Tools':'工具',row.configuration?.tools],[en?'Budget / attempts':'预算／尝试次数',`${row.configuration?.budget??'—'} · ${row.trialCount??'—'}`],[en?'Evaluated by':'实际评测方',row.attribution?.evaluator],[en?'Report':'报告',row.attribution?.sourceTitle],[en?'Reported by':'报告发布方',row.attribution?.reporter],[en?'Source version / location':'来源版本／位置',`${row.sourceVersion??'—'} · ${row.locator??'—'}`],[en?'Release / report dates':'发布／报告日期',`${row.releaseDate??'—'} / ${row.reportDate??'—'}`]]){const div=document.createElement('div');div.append(node('dt',label),node('dd',value));dl.append(div);}host.append(dl);const link=node('a',en?'Full observation record →':'完整观测档案 →') as HTMLAnchorElement;link.href=`${base}/result/${row.resultId}/`;host.append(link);};
 const renderProtocol=()=>{const panel=panels.find(p=>p.id===benchmark.value),p=panel?.groups.find((p:any)=>p.group.id===protocol.value);if(!p){grid.setActive?.(false);return;}currentGroup=p.group;const permission=comparisonPermissions(currentGroup),state=readGridState();const sourceRows=p.rows.map((row:any)=>({...row,key:`${row.resultId}|${row.metricId}`,conditionStatus:permission.rank?'matched':currentGroup.conditionsComplete?'conditional':'incomplete'}));currentRows=orderChartRows(projectEvidenceRows(sourceRows,{...state,rankAllowed:permission.rank,locale}),currentGroup,{gridSortField:state.sortField});this.dataset.modelSourceIds=[...new Set(currentRows.flatMap((r:any)=>[r.sourceId,...modelMetadataReferences({modelMetadata:r.modelMetadata}).map((s:any)=>s.sourceId)]))].join(' ');this.dispatchEvent(new CustomEvent('nuwa-monitor-sources',{bubbles:true}));this.querySelector('[data-model-chart-title]')!.textContent=panel.name;this.querySelector('[data-model-description]')!.textContent=p.group.description[locale];this.querySelector('[data-model-credit]')!.textContent=(en?'Evaluated by: ':'实际评测方：')+[...new Set(currentRows.map((r:any)=>r.attribution.evaluator))].join(' · ')+(en?' · NUWA: source compilation; no NUWA experiment.':' · NUWA：来源汇编；非 NUWA 实验。');plot.hidden=state.display==='table';dataView.hidden=state.display!=='table';this.querySelectorAll<HTMLButtonElement>('[data-model-display]').forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.modelDisplay===state.display)));grid.setRows?.(currentRows,{...state,active:state.display==='table'&&!this.closest('[hidden]'),rankAllowed:permission.rank});window.dispatchEvent(new Event('nuwa-selects-sync'));renderSelection();if(!plot.hidden)import('../../../lib/nuwa-intelligence/chartClient').then(m=>{if(!this.isConnected)return;this.chart=m;draw();});};
 const renderBenchmark=()=>{const gs=panels.find(p=>p.id===benchmark.value)?.groups??[];setOptions(protocol,gs,p=>p.group.title[locale],p=>p.group.id);renderProtocol();};
 const load=async()=>{const token=++this.request,q=new URLSearchParams(location.search),filter=readModelScope(location.search),scope=filterModelOptions(models,filter),id=scope.some((m:any)=>m.id===q.get('model'))?q.get('model')!:scope.some((m:any)=>m.id===this.dataset.initial)?this.dataset.initial!:scope[0]?.id;this.querySelector<HTMLInputElement>('[data-model-search]')!.value=filter.query;this.querySelector<HTMLSelectElement>('[data-model-developer]')!.value=filter.developer;setOptions(modelSelect,scope,m=>m.name,m=>m.id);if(!id){grid.setActive?.(false);currentModel='';this.querySelector<HTMLElement>('.nm-model-profile')!.hidden=true;this.querySelector<HTMLElement>('[data-model-content]')!.hidden=true;this.querySelector('[data-model-status]')!.textContent=en?'No models match these filters. Clear model filters to restore the full list.':'没有模型符合当前条件，可清除模型筛选恢复完整列表。';return;}modelSelect.value=id;this.querySelector<HTMLElement>('.nm-model-profile')!.hidden=false;if(id===currentModel&&currentArea===(q.get('area')??'')){this.querySelector('[data-model-status]')!.textContent=panels.length?(en?`${panels.length} benchmarks. Metrics and configurations remain separate.`:`${panels.length} 项基准；指标与配置分别呈现。`):(en?'No eligible measurements linked to this exact model version.':'尚未关联该准确模型版本的合格测量。');const target=panels.find(p=>p.id===q.get('modelBenchmark'));if(target)benchmark.value=target.id;renderBenchmark();if(target?.groups.some((p:any)=>p.group.id===q.get('modelProtocol'))){protocol.value=q.get('modelProtocol')!;renderProtocol();}draw();return;}this.querySelector('[data-model-status]')!.textContent=en?'Loading published measurements…':'正在加载已发表测量…';try{const data=cache.get(id)??await fetch(`/nuwa/whitzard-index/model-data/${id}.json?snapshot=${this.dataset.snapshot}`,{signal}).then(r=>{if(!r.ok)throw new Error('data');return r.json();});if(token!==this.request)return;if(data.snapshotId!==this.dataset.snapshot)throw new Error('snapshot');cache.set(id,data);currentArea=q.get('area')??'';panels=data[locale].filter((p:any)=>!currentArea||p.areas.includes(currentArea)).map((p:any)=>({...p,groups:p.groups.filter((g:any)=>!currentArea||!g.group.areas?.length||g.group.areas.includes(currentArea))})).filter((p:any)=>p.groups.length);currentModel=id;setOptions(modelSelect,scope,m=>m.name,m=>m.id);modelSelect.value=id;const m=models.find((m:any)=>m.id===id);this.querySelector('[data-model-title]')!.textContent=m.name;this.querySelector('[data-model-parameters]')!.textContent=parameterLabel(m.modelMetadata?.parameters,locale);this.querySelector('[data-model-date]')!.textContent=(en?'Public release: ':'公开发布：')+(m.releaseDate??(en?'Not verified':'未核实'));const link=this.querySelector<HTMLAnchorElement>('[data-model-link]')!;link.href=`${base}/model/${id}/`;this.querySelector('[data-model-mark]')!.textContent='';const {organizationMarkMarkup}=await import('../../../lib/organizationBrands.mjs');if(token!==this.request)return;this.querySelector('[data-model-mark]')!.innerHTML=organizationMarkMarkup(m.developerId,m.developerName?.[locale]??m.developerId);this.querySelector<HTMLElement>('[data-model-content]')!.hidden=!panels.length;this.querySelector('[data-model-status]')!.textContent=panels.length?(en?`${panels.length} benchmarks. Metrics and configurations remain separate.`:`${panels.length} 项基准；指标与配置分别呈现。`):(en?'No eligible measurements linked to this exact model version. See the model record for reports and evidence gaps.':'尚未关联该准确模型版本的合格测量；报告与缺口见模型档案。');setOptions(benchmark,panels,p=>p.name,p=>p.id);if(panels.some(p=>p.id===q.get('modelBenchmark')))benchmark.value=q.get('modelBenchmark')!;renderBenchmark();if(panels.find(p=>p.id===benchmark.value)?.groups.some((p:any)=>p.group.id===q.get('modelProtocol'))){protocol.value=q.get('modelProtocol')!;renderProtocol();}}catch(e){if(signal.aborted)return;this.querySelector('[data-model-status]')!.textContent=en?'Measurements could not be loaded. Open the model record to continue.':'测量暂未加载成功，可打开模型档案继续查看。';}};
 const saveScope=(clear=false)=>{const q=new URLSearchParams(location.search);q.set('view','trend');q.set('trendMode','model');const query=clear?'':this.querySelector<HTMLInputElement>('[data-model-search]')!.value,developer=clear?'':this.querySelector<HTMLSelectElement>('[data-model-developer]')!.value;q.set('modelSearch',query);q.set('modelDeveloper',developer);const candidates=filterModelOptions(models,{query,developer});if(!candidates.some((m:any)=>m.id===q.get('model'))){const target=clear?(candidates.find((m:any)=>m.id===this.dataset.initial)??candidates[0]):candidates[0];if(target)q.set('model',target.id);else q.delete('model');}history[clear?'pushState':'replaceState'](history.state,'',location.pathname+'?'+q+location.hash);load();};this.querySelector('[data-model-views]')!.addEventListener('click',event=>{const button=(event.target as HTMLElement).closest<HTMLElement>('[data-model-display]');if(button)saveGridState({modelDisplay:button.dataset.modelDisplay==='table'?'table':'bars'});},{signal});grid.addEventListener('nuwa-grid-change',event=>{if(readGridState().display!=='table'||this.closest('[hidden]'))return;const detail=(event as CustomEvent).detail;saveGridState({modelGridFilters:Object.keys(detail.filters??{}).length?JSON.stringify(detail.filters):'',modelGridSortField:detail.sortField??'',modelGridSortDirection:detail.sortDirection??''},false);},{signal});grid.addEventListener('nuwa-grid-select',event=>choose([(event as CustomEvent).detail.key]),{signal});this.querySelector('[data-model-csv]')!.addEventListener('click',()=>{if(!currentGroup)return;const url=URL.createObjectURL(new Blob([monitorCsv(currentRows,currentGroup,locale)],{type:'text/csv;charset=utf-8'}));const a=document.createElement('a');a.href=url;a.download=`nuwa-model-${currentModel}-${currentGroup.id}.csv`;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);},{signal});customElements.whenDefined('nuwa-evidence-grid').then(()=>{if(this.isConnected)renderProtocol();});this.querySelector('[data-model-search]')!.addEventListener('input',()=>saveScope(),{signal});this.querySelector('[data-model-developer]')!.addEventListener('change',()=>saveScope(),{signal});this.querySelector('[data-model-clear]')!.addEventListener('click',()=>saveScope(true),{signal});
 modelSelect.addEventListener('change',()=>{const q=new URLSearchParams(location.search);q.set('model',modelSelect.value);q.set('trendMode','model');history.pushState(history.state,'',location.pathname+'?'+q+location.hash);load();},{signal});const saveSelection=()=>{const q=new URLSearchParams(location.search);q.set('modelBenchmark',benchmark.value);q.set('modelProtocol',protocol.value);history.pushState(history.state,'',location.pathname+'?'+q+location.hash);};benchmark.addEventListener('change',()=>{renderBenchmark();saveSelection();},{signal});protocol.addEventListener('change',()=>{renderProtocol();saveSelection();},{signal});window.addEventListener('popstate',()=>{if(!this.closest<HTMLElement>('[data-trend-panel]')?.hidden)load();},{signal});window.addEventListener('nuwa-index-change',()=>{if(!this.closest<HTMLElement>('[data-trend-panel]')?.hidden)load();else grid.setActive?.(false);},{signal});if(!this.closest<HTMLElement>('[data-trend-panel]')?.hidden)load();
 }
 disconnectedCallback(){this.request++;this.controller?.abort();const plot=this.querySelector<HTMLElement>('[data-model-plot]');if(plot)this.chart?.disposeMonitorChart(plot);}
}
if(!customElements.get('nuwa-model-trend'))customElements.define('nuwa-model-trend',NuwaModelTrend);
</script>
<style is:global>.nm-model-trend{display:block}.nm-model-selection{display:grid;grid-template-columns:1fr 1fr 1.4fr;gap:16px;margin:24px 0}.nm-model-selection label{min-width:0;display:grid;gap:8px;font-size:12px;color:#47635c}.nm-model-selection select{min-width:0;width:100%;padding:12px;background:#fff;border:1px solid #b7ccc2;font:inherit;color:#213f4d;border-radius:4px}.nm-model-profile{margin:26px 0}.nm-model-profile h2{font-size:30px;margin:10px 0;font-weight:500}.nm-model-profile p,.nm-model-profile a{font-size:13px}.nm-model-trend [data-model-chart-title]{font-size:24px;font-weight:500}.nm-model-trend [data-model-description]{font-size:14px;line-height:1.8;color:#4e6669}@media(max-width:800px){.nm-model-selection{grid-template-columns:1fr}.nm-model-profile h2{font-size:25px}}</style>

<style is:global>.nm-model-filter{display:flex;gap:15px;align-items:end;margin:20px 0}.nm-model-filter label{display:grid;gap:8px;flex:1;min-width:0;font-size:12px;color:#47635c}.nm-model-filter input,.nm-model-filter select{width:100%;padding:11px;border:1px solid #b7ccc2;background:#fff;color:#214653;min-width:0;font:inherit;border-radius:4px}.nm-model-filter button{padding:11px;font-size:12px;border:1px solid #b7ccc2;border-radius:4px;background:transparent;cursor:pointer}.nm-model-trend [hidden]{display:none!important}@media(max-width:700px){.nm-model-filter{flex-wrap:wrap}.nm-model-filter label{flex:1 1 100%}}</style>

<style is:global>
.nm-model-views{display:flex;gap:8px;flex-wrap:wrap;margin:18px 0}.nm-model-views button{min-height:42px;padding:10px 15px;border:1px solid #b7ccc2;border-radius:4px;color:#254e52;background:#fff;font:inherit;font-size:12px;cursor:pointer}.nm-model-views button[aria-pressed=true]{color:#fff;background:#215c58;border-color:#215c58}.nm-model-views [data-model-csv]{margin-left:auto}.nm-model-observation{min-height:160px;margin-top:22px;padding:18px;border:1px solid #d2dfd8;background:#f6f7f3;overflow-wrap:anywhere}.nm-model-observation h4{font-size:17px;font-weight:500;margin:0 0 15px}.nm-model-observation p,.nm-model-observation a{font-size:13px;line-height:1.8}.nm-model-observation dl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px 22px;margin:0 0 18px}.nm-model-observation dt{font-size:11px;color:#50685f}.nm-model-observation dd{font-size:12px;line-height:1.7;margin:3px 0 0}@media(max-width:650px){.nm-model-observation dl{grid-template-columns:1fr}}
</style>
