---
import {modelMetadata,modelRelease,parameterLabel,modelMetadataReferences,modelMetadataSources} from '../../../lib/modelMetadata.mjs';
import ModelMonitoring from './ModelMonitoring.astro';
import OrganizationMark from './OrganizationMark.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageSources from '../PageSources.astro';
import {catalogue,indexBase} from '../../../data/nuwa-index';
import {localizedPath,type Locale} from '../../../i18n/config';
import {modelOriginLabels} from '../../../lib/modelEvidence.mjs';
import {formatMetric} from '../../../lib/evidenceCharts.mjs';
import '../../../styles/nuwa-index.css';
interface Props{locale:Locale;id:string}
const {locale,id}=Astro.props,en=locale==='en',base=localizedPath(indexBase,locale),m=catalogue.models!.find(m=>m.id===id)!,org=catalogue.organizations.find(o=>o.id===m.developerId)!,assessments=catalogue.assessments!.filter(a=>a.modelIds.includes(id)),links=catalogue.assessmentEvidence!.filter(l=>l.modelId===id),results=links.flatMap(l=>{const r=catalogue.results.find(r=>r.id===l.resultId);return r?[{link:l,record:r}]:[];});
const meta=modelMetadata(m)!,release=modelRelease(m);
const refs=[...modelMetadataReferences(m,locale),...m.synthesis.flatMap(s=>s.sourceIds.map(sourceId=>({sourceId,appliesTo:en?'NUWA synthesis':'NUWA 综合解读'}))),...(m.releaseSourceId?[{sourceId:m.releaseSourceId,appliesTo:en?'Model release':'模型发布'}]:[]),...assessments.map(a=>({sourceId:a.sourceId,appliesTo:a.title})),...results.map(({record:r})=>({sourceId:r.sourceId,locator:r.locator,appliesTo:en?'Recorded result':'记录结果'}))];
---
<BaseLayout locale={locale} brand="nuwa" title={`${m.name} — NUWA Index`} description={m.summary[locale]} canonicalPath={`${indexBase}/model/${id}`}>
<article class="ni-page nm-profile"><div class="site-container"><header class="ni-header"><a class="ni-back" href={`${base}?view=models#ni-models`}>← Models</a><p class="ni-kicker"><OrganizationMark organizationId={org.id} locale={locale}/></p><h1>{m.name}</h1><p class="ni-lead">{en?'Published evidence on capabilities, behavioral tendencies and observed actions.':'关于能力、行为倾向及可观察行动的已发表证据。'}</p><dl class="nm-profile-facts"><div><dt>{en?'First public availability':'首次公开可用日期'}</dt><dd>{release??(meta.release.status==='conflict'?(en?'Date conflict under review':'日期差异待复核'):(en?'Not yet verified':'待核实'))}</dd></div><div><dt>{en?'Parameters':'参数规模'}</dt><dd>{parameterLabel(meta.parameters,locale)}{meta.parameters.architecture&&<small> · {meta.parameters.architecture}</small>}</dd></div><div><dt>{en?'Metadata updated':'元数据更新'}</dt><dd>2026-10-27</dd></div></dl>
{meta.release.note&&<p class="ni-note">{meta.release.note[locale]}</p>}
{meta.parameters.note&&<p class="ni-note">{meta.parameters.note[locale]}</p>}
{meta.release.events.length>1&&<ul class="nm-release-events">{meta.release.events.map(event=><li><time datetime={event.date}>{event.date}</time> · {event.kind==='api-release'?(en?'API availability':'API 开放'):event.kind==='weights-release'?(en?'Open weights':'权重开放'):en?'Public release':'公开发布'}</li>)}</ul>}
{meta.reportedRelease.date&&meta.reportedRelease.date!==release&&<p class="ni-note">{en?'The assessment records':'评测档案记载'} {meta.reportedRelease.date}{en?'. It is retained as a source-reported date, separate from the independently maintained release metadata.':'；该日期保留为来源记录，与独立维护的发布元数据区分。'}</p>}
<a class="text-link" href="#research-sources">{en?'Sources':'来源'} ↓</a></header>
 <section class="nm-profile-summary"><h2>{en?'Evidence overview':'证据概述'}</h2>{m.synthesis.length?m.synthesis.map(s=><p>{s.text[locale]}</p>):<p>{m.summary[locale]}</p>}<p class="ni-note">{en?'NUWA curates and interprets these sources. Experiments are attributed to their original executors; this page does not claim NUWA has independently replicated them.':'NUWA 整理和解读这些来源。实验归属于原始执行方，本页不宣称 NUWA 已独立复现。'}</p></section>
 <ModelMonitoring modelId={id} locale={locale}/><section class="nm-assessment-list"><h2>{en?'Developer disclosures':'开发者披露'}</h2>{assessments.filter(a=>a.kind==='developer').map(a=><article><div><h3><a href={`${base}/assessment/${a.id}`}>{a.title} →</a></h3><p>{a.summary[locale]}</p><span>{a.publicationDate??(en?'Publication date not verified':'未核实发表日期')}{a.updatedDate&&` · ${en?'Updated':'更新'} ${a.updatedDate}`}</span></div><small>{a.reviewStatus==='source-reviewed-partial'?(en?'Source extraction reviewed; scope documented':'来源提取已复核；范围见档案'):a.reviewStatus==='section-reviewed'?(en?'Sections reviewed':'已核查章节'):a.reviewStatus==='bounded-sections'?(en?'Selected sections reviewed':'已阅读部分章节'):a.reviewStatus==='section-map'?(en?'Section map only':'仅核查章节结构'):en?'Report indexed; detailed extraction pending':'已收录报告；详细提取待完成'}</small></article>)}{!assessments.some(a=>a.kind==='developer')&&<p class="ni-note">{en?'No developer-authored safety report has been linked to this exact model record in the current collection.':'当前目录尚未关联到该具体模型的开发者安全报告。'}</p>}</section>
 <section class="nm-assessment-list"><h2>{en?'External assessments':'外部评估'}</h2>{assessments.filter(a=>a.kind==='external').map(a=><article><div><p class="ni-kicker">{a.publisherIds.map(id=>catalogue.organizations.find(o=>o.id===id)!.name[locale]).join(' · ')}</p><h3><a href={`${base}/assessment/${a.id}`}>{a.title} →</a></h3><p>{a.summary[locale]}</p><span>{a.publicationDate??(en?'Publication date not established':'发表日期未确定')}</span></div></article>)}{!assessments.some(a=>a.kind==='external')&&<p class="ni-note">{en?'No model-specific external assessment is linked in the current collection.':'当前目录尚未关联该模型的专项外部评估。'}</p>}</section>
 <section class="nm-profile-results"><h2>{en?'Evidence by risk topic':'按风险主题组织的证据'}</h2>{catalogue.areas.map(area=>{const items=results.filter(({link})=>{const v=catalogue.protocolVariants!.find(v=>v.id===link.variantId);return v?.riskAssociations.some(a=>a.area===area.id);});return <details open={items.length>0}><summary>{area.label[locale]} <small>{items.length?`${items.length} ${en?'protocol results':'项协议结果'}`:en?'No structured result linked':'未关联结构化结果'}</small></summary>{items.map(({link,record:r})=><article><h3><a href={`${base}/result/${r.id}`}>{catalogue.protocolVariants!.find(v=>v.id===link.variantId)!.name} →</a></h3><p class="nm-result-origin">{modelOriginLabels[locale][link.origin]} · {en?'Executed by':'执行方'} {link.executorIds.map(id=>catalogue.organizations.find(o=>o.id===id)?.name[locale]??id).join(' · ')}{link.originalExecutorIds.length>0&&` · ${en?'Original executor':'原始执行方'} ${link.originalExecutorIds.map(id=>catalogue.organizations.find(o=>o.id===id)?.name[locale]??id).join(' · ')}`}</p><dl>{r.metrics.map(metric=><div><dt>{metric.label[locale]}</dt><dd>{formatMetric(metric)}{link.measurement==='imputed'&&<small>{en?'IRT-imputed':'IRT 插补'}</small>}</dd></div>)}</dl><p class="ni-note">{r.sampleSize[locale]}</p></article>)}{!items.length&&<p class="ni-note">{en?'A gap in this collection is not evidence of low risk. Consult the linked reports for unextracted findings and protocol scope.':'目录缺口不代表低风险。尚未提取的发现及协议范围请见关联报告。'}</p>}</details>;})}</section>
 <section class="nm-profile-summary"><h2>{en?'Source review and evidence gaps':'来源核查与证据缺口'}</h2>{(catalogue.sourceUnits??[]).filter(u=>assessments.some(a=>a.sourceId===u.sourceId)).map(u=><article><h3><a href={`${base}/source/${u.id}`}>{u.title} →</a></h3><p>{u.summary[locale]}</p><p class="ni-note">{u.limits[locale]}</p></article>)}{(catalogue.evidenceGaps??[]).filter(g=>g.modelId===id).map(g=><article><h3>{g.question[locale]}</h3><p>{g.reason[locale]}</p><p class="ni-note">{g.nextAction[locale]}</p></article>)}<p>{en?'Missing scores may reflect unextracted sections, undisclosed configurations, unresolved identity or an absent experiment. These are separate research questions; none implies a zero result.':'缺失分数可能来自尚未提取的章节、未披露配置、身份待核实或尚无实验。这些问题需要分别处理，均不代表零分。'}</p></section>
 <section class="nm-profile-summary"><h2>{en?'Interpretation and open questions':'解读与开放问题'}</h2><p>{en?'Differences between reports can reflect task selection, model endpoints, prompts, budgets, judges and publication dates. Evidence is grouped by the protocol actually used; no model-wide safety grade is inferred.':'报告差异可能来自任务选择、模型端点、提示、预算、判别器和发表时间。证据依据实际协议分组，不推断模型整体安全等级。'}</p></section><PageSources locale={locale} references={refs} sources={[...catalogue.sources,...modelMetadataSources(catalogue.models??[],catalogue.sources)]}/>
</div></article>
</BaseLayout>
<style is:global>
.nm-profile>.site-container{max-width:1180px}.nm-profile .ni-header{padding-bottom:36px}.nm-profile h1{overflow-wrap:anywhere}.nm-profile-facts{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin:30px 0;font-size:14px}.nm-profile-facts dt{color:#587067;font-size:12px}.nm-profile-facts dd{margin:6px 0}.nm-profile section{scroll-margin-top:110px}.nm-profile h2{font-size:28px;font-weight:500;letter-spacing:-.02em;margin:0 0 22px}.nm-profile-summary{border-top:1px solid #cadbd0;padding:32px 0}.nm-profile-summary>p{max-width:880px;font-size:16px;line-height:1.85;color:#425c65}.nm-assessment-list{padding:32px 0;border-top:1px solid #cadbd0}.nm-assessment-list article{display:flex;justify-content:space-between;gap:28px;padding:24px 0;border-bottom:1px solid #dbe5de}.nm-assessment-list h3{font-size:20px;line-height:1.5;margin:0 0 10px;font-weight:500}.nm-assessment-list h3 a{text-decoration:none}.nm-assessment-list article p{font-size:14px;line-height:1.8;max-width:780px;color:#4d626b}.nm-assessment-list article span,.nm-assessment-list article>small{font-size:12px;color:#537266}.nm-profile-results{padding:32px 0;border-top:1px solid #cadbd0}.nm-profile-results>details{border-bottom:1px solid #cfdfd5;padding:15px 0}.nm-profile-results summary{font-size:19px;cursor:pointer}.nm-profile-results summary small{margin-left:15px;font-size:12px;color:#5c7269}.nm-profile-results article{margin:18px 0;padding:23px;background:#fff;border:1px solid #d3e0d8}.nm-profile-results h3{font-size:18px;line-height:1.5}.nm-profile-results h3 a{text-decoration:none}.nm-result-origin{font-size:12px;line-height:1.8;color:#3c7165}.nm-profile-results dl{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.nm-profile-results dt{font-size:12px;line-height:1.6;color:#546d65}.nm-profile-results dd{font-size:22px;font-weight:500;margin:5px 0}.nm-profile-results dd small{display:block;font-size:11px;color:#865c3d}@media(max-width:700px){.nm-profile-facts{grid-template-columns:1fr;gap:16px}.nm-assessment-list article{flex-direction:column;gap:10px}.nm-profile-results dl{grid-template-columns:1fr 1fr}.nm-profile-results summary small{display:block;margin:8px 0 0}}
</style>
