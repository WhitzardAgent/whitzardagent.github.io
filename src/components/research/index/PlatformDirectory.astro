---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {localizedPath,type Locale} from '../../../i18n/config';
import {catalogue,indexBase} from '../../../data/nuwa-index';
import {programs,publishedRuns,platformVersion} from '../../../lib/nuwa-intelligence/platformData';
import TopicMonitoring from './TopicMonitoring.astro';
import {loadMonitoringDrafts} from '../../../lib/nuwa-intelligence/localReview.mjs';
import '../../../styles/nuwa-platform.css';
interface Props{locale:Locale;kind:'trends'|'evaluations'|'assessments'}
const {locale,kind}=Astro.props,en=locale==='en',base=localizedPath(indexBase,locale),title=kind==='trends'?(en?'Track frontier risk evidence':'追踪前沿风险证据'):kind==='evaluations'?(en?'NUWA continuous evaluations':'NUWA 持续评测'):(en?'Global external assessments':'全球外部评测');
const reports=[...(catalogue.assessments??[])].sort((a,b)=>(b.publicationDate??'').localeCompare(a.publicationDate??''));
const orgs=catalogue.organizations.filter(o=>reports.some(r=>r.publisherIds.includes(o.id)));
const models=(catalogue.models??[]).filter(m=>reports.some(r=>r.modelIds.includes(m.id)));
---
<BaseLayout title={`${title} — NUWA Index`} description={en?'Versioned measurements, explicit conditions and attributable evidence.':'版本化测量、明确条件与可追溯评测证据。'} locale={locale} brand="nuwa" canonicalPath={`${indexBase}/${kind}`}>
<div class="np-platform" data-platform-version={platformVersion}><header class="np-container np-page-head"><p class="np-eyebrow">{kind==='trends'?'RISK TRENDS':kind==='evaluations'?'NUWA EVALUATIONS':'EXTERNAL ASSESSMENTS'}</p><h1>{title}</h1><p>{kind==='trends'?(en?'Read the finding, then inspect the measurements. System performance, protocol changes and newly indexed evidence are distinct kinds of change.':'先阅读结论，再查看具体测量。系统表现、协议调整与历史材料补录是不同类型的变化。'):kind==='evaluations'?(en?'Programs connect versioned protocols to future run batches. Existing published research is available below; new continuous runs are being prepared.':'通过版本化协议与运行批次开展持续评测。下方保留相关已发表研究，新的持续运行计划正在筹备。'):(en?'Explore developer disclosures and third-party evaluations. Original evaluators, publishers and source versions remain visible.':'按主题、机构、模型与日期查找开发者披露和第三方评测，核对实际执行方及原始来源。')}</p></header>
{kind==='trends'&&<section class="np-container np-section"><TopicMonitoring locale={locale} analyses={loadMonitoringDrafts(catalogue)}/><div class="np-detail"><h2>{en?'How to interpret changes':'如何理解变化'}</h2><p class="np-note">{en?'Compare results within their measured outcome and protocol. Lines require reviewed longitudinal comparability. Additional historical records change coverage, not past model behavior.':'结果按测量对象和协议分别解释；连线需要通过纵向可比性审查。新增历史记录改变证据覆盖，不代表过去的模型行为发生改变。'}</p><a href={`${base}/research/?view=methodology`}>{en?'Measurement and comparison methods':'测量与比较方法'} →</a></div></section>}
{kind==='evaluations'&&<div class="np-container"><section class="np-status"><strong>{en?'Program preparation':'计划筹备'}</strong><p>{en?'No new continuous-evaluation batch is published in this platform release. A batch requires a frozen protocol, exact system configuration, execution receipt and traceable results.':'本次平台版本没有发布新的持续评测批次。批次发布需要冻结协议、准确系统配置、执行回执与可追溯结果。'}</p></section>{programs.map(p=><section class="np-program" id={p.id}><span class="np-badge">{en?'Preparing':'筹备中'}</span><h2>{p.title[locale]}</h2><dl><dt>{en?'Research area':'研究主题'}</dt><dd>{catalogue.areas.find(a=>a.id===p.area)?.label[locale]}</dd><dt>{en?'Reference protocol':'参考协议'}</dt><dd>{p.protocol?<a href={`${base}/benchmark/${p.protocol.id}/`}>{p.protocol.name}</a>:'—'}</dd><dt>{en?'Version / system / run date':'协议版本／系统／运行日期'}</dt><dd>{en?'To be frozen for the first run':'首批运行前冻结'}</dd><dt>{en?'Execution responsibility':'执行职责'}</dt><dd>NUWA · {en?'planned execution':'计划执行'}</dd></dl><p>{en?'Related published evidence retains its original protocol and evaluator. It does not establish a new run under this program.':'相关已发表证据保留原协议和执行方，不计为此计划的新运行。'}</p>{p.protocol&&<p><a href={`${base}/benchmark/${p.protocol.id}/`}>{en?'Published evidence and protocol':'已发表证据与协议'} →</a></p>}</section>)}<section class="np-section"><h2>{en?'Published run batches':'已发布运行批次'}</h2>{publishedRuns.length===0?<p class="np-empty">{en?'No run batch has been published. Completed, validated runs will appear here with their protocol version, system, results and receipt.':'尚无已发布运行批次。真实运行完成并通过验证后，将在此列出协议版本、系统、结果与回执。'}</p>:publishedRuns.map(r=><article><h3>{r.system}</h3><p>{r.protocolVersion} · {r.receipt.completedAt}</p>{r.resultIds.map(id=><a href={`${base}/result/${id}/`}>{id} →</a>)}</article>)}</section><section class="np-section"><h2>{en?'Publication requirements':'发布要求'}</h2><p class="np-note">{en?'Each run binds its protocol, task set, harness, configuration hashes, time range, scoring version and sample outcomes. Method authorship and experimental execution are attributed separately.':'每次运行绑定协议、任务集、脚手架和配置哈希、起止时间、计分版本与样本状态。方法作者与实验执行方分别署名。'}</p><a href={`${indexBase}/platform-release.json`}>{en?'Platform publication manifest':'平台发布清单'} · JSON →</a></section></div>}
{kind==='assessments'&&<nuwa-assessments class="np-container np-directory" data-locale={locale}><form class="np-toolbar" data-assessment-filters hidden><label>{en?'Risk topic':'风险主题'}<select name="area"><option value="">{en?'All topics':'全部主题'}</option>{catalogue.areas.map(a=><option value={a.id}>{a.label[locale]}</option>)}</select></label><label>{en?'Publishing institution':'发布机构'}<select name="organization"><option value="">{en?'All institutions':'全部机构'}</option>{orgs.map(o=><option value={o.id}>{o.name[locale]}</option>)}</select></label><label>{en?'Model':'模型'}<select name="model"><option value="">{en?'All models':'全部模型'}</option>{models.map(m=><option value={m.id}>{m.name}</option>)}</select></label><label>{en?'Published from':'公开起始'}<input type="date" name="from"/></label><label>{en?'Published through':'公开截止'}<input type="date" name="to"/></label><button type="reset" class="np-button np-secondary">{en?'Reset':'重置'}</button></form><p class="np-status" data-assessment-count role="status">{reports.length} {en?'assessments':'份评估报告'}</p><div class="np-card-grid">{reports.map(r=><article data-assessment data-areas={r.areas.join(' ')} data-organizations={r.publisherIds.join(' ')} data-models={r.modelIds.join(' ')} data-date={r.publicationDate??''}><p class="np-caption">{r.kind==='developer'?(en?'Developer disclosure':'开发者披露'):(en?'Third-party assessment':'第三方评估')} · {r.publicationDate??(en?'Date unknown':'日期未知')}</p><h2 style="font-size:20px;font-weight:500;line-height:1.6"><a href={`${base}/assessment/${r.id}/`}>{r.title}</a></h2><p>{r.summary[locale]}</p><p class="np-caption">{r.publisherIds.map(id=>catalogue.organizations.find(o=>o.id===id)?.name[locale]??id).join(' · ')}</p><p class="np-caption">{r.reviewStatus==='section-reviewed'?(en?'Selected sections reviewed; see record scope':'已核查所列章节，范围见档案'):(en?'See record for source extraction and review scope':'来源提取与复核范围见档案')}</p><a href={`${base}/models/compare/?area=${r.areas[0]??''}`}>{en?'Explore related comparisons':'查看相关比较'} →</a></article>)}</div><p class="np-empty" data-assessment-empty hidden>{en?'No assessments match these filters. Reset filters to explore all reports.':'没有符合条件的评估报告，可重置筛选查看全部报告。'}</p><noscript><p class="np-note">{en?'All assessment records remain available without JavaScript.':'无 JavaScript 时仍可阅读全部评估档案。'}</p></noscript></nuwa-assessments>}
</div>
<script>
 class NuwaAssessments extends HTMLElement{controller?:AbortController;connectedCallback(){this.controller?.abort();this.controller=new AbortController();const {signal}=this.controller,form=this.querySelector<HTMLFormElement>('form')!,rows=[...this.querySelectorAll<HTMLElement>('[data-assessment]')],keys=['area','organization','model','from','to'],en=this.dataset.locale==='en';form.hidden=false;
 const apply=(save=false)=>{let count=0;const f=Object.fromEntries(keys.map(k=>[k,(form.elements.namedItem(k) as HTMLInputElement).value]));for(const row of rows){const show=(!f.area||row.dataset.areas?.split(' ').includes(f.area))&&(!f.organization||row.dataset.organizations?.split(' ').includes(f.organization))&&(!f.model||row.dataset.models?.split(' ').includes(f.model))&&(!f.from||Boolean(row.dataset.date&&row.dataset.date>=f.from))&&(!f.to||Boolean(row.dataset.date&&row.dataset.date<=f.to));row.hidden=!show;if(show)count++;}this.querySelector('[data-assessment-count]')!.textContent=`${count} ${en?'assessments':'份评估报告'}`;(this.querySelector('[data-assessment-empty]') as HTMLElement).hidden=count>0;if(save){const p=new URLSearchParams(location.search);for(const k of keys)f[k]?p.set(k,f[k]):p.delete(k);history.pushState({},'',location.pathname+(p.size?'?'+p:''));}document.querySelectorAll<HTMLAnchorElement>('[data-platform-language]').forEach(a=>a.search=location.search);};
 const restore=()=>{const p=new URLSearchParams(location.search);keys.forEach(k=>(form.elements.namedItem(k) as HTMLInputElement).value=p.get(k)??'');apply();};form.addEventListener('submit',e=>e.preventDefault(),{signal});form.addEventListener('change',()=>apply(true),{signal});form.addEventListener('reset',()=>setTimeout(()=>apply(true)),{signal});window.addEventListener('popstate',restore,{signal});document.addEventListener('astro:page-load',restore,{signal});restore();}disconnectedCallback(){this.controller?.abort();}}
 if(!customElements.get('nuwa-assessments'))customElements.define('nuwa-assessments',NuwaAssessments);
</script>
</BaseLayout>
