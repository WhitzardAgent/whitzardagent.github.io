---
import {catalogue,indexBase} from '../../../data/nuwa-index';
import {localizedPath,type Locale} from '../../../i18n/config';
import {sortMonitorGroups,monitorDisplayTitle,resultAttribution} from '../../../lib/nuwa-intelligence/monitoring.mjs';
interface Props{locale:Locale;benchmarkId:string}
const {locale,benchmarkId}=Astro.props,en=locale==='en',base=localizedPath(indexBase,locale),records=catalogue.results.filter(r=>r.benchmarkId===benchmarkId);
const sources=[...new Set(records.map(r=>r.sourceId))],groups=sortMonitorGroups(catalogue,catalogue.monitoring?.groups.filter(g=>g.benchmarkId===benchmarkId)??[]);
const aliases=catalogue.monitoring?.measurementAliases.filter(a=>records.some(r=>r.id===a.resultId))??[];
---
{sources.length>0&&<section class="nm-cross-report-inventory"><h2>{en?'Evidence across reports':'跨报告证据'}</h2><p>{en?'The same benchmark name can cover different tasks, scoring rules and system configurations. Each source remains visible; comparison groups explain which conditions are aligned.':'相同 Benchmark 名称可能对应不同任务、计分规则和系统配置。各来源分别保留，比较组说明具体对齐了哪些条件。'}</p><div class="nm-cross-report-list">{sources.map(sourceId=>{const source=catalogue.sources.find(s=>s.id===sourceId)!,rs=records.filter(r=>r.sourceId===sourceId),gs=groups.filter(g=>g.bindings.some((b:any)=>rs.some(r=>r.id===b.resultId))),assessment=catalogue.assessments?.find(a=>a.sourceId===sourceId);return <article><p class="ni-kicker">{[...new Set(rs.map(r=>resultAttribution(catalogue,r,locale).reporter))].join(' · ')}</p><h3>{assessment?<a href={`${base}/assessment/${assessment.id}/`}>{source.title} →</a>:source.title}</h3><p>{en?'Actual evaluators':'实际评测方'}: {[...new Set(rs.map(r=>resultAttribution(catalogue,r,locale).evaluator))].join(' · ')}</p><p>{rs.length} {en?'result records':'条结果记录'} · {[...new Set(rs.map(r=>r.system))].length} {en?'reported system names':'个报告系统名称'}</p><details><summary>{en?'Protocols and comparison decisions':'协议与比较依据'} ({gs.length})</summary>{gs.map(g=><div class="nm-protocol-link"><a href={`${base}/benchmark/${benchmarkId}/?mon-benchmark-${benchmarkId}-group=${g.id}#monitoring`}>{monitorDisplayTitle(catalogue,g,locale)}</a><small>{g.level} · {g.review.status==='accepted'?(en?'Scope reviewed':'范围已审查'):(en?'Review pending':'待审查')}</small></div>)}</details></article>;})}</div>{aliases.length>0&&<div class="ni-notice"><strong>{en?'Repeated presentation of the same measurement':'同一测量的重复呈现'}</strong>{aliases.map(a=><p><a href={`${base}/result/${a.resultId}/`}>{en?'Summary record':'汇总记录'}</a> → <a href={`${base}/result/${a.canonicalResultId}/`}>{en?'Detailed observation':'详细观测'}</a> · {a.locator}</p>)}<p>{en?'These are not independent replications. Raw records remain available; monitoring summaries retain the detailed observation.':'上述记录不构成独立复测。原始记录保持可访问，监测汇总保留详细观测。'}</p></div>}</section>}
<style is:global>.nm-cross-report-inventory{padding:34px 0}.nm-cross-report-inventory>p{font-size:14px;line-height:1.9;max-width:900px;color:#486169}.nm-cross-report-list{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:24px 0}.nm-cross-report-list article{padding:23px;border:1px solid #cfddd4;min-width:0;background:#fafcf9}.nm-cross-report-list h3{font-size:19px;line-height:1.5;font-weight:500;overflow-wrap:anywhere;margin:10px 0}.nm-cross-report-list p{font-size:12px;line-height:1.9;color:#4a6667;overflow-wrap:anywhere}.nm-cross-report-list summary{font-size:12px;cursor:pointer;line-height:1.8}.nm-protocol-link{border-top:1px solid #d6e2d9;padding:14px 0;margin-top:12px;font-size:12px;line-height:1.8}.nm-protocol-link small{display:block;font-size:11px;color:#507267}.nm-cross-report-inventory .ni-notice p{font-size:12px;line-height:1.8}@media(max-width:800px){.nm-cross-report-list{grid-template-columns:1fr}}</style>
