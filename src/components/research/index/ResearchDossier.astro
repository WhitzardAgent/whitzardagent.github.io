---
import {catalogue,indexBase} from '../../../data/nuwa-index';
import type {Locale} from '../../../i18n/config';
import {localizedPath} from '../../../i18n/config';
import {loadResearchDossiers,readingStatus} from '../../../lib/nuwa-intelligence/researchReading.mjs';
interface Props{recordId:string;locale:Locale}
const {recordId,locale}=Astro.props,en=locale==='en',work=catalogue.works.find(w=>w.id===recordId)!;
const dossier=loadResearchDossiers(catalogue).find((d:any)=>d.id===recordId),copy=dossier?.review?.state==='review-pending'?null:dossier?.[locale],status=readingStatus(work,{dossier});
const values=(value:any):string[]=>!value?[]:typeof value==='string'?[value]:Array.isArray(value)?value.flatMap(v=>typeof v==='string'?[v]:v?.text?[v.text]:v?.body?[v.body]:[]):[];
const figure=dossier?catalogue.figures?.find(f=>work.protocolIds.includes(f.protocolId)):null;
const finding=work.note.finding?.[locale]!==work.summary[locale]?work.note.finding?.[locale]:null;
const sourceScope=dossier?.review?.sourceScope==='introduction-only'?(en?'Abstract, contents and introduction only (pp. 1–3); later chapters have not been reviewed.':'仅摘要、目录和导论（第 1–3 页）；后续章节尚未审阅。'):dossier?.review?.sourceScope==='abstract'?(en?'Official abstract or summary only; full methods have not been reviewed.':'仅官方摘要或概要；完整方法尚未审阅。'):dossier?.review?.availableScope?.includes('research-introduction')?(en?'Team research introduction only; complete protocol methods remain unavailable.':'仅团队研究介绍；完整协议方法仍未取得。'):(en?'Selected sections of the original full text or official article; a complete section-by-section audit remains pending.':'选读原始全文或官方文章中的相关章节；尚未完成逐章节审计。');
const affiliated=work.contributions.some(c=>c.organizationId==='whitzard');
const sections=[['question',en?'Research question':'研究问题'],['design',en?'Design and assumptions':'研究设计与假设'],['findings',en?'Source findings':'来源发现'],['interpretation',en?'NUWA interpretation':'NUWA 解读'],['limits',en?'Limits and contrary evidence':'局限与相反证据'],['connections',en?'Research connections':'研究联系'],['decisionRelevance',en?'Research and decision relevance':'研究与决策意义']];
---
<section class="nw-dossier" data-research-dossier data-reading-status={status.id}>
 {dossier&&<p class="nw-dossier__scope" data-source-reading-scope>{en?'Model-assisted reading':'模型辅助整理'} · {sourceScope}</p>}
 {affiliated&&<p class="nw-dossier__scope">{en?'Affiliation disclosure: this research is associated with the organization maintaining this site. See the attribution section for its role.':'关联说明：本研究与本站维护机构有关联，具体角色见机构署名。'}</p>}
 <h2>{en?'At a glance':'研究速读'}</h2>
 {copy?.takeaway?<p class="nw-dossier__takeaway">{copy.takeaway}</p>:finding?<p class="nw-dossier__takeaway">{finding}</p>:<p>{work.summary[locale]}</p>}
 {status.id==='bibliographic'?<p class="nw-dossier__gap">{en?'This is a bibliographic entry. A substantive reading of the methods, findings and decision implications has not yet been completed.':'本条目前为书目记录，方法、发现及决策含义的实质解读尚未完成。'} <a href={work.originalUrl} target="_blank" rel="noreferrer">{en?'Read the original':'阅读原文'} ↗</a></p>:!copy&&<dl class="nw-dossier__facts">{work.note.method&&<div><dt>{en?'Design':'设计'}</dt><dd>{work.note.method[locale]}</dd></div>}{work.note.limits&&<div><dt>{en?'Key limit':'关键限制'}</dt><dd>{work.note.limits[locale]}</dd></div>}</dl>}
 {copy&&<div class="nw-dossier__draft" data-private-dossier={dossier.publication?.state!=='published'||undefined} data-reading-publication={dossier.publication?.state}>{sections.map(([id,title])=>values(copy[id]).length>0&&<section id={`claim-${recordId}-${id}`}>{id==='findings'&&figure&&<figure class="nw-dossier__figure"><a href={figure.original}><img src={figure.src} width={figure.width} height={figure.height} alt={figure.alt[locale]} loading="lazy"/></a><figcaption>{figure.figureLabel} · {figure.caption[locale]} <a href={figure.provenanceUrl??figure.original}>{en?'Original figure and source':'原图与来源'} ↗</a></figcaption></figure>}<h3>{title}</h3>{values(copy[id]).map((paragraph,i)=><p id={`claim-${recordId}-${id}-${i+1}`}>{paragraph}</p>)}</section>)}{dossier.sourceRefs?.length>0&&<details><summary>{en?'Precise source locations':'精确来源位置'}</summary><ul>{dossier.sourceRefs.map((ref:any)=>{const source=catalogue.sources.find(s=>s.id===ref.sourceId);return <li><a href={ref.url??source?.url??work.originalUrl}>{source?.title??ref.title??work.title}</a> · {ref.locator}{ref.version&&<small class="nw-source-version">{ref.version}</small>}</li>;})}</ul></details>}</div>}
 <p class="nw-dossier__scope">{en?'Source checking, extraction, editorial approval and replication are recorded separately.':'来源核查、数据提取、编辑批准与实验复现分别记录。'} <a href={`${localizedPath(indexBase,locale)}?view=methodology`}>{en?'Methodology':'方法说明'} →</a></p>
</section>
<style>.nw-dossier{background:#edf4ef;border-left:3px solid #407567;padding:22px 26px!important;margin:0 0 32px!important;max-width:800px}.nw-dossier h2{font-size:21px!important;margin:0 0 14px!important}.nw-dossier__scope{font-size:12px!important;line-height:1.6!important;color:#49625b;margin:0 0 12px!important}.nw-dossier__takeaway{font-size:19px!important;line-height:1.7!important;font-weight:550;color:#203b3e}.nw-dossier__facts{margin:18px 0}.nw-dossier__facts dt{font-size:13px;font-weight:650;margin-top:12px}.nw-dossier__facts dd{margin:4px 0;font-size:15px;line-height:1.75}.nw-dossier__gap{font-size:15px!important}.nw-dossier__draft{background:#fff;padding:20px;margin:20px -8px}.nw-dossier__draft section{margin-bottom:24px}.nw-dossier__draft h3{font-size:21px}.nw-dossier__draft p{font-size:16px!important;line-height:1.85!important}.nw-dossier__figure{margin:24px 0}.nw-dossier__figure img{width:100%;height:auto}.nw-dossier__figure figcaption{font-size:12px;line-height:1.7;color:#526763;margin-top:10px}.nw-source-version{display:block;font-size:11px;color:#526763;overflow-wrap:anywhere}.nw-dossier li{font-size:13px;line-height:1.7;overflow-wrap:anywhere}@media(max-width:600px){.nw-dossier{padding:18px!important}.nw-dossier__takeaway{font-size:17px!important}.nw-dossier__draft{padding:14px;margin:18px -6px}}</style>
