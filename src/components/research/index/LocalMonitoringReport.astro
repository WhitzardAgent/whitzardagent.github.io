---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleToc from '../ArticleToc.astro';
import {modelMetadataReferences,modelMetadataSources} from '../../../lib/modelMetadata.mjs';
import PageSources from '../PageSources.astro';
import MonitoringPanel from './MonitoringPanel.astro';
import {buildDisplaySets} from '../../../lib/nuwa-intelligence/panorama.mjs';
import {catalogue,indexBase} from '../../../data/nuwa-index';
import {localizedPath,type Locale} from '../../../i18n/config';
import '../../../styles/research-blog.css';
interface Props{analysis:any;locale:Locale}
const {analysis:a,locale}=Astro.props,en=locale==='en',sourceGroup=catalogue.monitoring!.groups.find(g=>g.id===a.groupId)!,group=a.displayGroupId?buildDisplaySets(catalogue,{area:a.area}).find(g=>g.id===a.displayGroupId)??sourceGroup:sourceGroup,base=localizedPath(indexBase,locale);
const headings=[{depth:2,slug:'measurements',text:en?'Measurements and interpretation':'测量与解读'},{depth:2,slug:'method',text:en?'Analysis method':'分析方法'},{depth:2,slug:'boundaries',text:en?'Conditions and limitations':'条件与局限'},{depth:2,slug:'next-check',text:en?'Next verification':'后续验证'},{depth:2,slug:'versions',text:en?'Version record':'版本记录'}];
---
<BaseLayout title={`${a.heading[locale]} — NUWA Index`} description={a.takeaway[locale]} locale={locale} brand="nuwa" noindex canonicalPath={`${indexBase}/review/${a.id}`}>
<article class="rb-article nm-local-review"><header class="rb-article__header site-container"><p class="eyebrow"><a href={`${base}?view=reports`}>NUWA INDEX · {en?'LOCAL EDITORIAL REVIEW':'本地编辑审阅稿'}</a></p><h1>{a.heading[locale]}</h1><p>{a.takeaway[locale]}</p><p class="ni-note">NUWA Lab · {a.date} · {en?'Evidence snapshot':'证据快照'} {a.snapshotId}</p></header><div class="site-container rb-article__layout rb-article__layout--toc"><ArticleToc headings={headings} locale={locale}/><div class="rb-prose"><h2 id="measurements">{headings[0].text}</h2><MonitoringPanel groups={[group]} namespace={`report-${a.id}`} locale={locale} defaultDisplay={group.defaultDisplay} analyses={[a]}/><h2 id="method">{headings[1].text}</h2><p>{en?'NUWA assembles published observations, checks protocol and model identities, and separates matched conditions, descriptive comparisons and unresolved evidence. Numeric values retain source units and reported uncertainty. Arithmetic conversions are recorded separately from experiments. No cross-benchmark score or future extrapolation is calculated.':'NUWA 汇集公开观测，核对协议与模型身份，区分条件匹配、描述性比较和待核实证据。数值保留原始单位及来源报告的不确定性；算术转换与实验分别记录。本分析不计算跨 Benchmark 总分或未来外推。'}</p><p>{en?'Original evaluators retain experimental attribution. Reused observations and subset analyses do not add independent replications. Changing a chart filter displays a subset; the interpretation continues to refer to the complete reviewed scope.':'实验归属于原始评测方。转载结果与子集分析不增加独立复测数量。图表筛选仅改变可见子集，解读仍针对完整审阅范围。'}</p><h2 id="boundaries">{headings[2].text}</h2><p>{a.limits[locale]}</p>{sourceGroup.conditions.map(c=><p><strong>{c.field} · {c.state}</strong><br/>{c.note[locale]}</p>)}<h2 id="next-check">{headings[3].text}</h2><p>{a.nextCheck[locale]}</p><h2 id="versions">{headings[4].text}</h2><p>{en?'Initial local draft':'首次本地草稿'}: {a.firstDraftDate??a.date}<br/>{en?'Updated':'更新'}: {a.date}<br/>{en?'Method':'方法'}: {a.methodVersion}<br/>{en?'Comparison group':'比较组'}: {a.groupId} · {a.groupRevision}<br/>{en?'Editorial status':'编辑状态'}: {en?'Awaiting publication approval':'待发布确认'}</p><PageSources locale={locale} sources={[...catalogue.sources,...modelMetadataSources(catalogue.models??[],catalogue.sources)]} references={[...(catalogue.models??[]).filter(m=>group.bindings.some((b:any)=>b.modelId===m.id)).flatMap(m=>modelMetadataReferences(m,locale)),...a.sourceIds.map((sourceId:string)=>({sourceId,appliesTo:en?'Measurements, interpretation and limitations':'测量、解读与局限'}))]}/></div></div></article>
</BaseLayout>

<style is:global>.nm-local-review .rb-prose{overflow-wrap:anywhere;min-width:0}.nm-local-review .rb-article__header h1{overflow-wrap:anywhere}.nm-original-results{scroll-margin-top:110px}.ni-evaluation__section{scroll-margin-top:110px}</style>
