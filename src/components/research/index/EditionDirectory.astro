---
import '../../../styles/nuwa-index.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {currentEdition,catalogue} from '../../../data/nuwa-index';
import {canonicalDocumentId} from '../../../lib/nuwa-intelligence/sourceVersions.mjs';
interface Props{locale:'en'|'zh';kind:string}
const {locale,kind}=Astro.props,en=locale==='en',base=`${en?'/en':''}/nuwa/whitzard-index`,opinion=kind==='opinion';
const sourceGroups=new Map<string,typeof catalogue.sources>();
if(!opinion)for(const source of catalogue.sources.filter(s=>catalogue.works.some(w=>w.sourceId===s.id)||catalogue.results.some(r=>r.sourceId===s.id))){const key=source.documentId??canonicalDocumentId(source.url);sourceGroups.set(key,[...(sourceGroups.get(key)??[]),source]);}
const items=opinion?(currentEdition?.opinions??[]):[...sourceGroups.values()].map(sources=>({...sources[0],sources,records:catalogue.works.filter(w=>sources.some(s=>s.id===w.sourceId))}));
const title=opinion?(en?'Arguments & perspectives':'研究观点'):(en?'Sources & research channels':'来源与研究渠道');
---
<BaseLayout title={`${title} · NUWA Index`} locale={locale} brand="nuwa"><main class="site-container ne-record"><header><p class="ne-kicker">{opinion?'OPINION':'SOURCES'}</p><h1>{title}</h1><p>{opinion?(en?'Technical arguments, their assumptions and supporting evidence.':'研究者的技术论点、前提与证据。'):(en?'Original publications behind the indexed evidence.':'索引证据所依据的原始出版物。')}</p></header>{!opinion&&currentEdition&&currentEdition.channels.length>0&&<section class="ne-channels"><h2>{en?'Channel checks':'渠道巡检'}</h2><p>{en?'HTTP availability checks are separate from publication reading and numerical extraction.':'渠道可达性巡检与文献阅读、数值提取分别记录。'}</p><div>{currentEdition.channels.map((c:any)=><article id={c.id}><a href={c.url}>{new URL(c.url).hostname}{new URL(c.url).pathname}</a><small>{c.checkedAt} · {c.status==='retrieved'?(en?'Retrieved':'已取得'):(en?'Retrieval failed':'取得失败')}</small></article>)}</div></section>}<div class="ne-directory">{items.map((p:any)=><article><p class="ne-meta">{opinion?p.authors.join(' · '):p.sources.length===1?p.publicationDate:en?`${p.sources.length} indexed source entries`:`${p.sources.length} 项来源记录`}</p><h2><a href={opinion?`${base}/opinion/${p.id}/`:p.url}>{p.title}</a></h2>{opinion&&<p>{p[locale].findings}</p>}{opinion?<a href={p.url}>{en?'Original publication':'原始文献'} ↗</a>:<div>{p.records.map((w:any)=><a href={`${base}/work/${w.id}/`}>{p.records.length>1?w.title:en?'Research record':'研究记录'} →</a>)}</div>}{!opinion&&p.sources.length>1&&<details class="ne-source-versions"><summary>{en?'Source versions and links':'来源版本与链接'}</summary><ul>{p.sources.map((s:any)=><li><a href={s.url}>{s.version}</a>{s.publicationDate&&<> · {s.publicationDate}</>}<small>{s.url}</small></li>)}</ul></details>}</article>)}</div></main></BaseLayout>
<style>.ne-channels{margin-bottom:40px}.ne-channels>div{max-height:360px;overflow:auto;border-block:1px solid #ccd9cf}.ne-channels article{padding:12px 0;overflow-wrap:anywhere}.ne-channels small{display:block;font-size:12px;color:#52625e}.ne-directory{max-width:900px}.ne-directory article{padding:24px 0;border-top:1px solid #ccd9d3}.ne-directory h2{font-size:24px;line-height:1.4;margin:10px 0 14px}.ne-directory p{font-size:17px;line-height:1.85}.ne-directory a{color:#235e53}.ne-source-versions{margin-top:14px;font-size:13px}.ne-source-versions summary{cursor:pointer;color:#235e53}.ne-source-versions li{margin:12px 0;overflow-wrap:anywhere}.ne-source-versions small{display:block;color:#52625e}.ne-directory article> a,.ne-directory article>div{font-size:13px}.ne-directory article>div>a{display:block;margin:8px 0}</style>
