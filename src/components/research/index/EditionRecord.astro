---
import '../../../styles/nuwa-index.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {currentEdition} from '../../../data/nuwa-index';
interface Props{locale:'en'|'zh';id:string;opinion?:boolean}
const {locale,id,opinion=false}=Astro.props,en=locale==='en',p=currentEdition!.publications.find((p:any)=>p.id===id)!,copy=p[locale];
const fields=[['question',en?'Research question':'研究问题'],['design',en?'Design & assumptions':'设计与前提'],['findings',opinion?(en?'Argument & evidence':'观点与依据'):(en?'Findings':'研究发现')],['limits',en?'Limits & counterevidence':'局限与反证']];
const text=(v:any)=>typeof v==='string'?v:JSON.stringify(v??'');
---
<BaseLayout title={`${p.title} · NUWA Index`} locale={locale} brand="nuwa" noindex>
<article class="ne-record site-container"><header><p class="ne-kicker">{opinion?'OPINION':'RESEARCH RECORD'}</p><h1>{p.title}</h1><p class="ne-meta">{p.authors.join(' · ')}{p.organization&&` · ${p.organization}`}</p><a href={p.url}>{en?'Original publication':'原始文献'} ↗</a><span> · </span><a href={`/nuwa/whitzard-index/exports/${locale}/${id}.bib`}>BibTeX</a><span> · </span><a href={`/nuwa/whitzard-index/exports/${locale}/${id}.ris`}>RIS</a></header><div class="ne-reading"><nav aria-label={en?'On this page':'本文导航'}>{fields.map(([key,label])=><a href={`#claim-${id}-${key}`}>{label}</a>)}<a href="#source-evidence">{en?'Source evidence':'来源证据'}</a></nav><div class="ne-article"><p class="ne-takeaway">{copy.findings}</p>{fields.map(([key,label])=><section id={`claim-${id}-${key}`}><h2>{label}</h2>{(Array.isArray(copy[key])?copy[key]:[copy[key]]).filter(Boolean).map((v:any)=><p>{text(v)}</p>)}</section>)}{p.originalFigures?.map((f:any)=><figure class="ne-original"><a href={f.src}><img src={f.src} loading="lazy" alt={f.caption?.[locale]??p.title}/></a><figcaption>{f.caption?.[locale]} <a href={f.url}>{en?'Original figure':'原图'} ↗</a></figcaption></figure>)}<section id="source-evidence"><h2>{en?'Source evidence':'来源证据'}</h2>{p.observations.length>0?<div class="ne-table"><table><thead><tr><th>{en?'System':'系统'}</th><th>{en?'Measure':'测量'}</th><th>{en?'Reported value':'原值'}</th><th>{en?'Conditions & location':'条件与位置'}</th></tr></thead><tbody>{p.observations.map((o:any)=><tr><td>{o.system??'—'}</td><td>{text(o.metricName?.[locale]??o.metricLabel??o.metric??o.label??o.id)}</td><td>{text(o.rawValue??o.rawToken??o.value)}<small>{o.unit}</small>{o.denominator!=null&&<small>n = {o.denominator} {o.denominatorUnit}</small>}{o.reportedUncertainty&&<small>{text(o.reportedUncertainty.raw??o.reportedUncertainty)}</small>}</td><td>{text(o.conditions?.[locale]??o.conditions??o.taskSet)}<small>{text(o.locator)}</small></td></tr>)}</tbody></table></div>:<p>{en?'No structured numerical extraction is available in this reading package.':'当前阅读包尚无结构化数值提取。'}</p>}</section><details class="ne-scope"><summary>{en?'Reading scope & review':'阅读范围与复核'}</summary><p>{p.scope}</p><p>{en?'Model-assisted reading; independent evidence review pending.':'模型辅助整理，独立证据复核待完成。'}</p><a href={p.url}>{en?'Check the original source':'核对原始来源'} ↗</a></details></div></div></article>
</BaseLayout>
