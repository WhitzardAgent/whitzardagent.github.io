---
import {catalogue,indexBase} from '../../../data/nuwa-index';
import {protocolComparison} from '../../../lib/nuwa-intelligence/protocolComparison.mjs';
import {loadProtocolDossiers} from '../../../lib/nuwa-intelligence/researchReading.mjs';
import {localizedPath,type Locale} from '../../../i18n/config';
interface Props{locale:Locale}
const {locale}=Astro.props,en=locale==='en',profiles=loadProtocolDossiers(catalogue),defaultIds=['cybergym','cybench','agentcyberrange'];
const comparison=protocolComparison(catalogue,defaultIds,locale,{profiles});
const protocolIds=catalogue.benchmarks.map(b=>b.id);
const profileRows=protocolIds.map(id=>({id,...protocolComparison(catalogue,[id,protocolIds.find(other=>other!==id)!],locale,{profiles}).rows.reduce((out:any,row:any)=>({...out,[row.id]:row.cells[0]}),{})}));
---
<nuwa-protocol-comparison data-comparison={JSON.stringify({protocols:catalogue.benchmarks.map(b=>({id:b.id,name:b.name,version:b.version})),rows:profileRows,labels:comparison.rows.map((r:any)=>({id:r.id,label:r.label})),base:localizedPath(indexBase,locale),en})}>
 <form class="np-compare-controls"><fieldset><legend>{en?'Choose 2–4 measurement protocols':'选择 2–4 项测量协议'}</legend><div>{Array.from({length:4},(_,i)=><label><span>{en?'Protocol':'协议'} {i+1}</span><select name={`protocol-${i}`} data-protocol-choice><option value="">{en?'Not selected':'未选择'}</option>{catalogue.benchmarks.map(b=><option value={b.id} selected={defaultIds[i]===b.id}>{b.name}</option>)}</select></label>)}</div></fieldset><button type="submit">{en?'Compare designs':'比较测量设计'}</button></form>
 <p role="status" data-compare-status>{comparison.scope}</p>
 <div class="np-compare-scroll" tabindex="0" role="region" aria-label={en?'Protocol design comparison':'协议设计比较'}><table><thead><tr><th scope="col">{en?'Measurement design':'测量设计'}</th>{comparison.protocols.map((p:any)=><th scope="col"><a href={`${localizedPath(indexBase,locale)}/benchmark/${p.id}/`}>{p.name}</a><small>{p.version}</small></th>)}</tr></thead><tbody>{comparison.rows.map((row:any)=><tr><th scope="row">{row.label}</th>{row.cells.map((cell:string)=><td>{cell}</td>)}</tr>)}</tbody></table></div>
 <noscript><p>{en?'The default comparison is available without JavaScript. Follow a protocol title for its complete static record.':'无 JavaScript 时显示默认三项比较，可通过协议标题访问完整静态档案。'}</p></noscript>
</nuwa-protocol-comparison>
<script>
class NuwaProtocolComparison extends HTMLElement{
 controller?:AbortController;
 connectedCallback(){this.controller?.abort();this.controller=new AbortController();const{signal}=this.controller;const data=JSON.parse(this.dataset.comparison!),selects=[...this.querySelectorAll<HTMLSelectElement>('[data-protocol-choice]')],table=this.querySelector('table')!,status=this.querySelector<HTMLElement>('[data-compare-status]')!;
 const render=(ids:string[],save=false)=>{ids=[...new Set(ids.filter(Boolean))];if(ids.length<2||ids.length>4){status.textContent=data.en?'Choose 2–4 different protocols.':'请选择 2–4 项不同协议。';return;}if(ids.some(id=>!data.protocols.some((p:any)=>p.id===id)))return;const head=document.createElement('thead'),tr=document.createElement('tr'),label=document.createElement('th');label.scope='col';label.textContent=data.en?'Measurement design':'测量设计';tr.append(label);for(const id of ids){const p=data.protocols.find((p:any)=>p.id===id),th=document.createElement('th'),a=document.createElement('a'),small=document.createElement('small');th.scope='col';a.href=`${data.base}/benchmark/${id}/`;a.textContent=p.name;small.textContent=p.version;th.append(a,small);tr.append(th);}head.append(tr);const body=document.createElement('tbody');for(const row of data.labels){const r=document.createElement('tr'),h=document.createElement('th');h.scope='row';h.textContent=row.label;r.append(h);for(const id of ids){const td=document.createElement('td');td.textContent=data.rows.find((p:any)=>p.id===id)[row.id];r.append(td);}body.append(r);}table.replaceChildren(head,body);status.textContent=data.en?'Comparing measurement design. Scores from different protocols are not pooled or ranked.':'当前比较测量设计。不同协议的成绩不合并、不排序。';selects.forEach((s,i)=>s.value=ids[i]??'');if(save){const url=new URL(location.href);url.searchParams.delete('protocol');ids.forEach(id=>url.searchParams.append('protocol',id));history.pushState(history.state,'',url);}};
 this.querySelector('form')!.addEventListener('submit',e=>{e.preventDefault();render(selects.map(s=>s.value),true);},{signal});const restore=()=>{const ids=new URLSearchParams(location.search).getAll('protocol');if(ids.length)render(ids);else render(['cybergym','cybench','agentcyberrange']);};window.addEventListener('popstate',restore,{signal});restore();}
 disconnectedCallback(){this.controller?.abort();}
}
if(!customElements.get('nuwa-protocol-comparison'))customElements.define('nuwa-protocol-comparison',NuwaProtocolComparison);
</script>
<style>.np-compare-controls fieldset{border:0;padding:0;margin:0}.np-compare-controls legend{font-size:14px;font-weight:600;margin-bottom:12px}.np-compare-controls fieldset>div{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.np-compare-controls label span{display:block;font-size:12px;margin-bottom:6px}.np-compare-controls select{width:100%;font-size:13px;padding:9px;border:1px solid #c8d2d0;border-radius:6px;background:#fff}.np-compare-controls button{margin:16px 0 10px;background:#214e48;color:#fff;border-radius:5px;padding:9px 16px}.np-compare-scroll{overflow:auto;border:1px solid #d5ded9;border-radius:8px;margin-top:20px}.np-compare-scroll table{border-collapse:collapse;min-width:800px;width:100%;table-layout:fixed;font-size:14px;line-height:1.8}.np-compare-scroll th,.np-compare-scroll td{padding:18px;vertical-align:top;border-bottom:1px solid #d5ded9;overflow-wrap:anywhere;text-align:left}.np-compare-scroll th:first-child{width:150px}.np-compare-scroll thead th{background:#eaf1ed}.np-compare-scroll th small{display:block;font-weight:400;font-size:11px;margin-top:8px}.np-compare-scroll td{background:#fff}.np-compare-scroll a{color:#25675a;text-decoration:underline}@media(max-width:900px){.np-compare-controls fieldset>div{grid-template-columns:1fr 1fr}}@media(max-width:500px){.np-compare-controls fieldset>div{grid-template-columns:1fr}.np-compare-scroll table{min-width:760px}}
</style>
