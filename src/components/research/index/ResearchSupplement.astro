---
import {catalogue,indexBase,researchSupplement} from '../../../data/nuwa-index';
import {localizedPath,type Locale} from '../../../i18n/config';
interface Props {locale:Locale;workId?:string;areaId?:string;library?:boolean}
const {locale,workId,areaId,library=false}=Astro.props,en=locale==='en',batch=researchSupplement;
const draft=batch?.dossiers.find((d:any)=>d.id===workId),update=batch?.updates.find((d:any)=>d.id===workId);
const observations=draft?.observations??[],relatedIds=[...new Set<string>([...(draft?.relatedWorkIds??[]),...(update?.relatedWorkIds??[])])];
const related=relatedIds.map(id=>catalogue.works.find(w=>w.id===id)).filter(Boolean);
const additions=areaId?batch?.works.filter((w:any)=>w.areas.includes(areaId))??[]:[];
const url=(id:string)=>localizedPath(`${indexBase}/work/${id}`,locale);
const units:Record<string,string>=en?{}:{fraction:'比例','fraction-difference':'比例差','%':'%','percentage-points':'百分点','percentage-points-of-GBP1-bonus':'百分点（占 £1 奖金）',runs:'运行',actions:'行为',people:'人',conversations:'对话',responses:'回应',models:'模型',items:'项目',scenarios:'场景',categories:'类别',benchmarks:'基准','attack-labeled-scenarios':'攻击标注场景','offensive-cyber-tasks':'任务',trials:'试验'};
const unit=(s:string)=>units[s]??s;
---
{batch&&library&&<p class="ns-batch" data-research-additions>{en?`Research update · ${batch.asOf}: ${batch.works.length} new records, ${batch.benchmarks.length} measurement profiles and ${batch.updates.length} existing-record updates. Published reading update; numeric trend series are unchanged.`:`研究补充 · ${batch.asOf}：新增 ${batch.works.length} 项记录、${batch.benchmarks.length} 项测量档案，补充 ${batch.updates.length} 项既有记录。公开阅读更新；数值趋势序列未变更。`}</p>}
{additions.length>0&&<section class="ns-additions" id="research-additions" data-research-additions><h2>{en?'New research and interpretation':'补充研究与解释'}</h2><p class="ns-scope">{en?'Selected original sections · model-assisted reading; independent review pending. These records add context without changing trend scores.':'原文选读 · 模型辅助整理，独立复核待完成。以下记录补充解释，未改变趋势图成绩。'}</p><ul>{additions.map((w:any)=><li><a href={url(w.id)}>{w.title} →</a><p>{w.summary[locale]}</p></li>)}</ul></section>}
{batch&&workId&&(draft||update)&&<section class="ns-record" id="research-update" data-research-supplement>
 <h2>{en?'Evidence update':'证据补充'} · {batch.asOf}</h2>
 <p class="ns-scope">{en?'Model-assisted reading · independent evidence and bilingual editorial review pending. Values are source findings or inventory counts, separate from the trend result series.':'模型辅助整理 · 独立证据及双语编辑复核待完成。以下数值为来源发现或材料计数，与趋势结果序列分开保存。'}</p>
 {update&&<p>{update.text[locale]}</p>}
 {draft?.workedExample&&<section class="ns-example" data-source-worked-example><h3>{draft.workedExample.title[locale]}</h3><p>{draft.workedExample.design[locale]}</p><p><strong>{draft.workedExample.outcome[locale]}</strong></p><p>{draft.workedExample.interpretation[locale]}</p><p class="ns-scope"><a href={draft.workedExample.sourceRef.url}>{en?'Original example':'原始案例'} ↗</a> · {draft.workedExample.sourceRef.locator}</p></section>}
 {observations.length>0&&<details class="ns-evidence"><summary>{en?`Source-bound observations (${observations.length})`:`原文数值与条件（${observations.length} 条）`}</summary>
 <p>{en?'Counts, rates and contrasts have different units. A sample count is not a number of independent experiments. Unknown numerators and interval levels remain unknown.':'计数、比例与对比效应使用不同单位。样本数量不等于独立实验数量；未披露的分子和区间水平保持未知。'}</p>
 <div class="ns-scroll" role="region" aria-label={en?'Source observations':'原文观测表'} tabindex="0"><table><thead><tr><th scope="col">{en?'System / metric':'系统／指标'}</th><th scope="col">{en?'Reported value':'原文数值'}</th><th scope="col">{en?'Population and conditions':'总体与条件'}</th></tr></thead><tbody>{observations.map((o:any)=><tr id={`observation-${o.id}`}><th scope="row">{o.system&&<span>{o.system}<br/></span>}{o.metric}</th><td>{o.value} {unit(o.unit)}{o.interval&&<small>{o.interval.lower}–{o.interval.upper} · {o.interval.kind} · {o.interval.level==null?(en?'level not stated':'水平未说明'):`${o.interval.level*100}%`}</small>}</td><td>{o.denominator&&<p>{en?'Denominator':'分母'}: {o.denominator.value} {unit(o.denominator.unit)}{o.denominator.basis&&<> · {o.denominator.basis}</>}</p>}{o.numerator!=null&&<p>{en?'Numerator':'分子'}: {o.numerator}</p>}{o.sampleCounts&&<p>{en?'Repeats per scenario':'每场景重复'}: {o.sampleCounts.repeatCount} · {en?'executions':'执行'}: {o.sampleCounts.executionCount} ({en?'NUWA arithmetic':'NUWA 计算'})</p>}<details><summary>{en?'Conditions, limitations and source':'条件、限制与来源'}</summary>{o.configuration&&<pre>{JSON.stringify(o.configuration,null,2)}</pre>}{o.aggregation&&<p>{o.aggregation}</p>}{o.interval?.note&&<p>{o.interval.note}</p>}{o.limitations&&<p>{o.limitations}</p>}{o.sourceRefs.map((r:any)=><p><a href={r.url}>{en?'Original source':'原文'} ↗</a> · {r.locator}<small>{r.version}</small></p>)}</details></td></tr>)}</tbody></table></div></details>}
 {related.length>0&&<div class="ns-connections"><h3>{en?'Related reading':'关联阅读'}</h3><p class="ns-scope">{en?'NUWA reading connections; these do not imply citation, replication or score equivalence.':'NUWA 阅读关联；不据此声称原文引用、实验复现或成绩等价。'}</p><ul>{related.map(w=><li><a href={url(w!.id)}>{w!.title} →</a></li>)}</ul></div>}
 {update&&<details><summary>{en?'Sources for this interpretation':'本次解释的来源'}</summary><ul>{update.sourceRefs.map((r:any)=><li><a href={r.url}>{r.title}</a> · {r.locator}<small>{r.version}</small></li>)}</ul></details>}
 <p><a href={`${indexBase}/data/review/${workId}.json`} download>{en?'Download source-bound evidence · JSON':'下载来源证据 · JSON'} ↓</a></p>
</section>}
<style>
.ns-batch,.ns-scope{font-size:12px!important;line-height:1.7!important;color:#49625b}.ns-batch{margin:0 0 18px}.ns-record,.ns-additions{margin:28px 0 36px;max-width:850px;min-width:0}.ns-record h2,.ns-additions h2{font-size:24px}.ns-record p,.ns-additions p{line-height:1.8}.ns-record a,.ns-additions a{color:#276455}.ns-record li,.ns-additions li{margin:12px 0;overflow-wrap:anywhere}.ns-additions ul{list-style:none;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 28px}.ns-additions li{border-top:1px solid #d8e2dc;padding-top:14px}.ns-additions li>a{font-weight:600}.ns-additions li p{font-size:14px}.ns-record summary{cursor:pointer;color:#276455;font-size:14px;line-height:1.6}.ns-evidence{border:1px solid #d8e2dc;padding:16px}.ns-evidence>p{font-size:13px!important}.ns-scroll{max-width:100%;overflow:auto}.ns-scroll table{width:100%;border-collapse:collapse;min-width:540px;font-size:13px}.ns-scroll th,.ns-scroll td{padding:12px;text-align:left;vertical-align:top;border-bottom:1px solid #d8e2dc;overflow-wrap:anywhere}.ns-scroll th{font-weight:550}.ns-scroll p,.ns-scroll pre{font-size:12px!important;line-height:1.7;margin:0 0 6px;white-space:pre-wrap;overflow-wrap:anywhere}.ns-scroll th:first-child{width:28%}.ns-scroll td:nth-child(2){width:22%}.ns-record small{display:block;font-size:11px;line-height:1.6;overflow-wrap:anywhere;color:#49625b;margin-top:6px}.ns-connections{margin:24px 0}@media(max-width:600px){.ns-additions ul{grid-template-columns:1fr}.ns-evidence{padding:12px}.ns-record h2,.ns-additions h2{font-size:22px}}
</style>
