---
import {loadResearchDossiers,loadResearchSyntheses} from '../../../lib/nuwa-intelligence/researchReading.mjs';
import TopicMonitoring from './TopicMonitoring.astro';
import {loadMonitoringDrafts} from '../../../lib/nuwa-intelligence/localReview.mjs';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import type { Locale } from '../../../i18n/config';
import { localizedPath } from '../../../i18n/config';
import { catalogue, indexBase, researchSupplement } from '../../../data/nuwa-index';
import { nuwaIndexCopy } from '../../../i18n/pages/nuwaIndex';
import { knowledgeCopy } from '../../../i18n/pages/nuwaKnowledge';
import { publishedIndexReports } from '../../../lib/indexReports';
import {reportPeriodLabel} from '../../../lib/nuwaIndex.mjs';
import { sortResearchRecords } from '../../../lib/nuwaIndex.mjs';
import ResearchCard from './ResearchCard.astro';
import ResearchSupplement from './ResearchSupplement.astro';
import ResearchCoverage from './ResearchCoverage.astro';
import RiskMechanism from './RiskMechanism.astro';
import IndexMethodology from './IndexMethodology.astro';
import RiskTimeline from './RiskTimeline.astro';
import TrendModelExplorer from './TrendModelExplorer.astro';
import IndexResults from './IndexResults.astro';
import {modelMetadataReferences,modelMetadataSources} from '../../../lib/modelMetadata.mjs';
import PageSources from '../PageSources.astro';
import '../../../styles/nuwa-index.css';
interface Props { locale: Locale }
const {locale}=Astro.props;
const c=nuwaIndexCopy[locale], k=knowledgeCopy[locale];
const path=(tail='')=>localizedPath(`${indexBase}${tail}`,locale);
const views=['framework','trend','research','benchmarks','methodology'] as const;
const labels=locale==='en'?{framework:'Framework',trend:'Trend',research:'Research',benchmarks:'Benchmarks',methodology:'Methodology'}:{framework:'Framework · 评测体系',trend:'Trend · 风险监测',research:'Research · 研究图谱',benchmarks:'Benchmarks · 安全基准',methodology:'Methodology · 方法说明'};
const analyses=loadMonitoringDrafts(catalogue);
const syntheses=loadResearchSyntheses(catalogue);
const hasDossierDrafts=loadResearchDossiers(catalogue).length>0;
const reports=(await publishedIndexReports()).filter(e=>e.data.locale===locale);
const works=sortResearchRecords(catalogue.works) as typeof catalogue.works;
const organizations=[...catalogue.organizations].sort((a,b)=>a.name[locale].localeCompare(b.name[locale]));
const years=[...new Set(works.map(w=>w.publicationDate?.slice(0,4)).filter(Boolean))].sort().reverse();
const kinds=[...new Set(works.map(w=>w.kind))];
const dimensions=['propensity','capability','behavior'] as const;
---
<BaseLayout title={c.title} description={k.description} locale={locale} brand="nuwa" canonicalPath={indexBase} ogImage="/assets/og/nuwa-og.png" ogImageAlt={c.title}>
<div class="ni-page nk-page">
  <header class="ni-header nk-header nm-index-header site-container"><a class="ni-back" href={localizedPath('/nuwa',locale)}>← {c.lab}</a><p class="ni-kicker">NUWA INDEX</p><h1>NUWA Frontier AI Safety Index</h1><p class="ni-lead">{k.description}</p></header>
  <script is:inline>document.documentElement.classList.add('nuwa-interactive');</script>
  <nuwa-index-explorer data-framework-sources={JSON.stringify([...catalogue.concepts.map(c=>c.sourceId),...catalogue.works.filter(w=>['self-replication','open-deception','agentcyberrange','agentic-misalignment'].some(id=>w.id.includes(id))).flatMap(w=>[w.sourceId,w.attributionSourceId])].filter(Boolean))} class="ni-explorer site-container" data-snapshot={catalogue.snapshotId} data-review-key={researchSupplement?.reviewFingerprint??''} data-empty={k.empty} data-count={k.count} data-clear={k.clear} data-record-count={c.records} data-selections={JSON.stringify(catalogue.monitoring?.benchmarkSelections.map(s=>({benchmarkId:s.benchmarkId,tier:s.tier,areas:s.areas})))}>
    <div class="ni-tabs" aria-label={c.title}>{views.map(v=><a href={`${path()}?view=${v}#ni-${v}`} data-index-view={v} id={`ni-tab-${v}`}><span>{labels[v].split(' · ')[0]}</span>{locale==='zh'&&<span class="nv-view-local">{labels[v].split(' · ')[1]}</span>}</a>)}</div>
    <nav class="nr-functions" data-research-function-navigation hidden aria-label={locale==='en'?'Research function':'研究功能'}>{catalogue.functions.map(f=><a href={`?view=research&function=${f.id}#ni-research`} data-function-filter={f.id}>{f.label[locale]}</a>)}</nav>
    <form class="nk-controls" data-index-controls hidden role="search">
      <div class="nk-controls__primary"><label class="nk-search"><span>{k.search}</span><input type="search" name="q" placeholder={k.searchHint} autocomplete="off" /></label><label data-library-control class="nr-function-select"><span>{k.function}</span><select name="function"><option value="">{k.all}</option>{catalogue.functions.map(f=><option value={f.id}>{f.label[locale]}</option>)}</select></label><label data-library-control><span>{locale==='en'?'Method tags':'方法标签'}</span><select name="tag"><option value="">{k.all}</option>{catalogue.researchTags?.map(t=><option value={t.id}>{t.label[locale]}</option>)}</select></label><label><span>{k.topics}</span><select name="area"><option value="">{k.all}</option>{catalogue.areas.map(a=><option value={a.id}>{a.label[locale]}</option>)}</select></label><label data-result-control hidden><span>{locale==='en'?'Order':'排序'}</span><select name="resultSort"><option value="priority">{locale==='en'?'Monitoring priority':'监测优先级'}</option><option value="coverage">{locale==='en'?'Source coverage':'来源覆盖'}</option><option value="updated">{locale==='en'?'Latest published evidence':'最近公开证据'}</option><option value="name">{locale==='en'?'Name A–Z':'名称 A–Z'}</option></select></label></div>
      <details class="nk-more" data-more><summary>{k.more}</summary><div class="nk-controls__secondary"><label data-library-control><span>{locale==='en'?'Reading scope':'阅读范围'}</span><select name="reviewScope"><option value="">{k.all}</option>{hasDossierDrafts&&<option value="published-note">{locale==='en'?'NUWA research notes':'NUWA 研究解读'}</option>}<option value="source-note">{locale==='en'?'Existing source note':'既有来源笔记'}</option><option value="bibliographic">{locale==='en'?'Bibliographic record':'书目记录'}</option></select></label><label data-library-control><span>{k.sort}</span><select name="sort"><option value="published">{k.published}</option><option value="relevance">{k.relevance}</option><option value="updated">{k.updated}</option></select></label><label data-library-control data-model-control><span>{k.organization}</span><select name="organization"><option value="">{k.institutions}</option>{organizations.map(o=><option value={o.id}>{o.name[locale]}</option>)}</select></label><label data-library-control><span>{k.kind}</span><select name="kind"><option value="">{k.kindsAll}</option>{kinds.map(t=><option value={t}>{k.kinds[t]}</option>)}</select></label><label data-library-control><span>{k.year}</span><select name="year"><option value="">{k.yearsAll}</option>{years.map(y=><option value={y}>{y}</option>)}</select></label><label data-dimension-control><span>{k.dimension}</span><select name="dimension"><option value="">{k.dimensionsAll}</option>{dimensions.map(d=><option value={d}>{c.dimensions[d].label}</option>)}</select></label><label data-library-control><span>{locale==='en'?'System scope':'系统范围'}</span><select name="scenario"><option value="">{k.all}</option><option value="multi-agent">{locale==='en'?'Multi-agent':'多智能体'}</option></select></label><label data-result-control hidden><span>{c.benchmark}</span><select name="benchmark"><option value="">{c.allBenchmarks}</option>{catalogue.benchmarks.map(b=><option value={b.id}>{b.name}</option>)}</select></label></div></details>
      <div class="nk-filter-status"><div data-active-filters aria-label={k.selected}></div><button type="reset">{k.clear}</button><output aria-live="polite" data-index-count></output></div>
    </form>
    <section class="ni-view ni-method" data-index-panel="framework" id="ni-framework" aria-labelledby="ni-tab-framework">
      <RiskMechanism locale={locale}/>
      <section class="nw-framework-definitions"><h2>{locale==='en'?'Risk themes':'风险主题'}</h2><div class="nw-theme-definitions">{catalogue.areas.map(a=><article><h3><a href={path(`/risk/${a.id}`)}>{a.label[locale]}</a></h3><p>{a.definition[locale]}</p></article>)}</div><h2>{locale==='en'?'Observation dimensions':'观测维度'}</h2><div class="ni-dimension-method">{dimensions.map(d=><article><h3>{c.dimensions[d].label}</h3><p>{c.dimensions[d].body}</p></article>)}</div></section>
    </section>
    <section class="ni-view" data-index-panel="methodology" id="ni-methodology" aria-labelledby="ni-tab-methodology"><IndexMethodology locale={locale}/><section id="source-series"><h3>{locale==='en'?'Archived source series':'来源历史系列'}</h3><RiskTimeline locale={locale}/></section></section>
    <section class="ni-view" data-index-panel="trend" id="ni-trend" aria-labelledby="ni-tab-trend"><span id="ni-overview"></span><span id="ni-risks"></span>
      {process.env.NUWA_LOCAL_REVIEW==='1'&&analyses.length>0&&<p class="ni-notice" data-local-review="DRAFT_NUWA_MONITORING_20261026">{locale==='en'?'NUWA research analysis · source scope and review status stated on each record':'NUWA 研究分析 · 来源范围与复核状态见各条目'}</p>}

      <div class="nm-trend-toolbar"><nav class="nm-scope-tabs" data-trend-switch aria-label="Trend view"><a href="?view=trend" data-trend-mode="topic">{locale==='en'?'By risk topic':'按风险主题'}</a><a href="?view=trend&trendMode=model" data-trend-mode="model">{locale==='en'?'Explore a model':'选择模型'}</a></nav><p class="nm-monitoring-intro">{locale==='en'?'Evidence cutoff':'证据截止日期'}: {catalogue.monitoring?.cutoff}</p></div>
      <div data-trend-panel="topic"><TopicMonitoring locale={locale} analyses={analyses}/></div>
      <section data-trend-panel="model" id="ni-models"><TrendModelExplorer locale={locale}/></section>
    </section>
    <section class="ni-view" data-index-panel="research" id="ni-research" aria-labelledby="ni-tab-research"><nav class="nm-scope-tabs" data-research-switch aria-label="Research collection"><a href="?view=research" data-research-mode="works">{locale==='en'?'Research landscape':'研究图谱'}</a><a href="?view=research&researchMode=reports" data-research-mode="reports">{locale==='en'?'Reports':'研究报告'}</a></nav>    <section class="nm-research-view" data-research-panel="works" id="ni-library"><div class="ni-section-heading nr-library-heading"><h2>{locale==='en'?'Research library':'研究目录'}</h2></div><ResearchSupplement locale={locale} library/><div class="nk-library" data-library-grid>{works.map(w=><ResearchCard work={w} locale={locale} filterable />)}</div><ResearchCoverage locale={locale}/></section>
    <section class="nm-research-view" data-research-panel="reports" id="ni-reports">{syntheses.length>0&&<section class="nm-local-reports"><div class="ni-section-heading"><h2>{locale==='en'?'NUWA research analysis':'NUWA 研究分析'}</h2><p>{locale==='en'?'Chart-scoped research notes with evidence, conditions and next verification. Review scope is stated in each analysis.':'围绕具体图表整理证据、条件与后续验证；各篇分别说明复核范围。'}</p></div><div class="nm-report-grid">{syntheses.map((a:any)=><article><p class="ni-kicker">NUWA Lab · {a.date}</p><h3><a href={path(`/synthesis/${a.id}`)}>{a.heading[locale]} →</a></h3><p>{a.takeaway[locale]}</p></article>)}</div></section>}<div class="ni-section-heading"><h2>{locale==='en'?'External assessments and developer reports':'外部评估与开发者报告'}</h2><p>{locale==='en'?'Reports retain their publishing institution, version and review scope. A report is not a Benchmark; its experiments are linked to the protocols actually used.':'报告保留发布机构、版本与核查范围。报告与 Benchmark 分开整理，实验关联至实际采用的协议。'}</p></div><div class="nm-report-grid">{[...(catalogue.assessments??[])].sort((a,b)=>(b.publicationDate??'').localeCompare(a.publicationDate??'')).map(a=><article data-source-ids={a.sourceId} data-report-record data-organizations={a.publisherIds.join(' ')} data-areas={a.areas.join(' ')} data-kind={a.kind} data-year={a.publicationDate?.slice(0,4)} data-date={a.publicationDate??''} data-updated={a.updatedDate??a.publicationDate??''} data-search={`${a.title} ${a.summary.en} ${a.summary.zh} ${a.publisherIds.map(id=>catalogue.organizations.find(o=>o.id===id)?.name[locale]??id).join(' ')}`}><p class="ni-kicker">{a.publisherIds.map(id=>catalogue.organizations.find(o=>o.id===id)?.name[locale]??id).join(' · ')}</p><span class="ni-kind">{a.kind==='developer'?(locale==='en'?'Developer disclosure':'开发者披露'):(locale==='en'?'External assessment':'外部评估')}</span><h3><a href={path(`/assessment/${a.id}`)}>{a.title} →</a></h3><time>{a.publicationDate??(locale==='en'?'Date not verified':'日期未核实')}</time><p>{a.summary[locale]}</p><small>{a.reviewStatus==='source-reviewed-partial'?(locale==='en'?'Source extraction reviewed; limitations documented':'来源提取已复核；限制见档案'):a.reviewStatus==='section-reviewed'?(locale==='en'?'Sections reviewed; extraction scope documented':'已逐节核查；提取范围见档案'):(locale==='en'?'Source indexed; detailed extraction pending':'已核验来源；详细提取待完成')}</small></article>)}</div><div class="ni-section-heading"><h2>{k.review}</h2><p>{k.reviewBody}</p></div>{reports.length ? reports.map(e=><article class="ni-benchmark"><div><span class="ni-kind">{reportPeriodLabel(e.data.period,locale)}</span><h3><a href={path(`/reports/${e.data.articleSlug}`)}>{e.data.title}</a></h3><p>{e.data.summary}</p></div><time datetime={e.data.date.toISOString()}>{e.data.date.toISOString().slice(0,10)}</time></article>) : <p class="ni-reading">{c.reportsEmpty}</p>}</section>
    </section>
    <section class="ni-view" data-index-panel="benchmarks" id="ni-benchmarks" aria-labelledby="ni-tab-benchmarks"><span id="ni-results"></span><div class="ni-section-heading"><h2>{c.resultsIntro}</h2><p>{c.resultsBody}</p></div><p class="ni-notice">{c.historical}</p><IndexResults records={catalogue.results} locale={locale} filterable/><p class="ni-note">{c.compareNote}</p></section>
    <p class="ni-empty" data-index-empty hidden>{k.empty}</p>
    <div class="nm-page-sources"><PageSources compact locale={locale} references={[...(catalogue.models??[]).flatMap(m=>modelMetadataReferences(m,locale)),...catalogue.works.flatMap(w=>[{sourceId:w.sourceId,appliesTo:w.title},...w.contributions.map(c=>({sourceId:c.sourceId,locator:c.locator,appliesTo:w.title}))]),...(catalogue.assessments??[]).map(a=>({sourceId:a.sourceId,appliesTo:a.title})),...(catalogue.monitoring?.groups??[]).flatMap(g=>g.sourceIds.map(sourceId=>({sourceId,appliesTo:g.title[locale]}))),...analyses.flatMap((a:any)=>a.sourceIds.map((sourceId:string)=>({sourceId,appliesTo:'NUWA analysis'}))),...catalogue.concepts.map(t=>({sourceId:t.sourceId,appliesTo:t.label[locale]})),...catalogue.results.map(r=>({sourceId:r.sourceId,locator:r.locator,appliesTo:r.benchmarkId})),...(catalogue.trendSeries??[]).flatMap(s=>s.sourceIds.map(sourceId=>({sourceId,appliesTo:s.title[locale]})))]} sources={[...catalogue.sources,...modelMetadataSources(catalogue.models??[],catalogue.sources)]}/></div>
  </nuwa-index-explorer>
</div>
<noscript><style is:global>[data-trend-panel],[data-research-panel],[data-risk-panel]{display:block!important}</style></noscript>
</BaseLayout>
<script>import '../../../lib/nuwa-intelligence/indexExplorer';</script>
<style is:global>
.nm-index-header{padding-top:20px!important;padding-bottom:16px!important}.nm-index-header .ni-back,.nm-index-header>.ni-kicker{display:none!important}.nm-index-header h1{font-size:clamp(26px,2.5vw,34px)!important;font-weight:550;letter-spacing:-.04em;line-height:1.2;margin:0 0 7px!important}.nm-index-header .ni-lead{font-size:13px!important;line-height:1.6;margin:0!important;color:#536974}.ni-explorer>.ni-tabs{overflow-x:auto;margin:0 0 16px;display:flex;border-bottom:1px solid #ccd9d3;gap:24px}.ni-explorer>.ni-tabs>a{flex:0 1 auto;padding:11px 3px!important;font-size:13px;color:#4d626b;border-bottom:2px solid transparent;margin-bottom:-1px;background:transparent!important}.nv-view-local{font-size:11px;margin-left:6px;color:#62756e}.ni-explorer>.ni-tabs>a[aria-selected=true]{color:#185d50;border-bottom-color:#2c7b62}.ni-view[hidden],[data-trend-panel][hidden],[data-research-panel][hidden]{display:none!important}.nm-trend-toolbar{display:flex;gap:18px;align-items:center;justify-content:space-between;margin:0 0 15px!important}.nm-scope-tabs{display:flex;gap:12px;align-items:center}.nm-scope-tabs a{font-size:11px;color:#536c70;padding:4px 0;text-decoration:none}.nm-scope-tabs a[aria-current=true]{color:#1b6655;font-weight:550}.nm-monitoring-intro{margin:0 0 0 auto;font-size:10px;color:#617775}.nm-framework-link{font-size:11px;color:#326b5b}.nm-deeper-exploration{margin-top:34px;border-top:1px solid #dce4de;padding-top:20px}.nm-deeper-exploration .nm-report-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.nm-deeper-exploration h2{font-size:20px}.nm-deeper-exploration h3{font-size:15px}.nm-deeper-exploration p,.nm-deeper-exploration li{font-size:12px;line-height:1.8}.nm-deeper-exploration article{background:transparent;border:0;border-top:1px solid #d2dfd6;border-radius:0;padding:15px 0}.nr-functions{display:flex;gap:8px;margin:20px 0 16px}.nr-functions a{font-size:13px;padding:9px 16px;background:#fff;border:1px solid #d6e1dc;border-radius:5px;color:#435e64;text-decoration:none}.nr-functions a[aria-current=true]{border-color:#35785f;background:#edf6f0;color:#1c654e}.nr-function-select{display:none!important}.nk-controls{margin:10px 0 14px;padding:10px 0 12px}.nk-controls label{gap:5px}.nk-controls label>span{font-size:11px}.nk-controls :is(input,select){height:36px;font-size:12px}.nk-controls .nk-more{margin-top:9px}.nk-controls .nk-more>summary{font-size:11px}.nk-controls .nk-filter-status{margin-top:9px;min-height:25px;font-size:11px}.nk-controls__primary{grid-template-columns:minmax(240px,1.8fr) 1fr 1fr}.nk-filter-status{margin-bottom:0}.nr-library-heading{margin:0 0 18px!important}.nr-library-heading h2{font-size:21px!important}.nm-research-view{margin:20px 0}.nm-report-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.nm-report-grid article{min-width:0}.ni-notice[data-local-review]{font-size:10px;line-height:1.5;padding:0;margin:0 0 9px;border:0;background:transparent;color:#6e7c7d}.nk-page .nt-topic .nv-featured{padding:0}.nk-page .nt-topic .nv-featured .nv-panel-heading h3{font-size:18px}.nk-page .nk-card__summary{font-size:14px;line-height:1.8}.ni-section-heading p{font-size:13px}.ni-view.ni-method>h3{margin-top:40px}.nm-page-sources{margin-top:28px}.nuwa-interactive nuwa-index-explorer:not([data-enhanced=true])>[data-index-panel]:not([data-index-panel=trend]){display:none}[data-page-sources] li[hidden]{display:none!important}.ni-explorer [hidden]{display:none!important}
.nw-framework-definitions{max-width:1100px}.nw-theme-definitions{display:grid;grid-template-columns:1fr 1fr;gap:24px 36px}.nw-theme-definitions h3{font-size:18px}.nw-theme-definitions p{font-size:15px;line-height:1.85;color:#405860}.nw-framework-definitions>h2{margin:35px 0 20px;font-size:25px}@media(max-width:600px){.nw-theme-definitions{grid-template-columns:1fr}.ni-explorer>.ni-tabs{gap:20px!important;justify-content:flex-start!important}}
@media(max-width:900px){.nm-deeper-exploration .nm-report-grid{grid-template-columns:1fr 1fr}.nm-index-header h1{font-size:28px!important}.ni-explorer>.ni-tabs{overflow-x:auto;gap:20px}.nm-report-grid{grid-template-columns:1fr}.nk-controls__primary{grid-template-columns:1fr 1fr}.nk-search{grid-column:1/-1}}
@media(max-width:600px){.nv-view-local{display:block;margin-left:0;margin-top:3px;font-size:10px}.nm-index-header{padding-top:18px!important;padding-bottom:12px!important}.nm-index-header h1{font-size:25px!important}.nm-index-header .ni-lead{font-size:12px!important}.ni-explorer>.ni-tabs{overflow-x:auto;gap:0;justify-content:space-between;margin-bottom:14px}.ni-explorer>.ni-tabs>a{font-size:11px;padding:10px 0!important;white-space:nowrap}.nm-trend-toolbar{gap:10px;flex-wrap:wrap}.nm-framework-link{margin-left:auto}.nm-monitoring-intro{order:3;flex-basis:100%;margin:0}.nr-functions{gap:6px;margin-top:16px}.nr-functions a{font-size:12px;padding:9px 11px}.nm-deeper-exploration .nm-report-grid{grid-template-columns:1fr}.nk-controls__primary{gap:10px}}
</style>
