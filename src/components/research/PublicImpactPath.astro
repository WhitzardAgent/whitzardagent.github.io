---
import type { Locale } from "../../i18n/config";
import ResearchPolicyWall from "./ResearchPolicyWall.astro";

interface Props { locale: Locale }
const { locale } = Astro.props;
---

<section id="public-impact" class="section research-policy-section" aria-labelledby="public-impact-title"><div class="site-container"><p class="eyebrow">{locale === "zh" ? "研究与公共影响" : "RESEARCH & PUBLIC IMPACT"}</p><h2 id="public-impact-title" class="section-title">{locale === "zh" ? "深度参与共识与标准建设" : "Contributing to consensus and standards"}</h2><p class="research-policy-section__lead">{locale === "zh" ? "NUWA Lab 深度参与国际 AI 安全共识、研究优先级与生成式人工智能安全标准建设。" : "NUWA Lab is deeply involved in international AI safety consensus, research priorities, and generative AI safety standards."}</p><ResearchPolicyWall locale={locale}/></div></section>
