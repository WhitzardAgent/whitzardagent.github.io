---
import type { Locale } from "../../i18n/config";
import { publicImpactCopy, publicImpactRecords } from "../../data/publicImpact";
import "../../styles/public-impact.css";

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = publicImpactCopy[locale].section;
const kindLabel = {
  "scientific-consensus": locale === "zh" ? "科学共识" : "Scientific consensus",
  "research-agenda": locale === "zh" ? "研究议程" : "Research agenda",
  "national-standard": locale === "zh" ? "国家标准" : "National standard",
};
const fact = (record: typeof publicImpactRecords[number]) => {
  if (record.id === "singapore-consensus") return locale === "zh" ? "由 100 余位全球贡献者形成，覆盖 13 个国家和 4 类研究优先级" : "Formed by more than 100 global contributors across 13 countries and four research-priority areas.";
  if (record.id === "gbt-45654") return locale === "zh" ? "现行国家标准；2025.04.25 发布，2025.11.01 实施" : "Current national standard; published 2025.04.25 and effective 2025.11.01.";
  return record.summary[locale];
};
---

<section id="public-impact" class="public-impact-path section" aria-labelledby="public-impact-title">
  <div class="site-container public-impact-path__head">
    <p class="eyebrow">{copy.eyebrow}</p>
    <div><h2 id="public-impact-title">{copy.title}</h2><p>{copy.body}</p></div>
  </div>
  <div class="site-container public-impact-path__timeline">
    {publicImpactRecords.map((record) => <article class={`is-${record.kind}`}>
      <div class="public-impact-path__meta"><span>{record.year}</span><em>{kindLabel[record.kind]}</em></div>
      <div class="public-impact-path__content">
        <h3>{record.title[locale]}</h3>
        {record.officialTitle && <p class="public-impact-path__official">{record.officialTitle[locale]}</p>}
        <p>{record.summary[locale]}</p>
        <p class="public-impact-path__fact">{fact(record)}</p>
        <ul class="public-impact-path__topics">{record.topics[locale].map((topic) => <li>{topic}</li>)}</ul>
        <div class="public-impact-path__sources">{record.sourceUrls.map((url, sourceIndex) => <a href={url} target="_blank" rel="noreferrer" data-umami-event="research-public-impact-source">{copy.source}{record.sourceUrls.length > 1 ? ` ${sourceIndex + 1}` : ""} ↗</a>)}</div>
      </div>
    </article>)}
  </div>
</section>
