---
import BaseLayout from "../../layouts/BaseLayout.astro";import type{Locale}from"../../i18n/config";import{localizedPath}from"../../i18n/config";import type{ResearchCopy}from"../../i18n/pages/research";import{researchAssets}from"../../data/generated/researchAssets";import"../../styles/research.css";
interface Props{locale:Locale;copy:ResearchCopy["nuwa"]}const{locale,copy}=Astro.props;const selected=researchAssets.filter(x=>x.featured).slice(0,4);
const schema={"@context":"https://schema.org","@type":"ResearchOrganization",name:"NVWA Lab",alternateName:"Nuwa Frontier AI Safety Lab",parentOrganization:{"@type":"Organization",name:"Whitzard"},url:"https://www.whitzard.tech/nuwa",description:copy.meta.description};
---
<BaseLayout title={copy.meta.title} description={copy.meta.description} locale={locale} brand="nuwa" canonicalPath="/nuwa" schema={schema}>
 <section class="nw-hero"><div class="site-container"><p class="eyebrow">{copy.eyebrow}</p><h1 class="serif">{copy.title}</h1><p>{copy.lead}</p><div class="nw-hero__arc" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div></div></section>
 <section class="nw-statement"><div class="site-container"><blockquote class="serif">{copy.statement}</blockquote></div></section>
 <section class="section nw-roles"><div class="site-container nw-roles__grid">{copy.roles.map((item,index)=><article><span>0{index+1}</span><h2>{item.title}</h2><p>{item.body}</p></article>)}</div></section>
 <section class="section nw-research"><div class="site-container nw-section-head"><p class="eyebrow">NVWA · PUBLIC RECORD</p><h2 class="section-title serif">{copy.researchTitle}</h2><p>{copy.researchBody}</p></div><div class="site-container research-list">{selected.map(item=><a href={item.url??item.pdfUrl} target="_blank" rel="noreferrer"><div><span>{item.year??item.status}</span><span>{item.venue??item.status}</span></div><h3>{item.title}</h3><p>{item.summary}</p><small>{item.topic?.join(" · ")}</small></a>)}</div><div class="site-container nw-more"><a class="button button--primary" href={localizedPath("/research",locale)}>{copy.cta}</a></div></section>
</BaseLayout>
