---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { Locale } from "../../i18n/config";
import { localizedPath } from "../../i18n/config";
import type { ResearchCopy } from "../../i18n/pages/research";
import { researchAssets } from "../../data/generated/researchAssets";
import { links } from "../../data/links";
import "../../styles/research.css";

interface Props { locale: Locale; copy: ResearchCopy["nuwa"] }
const { locale, copy } = Astro.props;
const selected = researchAssets.filter(item => item.featuredRank).sort((a, b) => (a.featuredRank ?? 99) - (b.featuredRank ?? 99)).slice(0, 4);
const itemLink = (item: typeof researchAssets[number]) => item.links.find((link) => link.kind === "paper")?.url ?? item.links[0].url;
const schema = { "@context": "https://schema.org", "@type": "ResearchOrganization", name: locale === "zh" ? "女娲实验室" : "NUWA Lab", alternateName: locale === "zh" ? ["NUWA Lab", "NVWA Lab", "Nuwa Frontier AI Safety Lab"] : ["女娲实验室", "NVWA Lab", "Nuwa Frontier AI Safety Lab"], parentOrganization: { "@type": "Organization", name: locale === "zh" ? "白泽（Whitzard）" : "Whitzard", alternateName: locale === "zh" ? ["Whitzard", "白泽"] : ["白泽"] }, url: `https://whitzard.tech${localizedPath("/nuwa", locale)}`, description: copy.meta.description };
---

<BaseLayout title={copy.meta.title} description={copy.meta.description} locale={locale} brand="nuwa" canonicalPath="/nuwa" schema={schema}>
  <section class="nw-hero"><div class="site-container nw-hero__grid"><div class="nw-hero__mark"><img src="/assets/logo/nvwa_logo.png" width="128" height="128" alt={locale === "zh" ? "女娲实验室标志" : "NUWA Lab logo"}/><span>{locale === "zh" ? "女娲实验室" : "NUWA LAB"}</span><small>{locale === "zh" ? "前沿人工智能安全" : "FRONTIER AI SAFETY"}</small></div><div><p class="eyebrow">{copy.eyebrow}</p><h1>{copy.title}</h1><p>{copy.lead}</p></div></div></section>
  <section class="nw-statement"><div class="site-container"><p class="eyebrow">{copy.statementEyebrow}</p><blockquote>{copy.statement}</blockquote></div></section>
  <section class="section nw-roles"><div class="site-container nw-roles__grid">{copy.roles.map((item, index) => <article><span>0{index + 1}</span><h2>{item.title}</h2><p>{item.body}</p></article>)}</div></section>
  <section class="section nw-research"><div class="site-container nw-section-head"><p class="eyebrow">{copy.evidenceEyebrow}</p><h2 class="section-title">{copy.researchTitle}</h2><p>{copy.researchBody}</p></div><div class="site-container research-list">{selected.map(item => <a href={itemLink(item)} target="_blank" rel="noreferrer"><div><span>{item.year}</span><span>{item.venue}</span></div><h3>{item.title}</h3><p>{item.summary[locale]}</p><small>{item.topics[locale].join(" · ")}</small></a>)}</div><div class="site-container nw-more"><a class="button button--primary" href={localizedPath("/research", locale)}>{copy.cta}</a></div></section>
  <section class="section nw-translation"><div class="site-container nw-translation__grid"><div><p class="eyebrow">{locale === "zh" ? "女娲实验室 × AGENTGUARD" : "NUWA LAB × AGENTGUARD"}</p><h2 class="section-title">{copy.translationTitle}</h2></div><div><p>{copy.translationBody}</p><a class="button button--secondary" href={localizedPath("/agentguard", locale)}>{copy.translationCta} →</a></div></div></section>
  <section class="section nw-collaboration"><div class="site-container"><p class="eyebrow">{locale === "zh" ? "研究合作" : "COLLABORATION"}</p><h2 class="section-title">{copy.collaborationTitle}</h2><p>{copy.collaborationBody}</p><div><a class="button button--primary" href={`mailto:${links.email}?subject=${encodeURIComponent(locale === "zh" ? "女娲实验室研究合作" : "NUWA research collaboration")}`}>{copy.collaborationCta}</a><a class="button button--secondary" href={localizedPath("/about", locale)}>{copy.teamCta}</a></div></div></section>
</BaseLayout>
