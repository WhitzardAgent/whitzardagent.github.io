---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { localizedPath } from "../../i18n/config";
import type { Locale } from "../../i18n/config";
import type { ResearchBlogEntry } from "../../lib/researchBlog";
import CompanionPaper from "./CompanionPaper.astro";
import ResearchLogoWall from "./ResearchLogoWall.astro";
import ResearchMediaWall from "./ResearchMediaWall.astro";
import { researchHighlights } from "../../data/researchHighlights";
import "../../styles/research-blog.css";

interface Props { entry: ResearchBlogEntry; locale: Locale; slug: string; pairedSlug?: string }
const { entry, locale, slug, pairedSlug } = Astro.props;
const { Content } = await render(entry);
const published = entry.data.date.toISOString();
const highlight = researchHighlights.find(item => item.articlePair === entry.data.pair);
const cover = entry.data.cover;
const canonicalPath = `/nuwa/blog/${slug}`;
const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: entry.data.title,
  description: entry.data.summary,
  datePublished: published,
  dateModified: (entry.data.updated ?? entry.data.date).toISOString(),
  author: entry.data.authors.map((name) => ({ "@type": "Person", name })),
  publisher: { "@type": "Organization", name: "NUWA Frontier AI Safety Lab" },
  mainEntityOfPage: `https://whitzard.tech${localizedPath(canonicalPath, locale)}`,
};
---

<BaseLayout title={`${entry.data.title} — Blogs`} description={entry.data.summary} locale={locale} brand="nuwa" canonicalPath={canonicalPath} schema={schema} ogImage={cover?.src} ogImageAlt={cover?.alt}>
  <article class="rb-article">
    <header class="rb-article__header">
      <div class="site-container rb-article__header-grid">
        <div>
          <p class="eyebrow"><a href={`${localizedPath("/nuwa/research", locale)}?kind=blogs`}>Research · Blogs</a></p>
          <h1>{entry.data.title}</h1>
        </div>
        <div class="rb-article__meta">
          <p>{entry.data.summary}</p>
          <dl>
            <div><dt>{locale === "zh" ? "发布" : "Published"}</dt><dd><time datetime={published}>{entry.data.date.toISOString().slice(0, 10)}</time></dd></div>
            <div><dt>{locale === "zh" ? "作者" : "Authors"}</dt><dd>{entry.data.authors.join(" · ")}</dd></div>
          </dl>
          {pairedSlug && <a class="text-link" href={localizedPath(`/nuwa/blog/${pairedSlug}`, locale === "zh" ? "en" : "zh")}>{locale === "zh" ? "Read in English" : "阅读中文版"} <span class="arrow">→</span></a>}
        </div>
      </div>
    </header>
    {cover && <div class="site-container rb-cover"><figure><a href={cover.src} target="_blank" rel="noreferrer"><img src={cover.src} alt={cover.alt} width={cover.width} height={cover.height} decoding="async" /></a>{highlight && <figcaption>{highlight.image.caption[locale]}</figcaption>}</figure></div>}
    <div class="site-container rb-article__layout">
      <div class="rb-prose"><Content />{highlight && <><ResearchLogoWall highlight={highlight} locale={locale} />{highlight.media && <ResearchMediaWall locale={locale}/>}<p><a href={highlight.sourceUrl} target="_blank" rel="noreferrer">{highlight.sourceLabel[locale]} ↗</a></p></>}{entry.data.updated && <p class="rb-updated">{locale === "zh" ? "更新于" : "Updated"} <time datetime={entry.data.updated.toISOString()}>{entry.data.updated.toISOString().slice(0, 10)}</time></p>}</div>
      <CompanionPaper entry={entry} locale={locale} />
    </div>
  </article>
</BaseLayout>
