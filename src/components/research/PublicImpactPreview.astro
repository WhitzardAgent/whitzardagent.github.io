---
import type { Locale } from "../../i18n/config";
import { localizedPath } from "../../i18n/config";
import { publicImpactCopy, publicImpactOverview } from "../../data/publicImpact";
import "../../styles/public-impact.css";

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = publicImpactCopy[locale].preview;
const metrics = publicImpactOverview(locale);
---

<section class="public-impact-preview section" aria-labelledby="public-impact-preview-title">
  <div class="site-container public-impact-preview__grid">
    <div><p class="eyebrow">{copy.eyebrow}</p><h2 id="public-impact-preview-title">{copy.title}</h2><p>{copy.body}</p></div>
    <div class="public-impact-preview__metrics">{metrics.map((metric) => <div><strong>{metric.value}</strong><span>{metric.label}</span></div>)}</div>
    <a class="text-link" href={`${localizedPath("/research", locale)}#public-impact`} data-umami-event="home-public-impact">{copy.cta} →</a>
  </div>
</section>
