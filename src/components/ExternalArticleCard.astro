---
interface Props {
  title: string;
  type: string;
  year?: string;
  summary: string;
  url: string;
  source?: string;
}

const { title, type, year, summary, url, source = "Substack" } = Astro.props;

const typeLabel: Record<string, string> = {
  "technical-note": "Technical Note",
  essay: "Essay",
  article: "Article",
};
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="block bg-white border border-wz-hairline rounded-lg p-5 hover:border-wz-border-strong transition-colors no-underline group"
>
  <div class="flex items-center gap-2 mb-2">
    <span class="text-wz-teal text-xs font-medium uppercase">{typeLabel[type] || type}</span>
    <span class="text-wz-muted text-xs font-medium px-1.5 py-0.5 rounded bg-wz-panel">External &middot; {source}</span>
    {year && <span class="text-wz-subtle text-xs">{year}</span>}
  </div>
  <h3 class="text-wz-ink font-semibold text-sm mb-1 group-hover:text-wz-blue transition-colors">{title}</h3>
  <p class="text-wz-muted text-xs leading-relaxed">{summary}</p>
  <div class="flex items-center gap-1 text-wz-blue text-xs font-medium mt-3">
    Read article
    <span class="text-wz-subtle group-hover:translate-x-0.5 transition-transform">&rarr;</span>
  </div>
</a>
