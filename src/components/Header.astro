---
import type { Locale } from "../i18n/config";
import { localizedPath, stripLocale } from "../i18n/config";
import { ui } from "../i18n/ui";
import LanguageSwitch from "./LanguageSwitch.astro";

interface Props { brand?: "whitzard" | "nuwa"; locale: Locale; }
const { brand = "whitzard", locale } = Astro.props;
const copy = ui[locale];
const currentPath = Astro.url.pathname;
const basePath = stripLocale(currentPath);
const homePath = localizedPath("/", locale);
const demoPath = localizedPath("/contact", locale);
function isActive(href: string) {
  if (href === "/research") return basePath.startsWith("/research") || basePath.startsWith("/nuwa");
  return basePath === href || basePath.startsWith(`${href}/`);
}
---

<site-menu>
  <header class:list={["site-header", brand === "nuwa" && "site-header--nuwa"]} data-site-header>
    <div class="site-container site-header__inner">
      <a href={homePath} class="wordmark" aria-label="Whitzard 白泽">
        <img class="wordmark__logo" src="/assets/logo/whitzard_logo.png" width="40" height="40" alt="" aria-hidden="true" decoding="async" />
        <span class="wordmark__text">Whitzard</span><span class="wordmark__han">白泽</span>
      </a>
      <nav class="site-nav" aria-label={locale === "zh" ? "主导航" : "Primary navigation"}>
        {copy.nav.map((item) => (
          <a href={localizedPath(item.href, locale)} class:list={["site-nav__link", isActive(item.href) && "is-active"]} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
        ))}
      </nav>
      <div class="site-header__actions">
        <LanguageSwitch locale={locale} pathname={currentPath} label={copy.languageLabel} />
        <a href={demoPath} class="button button--small button--primary site-header__cta">{copy.demo}</a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation" aria-label={copy.menuOpen} data-open-label={copy.menuOpen} data-close-label={copy.menuClose}>
          <span></span><span></span>
        </button>
      </div>
    </div>
    <div id="mobile-navigation" class="mobile-navigation" hidden>
      <nav class="site-container mobile-navigation__inner" aria-label={locale === "zh" ? "移动端主导航" : "Mobile navigation"}>
        {copy.nav.map((item, index) => (
          <a href={localizedPath(item.href, locale)} class:list={["mobile-navigation__link", isActive(item.href) && "is-active"]} data-mobile-first={index === 0 ? "true" : undefined}>
            <span>{String(index + 1).padStart(2, "0")}</span>{item.label}
          </a>
        ))}
        <a href={demoPath} class="button button--primary mobile-navigation__cta">{copy.demo}</a>
      </nav>
    </div>
  </header>
</site-menu>

<script>
  class SiteMenu extends HTMLElement {
    private button: HTMLButtonElement | null = null;
    private panel: HTMLElement | null = null;
    private aborter = new AbortController();
    connectedCallback() {
      this.button = this.querySelector(".menu-toggle");
      this.panel = this.querySelector(".mobile-navigation");
      this.button?.addEventListener("click", () => this.toggle(), { signal: this.aborter.signal });
      this.addEventListener("keydown", (event) => { if (event.key === "Escape") this.close(true); }, { signal: this.aborter.signal });
      this.querySelectorAll(".mobile-navigation a").forEach((link) => link.addEventListener("click", () => this.close(false), { signal: this.aborter.signal }));
    }
    disconnectedCallback() { this.aborter.abort(); }
    private toggle() { this.button?.getAttribute("aria-expanded") === "true" ? this.close(true) : this.open(); }
    private open() {
      if (!this.button || !this.panel) return;
      this.panel.hidden = false;
      this.button.setAttribute("aria-expanded", "true");
      this.button.setAttribute("aria-label", this.button.dataset.closeLabel ?? "Close navigation");
      document.documentElement.classList.add("menu-open");
      requestAnimationFrame(() => this.querySelector<HTMLAnchorElement>("[data-mobile-first]")?.focus());
    }
    private close(restoreFocus: boolean) {
      if (!this.button || !this.panel) return;
      this.panel.hidden = true;
      this.button.setAttribute("aria-expanded", "false");
      this.button.setAttribute("aria-label", this.button.dataset.openLabel ?? "Open navigation");
      document.documentElement.classList.remove("menu-open");
      if (restoreFocus) this.button.focus();
    }
  }
  if (!customElements.get("site-menu")) customElements.define("site-menu", SiteMenu);
</script>
