---
import { links } from "../data/links";

interface Props {
  brand?: "whitzard" | "nuwa";
}

const { brand = "whitzard" } = Astro.props;
const currentPath = Astro.url.pathname;
const isNuwaBrand = brand === "nuwa" || currentPath.startsWith("/nuwa") || currentPath.startsWith("/research");
---

<header
  class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-wz-hairline"
  style="height: 64px;"
>
  <div class="max-w-[1180px] mx-auto px-6 h-full flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 text-wz-ink font-semibold tracking-tight no-underline">
      {isNuwaBrand ? (
        <span class="flex items-center gap-2">
          <img src="/assets/logo/nvwa_logo.png" alt="" class="w-6 h-6 rounded" />
          <span class="text-base">Nuwa <span class="text-nw-muted font-normal text-sm">女娲</span></span>
        </span>
      ) : (
        <span class="flex items-center gap-2">
          <img src="/assets/logo/whitzard_logo.png" alt="" class="w-6 h-6 rounded" />
          <span class="text-base">Whitzard <span class="text-wz-muted font-normal text-sm">白泽</span></span>
        </span>
      )}
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-wz-muted">
      <a href="/nuwa" class:list={["hover:text-wz-ink transition-colors no-underline", currentPath.startsWith("/nuwa") && "text-wz-ink"]}>
        Nuwa
      </a>
      <a href="/research" class:list={["hover:text-wz-ink transition-colors no-underline", (currentPath.startsWith("/research") || currentPath.startsWith("/publications")) && "text-wz-ink"]}>
        Research
      </a>
      <a href="/blog" class:list={["hover:text-wz-ink transition-colors no-underline", currentPath.startsWith("/blog") && "text-wz-ink"]}>
        Blog
      </a>
      <a href="/about" class:list={["hover:text-wz-ink transition-colors no-underline", currentPath === "/about" && "text-wz-ink"]}>
        About
      </a>
      <a
        href="/contact"
        class="inline-flex items-center bg-wz-ink text-white rounded-full px-4 py-1.5 text-xs font-semibold hover:bg-wz-navy transition-colors no-underline"
      >
        Contact
      </a>
      <a
        href={links.github}
        target="_blank"
        rel="noopener noreferrer"
        class="text-wz-muted hover:text-wz-ink transition-colors no-underline"
      >
        GitHub
      </a>
    </nav>

    <!-- Mobile Menu Toggle -->
    <button
      id="mobile-menu-toggle"
      class="md:hidden p-2 text-wz-ink"
      aria-label="Toggle navigation menu"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>
  </div>

  <!-- Mobile Navigation -->
  <nav
    id="mobile-menu"
    class="hidden md:hidden bg-white border-b border-wz-hairline px-6 py-4"
  >
    <div class="flex flex-col gap-3 text-sm font-medium text-wz-muted">
      <a href="/nuwa" class="hover:text-wz-ink no-underline">Nuwa</a>
      <a href="/research" class="hover:text-wz-ink no-underline">Research</a>
      <a href="/blog" class="hover:text-wz-ink no-underline">Blog</a>
      <a href="/about" class="hover:text-wz-ink no-underline">About</a>
      <a href="/contact" class="hover:text-wz-ink no-underline">Contact</a>
      <a href={links.github} target="_blank" rel="noopener noreferrer" class="hover:text-wz-ink no-underline">GitHub</a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
  });
</script>
