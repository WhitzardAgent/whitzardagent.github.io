---
import type { Locale } from "../../i18n/config";
import type { ResearchCopy } from "../../i18n/pages/research";
import type { OpenSourceAsset } from "../../data/generated/openSourceAssets";
import BrandHero from "../brand/BrandHero.astro";
import { links } from "../../data/links";
interface Props { locale: Locale; copy: ResearchCopy["ecosystem"]; projects: OpenSourceAsset[] }
const {locale,copy}=Astro.props;
---
<BrandHero locale={locale} artwork="ecosystem" eyebrow={copy.eyebrow} title={copy.title} segments={locale === "zh" ? ["开放构建", "智能体", "安全基础设施"] : undefined} description={copy.lead}>
  <a class="button button--primary" href={links.github} target="_blank" rel="noreferrer">{copy.github} ↗</a>
  <a class="button button--secondary" href={links.huggingface} target="_blank" rel="noreferrer">{copy.hf} ↗</a>
</BrandHero>
