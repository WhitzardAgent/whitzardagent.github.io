---
import BaseLayout from "../layouts/BaseLayout.astro";
import { links } from "../data/links";
import SectionHeader from "../components/SectionHeader.astro";
import FiveStoneMotif from "../components/visuals/FiveStoneMotif.astro";
import ArcField from "../components/visuals/ArcField.astro";
---

<BaseLayout
  title="About — Whitzard & Nuwa"
  description="Learn about Whitzard, Nuwa Frontier AI Safety Lab, their Eastern-rooted naming, research roots, and core team."
  ogImage="/assets/og/whitzard-og.png"
>
  <section class="py-16 md:py-24">
    <div class="max-w-[1120px] mx-auto px-6">

      <!-- Mission -->
      <div class="max-w-2xl mb-16">
        <h1 class="text-wz-ink font-semibold tracking-tight mb-5" style="font-size: var(--text-h1);">
          About Whitzard and Nuwa
        </h1>
        <p class="text-wz-body text-lg leading-relaxed mb-4">
          Whitzard builds generalized, intelligent safety modules for frontier AI and agentic systems, designed for real-world vertical scenarios and public safety. Nuwa Frontier AI Safety Lab is the research lab supported by Whitzard, focused on transparent, third-party, open evaluation and governance evidence for frontier AI safety.
        </p>
        <p class="text-wz-muted text-base leading-relaxed">
          Together, Whitzard and Nuwa represent two complementary layers: Whitzard builds deployable safety infrastructure; Nuwa develops transparent research, open evaluation frameworks, and governance evidence.
        </p>
      </div>

      <FiveStoneMotif layout="row" size={5} gap={10} class="mb-16" />

      <!-- Names and Eastern Roots -->
      <div class="mb-16">
        <SectionHeader title="Names and Eastern Roots" subtitle="The mythology behind Whitzard and Nuwa." />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-wz-panel-blue/30 border border-wz-hairline rounded-3xl p-8 md:p-10">
            <div class="flex items-center gap-3 mb-4">
              <img src="/assets/logo/whitzard_logo.png" alt="" class="w-8 h-8 rounded" />
              <div>
                <p class="text-wz-ink font-semibold text-lg">Whitzard</p>
                <p class="text-wz-muted font-normal text-sm">白泽</p>
              </div>
            </div>
            <p class="text-wz-body text-sm leading-relaxed mb-6">
              Whitzard (白泽) is inspired by the Chinese mythic creature 白泽, known for recognizing hidden threats and understanding unseen dangers. The name carries this idea into AI safety: detect hidden risks, understand complex systems, and protect society before harm occurs.
            </p>
            <!-- Sensing eye arc motif -->
            <div class="flex justify-center" aria-hidden="true">
              <svg width="64" height="36" viewBox="0 0 64 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="32" cy="18" r="6" stroke="var(--wz-blue)" stroke-width="1" opacity="0.35" fill="none" />
                <path d="M8 18 Q20 2 32 2 Q44 2 56 18" stroke="var(--wz-blue)" stroke-width="1" opacity="0.25" fill="none" />
                <path d="M8 18 Q20 34 32 34 Q44 34 56 18" stroke="var(--wz-blue)" stroke-width="1" opacity="0.25" fill="none" />
              </svg>
            </div>
          </div>

          <div class="bg-nw-jade-pale/40 border border-nw-hairline rounded-3xl p-8 md:p-10">
            <div class="flex items-center gap-3 mb-4">
              <img src="/assets/logo/nvwa_logo.png" alt="" class="w-8 h-8 rounded" />
              <div>
                <p class="text-nw-ink font-semibold text-lg">Nuwa</p>
                <p class="text-nw-muted font-normal text-sm">女娲 Nüwa</p>
              </div>
            </div>
            <p class="text-nw-body text-sm leading-relaxed mb-6">
              Nüwa is known for repairing the sky. For Nuwa Frontier AI Safety Lab, this metaphor points to a research mission: identify safety gaps in advanced AI systems, repair fragile boundaries, and build evidence for controllable AI before failures become systemic.
            </p>
            <!-- Five-stone repair arc motif -->
            <div class="flex justify-center" aria-hidden="true">
              <svg width="64" height="32" viewBox="0 0 64 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 28 Q16 4 32 4 Q48 4 60 28" stroke="var(--nw-jade)" stroke-width="0.8" opacity="0.2" fill="none" stroke-dasharray="3 3" />
                <rect x="12" y="14" width="5" height="5" rx="1" transform="rotate(45 14.5 16.5)" fill="var(--stone-jade)" opacity="0.7" />
                <rect x="22" y="8" width="5" height="5" rx="1" transform="rotate(45 24.5 10.5)" fill="var(--stone-vermilion)" opacity="0.7" />
                <rect x="30" y="6" width="5" height="5" rx="1" transform="rotate(45 32.5 8.5)" fill="var(--stone-ochre)" opacity="0.7" />
                <rect x="38" y="8" width="5" height="5" rx="1" transform="rotate(45 40.5 10.5)" fill="var(--stone-ivory)" opacity="0.7" />
                <rect x="48" y="14" width="5" height="5" rx="1" transform="rotate(45 50.5 16.5)" fill="var(--stone-ink)" opacity="0.7" />
              </svg>
            </div>
          </div>
        </div>
      </div>

      <FiveStoneMotif layout="row" size={5} gap={10} class="mb-16" />

      <!-- Organization Relationship -->
      <div class="mb-16">
        <SectionHeader title="Organization" subtitle="How Whitzard and Nuwa work together." />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-wz-mist border border-wz-hairline rounded-3xl p-8">
            <div class="flex items-center gap-2 mb-5">
              <img src="/assets/logo/whitzard_logo.png" alt="" class="w-6 h-6 rounded" />
              <span class="text-wz-ink font-semibold text-base">Whitzard</span>
              <span class="text-wz-muted font-normal text-sm">白泽</span>
            </div>
            <ul class="space-y-3.5 text-wz-body text-sm leading-relaxed">
              <li class="flex items-start gap-2.5">
                <span class="text-wz-teal mt-0.5 text-xs">&#9670;</span>
                <span>Company and product brand</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-wz-teal mt-0.5 text-xs">&#9670;</span>
                <span>Generalized intelligent safety modules</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-wz-teal mt-0.5 text-xs">&#9670;</span>
                <span>Evaluation, runtime defense, monitoring systems</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-wz-teal mt-0.5 text-xs">&#9670;</span>
                <span>Real vertical-domain safety solutions</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-wz-teal mt-0.5 text-xs">&#9670;</span>
                <span>Public safety orientation</span>
              </li>
            </ul>
          </div>

          <div class="bg-nw-warm-paper border border-nw-hairline rounded-3xl p-8">
            <div class="flex items-center gap-2 mb-5">
              <img src="/assets/logo/nvwa_logo.png" alt="" class="w-6 h-6 rounded" />
              <span class="text-nw-jade text-sm">&#9670;</span>
              <span class="text-nw-ink font-semibold text-base">Nuwa</span>
              <span class="text-nw-muted font-normal text-sm">女娲</span>
            </div>
            <ul class="space-y-3.5 text-nw-body text-sm leading-relaxed">
              <li class="flex items-start gap-2.5">
                <span class="text-nw-jade mt-0.5 text-xs">&#9670;</span>
                <span>Research lab supported by Whitzard</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-nw-jade mt-0.5 text-xs">&#9670;</span>
                <span>Transparent third-party evaluation</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-nw-jade mt-0.5 text-xs">&#9670;</span>
                <span>Open infrastructure and benchmarks</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-nw-jade mt-0.5 text-xs">&#9670;</span>
                <span>Frontier AI safety evaluation and governance</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-nw-jade mt-0.5 text-xs">&#9670;</span>
                <span>Research on autonomy risks, deception, scheming, and loss-of-control</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="max-w-2xl mt-8">
          <p class="text-wz-body text-base leading-relaxed">
            Nuwa develops the research agenda, evaluation methodology, benchmarks, and governance evidence. Whitzard builds the deployable safety infrastructure that brings these ideas into real systems and public safety scenarios.
          </p>
        </div>
      </div>

      <FiveStoneMotif layout="row" size={5} gap={10} class="mb-16" />

      <!-- Core Members -->
      <div class="mb-16">
        <SectionHeader title="Core Members" subtitle="The people driving Whitzard and Nuwa." />

        <!-- Co-Founders -->
        <div class="mb-6">
          <p class="text-wz-muted text-xs uppercase tracking-wide mb-4 font-medium">Co-Founders</p>
          <div class="space-y-4">
            <!-- Dr. Jiarun Dai -->
            <div class="card card--profile hover-lift rounded-2xl">
              <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
                <div class="flex-1">
                  <div class="flex items-center gap-3 mb-2">
                    <p class="text-wz-ink font-semibold text-base">Dr. Jiarun Dai</p>
                    <span class="badge" style="background: var(--wz-panel-blue); color: var(--wz-blue);">CEO</span>
                  </div>
                  <p class="text-wz-body text-sm leading-relaxed max-w-xl">
                    Dr. Jiarun Dai is the CEO of Whitzard and an Assistant Professor at <a href={links.fudanUniversity} target="_blank" rel="noopener noreferrer" class="text-wz-blue hover:underline">Fudan University</a>. He is a cybersecurity expert and former captain of the Fudan Baize CTF team, with deep experience in binary analysis, vulnerability discovery, and exploitation. He received both his Ph.D. and B.Sc. from <a href={links.fudanUniversity} target="_blank" rel="noopener noreferrer" class="text-wz-blue hover:underline">Fudan University</a> under the supervision of <a href={links.minYang} target="_blank" rel="noopener noreferrer" class="text-wz-blue hover:underline">Prof. Min Yang</a>.
                  </p>
                </div>
                <div class="flex flex-wrap gap-3 mt-4 pt-3 border-t border-wz-hairline md:mt-0 md:pt-0 md:border-t-0">
                  <a href="https://djrrr.github.io/" target="_blank" rel="noopener noreferrer" class="text-wz-blue text-xs hover:underline no-underline whitespace-nowrap">Homepage &rarr;</a>
                  <a href="https://scholar.google.com/citations?user=YH1Y454AAAAJ" target="_blank" rel="noopener noreferrer" class="text-wz-blue text-xs hover:underline no-underline whitespace-nowrap">Google Scholar &rarr;</a>
                </div>
              </div>
            </div>

            <!-- Dr. Xudong Pan -->
            <div class="card card--profile hover-lift rounded-2xl">
              <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
                <div class="flex-1">
                  <div class="flex items-center gap-3 mb-2">
                    <p class="text-wz-ink font-semibold text-base">Dr. Xudong Pan</p>
                    <span class="badge" style="background: var(--wz-panel-blue); color: var(--wz-blue);">CTO</span>
                  </div>
                  <p class="text-wz-body text-sm leading-relaxed max-w-xl">
                    Dr. Xudong Pan is the CTO of Whitzard and an Assistant Professor (Xuemin Fellow) at <a href={links.fudanUniversity} target="_blank" rel="noopener noreferrer" class="text-wz-blue hover:underline">Fudan University</a>, as well as a PhD Advisor at the Shanghai Innovation Institute. His work focuses on AI safety, model safety, AI system security, and frontier AI risk evaluation. He received both his Ph.D. and B.Sc. from <a href={links.fudanUniversity} target="_blank" rel="noopener noreferrer" class="text-wz-blue hover:underline">Fudan University</a> under the supervision of <a href={links.minYang} target="_blank" rel="noopener noreferrer" class="text-wz-blue hover:underline">Prof. Min Yang</a>.
                  </p>
                </div>
                <div class="flex flex-wrap gap-3 mt-4 pt-3 border-t border-wz-hairline md:mt-0 md:pt-0 md:border-t-0">
                  <a href="https://ravensanstete.github.io/" target="_blank" rel="noopener noreferrer" class="text-wz-blue text-xs hover:underline no-underline whitespace-nowrap">Homepage &rarr;</a>
                  <a href="https://scholar.google.com/citations?user=Unl69CYAAAAJ" target="_blank" rel="noopener noreferrer" class="text-wz-blue text-xs hover:underline no-underline whitespace-nowrap">Google Scholar &rarr;</a>
                  <a href="https://github.com/ravenSanstete" target="_blank" rel="noopener noreferrer" class="text-wz-blue text-xs hover:underline no-underline whitespace-nowrap">GitHub &rarr;</a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Strategic Partners -->
        <div>
          <p class="text-wz-muted text-xs uppercase tracking-wide mb-4 font-medium">Strategic Partners</p>
          <div class="space-y-4">
            <!-- Dr. Geng Hong -->
            <div class="card card--profile hover-lift rounded-2xl bg-wz-panel">
              <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
                <div class="flex-1">
                  <div class="flex items-center gap-3 mb-2">
                    <p class="text-wz-ink font-semibold text-base">Dr. Geng Hong</p>
                    <span class="badge" style="background: var(--wz-teal-soft); color: var(--wz-teal);">Strategic Partner</span>
                  </div>
                  <p class="text-wz-body text-sm leading-relaxed max-w-xl">
                    Dr. Geng Hong is an Assistant Professor at <a href={links.fudanUniversity} target="_blank" rel="noopener noreferrer" class="text-wz-blue hover:underline">Fudan University</a> and a strategic partner for Whitzard and Nuwa. His work spans cybercrime, penetration testing, cybersecurity ecosystem research, and in-the-wild security studies, bringing practical security insight into AI safety evaluation and governance.
                  </p>
                </div>
                <div class="flex flex-wrap gap-3 mt-4 pt-3 border-t border-wz-hairline">
                  <a href={links.gengHong} target="_blank" rel="noopener noreferrer" class="text-wz-blue text-xs hover:underline no-underline whitespace-nowrap">Homepage &rarr;</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <FiveStoneMotif layout="row" size={5} gap={10} class="mb-16" />

      <!-- Research Roots -->
      <div class="mb-16">
        <SectionHeader title="Research Roots" subtitle="Our academic and research foundations." />
        <div class="flex flex-col sm:flex-row flex-wrap gap-4">
          <a
            href={links.fudanSecurityLab}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 bg-wz-mist border border-wz-hairline rounded-xl px-5 py-3.5 text-sm text-wz-ink font-medium no-underline hover:border-wz-teal transition-colors"
          >
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <rect x="2" y="3" width="14" height="12" rx="2" stroke="var(--wz-teal)" stroke-width="1.2" fill="none" />
              <path d="M6 7h6M6 10h4" stroke="var(--wz-teal)" stroke-width="1" opacity="0.6" />
            </svg>
            System Software &amp; Security Lab
          </a>
          <a
            href={links.fudanUniversity}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 bg-wz-mist border border-wz-hairline rounded-xl px-5 py-3.5 text-sm text-wz-ink font-medium no-underline hover:border-wz-teal transition-colors"
          >
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M9 2L2 7v9h14V7L9 2z" stroke="var(--wz-teal)" stroke-width="1.2" fill="none" />
              <path d="M6 16V10h6v6" stroke="var(--wz-teal)" stroke-width="1" opacity="0.5" />
            </svg>
            Fudan University
          </a>
          <a
            href={links.minYang}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 bg-wz-mist border border-wz-hairline rounded-xl px-5 py-3.5 text-sm text-wz-ink font-medium no-underline hover:border-wz-teal transition-colors"
          >
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <circle cx="9" cy="6" r="3.5" stroke="var(--wz-teal)" stroke-width="1.2" fill="none" />
              <path d="M3 16c0-3.3 2.7-6 6-6s6 2.7 6 6" stroke="var(--wz-teal)" stroke-width="1.2" fill="none" />
            </svg>
            Prof. Min Yang
          </a>
        </div>
        <p class="text-wz-muted text-sm leading-relaxed mt-4">
          This foundation in system security, vulnerability research, and AI safety continues to shape our approach to building practical safety infrastructure for frontier AI systems.
        </p>
      </div>

      <FiveStoneMotif layout="row" size={5} gap={10} class="mb-16" />

      <!-- Research and Collaboration -->
      <div class="max-w-2xl mb-16">
        <SectionHeader title="Research and Collaboration" />
        <p class="text-wz-body text-base leading-relaxed mb-6">
          Nuwa's research work is grounded in frontier AI risk evaluation, agent safety, AI control, and AI system security. We use this site to maintain a public record of research outputs, technical notes, and collaboration directions.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/research" class="btn btn--primary">
            View Research
          </a>
          <a href="/contact" class="btn btn--secondary">
            Collaborate With Us
          </a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
