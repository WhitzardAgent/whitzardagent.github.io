---
import BaseLayout from "../layouts/BaseLayout.astro";
import { links } from "../data/links";
import { team } from "../data/team";
import SectionHeader from "../components/SectionHeader.astro";

const founding = team.filter((m) => m.category === "founding");
const partners = team.filter((m) => m.category === "partner");
---

<BaseLayout
  title="About — Whitzard & Nuwa"
  description="Learn about Whitzard, Nuwa Frontier AI Safety Lab, their Eastern-rooted naming, research roots, and core team."
  ogImage="/assets/og/whitzard-og.png"
>
  <section class="py-20 md:py-28">
    <div class="max-w-[1120px] mx-auto px-6">

      <!-- Mission -->
      <div class="max-w-2xl mb-16">
        <h1 class="text-wz-ink font-semibold tracking-tight mb-5" style="font-size: var(--text-h1);">
          About Whitzard and Nuwa
        </h1>
        <p class="text-wz-body text-lg leading-relaxed mb-4">
          Whitzard builds generalized, intelligent safety modules for frontier AI and agentic systems, designed for real-world vertical scenarios and public safety. Nuwa Frontier AI Safety Lab is the research lab supported by Whitzard, focused on transparent, third-party, open evaluation and governance evidence for frontier AI safety.
        </p>
        <p class="text-wz-muted text-base leading-relaxed">
          Together, Whitzard and Nuwa represent two complementary layers: Whitzard builds deployable safety infrastructure; Nuwa develops transparent research, open evaluation frameworks, and governance evidence.
        </p>
      </div>

      <!-- Names and Eastern Roots -->
      <div class="mb-16">
        <SectionHeader title="Names and Eastern Roots" subtitle="The mythology behind Whitzard and Nuwa." />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-wz-panel-blue/30 border border-wz-hairline rounded-xl p-7">
            <div class="flex items-center gap-3 mb-4">
              <img src="/assets/logo/whitzard_logo.png" alt="" class="w-8 h-8 rounded" />
              <div>
                <p class="text-wz-ink font-semibold text-lg">Whitzard</p>
                <p class="text-wz-muted font-normal text-sm">白泽 Baize</p>
              </div>
            </div>
            <p class="text-wz-body text-sm leading-relaxed">
              In Chinese mythology, Baize is a wise creature known for recognizing hidden threats and understanding the forms of unseen dangers. The name Whitzard carries this idea into AI safety: detect hidden risks, understand complex systems, and protect society before harm occurs.
            </p>
          </div>

          <div class="bg-nw-jade-pale/40 border border-nw-hairline rounded-xl p-7">
            <div class="flex items-center gap-3 mb-4">
              <img src="/assets/logo/nvwa_logo.png" alt="" class="w-8 h-8 rounded" />
              <div>
                <p class="text-nw-ink font-semibold text-lg">Nuwa</p>
                <p class="text-nw-muted font-normal text-sm">女娲 Nüwa</p>
              </div>
            </div>
            <p class="text-nw-body text-sm leading-relaxed">
              Nüwa is known for repairing the sky. For Nuwa Frontier AI Safety Lab, this metaphor points to a research mission: identify safety gaps in advanced AI systems, repair fragile boundaries, and build evidence for controllable AI before failures become systemic.
            </p>
          </div>
        </div>
      </div>

      <!-- Organization Relationship -->
      <div class="mb-16">
        <SectionHeader title="Organization" subtitle="How Whitzard and Nuwa work together." />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-wz-panel-blue/40 border border-wz-hairline rounded-xl p-7">
            <div class="flex items-center gap-2 mb-4">
              <img src="/assets/logo/whitzard_logo.png" alt="" class="w-6 h-6 rounded" />
              <span class="text-wz-ink font-semibold text-base">Whitzard</span>
              <span class="text-wz-muted font-normal text-sm">白泽</span>
            </div>
            <ul class="space-y-2.5 text-wz-body text-sm leading-relaxed">
              <li class="flex items-start gap-2">
                <span class="text-wz-blue mt-0.5 text-xs">&#9670;</span>
                <span>Company and product brand</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-wz-blue mt-0.5 text-xs">&#9670;</span>
                <span>Generalized intelligent safety modules</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-wz-blue mt-0.5 text-xs">&#9670;</span>
                <span>Evaluation, runtime defense, monitoring systems</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-wz-blue mt-0.5 text-xs">&#9670;</span>
                <span>Real vertical-domain safety solutions</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-wz-blue mt-0.5 text-xs">&#9670;</span>
                <span>Public safety orientation</span>
              </li>
            </ul>
          </div>

          <div class="bg-nw-jade-pale/40 border border-nw-hairline rounded-xl p-7">
            <div class="flex items-center gap-2 mb-4">
              <img src="/assets/logo/nvwa_logo.png" alt="" class="w-6 h-6 rounded" />
              <span class="text-nw-jade text-sm">&#9670;</span>
              <span class="text-nw-ink font-semibold text-base">Nuwa</span>
              <span class="text-nw-muted font-normal text-sm">女娲</span>
            </div>
            <ul class="space-y-2.5 text-nw-body text-sm leading-relaxed">
              <li class="flex items-start gap-2">
                <span class="text-nw-jade mt-0.5 text-xs">&#9670;</span>
                <span>Research lab supported by Whitzard</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-nw-jade mt-0.5 text-xs">&#9670;</span>
                <span>Transparent third-party evaluation</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-nw-jade mt-0.5 text-xs">&#9670;</span>
                <span>Open infrastructure and benchmarks</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-nw-jade mt-0.5 text-xs">&#9670;</span>
                <span>Frontier AI safety evaluation and governance</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-nw-jade mt-0.5 text-xs">&#9670;</span>
                <span>Research on autonomy risks, deception, scheming, and loss-of-control</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="max-w-2xl mt-6">
          <p class="text-wz-body text-base leading-relaxed">
            Nuwa develops the research agenda, evaluation methodology, benchmarks, and governance evidence. Whitzard builds the deployable safety infrastructure that brings these ideas into real systems and public safety scenarios.
          </p>
        </div>
      </div>

      <!-- The Triangle Team -->
      <div class="mb-16">
        <SectionHeader title="The Triangle Team" subtitle="Core members driving Whitzard and Nuwa." />

        <div class="space-y-4">
          {founding.map((member) => (
            <div class="bg-white border border-wz-hairline rounded-xl p-6 md:p-7">
              <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
                <div class="flex-1">
                  <div class="flex items-center gap-3 mb-2">
                    <p class="text-wz-ink font-semibold text-base">{member.name}</p>
                    <span class="text-wz-blue text-xs font-medium bg-wz-panel-blue/40 px-2 py-0.5 rounded-full">{member.role}</span>
                  </div>
                  <p class="text-wz-body text-sm leading-relaxed max-w-xl">{member.bio}</p>
                </div>
                {member.links && member.links.length > 0 && (
                  <div class="flex flex-wrap gap-2 md:flex-col md:items-end">
                    {member.links.map((link) => (
                      <a href={link.url} target="_blank" rel="noopener noreferrer" class="text-wz-blue text-xs hover:underline no-underline whitespace-nowrap">
                        {link.label} &rarr;
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </div>
          ))}

          {partners.map((member) => (
            <div class="bg-wz-panel border border-wz-hairline rounded-xl p-6 md:p-7">
              <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
                <div class="flex-1">
                  <div class="flex items-center gap-3 mb-2">
                    <p class="text-wz-ink font-semibold text-base">{member.name}</p>
                    <span class="text-wz-teal text-xs font-medium bg-wz-teal-soft px-2 py-0.5 rounded-full">{member.role}</span>
                  </div>
                  <p class="text-wz-body text-sm leading-relaxed max-w-xl">{member.bio}</p>
                </div>
                {member.links && member.links.length > 0 && (
                  <div class="flex flex-wrap gap-2 md:flex-col md:items-end">
                    {member.links.map((link) => (
                      <a href={link.url} target="_blank" rel="noopener noreferrer" class="text-wz-blue text-xs hover:underline no-underline whitespace-nowrap">
                        {link.label} &rarr;
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Research Roots -->
      <div class="mb-16">
        <SectionHeader title="Research Roots" subtitle="Our academic and research foundations." />
        <div class="max-w-2xl">
          <p class="text-wz-body text-base leading-relaxed mb-4">
            Our core team has research roots in the <a href={links.fudanUniversity} target="_blank" rel="noopener noreferrer" class="text-wz-blue hover:underline">Fudan University</a> <a href={links.fudanSecurityLab} target="_blank" rel="noopener noreferrer" class="text-wz-blue hover:underline">System Software and Security Lab</a>, under the supervision of <a href={links.minYang} target="_blank" rel="noopener noreferrer" class="text-wz-blue hover:underline">Prof. Min Yang</a>. This foundation in system security, vulnerability research, and AI safety continues to shape our approach to building practical safety infrastructure for frontier AI systems.
          </p>
        </div>
      </div>

      <!-- Research and Collaboration -->
      <div class="max-w-2xl mb-16">
        <SectionHeader title="Research and Collaboration" />
        <p class="text-wz-body text-base leading-relaxed mb-4">
          Nuwa's research work is grounded in frontier AI risk evaluation, agent safety, AI control, and AI system security. We use this site to maintain a public record of research outputs, technical notes, and collaboration directions.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/research" class="inline-flex items-center bg-wz-ink text-white rounded-full px-5 py-2.5 text-sm font-semibold hover:bg-wz-navy transition-colors no-underline">
            View Research
          </a>
          <a href="/contact" class="inline-flex items-center bg-white text-wz-ink border border-wz-hairline rounded-full px-5 py-2.5 text-sm font-semibold hover:border-wz-border-strong transition-colors no-underline">
            Collaborate With Us
          </a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
