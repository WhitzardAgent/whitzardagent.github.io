---
import BaseLayout from "../layouts/BaseLayout.astro";
import { links } from "../data/links";
import { team } from "../data/team";
import SectionHeader from "../components/SectionHeader.astro";

const founding = team.filter((m) => m.category === "founding");
const research = team.filter((m) => m.category === "research");
const engineering = team.filter((m) => m.category === "engineering");
const advisors = team.filter((m) => m.category === "advisor");
---

<BaseLayout
  title="About — Whitzard & Nuwa"
  description="About Whitzard and Nuwa Frontier AI Safety Lab — team, mission, and organization."
  ogImage="/assets/og/whitzard-og.png"
>
  <section class="py-20 md:py-28">
    <div class="max-w-[1120px] mx-auto px-6">

      <!-- Mission -->
      <div class="max-w-2xl mb-16">
        <h1 class="text-wz-ink font-semibold tracking-tight mb-5" style="font-size: var(--text-h1);">
          About Whitzard and Nuwa
        </h1>
        <p class="text-wz-body text-lg leading-relaxed mb-4">
          Whitzard is an AI safety startup building safety infrastructure for frontier AI and agentic systems. Nuwa Frontier AI Safety Lab is the research lab supported by Whitzard, focused on frontier AI risks, agent safety, and controllable AI.
        </p>
        <p class="text-wz-muted text-base leading-relaxed">
          Our vision is to build safe and controllable AGI systems. We believe this requires both rigorous research into frontier AI risks and practical safety infrastructure that can be deployed in real AI systems.
        </p>
      </div>

      <!-- Organization Relationship -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
        <div class="bg-wz-panel-blue/40 border border-wz-hairline rounded-xl p-7">
          <div class="flex items-center gap-2 mb-4">
            <img src="/assets/logo/whitzard_logo.png" alt="" class="w-6 h-6 rounded" />
            <span class="text-wz-ink font-semibold text-base">Whitzard</span>
            <span class="text-wz-muted font-normal text-sm">白泽</span>
          </div>
          <ul class="space-y-2.5 text-wz-body text-sm leading-relaxed">
            <li class="flex items-start gap-2">
              <span class="text-wz-blue mt-0.5 text-xs">&#9670;</span>
              <span>Company and product brand</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-wz-blue mt-0.5 text-xs">&#9670;</span>
              <span>Safety infrastructure engineering</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-wz-blue mt-0.5 text-xs">&#9670;</span>
              <span>Evaluation, runtime defense, and monitoring systems</span>
            </li>
          </ul>
        </div>

        <div class="bg-nw-jade-pale/40 border border-nw-hairline rounded-xl p-7">
          <div class="flex items-center gap-2 mb-4">
            <img src="/assets/logo/nvwa_logo.png" alt="" class="w-6 h-6 rounded" />
            <span class="text-nw-jade text-sm">&#9670;</span>
            <span class="text-nw-ink font-semibold text-base">Nuwa</span>
            <span class="text-nw-muted font-normal text-sm">女娲</span>
          </div>
          <ul class="space-y-2.5 text-nw-body text-sm leading-relaxed">
            <li class="flex items-start gap-2">
              <span class="text-nw-jade mt-0.5 text-xs">&#9670;</span>
              <span>Research lab supported by Whitzard</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-nw-jade mt-0.5 text-xs">&#9670;</span>
              <span>Research agenda, reports, briefs, frameworks</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-nw-jade mt-0.5 text-xs">&#9670;</span>
              <span>Frontier AI risk evaluation and agent safety research</span>
            </li>
          </ul>
        </div>
      </div>

      <div class="max-w-2xl mb-16">
        <p class="text-wz-body text-base leading-relaxed">
          Nuwa develops the research agenda and evaluation methodology. Whitzard builds the safety infrastructure that turns these ideas into usable systems.
        </p>
      </div>

      <!-- Team -->
      <div class="mb-16">
        <SectionHeader title="Team" subtitle="Founding members of Whitzard and Nuwa." />

        <div class="space-y-10">
          {founding.length > 0 && (
            <div>
              <p class="text-wz-muted text-xs uppercase tracking-wide mb-4 font-medium">Founding Team</p>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {founding.map((member) => (
                  <div class="bg-white border border-wz-hairline rounded-lg p-5">
                    <p class="text-wz-ink font-semibold text-sm">{member.name}</p>
                    <p class="text-wz-muted text-xs mt-0.5">{member.role}{member.affiliation === "nuwa" ? " · Nuwa" : ""}</p>
                    <p class="text-wz-subtle text-xs mt-2 leading-relaxed">{member.bio}</p>
                    {member.links && member.links.length > 0 && (
                      <div class="flex flex-wrap gap-3 mt-3">
                        {member.links.map((link) => (
                          <a href={link.url} target="_blank" rel="noopener noreferrer" class="text-wz-blue text-xs hover:underline no-underline">{link.label}</a>
                        ))}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </div>
          )}

          {research.length > 0 && (
            <div>
              <p class="text-wz-muted text-xs uppercase tracking-wide mb-4 font-medium">Research</p>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {research.map((member) => (
                  <div class="bg-white border border-wz-hairline rounded-lg p-5">
                    <p class="text-wz-ink font-semibold text-sm">{member.name}</p>
                    <p class="text-wz-muted text-xs mt-0.5">{member.role}</p>
                    {member.bio && <p class="text-wz-subtle text-xs mt-2 leading-relaxed">{member.bio}</p>}
                  </div>
                ))}
              </div>
            </div>
          )}

          {engineering.length > 0 && (
            <div>
              <p class="text-wz-muted text-xs uppercase tracking-wide mb-4 font-medium">Engineering</p>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {engineering.map((member) => (
                  <div class="bg-white border border-wz-hairline rounded-lg p-5">
                    <p class="text-wz-ink font-semibold text-sm">{member.name}</p>
                    <p class="text-wz-muted text-xs mt-0.5">{member.role}</p>
                    {member.bio && <p class="text-wz-subtle text-xs mt-2 leading-relaxed">{member.bio}</p>}
                  </div>
                ))}
              </div>
            </div>
          )}

          {advisors.length > 0 && (
            <div>
              <p class="text-wz-muted text-xs uppercase tracking-wide mb-4 font-medium">Advisors</p>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {advisors.map((member) => (
                  <div class="bg-white border border-wz-hairline rounded-lg p-5">
                    <p class="text-wz-ink font-semibold text-sm">{member.name}</p>
                    <p class="text-wz-muted text-xs mt-0.5">{member.role}</p>
                    {member.bio && <p class="text-wz-subtle text-xs mt-2 leading-relaxed">{member.bio}</p>}
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>

      <!-- Research Roots -->
      <div class="max-w-2xl mb-16">
        <SectionHeader title="Research Roots" />
        <p class="text-wz-body text-base leading-relaxed">
          Our team has research roots in frontier AI safety, agent safety, evaluation, and AI system security. We collaborate with researchers, institutions, and builders working on safe and controllable AI.
        </p>
      </div>

      <!-- Research and Collaboration -->
      <div class="max-w-2xl mb-16">
        <SectionHeader title="Research and Collaboration" />
        <p class="text-wz-body text-base leading-relaxed mb-4">
          Nuwa's research work is grounded in frontier AI risk evaluation, agent safety, AI control, and AI system security. We use this site to maintain a public record of research outputs, technical notes, and collaboration directions.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/research" class="inline-flex items-center bg-wz-ink text-white rounded-full px-5 py-2.5 text-sm font-semibold hover:bg-wz-navy transition-colors no-underline">
            View Research
          </a>
          <a href="/contact" class="inline-flex items-center bg-white text-wz-ink border border-wz-hairline rounded-full px-5 py-2.5 text-sm font-semibold hover:border-wz-border-strong transition-colors no-underline">
            Collaborate With Us
          </a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
