---
import BaseLayout from "../layouts/BaseLayout.astro";
import { links } from "../data/links";
import { newsItems, getNewsLink } from "../data/news";
import NewsCard from "../components/NewsCard.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CalloutPanel from "../components/CalloutPanel.astro";
import FiveStoneMotif from "../components/visuals/FiveStoneMotif.astro";

const featuredNews = newsItems.filter((n) => n.featured);
const latestNews = newsItems.filter((n) => !n.featured);

function formatShortDate(date: string): string {
  const d = new Date(date);
  return d.toLocaleDateString("en-US", { month: "short", day: "numeric" });
}

function localizedNewsLink(item: (typeof newsItems)[number]): string | undefined {
  const href = getNewsLink(item);
  return href?.startsWith("/news/") ? `/en${href}` : href;
}
---

<BaseLayout
  locale="en"
  canonicalPath="/news"
  title="News — Whitzard & NUWA Lab"
  description="Research updates, company news, ecosystem progress, and public notes from Whitzard and NUWA Lab."
  ogImage="/assets/og/whitzard-og.png"
>
  <section class="py-16 md:py-24">
    <div class="max-w-[1120px] mx-auto px-6">
      <div class="max-w-2xl mb-12">
        <h1 class="text-wz-ink font-semibold tracking-tight mb-4" style="font-size: var(--text-h1);">
          News
        </h1>
        <p class="text-wz-body text-lg leading-relaxed">
          Research updates, company news, ecosystem progress, and public notes from Whitzard and NUWA Lab.
        </p>
      </div>

      <FiveStoneMotif class="mb-12" />

      <!-- Featured News -->
      {featuredNews.length > 0 && (
        <div class="mb-16">
          <SectionHeader title="Featured" subtitle="Highlighted updates from Whitzard and NUWA Lab." />
          <div class="space-y-4">
            {featuredNews.map((item, i) => (
              i === 0 ? (
                <div class="rounded-2xl p-6 md:p-8 border-l-4 border-nw-jade bg-white">
                  <div class="flex items-center gap-2 mb-2">
                    <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-nw-jade-pale text-nw-jade">
                      {item.type}
                    </span>
                    <span class="text-wz-muted text-xs">
                      {new Date(item.date).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
                    </span>
                    {item.featured && (
                      <span class="text-wz-blue text-xs font-medium">Featured</span>
                    )}
                    {item.url && (
                      <span class="text-wz-subtle text-xs">&#8599;</span>
                    )}
                  </div>
                  <p class="text-wz-ink font-semibold text-base md:text-lg mb-2">{item.title}</p>
                  {item.summary && (
                    <p class="text-wz-muted text-sm leading-relaxed">{item.summary}</p>
                  )}
                  {item.source && (
                    <p class="text-wz-subtle text-xs mt-2">Source: {item.source}</p>
                  )}
                </div>
              ) : (
                <NewsCard
                  title={item.title}
                  date={item.date}
                  type={item.type}
                  summary={item.summary}
                  href={getNewsLink(item)}
                  source={item.source}
                  featured={item.featured}
                />
              )
            ))}
          </div>
        </div>
      )}

      <!-- Latest News -->
      {latestNews.length > 0 && (
        <div class="mb-16">
          <SectionHeader title="Latest" subtitle="Recent updates and announcements." />
          <div class="space-y-4">
            {latestNews.map((item) => (
              <div class="flex gap-4">
                <div class="hidden md:flex flex-col items-center pt-5">
                  <span class="text-wz-muted text-xs font-mono whitespace-nowrap">{formatShortDate(item.date)}</span>
                  <span class="w-2 h-2 rounded-full bg-nw-jade mt-2"></span>
                  <div class="w-px flex-1 bg-nw-hairline mt-1"></div>
                </div>
                <div class="flex-1">
                  <NewsCard
                    title={item.title}
                    date={item.date}
                    type={item.type}
                    summary={item.summary}
                    href={localizedNewsLink(item)}
                    source={item.source}
                    featured={item.featured}
                  />
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Subscribe CTA -->
      <CalloutPanel
        variant="default"
        align="center"
        description="Get research updates from NUWA Lab delivered to your inbox."
      >
        <div class="flex items-center gap-3">
          <a href={links.substack} target="_blank" rel="noopener noreferrer" class="btn btn--primary no-underline">
            Subscribe to NUWA Brief
          </a>
          <a href="/en/" class="btn btn--secondary no-underline">
            Back to Home
          </a>
        </div>
      </CalloutPanel>
    </div>
  </section>
</BaseLayout>
