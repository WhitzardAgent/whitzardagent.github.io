---
import {currentEdition,catalogue,historicalCatalogue} from '../../../../../data/nuwa-index';
import EditionRecord from '../../../../../components/research/index/EditionRecord.astro';
import ScopeNotice from '../../../../../components/research/index/ScopeNotice.astro';
import SourceDetail from '../../../../../components/research/index/SourceDetail.astro';
import ModelDetail from '../../../../../components/research/index/ModelDetail.astro';
import AssessmentDetail from '../../../../../components/research/index/AssessmentDetail.astro';
import WorkDetail from '../../../../../components/research/index/WorkDetail.astro';
import IndexCollection from '../../../../../components/research/index/IndexCollection.astro';
import IndexDetail from '../../../../../components/research/index/IndexDetail.astro';
import { indexDetailPaths } from '../../../../../lib/nuwaIndexPaths';
export const getStaticPaths = indexDetailPaths;
const { kind, id } = Astro.props;
const removedWorkIds=new Set(currentEdition?.scopeDispositions.map((d:any)=>d.id)??[]);
const removedSources=new Set(historicalCatalogue.works.filter(w=>removedWorkIds.has(w.id)).map(w=>w.sourceId));
const removed=kind==='benchmark'&&!catalogue.benchmarks.some(b=>b.id===id)||kind==='work'&&removedWorkIds.has(id)||kind==='result'&&removedSources.has(historicalCatalogue.results.find(r=>r.id===id)?.sourceId??'');
const candidate=kind==='work'&&!historicalCatalogue.works.some(w=>w.id===id)&&currentEdition?.publications.some((p:any)=>p.id===id);
---
{removed ? <ScopeNotice locale="en"/> : candidate ? <EditionRecord locale="en" id={id}/> : kind === "source" ? <SourceDetail locale="en" id={id}/> : kind === "model" ? <ModelDetail locale="en" id={id}/> : kind === "assessment" ? <AssessmentDetail locale="en" id={id}/> : kind === 'work' ? <WorkDetail locale="en" id={id}/> : kind === 'function' || kind === 'organization' ? <IndexCollection locale="en" kind={kind} id={id}/> : <IndexDetail locale="en" kind={kind} id={id}/> }
