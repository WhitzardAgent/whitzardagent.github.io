---
import BaseLayout from "../layouts/BaseLayout.astro";
import { links } from "../data/links";
import { researchAssets } from "../data/generated/researchAssets";
import FeaturedResearchCard from "../components/FeaturedResearchCard.astro";
import PublicationCard from "../components/PublicationCard.astro";
import ResearchAreaCard from "../components/ResearchAreaCard.astro";
import BriefCard from "../components/BriefCard.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CalloutPanel from "../components/CalloutPanel.astro";

const featuredPapers = researchAssets.filter((p) => p.featured).slice(0, 4);
const recentPapers = researchAssets.slice(0, 5);

const researchThemes = [
  { title: "Autonomy Risks", tag: "Autonomy", description: "Self-replication, self-proliferation, and autonomous resource acquisition in frontier AI." },
  { title: "Deception", tag: "Deception", description: "AI deception in human-AI interaction, developer-facing deception, and trust dynamics." },
  { title: "Scheming", tag: "Scheming", description: "Evaluation faking, situational awareness, and observer effects in safety evaluations." },
  { title: "Loss-of-Control", tag: "Loss-of-Control", description: "Conditions under which AI systems may evade oversight or resist shutdown." },
  { title: "Evaluation", tag: "Evaluation", description: "Executable risk-evaluation environments, benchmarks, and evaluation integrity." },
  { title: "Agent Safety", tag: "Agent Safety", description: "Behavioral safety, thought correction, and guardrails for AI agent systems." },
];

const approachSteps = [
  { label: "Observe", desc: "Identify risk signals in frontier AI systems" },
  { label: "Evaluate", desc: "Assess capabilities, behaviors, and control thresholds" },
  { label: "Repair", desc: "Identify and close safety gaps before systemic failure" },
  { label: "Control", desc: "Build infrastructure for safe and controllable AI" },
];
---

<BaseLayout
  title="Nuwa Frontier AI Safety Lab"
  description="Nuwa Frontier AI Safety Lab studies frontier AI risks, agent safety, and controllable AI. Research, publications, and frameworks from an Eastern-rooted AI safety lab."
  brand="nuwa"
  ogImage="/assets/og/nuwa-og.png"
>
  <!-- Hero -->
  <section class="py-24 md:py-32">
    <div class="max-w-[1120px] mx-auto px-6">
      <div class="max-w-2xl">
        <div class="mb-6 flex items-center gap-3">
          <svg width="48" height="20" viewBox="0 0 48 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M2 16 Q24 -4 46 16" stroke="var(--nw-jade)" stroke-width="1.5" fill="none" stroke-dasharray="3 2" />
            <circle cx="14" cy="10" r="2.5" fill="var(--stone-jade)" />
            <circle cx="24" cy="6" r="2.5" fill="var(--stone-vermilion)" />
            <circle cx="34" cy="10" r="2.5" fill="var(--stone-ochre)" />
          </svg>
        </div>

        <h1 class="text-nw-ink font-semibold tracking-tight mb-5" style="font-size: var(--text-hero); line-height: 1.05;">
          Nuwa <span class="text-nw-muted font-normal" style="font-size: 0.4em;">女娲</span><br />
          <span style="font-size: 0.45em;">Frontier AI Safety Lab</span>
        </h1>
        <p class="text-nw-body text-lg md:text-xl leading-relaxed mb-3">
          An Eastern-rooted AI safety lab studying frontier AI risks, agent safety, and controllable AI.
        </p>
        <p class="text-nw-muted text-base leading-relaxed mb-3 font-serif italic max-w-xl">
          Inspired by N&uuml;wa repairing the sky, we study how to identify and repair safety gaps in advanced AI systems before they become systemic failures.
        </p>
        <p class="text-nw-jade text-sm font-medium mb-7">Supported by Whitzard</p>

        <div class="flex flex-wrap gap-3">
          <a href="/research" class="inline-flex items-center bg-nw-ink text-white rounded-full px-5 py-2.5 text-sm font-semibold hover:bg-nw-deep-blue transition-colors no-underline">
            Read Research
          </a>
          <a href={links.substack} target="_blank" rel="noopener noreferrer" class="inline-flex items-center bg-white text-nw-ink border border-nw-hairline rounded-full px-5 py-2.5 text-sm font-semibold hover:border-nw-subtle transition-colors no-underline">
            Subscribe to Nuwa Brief
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Research Approach -->
  <section class="py-14 md:py-18 bg-nw-warm-paper">
    <div class="max-w-[1120px] mx-auto px-6">
      <SectionHeader title="Research Approach" subtitle="Our methodology for studying and improving frontier AI safety." />
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {approachSteps.map((step, i) => (
          <div class="bg-white border border-nw-hairline rounded-lg p-5">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-nw-jade font-mono text-xs">{String(i + 1).padStart(2, '0')}</span>
              {i < approachSteps.length - 1 && (
                <span class="text-nw-subtle text-xs hidden md:inline">&rarr;</span>
              )}
            </div>
            <h3 class="text-nw-ink font-semibold text-sm mb-1">{step.label}</h3>
            <p class="text-nw-muted text-xs leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Research Themes -->
  <section class="py-14 md:py-20">
    <div class="max-w-[1120px] mx-auto px-6">
      <SectionHeader title="Research Themes" subtitle="Core themes driving our frontier AI safety research." />
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {researchThemes.map((theme) => (
          <ResearchAreaCard title={theme.title} tag={theme.tag} description={theme.description} />
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Research -->
  <section class="py-14 md:py-18 bg-nw-mist">
    <div class="max-w-[1120px] mx-auto px-6">
      <SectionHeader title="Featured Research" />
      <div class="space-y-4">
        {featuredPapers.map((paper) => (
          <FeaturedResearchCard
            title={paper.title}
            authors={paper.authors}
            year={paper.year}
            venue={paper.venue}
            status={paper.status}
            summary={paper.summary || ""}
            url={paper.url}
            pdfUrl={paper.pdfUrl}
            topic={paper.topic}
            featured={paper.featured}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Latest Nuwa Brief -->
  <section class="py-14 md:py-18">
    <div class="max-w-[1120px] mx-auto px-6">
      <SectionHeader title="Latest Nuwa Brief" />
      <BriefCard
        title="The Science of Frontier AI Risk Evaluation"
        date="2026"
        url="https://nuwasafety.substack.com/p/science-of-frontier-ai-risk-evaluation"
        summary="Nuwa essay on making frontier AI risk evaluation more scientific, evidence-based, and operational."
        external={true}
      />
    </div>
  </section>

  <!-- Publications Preview -->
  <section class="py-14 md:py-18 bg-nw-mist">
    <div class="max-w-[1120px] mx-auto px-6">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-nw-ink font-semibold" style="font-size: var(--text-h2);">Publications &amp; Papers</h2>
        <a href="/research" class="text-nw-jade text-sm font-medium hover:underline no-underline">View all &rarr;</a>
      </div>
      <div class="space-y-3">
        {recentPapers.map((paper) => (
          <PublicationCard
            title={paper.title}
            authors={paper.authors}
            year={paper.year}
            venue={paper.venue}
            status={paper.status}
            summary={paper.summary || ""}
            url={paper.url}
            pdfUrl={paper.pdfUrl}
            topic={paper.topic}
            featured={paper.featured}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Follow / Collaborate -->
  <section class="py-14 md:py-18">
    <div class="max-w-[1120px] mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <CalloutPanel variant="nuwa" align="left" description="Follow Nuwa's research updates on frontier AI risk, agent safety, and controllable AI.">
          <div class="flex flex-wrap gap-3">
            <a href={links.substack} target="_blank" rel="noopener noreferrer" class="inline-flex items-center bg-nw-ink text-white rounded-full px-4 py-2 text-xs font-semibold hover:bg-nw-deep-blue transition-colors no-underline">
              Subscribe to Nuwa Brief
            </a>
            <a href={links.x} target="_blank" rel="noopener noreferrer" class="inline-flex items-center bg-white text-nw-ink border border-nw-hairline rounded-full px-4 py-2 text-xs font-semibold hover:border-nw-subtle transition-colors no-underline">
              Follow on X
            </a>
          </div>
        </CalloutPanel>

        <CalloutPanel variant="default" align="left" description="We collaborate on frontier AI safety evaluation, agent safety research, and runtime defense.">
          <div class="flex flex-wrap gap-3">
            <a href="/contact" class="inline-flex items-center bg-wz-ink text-white rounded-full px-4 py-2 text-xs font-semibold hover:bg-wz-navy transition-colors no-underline">
              Contact Us
            </a>
            <a href={links.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center bg-white text-wz-ink border border-wz-hairline rounded-full px-4 py-2 text-xs font-semibold hover:border-wz-border-strong transition-colors no-underline">
              GitHub
            </a>
          </div>
        </CalloutPanel>
      </div>
    </div>
  </section>
</BaseLayout>
