---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { newsItems } from "../../data/news";
import "../../styles/content.css";

export function getStaticPaths() {
  return newsItems.filter((item) => item.slug).map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const date = new Date(item.date).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---
<BaseLayout title={`${item.title} — Whitzard News`} description={item.summary??""} locale="en" canonicalPath={`/news/${item.slug}`}>
 <article class="article-shell"><div class="site-container article-shell__inner"><a class="article-back" href="/en/news">← Back to News</a><div class="article-meta"><span>{item.type}</span><time datetime={item.date}>{date}</time>{item.source&&<span>{item.source}</span>}</div><h1>{item.title}</h1>{item.summary&&<p class="article-summary">{item.summary}</p>}{item.body&&<div class="article-body">{item.body.split("\n\n").map((paragraph:string)=><p>{paragraph}</p>)}</div>}{item.url&&<div class="article-cta"><a class="button button--primary" href={item.url} target="_blank" rel="noreferrer">Read source ↗</a></div>}</div></article>
</BaseLayout>
