---
import BaseLayout from "../layouts/BaseLayout.astro";
import { links } from "../data/links";
import { researchPapers } from "../data/researchPapers";

const substackArticles = researchPapers.filter((p) => p.type === "technical-note");
---

<BaseLayout
  title="Blog — Whitzard & Nuwa"
  description="Updates, essays, and technical notes from Whitzard and Nuwa Frontier AI Safety Lab on frontier AI safety, agent safety, and controllable AI."
>
  <section class="py-24 md:py-32">
    <div class="max-w-[1180px] mx-auto px-6">
      <div class="max-w-2xl mb-12">
        <h1 class="text-wz-ink font-semibold tracking-tight mb-4" style="font-size: var(--text-h1);">
          Blog
        </h1>
        <p class="text-wz-body text-lg leading-relaxed">
          Updates, essays, and notes from Whitzard and Nuwa.
        </p>
      </div>

      <!-- External Articles -->
      {substackArticles.length > 0 && (
        <div class="mb-16">
          <h2 class="text-wz-ink font-semibold mb-6" style="font-size: var(--text-h2);">External Articles</h2>
          <div class="space-y-3">
            {substackArticles.map((article) => (
              <a href={article.url} target="_blank" rel="noopener noreferrer" class="block bg-white border border-wz-hairline rounded-lg p-5 hover:shadow-md transition-shadow no-underline">
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-wz-teal text-xs font-medium uppercase">{article.type === "technical-note" ? "Technical Note" : article.type}</span>
                  <span class="text-wz-muted text-xs font-medium px-2 py-0.5 rounded-full bg-wz-panel">External &middot; Substack</span>
                  {article.year && <span class="text-wz-subtle text-xs">{article.year}</span>}
                </div>
                <h3 class="text-wz-ink font-semibold text-sm">{article.title}</h3>
                {article.summary && <p class="text-wz-muted text-xs leading-relaxed mt-1">{article.summary}</p>}
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Subscribe CTA -->
      <div class="bg-wz-panel border border-wz-hairline rounded-lg p-8 text-center">
        <p class="text-wz-body text-sm mb-3">Get research updates from Nuwa Frontier AI Safety Lab.</p>
        <a
          href={links.substack}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center bg-wz-ink text-white rounded-full px-5 py-2.5 text-sm font-semibold hover:bg-wz-navy transition-colors no-underline"
        >
          Subscribe to Nuwa Brief
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
