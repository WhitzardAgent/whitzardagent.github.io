---
import BaseLayout from "../layouts/BaseLayout.astro";
import { links } from "../data/links";
import { externalArticles } from "../data/externalArticles";
import ExternalArticleCard from "../components/ExternalArticleCard.astro";
import BriefCard from "../components/BriefCard.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CalloutPanel from "../components/CalloutPanel.astro";
---

<BaseLayout
  locale="en"
  canonicalPath="/blog"
  title="Blog — Whitzard & NUWA Lab"
  description="Updates, essays, and technical notes from Whitzard and NUWA Lab on frontier AI safety, agent safety, and controllable AI."
  ogImage="/assets/og/nuwa-og.png"
>
  <section class="py-20 md:py-28">
    <div class="max-w-[1120px] mx-auto px-6">
      <div class="max-w-2xl mb-12">
        <h1 class="text-wz-ink font-semibold tracking-tight mb-4" style="font-size: var(--text-h1);">
          Blog
        </h1>
        <p class="text-wz-body text-lg leading-relaxed">
          Updates, essays, and notes from Whitzard and NUWA Lab.
        </p>
      </div>

      <!-- External Articles -->
      {externalArticles.length > 0 && (
        <div class="mb-16">
          <SectionHeader title="External Articles" subtitle="Essays and notes published on external platforms." />
          <div class="space-y-3">
            {externalArticles.map((article) => (
              <ExternalArticleCard
                title={article.title}
                type={article.type}
                year={article.year}
                summary={article.summary || ""}
                url={article.url}
                source={article.source}
              />
            ))}
          </div>
        </div>
      )}

      <!-- NUWA Brief -->
      <div class="mb-16">
        <SectionHeader title="NUWA Brief" subtitle="Research updates from NUWA Lab, published on Substack." />
        <BriefCard
          title="NUWA Brief on Substack"
          url={links.substack}
          summary="Research updates, analysis, and commentary on frontier AI safety, agent safety, and controllable AI."
          external={true}
        />
      </div>

      <!-- Updates / Announcements -->
      <div class="mb-16">
        <SectionHeader title="Updates & Announcements" subtitle="Project announcements and organizational updates from Whitzard." />
        <div class="bg-wz-panel border border-wz-hairline rounded-lg p-8 text-center">
          <p class="text-wz-muted text-sm">Updates will be published here as they become available.</p>
        </div>
      </div>

      <!-- Subscribe CTA -->
      <CalloutPanel
        variant="default"
        align="center"
        description="Get research updates from NUWA Lab delivered to your inbox."
      >
        <a href={links.substack} target="_blank" rel="noopener noreferrer" class="inline-flex items-center bg-wz-ink text-white rounded-full px-5 py-2.5 text-sm font-semibold hover:bg-wz-navy transition-colors no-underline">
          Subscribe to NUWA Brief
        </a>
      </CalloutPanel>
    </div>
  </section>
</BaseLayout>
