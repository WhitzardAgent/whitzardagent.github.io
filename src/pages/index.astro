---
import BaseLayout from "../layouts/BaseLayout.astro";
import { links } from "../data/links";
import { researchAssets } from "../data/generated/researchAssets";
import { newsItems, getNewsLink } from "../data/news";
import FeaturedResearchCard from "../components/FeaturedResearchCard.astro";
import NewsCard from "../components/NewsCard.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CalloutPanel from "../components/CalloutPanel.astro";
import SocialIcon from "../components/SocialIcon.astro";
import WhitzardHero from "../components/WhitzardHero";

const featuredPapers = researchAssets.filter((p) => p.featured).slice(0, 3);

const philosophyCards = [
  {
    title: "Generalized Safety Modules",
    desc: "Reusable safety capabilities across models, agents, tools, and deployment environments.",
  },
  {
    title: "Intelligent Runtime Protection",
    desc: "Policy, tracing, approval, monitoring, and intervention for agentic systems in action.",
  },
  {
    title: "Vertical Scenario Adaptation",
    desc: "Safety infrastructure designed for real-world sectors, workflows, and operational constraints.",
  },
  {
    title: "Public Safety Orientation",
    desc: "Practical AI safety products that can support broader access, governance, and social trust.",
  },
];

const latestNews = newsItems.slice(0, 3);
---

<BaseLayout
  title="Whitzard — Generalized AI Safety Infrastructure"
  description="Whitzard builds generalized, intelligent safety modules for frontier AI and agentic systems, supporting real-world vertical scenarios and public safety."
  ogImage="/assets/og/whitzard-og.png"
>
  <!-- Animated Hero -->
  <WhitzardHero client:load />

  <!-- A Practical Path to Safe AI -->
  <section class="py-14 md:py-18 bg-wz-mist">
    <div class="max-w-[1180px] mx-auto px-6">
      <div class="max-w-2xl mb-8">
        <h2 class="text-wz-ink font-semibold mb-3" style="font-size: var(--text-h2);">
          A Practical Path to Safe AI
        </h2>
        <p class="text-wz-body text-base leading-relaxed">
          Many frontier AI safety approaches rely heavily on centralized post-training and alignment pipelines. Whitzard focuses on another complementary path: generalized safety modules that can be integrated into real systems, adapted to vertical scenarios, and continuously improved through evaluation, monitoring, and runtime protection.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {philosophyCards.map((card) => (
          <div class="bg-white border border-wz-hairline rounded-lg p-5">
            <h3 class="text-wz-ink font-semibold text-sm mb-2">{card.title}</h3>
            <p class="text-wz-muted text-sm leading-relaxed">{card.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- News -->
  <section class="py-14 md:py-18">
    <div class="max-w-[1180px] mx-auto px-6">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-wz-ink font-semibold" style="font-size: var(--text-h2);">Latest News</h2>
        <a href="/news" class="text-wz-blue text-sm font-medium hover:underline no-underline">
          View all &rarr;
        </a>
      </div>
      <div class="space-y-4">
        {latestNews.map((item) => (
          <NewsCard
            title={item.title}
            date={item.date}
            type={item.type}
            summary={item.summary}
            href={getNewsLink(item)}
            source={item.source}
            featured={item.featured}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Nuwa Lab Feature -->
  <section class="py-14 md:py-18">
    <div class="max-w-[1180px] mx-auto px-6">
      <div class="bg-nw-warm-paper border border-nw-hairline rounded-xl p-7 md:p-10">
        <div class="flex items-center gap-2 mb-3">
          <span class="text-nw-jade text-lg">&#9670;</span>
          <span class="text-nw-jade text-xs font-medium uppercase tracking-wide">Research Lab</span>
        </div>
        <h2 class="text-nw-ink font-semibold mb-3" style="font-size: var(--text-h2);">
          Nuwa Frontier AI Safety Lab <span class="text-nw-muted font-normal" style="font-size: 0.55em;">女娲</span>
        </h2>
        <p class="text-nw-body text-base leading-relaxed mb-2 max-w-2xl">
          Transparent, third-party, open infrastructure for frontier AI safety evaluation and governance.
        </p>
        <p class="text-nw-muted text-sm leading-relaxed mb-5 max-w-2xl">
          Supported by Whitzard, Nuwa develops open evaluation frameworks, benchmarks, technical notes, and governance evidence for safe and controllable AI.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/nuwa" class="inline-flex items-center bg-nw-ink text-white rounded-full px-5 py-2.5 text-sm font-semibold hover:bg-nw-deep-blue transition-colors no-underline">
            Visit Nuwa
          </a>
          <a href={links.substack} target="_blank" rel="noopener noreferrer" class="inline-flex items-center bg-white text-nw-ink border border-nw-hairline rounded-full px-5 py-2.5 text-sm font-semibold hover:border-nw-subtle transition-colors no-underline">
            Subscribe to Nuwa Brief
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Research -->
  <section class="py-14 md:py-18 bg-wz-mist">
    <div class="max-w-[1180px] mx-auto px-6">
      <SectionHeader title="Latest Research" subtitle="Recent publications from Nuwa Frontier AI Safety Lab." />
      <div class="space-y-4">
        {featuredPapers.map((paper) => (
          <FeaturedResearchCard
            title={paper.title}
            authors={paper.authors}
            year={paper.year}
            venue={paper.venue}
            status={paper.status}
            summary={paper.summary || ""}
            url={paper.url}
            pdfUrl={paper.pdfUrl}
            topic={paper.topic}
            featured={paper.featured}
          />
        ))}
      </div>
      <div class="mt-6">
        <a href="/research" class="text-wz-blue text-sm font-medium hover:underline no-underline">
          View all publications &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Open Ecosystem CTA -->
  <section class="py-14 md:py-18">
    <div class="max-w-[1180px] mx-auto px-6">
      <div class="bg-white border border-wz-hairline rounded-xl p-7 md:p-10">
        <div class="flex items-center gap-2 mb-3">
          <span class="text-wz-teal text-lg">&#9670;</span>
          <span class="text-wz-teal text-xs font-medium uppercase tracking-wide">Open Source</span>
        </div>
        <h2 class="text-wz-ink font-semibold mb-3" style="font-size: var(--text-h2);">
          Open Ecosystem
        </h2>
        <p class="text-wz-body text-base leading-relaxed mb-6 max-w-xl">
          Explore WhitzardAgent open tools, datasets, and infrastructure for AI safety evaluation and agent safety.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href={links.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center bg-wz-ink text-white rounded-full px-5 py-2.5 text-sm font-semibold hover:bg-wz-navy transition-colors no-underline">
            <SocialIcon platform="github" size={14} class="mr-1.5" /> GitHub
          </a>
          <a href={links.huggingface} target="_blank" rel="noopener noreferrer" class="inline-flex items-center bg-white text-wz-ink border border-wz-hairline rounded-full px-5 py-2.5 text-sm font-semibold hover:border-wz-border-strong transition-colors no-underline">
            <SocialIcon platform="huggingface" size={14} class="mr-1.5" /> Hugging Face
          </a>
          <a href="/open-ecosystem" class="inline-flex items-center bg-white text-wz-ink border border-wz-hairline rounded-full px-5 py-2.5 text-sm font-semibold hover:border-wz-border-strong transition-colors no-underline">
            Open Ecosystem &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Combined CTA -->
  <section class="py-10 md:py-14 bg-wz-panel-ink">
    <div class="max-w-[1180px] mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="text-center md:text-left">
        <p class="text-white text-base font-medium mb-1">Learn about the team behind Whitzard and Nuwa.</p>
        <p class="text-wz-subtle text-sm">We collaborate on frontier AI safety evaluation, agent safety, and runtime defense.</p>
      </div>
      <div class="flex gap-3">
        <a href="/about" class="inline-flex items-center bg-white text-wz-ink rounded-full px-5 py-2.5 text-sm font-semibold hover:bg-wz-mist transition-colors no-underline">
          About Us
        </a>
        <a href="/contact" class="inline-flex items-center bg-transparent text-white border border-white/20 rounded-full px-5 py-2.5 text-sm font-semibold hover:border-white/40 transition-colors no-underline">
          Get in Touch
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
