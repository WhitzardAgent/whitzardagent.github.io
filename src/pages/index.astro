---
import BaseLayout from "../layouts/BaseLayout.astro";
import { links } from "../data/links";
import { projects } from "../data/projects";
import { researchPapers } from "../data/researchPapers";
import ResearchCard from "../components/ResearchCard.astro";
import { getCollection } from "astro:content";

const allReports = await getCollection("reports", ({ data }) => !data.draft);

const homepagePapers = researchPapers.filter((p) =>
  [
    "science-of-frontier-ai-risk-evaluation",
    "deceptive-ai-developers-position-paper",
    "self-replication-frontier-ai",
  ].includes(p.id)
);

const nasfReport = allReports.find((r) => r.id.includes("nasf"));

const focusAreas = [
  {
    label: "Evaluation",
    title: "Frontier AI Risk Evaluation",
    description: "Systematic evaluation of frontier AI capabilities and risk thresholds before deployment.",
  },
  {
    label: "Safety",
    title: "Agent Safety",
    description: "Safety mechanisms for autonomous and semi-autonomous AI agent systems.",
  },
  {
    label: "Infrastructure",
    title: "Runtime Safety Infrastructure",
    description: "Runtime policy enforcement and access control for AI agent tool calls.",
  },
  {
    label: "Governance",
    title: "Risk Monitoring & Governance",
    description: "Continuous risk signal monitoring and governance evidence collection.",
  },
];
---

<BaseLayout
  title="Whitzard — AI Safety Infrastructure"
  description="Whitzard builds safety infrastructure for frontier AI and agentic systems, supporting evaluation, runtime defense, risk monitoring, and controllable AI."
>
  <!-- Hero -->
  <section class="py-24 md:py-36">
    <div class="max-w-[1180px] mx-auto px-6">
      <div class="max-w-3xl">
        <h1
          class="text-wz-ink font-semibold tracking-tight mb-6"
          style="font-size: var(--text-hero); line-height: 1.05;"
        >
          Whitzard <span class="text-wz-muted font-normal" style="font-size: 0.45em;">白泽</span>
        </h1>
        <p class="text-wz-body text-xl md:text-2xl leading-relaxed mb-3 max-w-xl">
          Building safety infrastructure for frontier AI and agentic systems.
        </p>
        <p class="text-wz-muted text-lg leading-relaxed mb-8 max-w-xl">
          Our vision is to build safe and controllable AGI systems.
        </p>
        <p class="text-wz-body text-base leading-relaxed mb-8 max-w-xl">
          Whitzard is an AI safety startup in China building evaluation, runtime safety, and risk-monitoring infrastructure for advanced AI systems. Nuwa Frontier AI Safety Lab is the research lab supported by Whitzard.
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href="/nuwa"
            class="inline-flex items-center bg-wz-ink text-white rounded-full px-5 py-3 text-sm font-semibold hover:bg-wz-navy transition-colors no-underline"
          >
            Explore Nuwa
          </a>
          <a
            href="/research"
            class="inline-flex items-center bg-white text-wz-ink border border-wz-hairline rounded-full px-5 py-3 text-sm font-semibold hover:border-wz-border-strong transition-colors no-underline"
          >
            Read Research
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- What Whitzard Does -->
  <section class="py-16 md:py-20 bg-wz-mist">
    <div class="max-w-[1180px] mx-auto px-6">
      <h2
        class="text-wz-ink font-semibold mb-10"
        style="font-size: var(--text-h2);"
      >
        What Whitzard Does
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {focusAreas.map((area) => (
          <div class="bg-white border border-wz-hairline rounded-xl p-6 hover:shadow-md transition-shadow">
            <span class="text-wz-blue text-xs font-medium uppercase tracking-wide">{area.label}</span>
            <h3 class="text-wz-ink font-semibold mt-2 mb-2" style="font-size: var(--text-title);">{area.title}</h3>
            <p class="text-wz-muted text-sm leading-relaxed">{area.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Nuwa Lab Feature -->
  <section class="py-16 md:py-24">
    <div class="max-w-[1180px] mx-auto px-6">
      <div class="bg-nw-warm-paper border border-nw-hairline rounded-xl p-8 md:p-12">
        <div class="flex items-center gap-2 mb-4">
          <span class="text-nw-jade text-xl">&#9670;</span>
          <span class="text-nw-jade text-xs font-medium uppercase tracking-wide">Research Lab</span>
        </div>
        <h2
          class="text-nw-ink font-semibold mb-4"
          style="font-size: var(--text-h2);"
        >
          Nuwa Frontier AI Safety Lab <span class="text-nw-muted font-normal" style="font-size: 0.6em;">女娲</span>
        </h2>
        <p class="text-nw-body text-base leading-relaxed mb-2 max-w-2xl">
          An Eastern-rooted AI safety lab studying frontier AI risks, agent safety, and controllable AI.
        </p>
        <p class="text-nw-muted text-sm leading-relaxed mb-2 max-w-2xl font-serif italic">
          Inspired by N&uuml;wa repairing the sky, we study how to identify and repair safety gaps in advanced AI systems before they become systemic failures.
        </p>
        <p class="text-nw-jade text-sm font-medium mb-6">
          Supported by Whitzard
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href="/nuwa"
            class="inline-flex items-center bg-nw-ink text-white rounded-full px-5 py-2.5 text-sm font-semibold hover:bg-nw-deep-blue transition-colors no-underline"
          >
            Visit Nuwa
          </a>
          <a
            href={links.substack}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center bg-white text-nw-ink border border-nw-hairline rounded-full px-5 py-2.5 text-sm font-semibold hover:border-nw-subtle transition-colors no-underline"
          >
            Subscribe to Nuwa Brief
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Research and Briefs -->
  <section class="py-16 md:py-20 bg-wz-mist">
    <div class="max-w-[1180px] mx-auto px-6">
      <h2
        class="text-wz-ink font-semibold mb-8"
        style="font-size: var(--text-h2);"
      >
        Latest Research &amp; Briefs
      </h2>
      <div class="space-y-4">
        {homepagePapers.map((paper) => (
          <ResearchCard
            title={paper.title}
            type={paper.type}
            status={paper.status}
            venue={paper.venue}
            year={paper.year}
            authors={paper.authors}
            summary={paper.summary}
            url={paper.url}
            secondaryUrl={paper.secondaryUrl}
            topic={paper.topic}
            featured={paper.featured}
          />
        ))}
        {nasfReport && (
          <a href={`/research/${nasfReport.id}`} class="block bg-white border border-nw-hairline rounded-lg p-5 hover:shadow-md transition-shadow no-underline">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-nw-jade text-xs font-medium uppercase">{nasfReport.data.type}</span>
              <span class="text-wz-subtle text-xs">
                {nasfReport.data.date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
              </span>
            </div>
            <h3 class="text-wz-ink font-semibold mb-1">{nasfReport.data.title}</h3>
            {nasfReport.data.summary && <p class="text-wz-muted text-sm leading-relaxed">{nasfReport.data.summary}</p>}
          </a>
        )}
      </div>
      <div class="mt-6">
        <a href="/research" class="text-wz-blue text-sm font-medium hover:underline no-underline">
          View all research &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Products and Capabilities -->
  <section class="py-16 md:py-20">
    <div class="max-w-[1180px] mx-auto px-6">
      <h2
        class="text-wz-ink font-semibold mb-4"
        style="font-size: var(--text-h2);"
      >
        Products &amp; Capabilities
      </h2>
      <p class="text-wz-muted text-sm mb-8 max-w-lg">
        Safety infrastructure built by Whitzard for frontier AI and agentic systems.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white border border-wz-hairline rounded-xl p-6">
          <span class="text-wz-teal text-xs font-medium uppercase tracking-wide">Runtime Security</span>
          <h3 class="text-wz-ink font-semibold mt-2 mb-2">AgentGuard</h3>
          <p class="text-wz-muted text-sm leading-relaxed mb-3">
            Zero-trust access control for AI agent tool calls. Policy enforcement, tracing, and audit.
          </p>
          <a href="/agentguard" class="text-wz-blue text-xs font-medium hover:underline no-underline">Learn more &rarr;</a>
        </div>
        <div class="bg-white border border-wz-hairline rounded-xl p-6">
          <span class="text-wz-blue text-xs font-medium uppercase tracking-wide">Evaluation</span>
          <h3 class="text-wz-ink font-semibold mt-2 mb-2">Snowl</h3>
          <p class="text-wz-muted text-sm leading-relaxed mb-3">
            AI safety evaluation and benchmark infrastructure for frontier AI systems.
          </p>
          <span class="text-wz-subtle text-xs">Coming soon</span>
        </div>
        <div class="bg-white border border-wz-hairline rounded-xl p-6">
          <span class="text-wz-navy text-xs font-medium uppercase tracking-wide">Risk Monitoring</span>
          <h3 class="text-wz-ink font-semibold mt-2 mb-2">Risk Monitoring</h3>
          <p class="text-wz-muted text-sm leading-relaxed mb-3">
            Frontier AI risk signal tracking and governance evidence collection.
          </p>
          <span class="text-wz-subtle text-xs">Coming soon</span>
        </div>
      </div>
    </div>
  </section>

  <!-- About CTA -->
  <section class="py-12 md:py-16 bg-wz-panel-ink">
    <div class="max-w-[1180px] mx-auto px-6 text-center">
      <p class="text-white text-base mb-4">
        Learn about the team behind Whitzard and Nuwa.
      </p>
      <a
        href="/about"
        class="inline-flex items-center bg-white text-wz-ink rounded-full px-5 py-2.5 text-sm font-semibold hover:bg-wz-mist transition-colors no-underline"
      >
        About Us
      </a>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="py-12 md:py-16">
    <div class="max-w-[1180px] mx-auto px-6 text-center">
      <p class="text-wz-muted text-sm mb-4">
        We collaborate on frontier AI safety evaluation, agent safety, and runtime defense.
      </p>
      <a
        href="/contact"
        class="text-wz-blue text-sm font-medium hover:underline no-underline"
      >
        Get in Touch &rarr;
      </a>
    </div>
  </section>
</BaseLayout>
