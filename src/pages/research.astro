---
import BaseLayout from "../layouts/BaseLayout.astro";
import { links } from "../data/links";
import { getCollection } from "astro:content";

const reports = await getCollection("reports", ({ data }) => !data.draft);
const briefs = await getCollection("briefs", ({ data }) => !data.draft && data.brand === "nuwa");

const sortedReports = reports.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const sortedBriefs = briefs.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title="Research"
  description="Research, reports, and frameworks from Whitzard and Nuwa Frontier AI Safety Lab."
  brand="nuwa"
>
  <section class="py-24 md:py-32">
    <div class="max-w-[1120px] mx-auto px-6">
      <div class="flex items-center gap-2 mb-4">
        <span style="color: var(--stone-jade);" class="text-lg">&#9670;</span>
        <span class="text-nw-jade text-xs font-medium uppercase tracking-wide">Research</span>
      </div>
      <h1
        class="text-nw-ink font-semibold tracking-tight mb-4"
        style="font-size: var(--text-h1);"
      >
        Research &amp; Reports
      </h1>
      <p class="text-nw-body text-lg leading-relaxed max-w-2xl mb-12">
        Research, reports, and frameworks from Whitzard and Nuwa Frontier AI Safety Lab on frontier AI risks, agent safety, and controllable AI.
      </p>

      <!-- Nuwa link block -->
      <div class="bg-nw-jade-pale border border-nw-hairline rounded-lg p-6 mb-16 flex items-center gap-4">
        <span class="text-nw-jade text-xl">&#9670;</span>
        <div>
          <p class="text-nw-ink font-medium text-sm">Nuwa Frontier AI Safety Lab</p>
          <p class="text-nw-muted text-sm">Our primary research lab studying frontier AI risks and agent safety.</p>
        </div>
        <a href="/nuwa" class="ml-auto text-nw-jade text-sm font-medium hover:underline no-underline whitespace-nowrap">
          Visit Nuwa &rarr;
        </a>
      </div>

      <!-- Reports -->
      <h2 class="text-nw-ink font-semibold mb-6" style="font-size: var(--text-h2);">Reports</h2>
      {sortedReports.length > 0 ? (
        <div class="space-y-4 mb-16">
          {sortedReports.map((report) => (
            <article class="bg-nw-paper border border-nw-hairline rounded-lg p-6">
              <div class="flex items-center gap-2 mb-2">
                <span class="text-nw-jade text-xs font-medium uppercase">{report.data.type || "Report"}</span>
                <span class="text-nw-subtle text-xs">
                  {report.data.date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
                </span>
                {report.data.brand && (
                  <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-nw-mist text-nw-muted">
                    {report.data.brand}
                  </span>
                )}
              </div>
              <h3 class="text-nw-ink font-semibold mb-1">{report.data.title}</h3>
              {report.data.summary && (
                <p class="text-nw-muted text-sm leading-relaxed mb-3">{report.data.summary}</p>
              )}
              <div class="flex gap-3">
                {report.data.pdf_url && (
                  <a href={report.data.pdf_url} target="_blank" rel="noopener noreferrer" class="text-nw-jade text-xs font-medium hover:underline no-underline">PDF</a>
                )}
                {report.data.github_url && (
                  <a href={report.data.github_url} target="_blank" rel="noopener noreferrer" class="text-nw-jade text-xs font-medium hover:underline no-underline">GitHub</a>
                )}
                {report.data.doi_url && (
                  <a href={report.data.doi_url} target="_blank" rel="noopener noreferrer" class="text-nw-jade text-xs font-medium hover:underline no-underline">DOI</a>
                )}
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="bg-nw-paper border border-nw-hairline rounded-lg p-8 text-center mb-16">
          <p class="text-nw-muted text-sm">No reports published yet. Reports will appear here when available.</p>
        </div>
      )}

      <!-- Briefs -->
      <h2 class="text-nw-ink font-semibold mb-6" style="font-size: var(--text-h2);">Nuwa Briefs</h2>
      {sortedBriefs.length > 0 ? (
        <div class="space-y-4 mb-16">
          {sortedBriefs.map((brief) => (
            <article class="bg-nw-paper border border-nw-hairline rounded-lg p-6">
              <div class="flex items-center gap-2 mb-2">
                <span class="text-nw-jade text-xs font-medium uppercase">Brief</span>
                <span class="text-nw-subtle text-xs">
                  {brief.data.date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
                </span>
              </div>
              <h3 class="text-nw-ink font-semibold mb-1">{brief.data.title}</h3>
              {brief.data.summary && (
                <p class="text-nw-muted text-sm leading-relaxed">{brief.data.summary}</p>
              )}
            </article>
          ))}
        </div>
      ) : (
        <div class="bg-nw-paper border border-nw-hairline rounded-lg p-8 text-center mb-16">
          <p class="text-nw-muted text-sm">No briefs published yet. <a href={links.substack} target="_blank" rel="noopener noreferrer" class="text-nw-jade hover:underline no-underline">Subscribe to Nuwa Brief on Substack</a>.</p>
        </div>
      )}

      <!-- Frameworks -->
      <h2 class="text-nw-ink font-semibold mb-6" style="font-size: var(--text-h2);">Frameworks</h2>
      <div class="bg-nw-paper border border-nw-hairline rounded-lg p-6">
        <h3 class="text-nw-ink font-semibold mb-2">Nuwa Agent Safety Framework (NASF)</h3>
        <p class="text-nw-muted text-sm leading-relaxed mb-3">
          A structured framework for evaluating and ensuring AI agent safety, covering execution chains, HCA principles, risk domains, and evaluation protocols.
        </p>
        <a href="/nuwa" class="text-nw-jade text-sm font-medium hover:underline no-underline">
          Learn more &rarr;
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
