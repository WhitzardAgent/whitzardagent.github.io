---
import BaseLayout from "../layouts/BaseLayout.astro";
import { links } from "../data/links";
import { researchPapers } from "../data/researchPapers";
import ResearchCard from "../components/ResearchCard.astro";
import { getCollection } from "astro:content";

const reports = await getCollection("reports", ({ data }) => !data.draft);
const briefs = await getCollection("briefs", ({ data }) => !data.draft && data.brand === "nuwa");
const notes = await getCollection("notes", ({ data }) => !data.draft);

const featuredPapers = researchPapers.filter((p) => p.featured);
const otherPapers = researchPapers.filter((p) => !p.featured);

const localFrameworks = reports
  .filter((r) => r.data.type === "framework")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const localReports = reports
  .filter((r) => r.data.type !== "framework")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const researchAreas = [
  { title: "Agent Behavior Safety", tag: "Agent Safety", description: "Deception, goal misalignment, tool misuse, and autonomous risk in AI agents." },
  { title: "Frontier AI Risk Evaluation", tag: "Evaluation", description: "Evaluation methods, benchmarks, and risk thresholds for frontier AI systems." },
  { title: "AI Control and Loss-of-Control Risk", tag: "AI Control", description: "Control methods, oversight evasion, and conditions for loss of control." },
  { title: "Runtime Safety Infrastructure", tag: "Runtime Safety", description: "Zero-trust access control, execution chain safety, and policy enforcement." },
  { title: "Risk Monitoring and Governance", tag: "Governance", description: "Risk signal tracking, governance evidence, and evidence-based policy." },
];
---

<BaseLayout
  title="Research — Nuwa Frontier AI Safety Lab"
  description="Publications, papers, reports, and technical notes from Nuwa Frontier AI Safety Lab covering frontier AI risk evaluation, agent safety, AI control, and runtime safety."
  brand="nuwa"
>
  <section class="py-24 md:py-32">
    <div class="max-w-[1120px] mx-auto px-6">

      <!-- Header -->
      <div class="max-w-2xl mb-16">
        <div class="flex items-center gap-2 mb-3">
          <span style="color: var(--stone-jade);" class="text-base">&#9670;</span>
          <span class="text-nw-jade text-xs font-medium uppercase tracking-wide">Nuwa Research</span>
        </div>
        <h1 class="text-nw-ink font-semibold tracking-tight mb-4" style="font-size: var(--text-h1);">
          Research
        </h1>
        <p class="text-nw-body text-lg leading-relaxed">
          Publications, research papers, reports, frameworks, and technical notes from Nuwa Frontier AI Safety Lab.
        </p>
      </div>

      <!-- Research Areas -->
      <div class="mb-20">
        <h2 class="text-nw-ink font-semibold mb-6" style="font-size: var(--text-h2);">Research Areas</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {researchAreas.map((area) => (
            <div class="bg-nw-paper border border-nw-hairline rounded-lg p-5">
              <span class="text-nw-jade text-xs font-medium bg-nw-jade-pale px-2 py-0.5 rounded-full">{area.tag}</span>
              <h3 class="text-nw-ink font-semibold mt-2 mb-1 text-sm">{area.title}</h3>
              <p class="text-nw-muted text-xs leading-relaxed">{area.description}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Featured Research -->
      <div class="mb-20">
        <h2 class="text-nw-ink font-semibold mb-6" style="font-size: var(--text-h2);">Featured Research</h2>
        <div class="space-y-4">
          {featuredPapers.map((paper) => (
            <ResearchCard
              title={paper.title}
              type={paper.type}
              status={paper.status}
              venue={paper.venue}
              year={paper.year}
              authors={paper.authors}
              summary={paper.summary}
              url={paper.url}
              secondaryUrl={paper.secondaryUrl}
              topic={paper.topic}
              featured={paper.featured}
            />
          ))}
        </div>
      </div>

      <!-- Publications and Papers -->
      {otherPapers.length > 0 && (
        <div class="mb-20">
          <h2 class="text-nw-ink font-semibold mb-6" style="font-size: var(--text-h2);">Publications</h2>
          <div class="space-y-4">
            {otherPapers.map((paper) => (
              <ResearchCard
                title={paper.title}
                type={paper.type}
                status={paper.status}
                venue={paper.venue}
                year={paper.year}
                authors={paper.authors}
                summary={paper.summary}
                url={paper.url}
                secondaryUrl={paper.secondaryUrl}
                topic={paper.topic}
                featured={paper.featured}
              />
            ))}
          </div>
        </div>
      )}

      <!-- Nuwa Frameworks and Reports -->
      {(localFrameworks.length > 0 || localReports.length > 0) && (
        <div class="mb-20">
          <h2 class="text-nw-ink font-semibold mb-6" style="font-size: var(--text-h2);">Frameworks &amp; Reports</h2>
          <div class="space-y-4">
            {localFrameworks.map((item) => (
              <a href={`/research/${item.id}`} class="block bg-white border border-nw-hairline rounded-lg p-5 hover:shadow-md transition-shadow no-underline">
                <div class="flex items-center gap-2 mb-2">
                  <span class="text-nw-jade text-xs font-medium uppercase">{item.data.type}</span>
                  <span class="text-nw-subtle text-xs">
                    {item.data.date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
                  </span>
                </div>
                <h3 class="text-nw-ink font-semibold text-sm mb-1">{item.data.title}</h3>
                {item.data.summary && (
                  <p class="text-nw-muted text-xs leading-relaxed">{item.data.summary}</p>
                )}
              </a>
            ))}
            {localReports.map((item) => (
              <a href={`/research/${item.id}`} class="block bg-white border border-wz-hairline rounded-lg p-5 hover:shadow-md transition-shadow no-underline">
                <div class="flex items-center gap-2 mb-2">
                  <span class="text-nw-jade text-xs font-medium uppercase">{item.data.type}</span>
                  <span class="text-nw-subtle text-xs">
                    {item.data.date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
                  </span>
                </div>
                <h3 class="text-nw-ink font-semibold text-sm mb-1">{item.data.title}</h3>
                {item.data.summary && (
                  <p class="text-nw-muted text-xs leading-relaxed">{item.data.summary}</p>
                )}
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Nuwa Briefs -->
      {briefs.length > 0 && (
        <div class="mb-20">
          <h2 class="text-nw-ink font-semibold mb-6" style="font-size: var(--text-h2);">Nuwa Briefs</h2>
          <div class="space-y-3">
            {briefs.map((brief) => (
              <a href={`/research/${brief.id}`} class="block bg-nw-jade-pale border border-nw-hairline rounded-lg p-5 hover:shadow-md transition-shadow no-underline">
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-nw-jade text-xs font-medium uppercase">Nuwa Brief</span>
                  <span class="text-nw-subtle text-xs">
                    {brief.data.date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
                  </span>
                </div>
                <h3 class="text-nw-ink font-semibold text-sm">{brief.data.title}</h3>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Subscribe CTA -->
      <div class="bg-nw-warm-paper border border-nw-hairline rounded-xl p-8 text-center">
        <p class="text-nw-body text-base mb-4">Follow Nuwa's research updates</p>
        <div class="flex justify-center gap-3">
          <a
            href={links.substack}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center bg-nw-ink text-white rounded-full px-5 py-2.5 text-sm font-semibold hover:bg-nw-deep-blue transition-colors no-underline"
          >
            Subscribe to Nuwa Brief
          </a>
          <a
            href={links.x}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center bg-white text-nw-ink border border-nw-hairline rounded-full px-5 py-2.5 text-sm font-semibold hover:border-nw-subtle transition-colors no-underline"
          >
            Follow on X
          </a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
