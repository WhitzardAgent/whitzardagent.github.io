---
import BaseLayout from "../layouts/BaseLayout.astro";
import { links } from "../data/links";
import { researchAssets } from "../data/generated/researchAssets";
import UnifiedResearchCard from "../components/UnifiedResearchCard.astro";
import ResearchAreaCard from "../components/ResearchAreaCard.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CalloutPanel from "../components/CalloutPanel.astro";
import FiveStoneMotif from "../components/visuals/FiveStoneMotif.astro";

const featuredPapers = researchAssets.filter((p) => p.featured);
const otherPapers = researchAssets.filter((p) => !p.featured);

// Extract unique topic tags for filter bar
const allTopics = [...new Set(researchAssets.flatMap((p) => p.topic || []))];

const researchAreas = [
  { title: "Autonomy Risks", tag: "Autonomy", description: "Self-replication, self-proliferation, and autonomous resource acquisition in AI systems." },
  { title: "Deception", tag: "Deception", description: "AI deception in human-AI interaction, developer-facing deception, and trust dynamics." },
  { title: "Scheming", tag: "Scheming", description: "Evaluation faking, situational awareness, and observer effects in safety evaluations." },
  { title: "Loss-of-Control", tag: "Loss-of-Control", description: "Conditions under which advanced AI systems may evade oversight or resist shutdown." },
  { title: "Agent Safety", tag: "Agent Safety", description: "Behavioral safety, thought correction, and guardrails for AI agent systems." },
  { title: "Evaluation", tag: "Evaluation", description: "Executable risk-evaluation environments, benchmarks, and evaluation integrity." },
  { title: "Runtime Safety", tag: "Runtime Safety", description: "Zero-trust access control, policy enforcement, and security for agent runtimes." },
];
---

<BaseLayout
  title="Research — Nuwa Frontier AI Safety Lab"
  description="Publications, papers, reports, and technical notes from Nuwa Frontier AI Safety Lab covering frontier AI risk evaluation, agent safety, AI control, and runtime safety."
  brand="nuwa"
  ogImage="/assets/og/nuwa-og.png"
>
  <section class="py-20 md:py-28">
    <div class="max-w-[1120px] mx-auto px-6">

      <!-- Hero -->
      <div class="max-w-2xl mb-16">
        <div class="flex items-center gap-2 mb-4">
          <span style="color: var(--stone-jade);" class="text-base">&#9670;</span>
          <span class="text-nw-jade text-xs font-medium uppercase tracking-wide">Nuwa Research</span>
        </div>
        <h1 class="text-wz-ink font-semibold tracking-tight mb-5" style="font-size: var(--text-h1);">
          Research
        </h1>
        <p class="text-wz-body text-lg leading-relaxed">
          Publications, research papers, reports, frameworks, and technical notes from Nuwa Frontier AI Safety Lab.
        </p>
      </div>

      <!-- Research Areas -->
      <div class="mb-20">
        <SectionHeader title="Research Areas" subtitle="Themes guiding our work on frontier AI safety." />
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
          {researchAreas.map((area) => (
            <ResearchAreaCard title={area.title} tag={area.tag} description={area.description} />
          ))}
        </div>
      </div>

      <FiveStoneMotif layout="row" size={4} gap={8} class="mb-16" />

      <!-- Theme Filter Bar (static, visual taxonomy) -->
      <div class="mb-10">
        <div class="flex flex-wrap gap-2">
          <span class="badge badge--active">All</span>
          {allTopics.slice(0, 7).map((t) => (
            <span class="badge" style="background: var(--nw-jade-pale); color: var(--nw-jade);">{t}</span>
          ))}
        </div>
      </div>

      <!-- Featured Research -->
      <div class="mb-20">
        <SectionHeader title="Featured Research" />
        <div class="space-y-5">
          {featuredPapers.map((paper) => (
            <UnifiedResearchCard
              title={paper.title}
              authors={paper.authors}
              year={paper.year}
              venue={paper.venue}
              status={paper.status}
              summary={paper.summary}
              url={paper.url}
              pdfUrl={paper.pdfUrl}
              topic={paper.topic}
              featured={paper.featured}
              brand="nuwa"
            />
          ))}
        </div>
      </div>

      <!-- All Publications -->
      {otherPapers.length > 0 && (
        <div class="mb-20">
          <SectionHeader title="All Publications" subtitle="Complete list of research outputs from the lab." />
          <div class="space-y-4">
            {otherPapers.map((paper) => (
              <UnifiedResearchCard
                title={paper.title}
                authors={paper.authors}
                year={paper.year}
                venue={paper.venue}
                status={paper.status}
                summary={paper.summary}
                url={paper.url}
                pdfUrl={paper.pdfUrl}
                topic={paper.topic}
                featured={paper.featured}
                brand="nuwa"
              />
            ))}
          </div>
        </div>
      )}

      <!-- Subscribe CTA -->
      <CalloutPanel
        variant="nuwa"
        align="center"
        description="Follow Nuwa's research updates on frontier AI risk, agent safety, and controllable AI."
      >
        <div class="flex justify-center gap-3">
          <a href={links.substack} target="_blank" rel="noopener noreferrer" class="btn btn--primary">
            Subscribe to Nuwa Brief
          </a>
          <a href={links.x} target="_blank" rel="noopener noreferrer" class="btn btn--secondary">
            Follow on X
          </a>
        </div>
      </CalloutPanel>

    </div>
  </section>
</BaseLayout>
